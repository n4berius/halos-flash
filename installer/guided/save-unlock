#!/bin/bash
# halOS guided install (#13): how the disk unlocks, as chosen in plan-install. Run from the %post
# section plan-install writes into the kickstart: save-unlock <choice> <disk>, with the keys that
# may unlock over SSH on stdin. The keys and the choice (read by halosctl setup at first boot) go
# on the new system's EFI partition on that disk, where the initramfs looks, through the same
# helper halosctl uses. Should it fail, the install still boots: sudo halosctl ssh-unlock on sets it
# up later. Its output lands in the installed system's /var/log/anaconda/ks-script-*.log.
set -u
choice="${1:-}" disk="${2:-}"
esp_type=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
root="${ANA_INSTALL_PATH:-/mnt/sysroot}"
say() { echo "halOS: $*"; }
esp="${HALOS_SAVE_ESP:-}" mnt=""   # HALOS_SAVE_ESP: tests only
[ -n "$esp" ] || for d in "$root/boot/efi" /mnt/sysimage/boot/efi; do
  if mountpoint -q "$d"; then esp="$d"; break; fi
done
# Not mounted at this point of a bootc install: mount the EFI partition of the disk installed to.
if [ -z "$esp" ] && [[ "$disk" =~ ^[a-z0-9]+$ ]]; then
  part=""
  while read -r p t; do
    [ "$t" = "$esp_type" ] && { part="$p"; break; }
  done < <(lsblk -rnpo PATH,PARTTYPE "/dev/$disk" 2> /dev/null)
  if [ -z "$part" ]; then
    # lsblk reads udev's database, which may lag; ask the partition table itself.
    for p in $(lsblk -rnpo PATH "/dev/$disk" 2> /dev/null); do
      [ "$(blkid -p -s PART_ENTRY_TYPE -o value "$p" 2> /dev/null)" = "$esp_type" ] && { part="$p"; break; }
    done
  fi
  if [ -n "$part" ] && mnt="$(mktemp -d /run/halos-esp.XXXXXX)" && mount -t vfat -o umask=0077 "$part" "$mnt"; then
    esp="$mnt"
  else
    say "no EFI partition found on /dev/$disk"; [ -z "$mnt" ] || rmdir "$mnt"; mnt=""
  fi
fi
say "unlock choice $choice; EFI partition at ${esp:-(none found)}"
if [ -n "$esp" ] && HALOS_ESP="$esp" HALOS_UNLOCK_CHOICE="$choice" "${HALOS_KEYS_TOOL:-/usr/libexec/halos/ssh-unlock}" install-choice 2>&1 | sed 's/^/halOS: /'; [ "${PIPESTATUS[0]}" = 0 ]; then
  say "unlock choice saved"
else
  say "the unlock choice couldn't be saved; after the install: sudo halosctl ssh-unlock on"
fi
if [ -n "$mnt" ]; then sync; umount "$mnt" && rmdir "$mnt"; fi
exit 0
