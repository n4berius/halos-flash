# The live environment on the USB. Its packages stay on the USB: the installed
# system comes only from the embedded OS image, which has no desktop.
# The installer drops what it never uses on this hardware: other vendors' firmware, Vulkan,
# video codecs, CPU emulators, and the base image's own OSTree copy of its files.
ARG FEDORA_BOOTC_IMAGE
FROM ${FEDORA_BOOTC_IMAGE}
ARG TARGET_IMAGE
ARG HALOGEN_VARIANT

RUN dnf -y install \
      anaconda anaconda-install-img-deps anaconda-dracut \
      dracut-config-generic dracut-live dracut-network \
      net-tools plymouth jq isomd5sum xorrisofs squashfs-tools \
      grub2-efi-x64-cdboot grub2-pc-modules \
      default-fonts-core-sans default-fonts-other-sans && \
    dnf -y remove \
      nvidia-gpu-firmware intel-gpu-firmware intel-npu-firmware intel-audio-firmware \
      cirrus-audio-firmware brcmfmac-firmware tiwilink-firmware nxpwireless-firmware \
      qcom-wwan-firmware microcode_ctl \
      'qemu-user-static*' toolbox sos python3-boto3 python3-botocore python3-s3transfer \
      mesa-vulkan-drivers intel-mediasdk intel-vpl-gpu-rt libavcodec-free libmediainfo && \
    dnf clean all && \
    rpm -q anaconda-gui anaconda-tui amd-gpu-firmware && \
    rm -rf /sysroot/ostree

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

COPY LICENSE THIRD-PARTY-NOTICES.md /usr/share/licenses/halos-flash/
COPY installer/buildstamp /.buildstamp
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY installer/anaconda/10-halogen.conf /etc/anaconda/conf.d/10-halogen.conf
COPY installer/anaconda/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
COPY installer/guided/halos-guided.ks /usr/share/anaconda/halos-guided.ks
COPY installer/guided/plan-install /usr/libexec/halos/plan-install
# The same key helper as the installed system's halosctl ssh-unlock (#13).
COPY files/usr/libexec/halogen/ssh-unlock /usr/libexec/halos/ssh-unlock
COPY installer/guided/save-unlock /usr/libexec/halos/save-unlock
COPY installer/anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
COPY installer/allowroot.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY installer/allowroot.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf

RUN sed -i "s|@EDITION@|${HALOGEN_VARIANT}|g" /usr/lib/image-builder/bootc/iso.yaml && \
    sed -i "s|@TARGET_IMAGE@|${TARGET_IMAGE}|g" /usr/share/anaconda/interactive-defaults.ks \
      /usr/share/anaconda/halos-guided.ks && \
    ! grep -q '@TARGET_IMAGE@' /usr/share/anaconda/interactive-defaults.ks /usr/share/anaconda/halos-guided.ks && \
    for c in chvt jq numfmt wipefs lsblk blkid findmnt pvs getent openssl ssh-keygen curl setpriv nm-online mountpoint; do command -v "$c" >/dev/null || exit 1; done

# What lorax normally does so Anaconda can run. Based on image-builder's example.
RUN echo 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' >> /etc/passwd && \
    echo 'install::14438:0:99999:7:::' >> /etc/shadow && \
    passwd -d root && \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service && \
    systemctl mask bootloader-update.service

RUN mkdir -p "$(realpath /root)" && \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')" && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add "anaconda dmsquash-live" \
      --include /usr/share/anaconda/halos-guided.ks /halos-guided.ks \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}" && \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q ' halos-guided.ks$'
