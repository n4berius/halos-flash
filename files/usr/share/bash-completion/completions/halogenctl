# bash completion for halogenctl (halOS). Names of your own checkpoints complete only where
# you can read /srv/models (as root, or in the halogen group): sudo runs completion as you.
_halogenctl() {
  # shellcheck disable=SC2034 # prev is set by _init_completion
  local cur prev words cword
  _init_completion 2>/dev/null || { cur="${COMP_WORDS[COMP_CWORD]}"; words=("${COMP_WORDS[@]}"); cword=$COMP_CWORD; }
  local models=/srv/models
  _halogenctl_names() { local d; for d in "$@"; do [ -d "$d" ] && find "$d" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null; done; }
  if [ "$cword" -eq 1 ]; then
    mapfile -t COMPREPLY < <(compgen -W "status start stop restart logs fetch-logs doctor selftest bench config options api-key hf-token model flash" -- "$cur")
    return
  fi
  case "${words[1]}" in
    options) [ "$cword" -eq 2 ] && mapfile -t COMPREPLY < <(compgen -W "--new" -- "$cur") ;;
    bench) [ "$cword" -eq 2 ] && mapfile -t COMPREPLY < <(compgen -W "--quick" -- "$cur") ;;
    hf-token) [ "$cword" -eq 2 ] && mapfile -t COMPREPLY < <(compgen -W "--remove" -- "$cur") ;;
    model)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "pull list remove" -- "$cur")
      elif [ "${words[2]}" = remove ] && [ "$cword" -eq 3 ]; then
        mapfile -t COMPREPLY < <(compgen -W "$(_halogenctl_names "$models/decider" "$models/LFM" "$models/custom")" -- "$cur")
      elif [ "${words[2]}" = pull ] && [ "$cword" -ge 4 ]; then
        mapfile -t COMPREPLY < <(compgen -W "--revision --as" -- "$cur")
      fi ;;
    flash)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "pull list use verify check remove" -- "$cur")
      elif [ "$cword" -eq 3 ]; then
        case "${words[2]}" in
          use) mapfile -t COMPREPLY < <(compgen -W "official $(_halogenctl_names "$models/flash")" -- "$cur") ;;
          verify|check|remove) mapfile -t COMPREPLY < <(compgen -W "$(_halogenctl_names "$models/flash")" -- "$cur") ;;
        esac
      else
        case "${words[2]}" in
          pull) mapfile -t COMPREPLY < <(compgen -W "--revision --as --file" -- "$cur") ;;
          use|check|remove) mapfile -t COMPREPLY < <(compgen -W "--yes" -- "$cur") ;;
        esac
      fi ;;
  esac
}
complete -F _halogenctl halogenctl
