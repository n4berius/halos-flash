# bash completion for halogen-enroll-tpm (halOS): the LUKS device, if not the one in /etc/crypttab.
_halogen_enroll_tpm() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  [ "$COMP_CWORD" -eq 1 ] || return 0
  mapfile -t COMPREPLY < <(compgen -W "$(lsblk -rnpo PATH,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')" -- "$cur")
}
complete -F _halogen_enroll_tpm halogen-enroll-tpm
