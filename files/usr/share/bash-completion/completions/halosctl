# bash completion for halosctl (halOS).
_halosctl() {
  local cur prev words cword
  if declare -F _init_completion > /dev/null; then _init_completion || return
  else cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[COMP_CWORD-1]}"; words=("${COMP_WORDS[@]}"); cword=$COMP_CWORD; fi
  if [ "$cword" -eq 1 ]; then
    mapfile -t COMPREPLY < <(compgen -W "version upgrade switch rollback npu power history setup ssh-unlock ssh-passwords dashboard https help" -- "$cur")
    return
  fi
  [ "$prev" != --to ] || return 0   # a release such as 0.19.0-alpha.1: nothing to offer
  case "${words[1]}" in
    upgrade) mapfile -t COMPREPLY < <(compgen -W "--check --reboot --yes" -- "$cur") ;;
    switch)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "alpha beta rc release edge" -- "$cur")
      else mapfile -t COMPREPLY < <(compgen -W "--reboot --yes" -- "$cur"); fi ;;
    npu)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "on off" -- "$cur")
      else mapfile -t COMPREPLY < <(compgen -W "--reboot --yes" -- "$cur"); fi ;;
    power) [ "$cword" -ne 2 ] || mapfile -t COMPREPLY < <(compgen -W "low-power balanced performance" -- "$cur") ;;
    dashboard) [ "$cword" -ne 2 ] || mapfile -t COMPREPLY < <(compgen -W "on off" -- "$cur") ;;
    https)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "self-signed custom letsencrypt off ca forget-dns" -- "$cur")
      elif [ "${COMP_WORDS[2]}" = custom ] && [ "$cword" -le 4 ]; then mapfile -t COMPREPLY < <(compgen -f -- "$cur")
      elif [ "${COMP_WORDS[2]}" = letsencrypt ] && [ "$cword" -eq 3 ]; then mapfile -t COMPREPLY < <(compgen -W "cloudflare duckdns porkbun namecheap" -- "$cur")
      elif [ "${COMP_WORDS[2]}" = letsencrypt ] && [ "$prev" != --email ]; then mapfile -t COMPREPLY < <(compgen -W "--email --staging --yes" -- "$cur")
      fi ;;
    rollback) mapfile -t COMPREPLY < <(compgen -W "--to --reboot --yes" -- "$cur") ;;
    setup) mapfile -t COMPREPLY < <(compgen -W "--skip" -- "$cur") ;;
    ssh-passwords)
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "on off" -- "$cur")
      else mapfile -t COMPREPLY < <(compgen -W "--yes" -- "$cur"); fi ;;
    ssh-unlock)
      case "$prev" in --github|--gitlab|--codeberg|--key) return 0 ;; esac   # a user name or a key
      if [ "$cword" -eq 2 ]; then mapfile -t COMPREPLY < <(compgen -W "on off record" -- "$cur")
      elif [ "${words[2]}" = on ]; then mapfile -t COMPREPLY < <(compgen -W "--github --gitlab --codeberg --key --yes" -- "$cur")
      else mapfile -t COMPREPLY < <(compgen -W "--yes" -- "$cur"); fi ;;
  esac
}
complete -F _halosctl halosctl
