# Imported into Caddyfile.letsencrypt's global options for HALOS_ACME_DNS=namecheap: the credentials are
# systemd credentials halos-proxy.service loads from root's /etc/halos/https/dns (LoadCredential=).
acme_dns namecheap {
	api_key {file.{$CREDENTIALS_DIRECTORY}/dns_api_key}
	user {file.{$CREDENTIALS_DIRECTORY}/dns_user}
	client_ip {file.{$CREDENTIALS_DIRECTORY}/dns_client_ip}
}
