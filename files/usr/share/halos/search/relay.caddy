# The relay from Halogen to your own SearXNG (halos-search-relay.container): halOS's Caddy in a tiny
# image, listening on 10.89.250.2:8080 on halos-search, where Halogen looks for web search. It
# passes GET (and HEAD) requests to HALOS_SEARCH_UPSTREAM, the scheme, host and port of the URL
# given to sudo halogenctl web-search external (checked there), and to nothing else; the path is
# Halogen's, which render-config gives the URL's path as its prefix. Checked with caddy adapt when
# the image is built.
{
	admin off
	persist_config off
	auto_https off
	servers {
		max_header_size 32KB
		protocols h1
	}
	grace_period 5s
}

http://:8080 {
	@other not method GET HEAD
	respond @other 405
	reverse_proxy {$HALOS_SEARCH_UPSTREAM} {
		# Your server sees its own name, as a browser would send it (needed for HTTPS and for
		# servers that answer several names).
		header_up Host {upstream_hostport}
	}
	handle_errors 502 503 504 {
		respond "Your SearXNG server didn't answer" 502
	}
}
