# The relay from Halogen to your own SearXNG (halos-search-relay.container): halOS's Caddy in a tiny
# image, listening on 10.89.250.2:8080 on halos-search, where Halogen looks for web search. It
# passes GET (and HEAD) requests to HALOS_SEARCH_UPSTREAM, the scheme, host and port of the URL
# given to sudo halogenctl web-search external (checked there), and to nothing else. Only the two
# pages Halogen and halOS use pass: the search and the health page under HALOS_SEARCH_PATH, the URL's
# path (render-config gives Halogen the same prefix). Every other page of your server gets 404, so
# port 8730 can't be used to reach the rest of it (security audit of #184). Checked with caddy adapt
# when the image is built.
{
	admin off
	persist_config off
	auto_https off
	servers {
		max_header_size 32KB
		protocols h1
	}
	grace_period 5s
}

http://:8080 {
	# handle blocks run in the order written, the first that matches alone.
	# Caddy matches the cleaned, decoded path, without case, but would pass on the path as it came
	# (code review of #186: /searx/stats/../search matched and went on as it was), so each page goes
	# on as exactly its own path, with only the query kept.
	@search {
		method GET HEAD
		path {$HALOS_SEARCH_PATH}/search
	}
	handle @search {
		rewrite * {$HALOS_SEARCH_PATH}/search?{query}
		reverse_proxy {$HALOS_SEARCH_UPSTREAM} {
			# Your server sees its own name, as a browser would send it (needed for HTTPS and for
			# servers that answer several names).
			header_up Host {upstream_hostport}
		}
	}
	@health {
		method GET HEAD
		path {$HALOS_SEARCH_PATH}/healthz
	}
	handle @health {
		rewrite * {$HALOS_SEARCH_PATH}/healthz
		reverse_proxy {$HALOS_SEARCH_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}
	@other not method GET HEAD
	handle @other {
		respond 405
	}
	handle {
		respond "Only searches pass to your SearXNG server; open its page on that server" 404
	}
	handle_errors 502 503 504 {
		respond "Your SearXNG server didn't answer" 502
	}
}
