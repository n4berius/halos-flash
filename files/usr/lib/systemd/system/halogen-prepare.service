[Unit]
Description=Prepare Halogen directories, configuration and API key
RequiresMountsFor=/var/srv/models /var/srv/configs /var/srv/logs /var/lib/halogen
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=user@970.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/halogen/prepare
# A root job that works in halogen's folders: let it write only there, with no network.
# Costs nothing; it runs for well under a second at boot.
ProtectSystem=strict
ReadWritePaths=/var/srv/models /var/srv/configs /var/srv/logs /var/lib/halogen /var/lib/halos
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
# More of the same (security audit, after #165): no kernel settings, modules, log, clock, host
# name, cgroups or new namespaces, no devices but the basic ones, and only the capabilities its
# work takes: owners and modes in halogen's folders (chown, chmod, chcon on files halogen owns),
# runuser to halogen (set ids, PAM's audit record and limits).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target
