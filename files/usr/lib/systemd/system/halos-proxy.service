[Unit]
Description=halOS front door: Caddy on Halogen's API (8731) and the dashboard (8732), HTTP or HTTPS
Documentation=https://caddyserver.com/docs/
# Halogen and the dashboard listen on 127.0.0.1:18731 and :18732 only; every connection from the
# network comes through here. It needs neither to start: until they answer, it says so (503).
# In self-signed HTTPS mode the certificates name this machine's addresses, so wait for the network
# to have them; one that comes later (Tailscale, a new DHCP lease) is picked up by
# halos-https-refresh.timer within a minute.
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
# HTTP or HTTPS (sudo halosctl https): as root, outside the sandbox, the https helper writes which
# Caddyfile and sites to use into /run/halos-https, and for your own certificate copies it into the
# runtime folder for Caddy's user; for Let's Encrypt it checks the DNS credentials loaded below.
# Root reads only its own /etc/halos.
ExecStartPre=+/usr/libexec/halogen/https env
# A bad setting (such as a mistyped range in /etc/halos/proxy.env) fails here once, with Caddy's
# reason in the journal, instead of a silent restart loop.
ExecStartPre=/usr/libexec/halogen/caddy validate --config ${HALOS_PROXY_CONFIG} --adapter caddyfile
ExecStart=/usr/libexec/halogen/caddy run --config ${HALOS_PROXY_CONFIG} --adapter caddyfile
Environment=HOME=/var/lib/halos-proxy XDG_DATA_HOME=/var/lib/halos-proxy XDG_CONFIG_HOME=/var/lib/halos-proxy
# No default: if the https helper's file below is missing, validate fails and Caddy doesn't start,
# rather than serve plain HTTP when HTTPS was asked for.
Environment=HALOS_PROXY_CONFIG=/run/halos-https/missing
# Optional, root's: HALOS_DASHBOARD_ALLOW=<more address ranges> lets other networks see the dashboard.
EnvironmentFile=-/etc/halos/proxy.env
# Written by the https helper above, in a folder of its own that only root writes (Caddy's runtime
# folder is Caddy's, and systemd reads this as root). Read again for each command, so the two below
# see it; "-" only because the helper itself runs before the file exists.
EnvironmentFile=-/run/halos-https/proxy.env
# Let's Encrypt: the DNS provider's credentials, from root's folder, as systemd credentials Caddy
# reads through {file.{$CREDENTIALS_DIRECTORY}/dns_<field>}: read-only, in memory, gone when it stops,
# and never in a folder Caddy's user owns. Hidden entries (.pending, .prev) and links are skipped.
# SetCredential= is meant as the fallback for a missing folder, but in the VM test Caddy didn't
# start without it, so tmpfiles makes the folder at boot and forget-dns only empties it. Loaded in every
# mode, so put nothing else there: a file systemd can't load (a name with ":", a socket, one too
# big) stops Caddy's start. Never load /etc/halos/https as a whole: it would take dns/ with it.
LoadCredential=dns:/etc/halos/https/dns
SetCredential=dns:
RuntimeDirectory=halos-proxy
RuntimeDirectoryMode=0700
Restart=always
RestartSec=2
TimeoutStopSec=20
DynamicUser=yes
StateDirectory=halos-proxy
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=8192
MemoryMax=256M
# Go's collector works to stay under this, well below the cap, rather than being throttled by it.
Environment=GOMEMLIMIT=192MiB
LimitCORE=0
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# It may listen on these two ports only (connecting out needs no bind).
SocketBindAllow=tcp:8731
SocketBindAllow=tcp:8732
SocketBindDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
