# The firmware's power profile, as chosen with halosctl power (performance when none is chosen).
# Runs at boot and after resume, like the fabric clock. Machines without an ACPI platform profile
# (QEMU, some boards) skip it.
[Unit]
Description=Set the firmware power profile chosen with halosctl power
ConditionPathExists=/sys/firmware/acpi/platform_profile
After=systemd-modules-load.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
Before=user@970.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/halogen/platform-profile apply
# It writes one file in /sys and reads one in /etc. ProtectKernelTunables makes all of /sys
# read-only; ReadWritePaths opens that one file again (checked on freyja). No capabilities: root
# owns both files, so plain file permissions are enough.
ProtectSystem=strict
ProtectKernelTunables=yes
ReadWritePaths=-/sys/firmware/acpi/platform_profile
CapabilityBoundingSet=
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
