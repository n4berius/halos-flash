[Unit]
Description=halOS dashboard: Halogen's load and health (port 8732, through halos-proxy)
Documentation=https://github.com/Quat3rnion/halogen-dashboard
# The API key exists once halogen-prepare made it (first boot).
After=network.target halogen-prepare.service
StartLimitIntervalSec=0

[Service]
# Reads the API key as the halogen user, never as root (dashboard-key); the dashboard itself runs
# as a user of its own, with no access to Halogen's files, models or tokens.
ExecStartPre=+/usr/libexec/halogen/dashboard-key
ExecStart=/usr/libexec/halogen/dashboard-run
Environment=HALOGEN_URL=http://127.0.0.1:18731
# On this machine only: halos-proxy.service (Caddy) answers the network on 8732 and lets only
# this machine and private networks through.
Environment=HALOGEN_DASHBOARD_LISTEN=127.0.0.1:18732
Environment=HALOGEN_DASHBOARD_DB=/var/lib/halos-dashboard/halogen-dashboard.sqlite
Environment=RUST_LOG=warn
Restart=on-failure
RestartSec=30
DynamicUser=yes
StateDirectory=halos-dashboard
RuntimeDirectory=halos-dashboard
RuntimeDirectoryMode=0700
UMask=0077
# One request a second to Halogen and a small SQLite file (30 days of minute summaries).
MemoryHigh=192M
MemoryMax=256M
CPUWeight=20
# At most one core, whatever a client on the network asks of it (it normally uses almost none).
CPUQuota=100%
Nice=5
IOSchedulingClass=idle
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only this machine: Caddy (halos-proxy) in front and Halogen behind are both on 127.0.0.1. The
# private-networks rule for visitors is Caddy's (/usr/share/halos/proxy/Caddyfile).
IPAddressDeny=any
IPAddressAllow=localhost
# Counts its traffic with the same kernel feature (BPF on its cgroup) the filter above uses, so the
# selftest can tell the filter is really on: without that feature systemd starts it unfiltered.
IPAccounting=yes
# It may listen on 18732 only, whatever its settings say (connecting out needs no bind).
SocketBindAllow=tcp:18732
SocketBindDeny=any
# No core file, which would hold the API key. dashboard-run also makes the process not dumpable,
# so a crash isn't handed to systemd-coredump either (it would journal the environment, key included).
LimitCORE=0
PrivateUsers=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Traced under load against the simulator: everything it calls is in @system-service; of the denied
# groups only fchown, which SQLite calls just as root (it runs as its own user). A blocked call
# fails with EPERM rather than killing it.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
