# halOS: the initramfs SSH server, only for the disk passphrase (#13). Not the system's sshd.
Port 22
HostKey /run/halos-ssh-unlock/ssh_host_ed25519_key
AuthorizedKeysFile /run/halos-ssh-unlock/authorized_keys
AllowUsers root
PermitRootLogin prohibit-password
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
# Nothing but the passphrase prompt. --watch waits for it (the TPM may still be trying) and asks
# again after a wrong passphrase; switch-root ends the session.
ForceCommand /usr/bin/systemd-tty-ask-password-agent --watch
PermitTTY yes
DisableForwarding yes
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
PrintMotd no
# One machine on the network can't hold every slot.
LoginGraceTime 20
MaxAuthTries 6
MaxSessions 1
MaxStartups 4:50:10
PerSourceMaxStartups 2
