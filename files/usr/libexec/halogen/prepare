#!/bin/bash
# Runs as root on every boot. Safe to repeat.
#
# /srv/models, /srv/configs and /srv/logs belong to the halogen user, and the fetch containers can
# write in /srv/models. So root only creates those three folders (their parent, /var/srv, is root's), and
# everything inside them is created as halogen: a link planted there can then only reach what
# halogen could reach anyway, never a root-owned file.
set -euo pipefail
models="${HALOGEN_MODELS_DIR:-/var/srv/models}"
configs="${HALOGEN_CONFIGS_DIR:-/var/srv/configs}"
logs="${HALOGEN_LOGS_DIR:-/var/srv/logs}"
state="${HALOGEN_STATE_DIR:-/var/lib/halogen}"
as_halogen() { runuser -u halogen -- "$@"; }

install -d -o halogen -g halogen -m 0750 "$models" "$configs" "$logs" "$state"
# Halogen's request records (sudo halogenctl records on mounts it at /records). On installs made
# before #107 /srv/logs is a folder on /var; newer guided installs give it a volume of its own.
as_halogen install -d -m 0700 "$logs/halogen"
# shellcheck source=/dev/null
. "${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
# Your own Flash checkpoints (halogenctl flash pull), on both editions.
as_halogen install -d -m 0750 "$models/flash"
if [ "$HALOGEN_VARIANT" = npu ]; then
  # Halogen's NPU models, and folders for your own checkpoints (halogenctl model pull).
  as_halogen install -d -m 0750 "$models/npu" "$models/decider" "$models/LFM" "$models/custom"
fi

# A new install has no halogen.env yet. Only then is first-boot setup (sudo halosctl setup)
# pending: the first download waits for it, up to 30 minutes. Upgrades never get the marker.
if ! as_halogen test -e "$configs/halogen.env" && ! as_halogen test -L "$configs/halogen.env" &&
   ! as_halogen test -e "$models/.fetch-stamp"; then
  as_halogen touch "$state/setup-pending"
fi
# shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
as_halogen sh -c '[ -e "$1" ] || [ -L "$1" ] || install -m 0640 "$2" "$1"' \
  sh "$configs/halogen.env" "${HALOGEN_ENV_DEFAULT:-/usr/share/halogen/halogen.env.default}"
# halogen.env is yours and never changes after the first boot. Beside it, a reference of every
# option this release offers, rewritten at every boot (sudo halogenctl options --new: what's new).
# shellcheck disable=SC2016
as_halogen sh -c 'umask 027
  { echo "# Reference only: every option this halOS release offers, rewritten at every boot."
    echo "# Copy a line into halogen.env to use it. Options you do not mention yet: sudo halogenctl options --new"
    echo; cat "$2"; } > "$1.new" && mv -f "$1.new" "$1"' \
  sh "$configs/halogen.env.example" "${HALOGEN_ENV_DEFAULT:-/usr/share/halogen/halogen.env.default}" \
  || echo "halogen-prepare: could not write halogen.env.example (a reference only; nothing else is affected)" >&2
# shellcheck disable=SC2016
as_halogen sh -c 'umask 077; [ -e "$1" ] || [ -L "$1" ] || head -c 32 /dev/urandom | od -An -tx1 | tr -d " \n" > "$1"' \
  sh "$configs/api-key"

if command -v selinuxenabled >/dev/null && selinuxenabled; then
  for dir in "$models" "$configs" "$logs"; do
    case "$(stat -c %C "$dir")" in
      *:container_file_t:*) ;;
      # -R does not follow links (-P is the default), so this stays inside the folder.
      *) chcon -R -P -t container_file_t "$dir" ;;
    esac
  done
fi
