#!/bin/bash
# Unlock the disk over SSH at boot (#13): the keys and the early-boot server's own host key live
# on the EFI system partition, in /halos/ssh-unlock/, because every machine boots the same
# initramfs from the image. The initramfs module 90halos-ssh-unlock reads them. Run by halosctl.
#   ssh-unlock fetch github|gitlab|codeberg <user>   that account's public keys, checked
#   ssh-unlock check        public keys on stdin, checked (bad lines are named on stderr)
#   ssh-unlock describe     public keys on stdin, one line each: type, size, fingerprint, comment
#   ssh-unlock install      public keys on stdin become the ones allowed to unlock
#   ssh-unlock remove       turn it off
#   ssh-unlock status [--short]
# The EFI partition is readable by anyone holding the disk, so it holds only public keys and the
# early-boot host key, which is not the system's own.
set -euo pipefail
esp_type=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
die() { echo "ssh-unlock: $*" >&2; exit 1; }

# One public key per line, as GitHub, GitLab and Codeberg serve them: no options, a known type, a
# size OpenSSH accepts. Prints the key (type, blob, printable comment); fails otherwise.
check_line() {
  local line="$1" bits
  [[ "$line" =~ ^(ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp(256|384|521)|sk-ecdsa-sha2-nistp256@openssh\.com|ssh-rsa)\ [A-Za-z0-9+/]+={0,3}(\ [[:print:]]{0,200})?$ ]] || return 1
  bits="$(ssh-keygen -l -f /dev/stdin <<< "$line" 2> /dev/null | awk '{print $1}')" || return 1
  [[ "$bits" =~ ^[0-9]+$ ]] || return 1
  if [ "${line%% *}" = ssh-rsa ] && [ "$bits" -lt 2048 ]; then return 1; fi
  printf '%s\n' "$line"
}
check() {
  local line n=0 seen=" " blob good=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1)); line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue ;; esac
    if ! out="$(check_line "$line")"; then echo "line $n is not a public key this can use; skipped" >&2; continue; fi
    blob="$(cut -d' ' -f2 <<< "$out")"
    case "$seen" in *" $blob "*) continue ;; esac
    seen+="$blob "; good=$((good + 1)); printf '%s\n' "$out"
  done
  [ "$good" -gt 0 ]
}
describe() {
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    ssh-keygen -l -f /dev/stdin <<< "$line" | awk '{ t = $NF; $NF = ""; printf "  %s %s\n", t, $0 }'
  done
}

# The EFI partition, mounted read-write: where it is mounted already, or for this run in /run.
esp=""; mounted_here=""
cleanup() { [ -z "$mounted_here" ] || { umount "$mounted_here" && rmdir "$mounted_here"; }; }
trap cleanup EXIT
find_esp() { # [ro]: only to read (status), so nothing is remounted or written
  local ro="${1:-}"
  if [ -n "${HALOS_ESP:-}" ]; then esp="$HALOS_ESP"; return; fi
  local p t m devs=() mnt=()
  while read -r p t m; do
    [ "$t" = "$esp_type" ] || continue
    devs+=("$p"); mnt+=("${m:-}")
  done < <(lsblk -rno PATH,PARTTYPE,MOUNTPOINT)
  [ "${#devs[@]}" -gt 0 ] || die "no EFI system partition found"
  local i pick=""
  for i in "${!devs[@]}"; do [ "${mnt[$i]}" = /boot/efi ] && pick="$i"; done
  if [ -z "$pick" ]; then
    [ "${#devs[@]}" = 1 ] || die "several EFI system partitions and none at /boot/efi: ${devs[*]}"
    pick=0
  fi
  if [ -n "${mnt[$pick]}" ]; then
    esp="${mnt[$pick]}"
    # Read-only mounts happen (bootupd mounts it only when it needs to); write anyway.
    if [ -z "$ro" ] && ! findmnt -rno OPTIONS "$esp" | tr , '\n' | grep -qx rw; then
      mount -o remount,rw "$esp" || die "can't write to $esp"
    fi
  else
    mounted_here="$(mktemp -d /run/halos-esp.XXXXXX)"
    mount -t vfat -o "umask=0077${ro:+,ro}" "${devs[$pick]}" "$mounted_here" || { rmdir "$mounted_here"; mounted_here=""; die "can't mount ${devs[$pick]}"; }
    esp="$mounted_here"
  fi
}

cmd="${1:-status}"; [ $# = 0 ] || shift
case "$cmd" in
  fetch)
    [ $# = 2 ] || die "usage: ssh-unlock fetch github|gitlab|codeberg <user>"
    case "$1" in github) host=github.com ;; gitlab) host=gitlab.com ;; codeberg) host=codeberg.org ;; *) die "unknown site: $1" ;; esac
    user="$2"
    [[ "$user" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] && [[ "$user" != *..* ]] || die "not a user name: $(printf '%s' "$user" | tr -cd '[:print:]' | head -c 64)"
    if ! body="$(curl -fsSL --proto '=https' --tlsv1.2 --max-time 20 --max-filesize 200000 "https://$host/$user.keys" 2>&1)"; then
      die "could not get https://$host/$user.keys: $(printf '%s' "$body" | tr -cd '[:print:]' | tail -c 200)"
    fi
    printf '%s\n' "$body" | check || die "$user has no public keys on $host that can be used"
    ;;
  check) check ;;
  describe) describe ;;
  install)
    keys="$(check)" || die "no usable public keys given"
    find_esp
    dir="$esp/halos/ssh-unlock"; mkdir -p "$dir"
    # Keep the early-boot host key across key changes, so clients keep trusting it.
    if [ ! -s "$dir/ssh_host_ed25519_key" ] || [ ! -s "$dir/ssh_host_ed25519_key.pub" ]; then
      tmp="$(mktemp -d)"
      ssh-keygen -q -t ed25519 -N '' -C halos-unlock -f "$tmp/key"
      cp "$tmp/key" "$dir/ssh_host_ed25519_key.new" && mv -f "$dir/ssh_host_ed25519_key.new" "$dir/ssh_host_ed25519_key"
      cp "$tmp/key.pub" "$dir/ssh_host_ed25519_key.pub.new" && mv -f "$dir/ssh_host_ed25519_key.pub.new" "$dir/ssh_host_ed25519_key.pub"
      rm -rf "$tmp"
    fi
    # Each key may only answer the passphrase prompt (sshd's ForceCommand does the rest).
    while IFS= read -r k; do printf 'restrict,pty %s\n' "$k"; done <<< "$keys" > "$dir/authorized_keys.new"
    mv -f "$dir/authorized_keys.new" "$dir/authorized_keys"
    sync -f "$dir/authorized_keys" 2> /dev/null || sync
    ;;
  remove)
    find_esp
    rm -rf "$esp/halos/ssh-unlock"
    rmdir "$esp/halos" 2> /dev/null || true
    sync
    ;;
  status)
    find_esp ro
    dir="$esp/halos/ssh-unlock"
    if [ ! -s "$dir/authorized_keys" ] || [ ! -s "$dir/ssh_host_ed25519_key.pub" ]; then echo off; exit 0; fi
    n="$(grep -c . "$dir/authorized_keys" || true)"
    if [ "${1:-}" = --short ]; then echo "on $n"; exit 0; fi
    echo "on, $n key(s) may unlock:"
    sed 's/^restrict,pty //' "$dir/authorized_keys" | describe
    echo "Early-boot host key: $(ssh-keygen -l -f "$dir/ssh_host_ed25519_key.pub" | awk '{print $2}')"
    echo "known_hosts line: $(hostname) $(cut -d' ' -f1,2 "$dir/ssh_host_ed25519_key.pub")"
    ;;
  *) die "usage: ssh-unlock fetch|check|describe|install|remove|status" ;;
esac
