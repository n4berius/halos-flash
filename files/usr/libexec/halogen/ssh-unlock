#!/bin/bash
# Unlock the disk over SSH at boot (#13): the keys and the early-boot server's own host key live
# on the EFI system partition, in /halos/ssh-unlock/, because every machine boots the same
# initramfs from the image. The initramfs module 90halos-ssh-unlock reads them. Run by halosctl.
#   ssh-unlock fetch github|gitlab|codeberg <user>   that account's public keys, checked
#   ssh-unlock check        public keys on stdin, checked (bad lines are named on stderr)
#   ssh-unlock describe     public keys on stdin, one line each: type, size, fingerprint, comment
#   ssh-unlock install      public keys on stdin become the ones allowed to unlock
#   ssh-unlock remove       turn it off
#   ssh-unlock install-choice   the installer's: HALOS_UNLOCK_CHOICE (both, tpm, ssh, none) kept for
#                           halosctl setup, and the keys on stdin installed when there are any
#   ssh-unlock choice       the choice made at install, or nothing
#   ssh-unlock record       keep the fingerprints of the keys and the host key on the encrypted disk
#   ssh-unlock verify       0: the EFI partition still matches that record, 1: it doesn't, 2: no record
#   ssh-unlock status [--short]
# The EFI partition is readable by anyone holding the disk, so it holds only public keys and the
# early-boot host key, which is not the system's own.
set -euo pipefail
# Bytes, not characters: [[:print:]] is plain ASCII, so a key comment can't carry look-alike or
# direction-changing characters onto root's terminal.
export LC_ALL=C
esp_type=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
die() { echo "ssh-unlock: $*" >&2; exit 1; }

# One public key per line, as GitHub, GitLab and Codeberg serve them: no options, a known type, a
# size OpenSSH accepts. Prints the key (type, blob, and its comment cut to plain characters);
# fails otherwise.
check_line() {
  local line="$1" bits key comment
  [[ "$line" =~ ^((ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp(256|384|521)|sk-ecdsa-sha2-nistp256@openssh\.com|ssh-rsa)\ [A-Za-z0-9+/]+={0,3})(\ (.*))?$ ]] || return 1
  key="${BASH_REMATCH[1]}"
  comment="$(printf '%s' "${BASH_REMATCH[5]:-}" | tr -cd 'A-Za-z0-9 ._@:,+=/-' | head -c 100)"
  bits="$(ssh-keygen -l -f /dev/stdin <<< "$key" 2> /dev/null | awk '{print $1}')" || return 1
  [[ "$bits" =~ ^[0-9]+$ ]] || return 1
  if [ "${key%% *}" = ssh-rsa ] && [ "$bits" -lt 2048 ]; then return 1; fi
  printf '%s%s\n' "$key" "${comment:+ $comment}"
}
# What is shown on root's terminal: no control characters, even from a file someone changed.
clean() { tr -d '\000-\010\013-\037\177-\377'; }
check() {
  local line n=0 seen=" " blob good=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1)); line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue ;; esac
    if ! out="$(check_line "$line")"; then echo "line $n is not a public key this can use; skipped" >&2; continue; fi
    blob="$(cut -d' ' -f2 <<< "$out")"
    case "$seen" in *" $blob "*) continue ;; esac
    seen+="$blob "; good=$((good + 1)); printf '%s\n' "$out"
  done
  [ "$good" -gt 0 ]
}
describe() {
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    ssh-keygen -l -f /dev/stdin <<< "$line" | awk '{ t = $NF; $NF = ""; printf "  %s %s\n", t, $0 }'
  done | clean
}

# The EFI partition, mounted read-write: where it is mounted already, or for this run in /run.
esp=""; mounted_here=""; remounted=""
# The EFI partition can be changed by anyone holding the disk; the record lives on the encrypted
# root, so a swapped key or host key is noticed (security audit, #13).
record="${HALOS_UNLOCK_RECORD:-/var/lib/halos/ssh-unlock.sums}"
sums() { (cd "$esp/halos/ssh-unlock" && sha256sum authorized_keys ssh_host_ed25519_key.pub); }
cleanup() {
  [ -z "$remounted" ] || mount -o remount,ro "$esp" || true
  [ -z "$mounted_here" ] || { umount "$mounted_here" && rmdir "$mounted_here"; }
}
trap cleanup EXIT
find_esp() { # [ro]: only to read (status), so nothing is remounted or written
  local ro="${1:-}"
  if [ -n "${HALOS_ESP:-}" ]; then esp="$HALOS_ESP"; return; fi
  local p t rm tran m devs=() mnt=()
  # The machine's own disks, as the initramfs looks (not a USB stick's EFI partition).
  while read -r p t rm tran m; do
    if [ "$t" != "$esp_type" ] || [ "$rm" != 0 ] || [ "$tran" = usb ]; then continue; fi
    devs+=("$p"); mnt+=("${m:-}")
  done < <(lsblk -rno PATH,PARTTYPE,RM,TRAN,MOUNTPOINT)
  [ "${#devs[@]}" -gt 0 ] || die "no EFI system partition found"
  local i pick=""
  for i in "${!devs[@]}"; do [ "${mnt[$i]}" = /boot/efi ] && pick="$i"; done
  if [ -z "$pick" ]; then
    [ "${#devs[@]}" = 1 ] || die "several EFI system partitions and none at /boot/efi: ${devs[*]}"
    pick=0
  fi
  if [ -n "${mnt[$pick]}" ]; then
    esp="${mnt[$pick]}"
    # Read-only mounts happen (bootupd mounts it only when it needs to); write anyway.
    if [ -z "$ro" ] && ! findmnt -rno OPTIONS "$esp" | tr , '\n' | grep -qx rw; then
      mount -o remount,rw "$esp" || die "can't write to $esp"
      remounted=1
    fi
  else
    mounted_here="$(mktemp -d /run/halos-esp.XXXXXX)"
    mount -t vfat -o "umask=0077${ro:+,ro}" "${devs[$pick]}" "$mounted_here" || { rmdir "$mounted_here"; mounted_here=""; die "can't mount ${devs[$pick]}"; }
    esp="$mounted_here"
  fi
}

cmd="${1:-status}"; [ $# = 0 ] || shift
case "$cmd" in
  fetch)
    [ $# = 2 ] || die "usage: ssh-unlock fetch github|gitlab|codeberg <user>"
    case "$1" in github) host=github.com ;; gitlab) host=gitlab.com ;; codeberg) host=codeberg.org ;; *) die "unknown site: $1" ;; esac
    user="$2"
    if ! [[ "$user" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || [[ "$user" == *..* ]]; then
      die "not a user name: $(printf '%s' "$user" | tr -cd '[:print:]' | head -c 64)"
    fi
    # The download runs as nobody: only its output is used.
    drop=(); if [ "$(id -u)" = 0 ] && [ -z "${HALOS_FETCH_AS_ROOT:-}" ]; then drop=(setpriv --reuid=65534 --regid=65534 --clear-groups --); fi
    if ! body="$("${drop[@]}" curl -fsSL --proto '=https' --tlsv1.2 --max-time 20 --max-filesize 200000 "https://$host/$user.keys" 2>&1)"; then
      die "could not get https://$host/$user.keys: $(printf '%s' "$body" | tr -cd '[:print:]' | tail -c 200)"
    fi
    printf '%s\n' "$body" | check || die "$user has no public keys on $host that can be used"
    ;;
  check) check ;;
  describe) describe ;;
  install)
    keys="$(check)" || die "no usable public keys given"
    find_esp
    dir="$esp/halos/ssh-unlock"; mkdir -p "$dir"
    # Keep the early-boot host key across key changes, so clients keep trusting it.
    if [ ! -s "$dir/ssh_host_ed25519_key" ] || [ ! -s "$dir/ssh_host_ed25519_key.pub" ]; then
      rm -f "$dir/new_host_key" "$dir/new_host_key.pub"
      ssh-keygen -q -t ed25519 -N '' -C halos-unlock -f "$dir/new_host_key"
      mv -f "$dir/new_host_key.pub" "$dir/ssh_host_ed25519_key.pub"
      mv -f "$dir/new_host_key" "$dir/ssh_host_ed25519_key"
    fi
    # The EFI partition's mount options decide who can read the private host key.
    mode="$(stat -c %a "$dir/ssh_host_ed25519_key")"
    case "$mode" in 600|700|400|500) ;; *) echo "warning: $dir/ssh_host_ed25519_key is readable by other users (mode $mode); mount the EFI partition with umask=0077" >&2 ;; esac
    # Each key may only answer the passphrase prompt (sshd's ForceCommand does the rest).
    while IFS= read -r k; do printf 'restrict,pty %s\n' "$k"; done <<< "$keys" > "$dir/authorized_keys.new"
    mv -f "$dir/authorized_keys.new" "$dir/authorized_keys"
    sync -f "$dir/authorized_keys" 2> /dev/null || sync
    ;;
  install-choice)
    choice="${HALOS_UNLOCK_CHOICE:-}"
    case "$choice" in both|tpm|ssh|none) ;; *) die "unknown unlock choice: $(printf '%s' "$choice" | clean | head -c 20)" ;; esac
    keys="$(check 2> /dev/null || true)"
    case "$choice" in both|ssh) [ -n "$keys" ] || die "no keys for unlocking over SSH" ;; esac
    if [ -n "$keys" ]; then printf '%s\n' "$keys" | "$0" install; fi
    find_esp
    mkdir -p "$esp/halos"
    printf '%s\n' "$choice" > "$esp/halos/unlock-choice.new" && mv -f "$esp/halos/unlock-choice.new" "$esp/halos/unlock-choice"
    sync
    ;;
  choice)
    find_esp ro
    c="$(head -c 8 "$esp/halos/unlock-choice" 2> /dev/null | tr -cd '[:lower:]')" || true
    case "$c" in both|tpm|ssh|none) echo "$c" ;; esac
    ;;
  record)
    find_esp ro
    [ -s "$esp/halos/ssh-unlock/authorized_keys" ] || die "unlocking over SSH isn't set up"
    mkdir -p "$(dirname "$record")"
    sums > "$record.new" && mv -f "$record.new" "$record"
    ;;
  verify)
    find_esp ro
    [ -s "$record" ] || exit 2
    [ -s "$esp/halos/ssh-unlock/authorized_keys" ] || exit 1
    [ "$(sums 2> /dev/null)" = "$(cat "$record")" ]
    ;;
  remove)
    find_esp
    rm -f "$record"
    rm -rf "$esp/halos/ssh-unlock" "$esp/halos/unlock-choice"
    rmdir "$esp/halos" 2> /dev/null || true
    sync
    ;;
  status)
    find_esp ro
    dir="$esp/halos/ssh-unlock"
    if [ ! -s "$dir/authorized_keys" ] || [ ! -s "$dir/ssh_host_ed25519_key.pub" ]; then echo off; exit 0; fi
    n="$(grep -c . "$dir/authorized_keys" || true)"
    if [ "${1:-}" = --short ]; then echo "on $n"; exit 0; fi
    host="$(hostname -s 2> /dev/null || hostname)"; host="$(printf '%s' "$host" | tr -cd 'A-Za-z0-9.-')"
    echo "on, $n key(s) may unlock:"
    sed 's/^restrict,pty //' "$dir/authorized_keys" | describe
    echo "Early-boot host key: $(ssh-keygen -l -f "$dir/ssh_host_ed25519_key.pub" | awk '{print $2}')"
    if [ ! -s "$record" ]; then echo "Record: none on the encrypted disk yet (sudo halosctl ssh-unlock record)"
    elif [ "$(sums 2> /dev/null)" = "$(cat "$record")" ]; then echo "Record: the keys and host key match the one on the encrypted disk"
    else echo "WARNING: the keys or host key on the EFI partition differ from the record on the encrypted disk."
      echo "If you didn't change them, someone with the disk may have. Check the keys above, then set them again: sudo halosctl ssh-unlock on"; fi
    # Its own name in ssh (HostKeyAlias): the early-boot key is then trusted only for unlocking,
    # never for the running system, and ssh's UpdateHostKeys doesn't remove it.
    echo "ssh config entry (in ~/.ssh/config on your computer; HostName: how you reach this machine):"
    printf '  Host %s-unlock\n      HostName %s\n      User root\n      HostKeyAlias %s-unlock\n' "$host" "$host" "$host"
    echo "known_hosts line: $host-unlock $(cut -d' ' -f1,2 "$dir/ssh_host_ed25519_key.pub" | clean)"
    ;;
  *) die "usage: ssh-unlock fetch|check|describe|install|install-choice|choice|record|verify|remove|status" ;;
esac
