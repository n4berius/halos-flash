#!/bin/bash
# Checks the host before Halogen starts. Also run by: halogenctl doctor
set -uo pipefail
sysfs="${HALOGEN_SYSFS:-/sys}"
effective="${HALOGEN_EFFECTIVE_FILE:-${XDG_RUNTIME_DIR:-/run/user/970}/halogen/effective.env}"
clock="${HALOGEN_CLOCK:-/usr/libexec/halogen/halogen-fabric-clock}"
cmdline="${HALOGEN_CMDLINE:-/proc/cmdline}"
meminfo="${HALOGEN_MEMINFO:-/proc/meminfo}"
dev="${HALOGEN_DEV:-/dev}"
failed=0

fail() { echo "preflight: FAIL: $*" >&2; failed=1; }
warn() { echo "preflight: warning: $*" >&2; }

npu_models="$(sed -n 's/^HALOGEN_NPU_MODELS=//p' "$effective" 2>/dev/null | tail -n 1)"

if [ ! -e "$dev/kfd" ]; then
  fail "$dev/kfd is missing, so the GPU driver is not ready"
elif [ ! -r "$dev/kfd" ] || [ ! -w "$dev/kfd" ]; then
  fail "this service cannot open $dev/kfd. Check its group with ls -l"
fi

# The prompt cache folder is mounted writable into Halogen's container, from a place the download
# container can write: a link there would hand Halogen whatever it points to (/srv/configs, say).
pcache="${HALOGEN_MODELS_DIR:-/srv/models}/.prompt-cache"
if [ -L "$pcache" ]; then
  fail "$pcache is a link, not a folder. Remove it; the next boot (or sudo systemctl restart halogen-prepare.service) makes the folder again"
elif [ ! -d "$pcache" ]; then
  fail "$pcache is missing. Make it with: sudo systemctl restart halogen-prepare.service"
elif [ ! -O "$pcache" ]; then
  fail "$pcache belongs to $(stat -c %U "$pcache" 2>/dev/null || echo someone else), not to this service's user"
elif [ "$(stat -c %a "$pcache" 2>/dev/null)" != 700 ]; then
  warn "$pcache has mode $(stat -c %a "$pcache" 2>/dev/null), not 700: others may read saved conversation state (the next boot resets it)"
fi

# The same for the folders mounted into Halogen's container one by one (the NPU edition's models
# and your own checkpoints, three of them writable): the download container can write the top of
# /srv/models, and a link in a folder's place would mount whatever it points to (/srv/configs, with
# the keys). A folder that isn't there is fine here: this edition may not use it.
for f in npu decider LFM custom; do
  d="${HALOGEN_MODELS_DIR:-/srv/models}/$f"
  if [ -L "$d" ]; then
    fail "$d is a link, not a folder. Remove it; the next boot (or sudo systemctl restart halogen-prepare.service) makes the folder again"
  elif [ -e "$d" ] && { [ ! -d "$d" ] || [ ! -O "$d" ]; }; then
    fail "$d isn't a folder of this service's user (it belongs to $(stat -c %U "$d" 2>/dev/null || echo someone else))"
  fi
done

mem_gib="$(awk '$1 == "MemTotal:" { printf "%d", $2 / 1048576 }' "$meminfo")"
[ "${mem_gib:-0}" -ge 100 ] \
  || fail "the OS sees ${mem_gib:-0} GiB. Set the BIOS UMA frame buffer to its explicit minimum, not Auto"

if [ -n "$npu_models" ]; then
  if [ ! -e "$dev/accel/accel0" ]; then
    fail "$dev/accel/accel0 is missing. Check the IOMMU, amdxdna and NPU firmware"
  elif [ ! -r "$dev/accel/accel0" ] || [ ! -w "$dev/accel/accel0" ]; then
    fail "this service cannot open $dev/accel/accel0. Check its group with ls -l"
  fi
  grep -qw 'amd_iommu=off' "$cmdline" && fail "amd_iommu=off disables the NPU"
  "$clock" status >/dev/null 2>&1 \
    || fail "the fabric clock is not held. Check: systemctl status halogen-fabric-clock"
  memlock="${HALOGEN_MEMLOCK:-$(ulimit -Hl)}"
  [ "$memlock" = unlimited ] || fail "memlock is limited to $memlock KiB"
fi

for key in amdgpu.gttsize ttm.pages_limit; do
  grep -q "$key=" "$cmdline" || warn "$key is not set on the kernel command line"
done

for f in "$sysfs"/class/drm/card*/device/mem_info_gtt_used; do
  [ -r "$f" ] || continue
  used_gib=$(($(cat "$f") / 1073741824))
  if [ "${HALOGEN_SERVER_RUNNING:-0}" = 1 ]; then
    echo "preflight: $used_gib GiB of GTT in use, by the running server"
  elif [ "$used_gib" -ge 10 ]; then
    warn "$used_gib GiB of GTT is already in use. If no GPU process is running, reboot before starting"
  fi
done

[ "$failed" = 0 ] || exit 1
echo "preflight: ok"
