#!/bin/bash
# Checks the host before Halogen starts. Also run by: halogenctl doctor
set -uo pipefail
sysfs="${HALOGEN_SYSFS:-/sys}"
effective="${HALOGEN_EFFECTIVE_FILE:-${XDG_RUNTIME_DIR:-/run/user/970}/halogen/effective.env}"
clock="${HALOGEN_CLOCK:-/usr/libexec/halogen/halogen-fabric-clock}"
cmdline="${HALOGEN_CMDLINE:-/proc/cmdline}"
meminfo="${HALOGEN_MEMINFO:-/proc/meminfo}"
dev="${HALOGEN_DEV:-/dev}"
failed=0

fail() { echo "preflight: FAIL: $*" >&2; failed=1; }
warn() { echo "preflight: warning: $*" >&2; }

npu_models="$(sed -n 's/^HALOGEN_NPU_MODELS=//p' "$effective" 2>/dev/null | tail -n 1)"

if [ ! -e "$dev/kfd" ]; then
  fail "$dev/kfd is missing, so the GPU driver is not ready"
elif [ ! -r "$dev/kfd" ] || [ ! -w "$dev/kfd" ]; then
  fail "this service cannot open $dev/kfd. Check its group with ls -l"
fi

# The prompt cache folder is mounted writable into Halogen's container, from a place the download
# container can write: a link there would hand Halogen whatever it points to (/srv/configs, say).
pcache="${HALOGEN_MODELS_DIR:-/srv/models}/.prompt-cache"
if [ -L "$pcache" ]; then
  fail "$pcache is a link, not a folder. Remove it; the next boot (or sudo systemctl restart halogen-prepare.service) makes the folder again"
elif [ ! -d "$pcache" ]; then
  fail "$pcache is missing. Make it with: sudo systemctl restart halogen-prepare.service"
elif [ ! -O "$pcache" ]; then
  fail "$pcache belongs to $(stat -c %U "$pcache" 2>/dev/null || echo someone else), not to this service's user"
elif [ "$(stat -c %a "$pcache" 2>/dev/null)" != 700 ]; then
  warn "$pcache has mode $(stat -c %a "$pcache" 2>/dev/null), not 700: others may read saved conversation state (the next boot resets it)"
fi

# The same for the folders mounted into Halogen's container one by one (the NPU edition's models
# and your own checkpoints, three of them writable): the download container can write the top of
# /srv/models, and a link in a folder's place would mount whatever it points to (/srv/configs, with
# the keys). A folder that isn't there is fine here: this edition may not use it.
for f in npu decider LFM custom; do
  d="${HALOGEN_MODELS_DIR:-/srv/models}/$f"
  if [ -L "$d" ]; then
    fail "$d is a link, not a folder. sudo systemctl restart halogen-prepare.service (or the next boot) removes it and makes the folder again"
  elif [ -e "$d" ] && [ ! -d "$d" ]; then
    fail "$d isn't a folder. Remove it, then: sudo systemctl restart halogen-prepare.service"
  elif [ -e "$d" ] && [ ! -O "$d" ]; then
    fail "$d belongs to $(stat -c %U "$d" 2>/dev/null || echo someone else), not to this service's user (for a disk mounted there: sudo chown halogen:halogen $d)"
  fi
done

# Since 0.21.0 Halogen reads an adapters/ folder beside the checkpoint (LoRA adapters, for
# Qwen3.8-27B) and converts what is in it at every start. halOS makes none, and the download and
# pull containers can write there, so one beside the official checkpoint or an own one stops the
# start rather than let a download choose what Halogen loads.
# Only folders render-config could serve (a checkpoint name: letters, digits, '.', '_', '-', not
# starting with '.'), so the path in the message is safe to paste.
for d in "${HALOGEN_MODELS_DIR:-/srv/models}/adapters" "${HALOGEN_MODELS_DIR:-/srv/models}"/flash/*/adapters; do
  case "$d" in */flash/*/adapters)
    n="${d%/adapters}"; n="${n##*/}"
    [[ "$n" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || continue ;;
  esac
  if [ -e "$d" ] || [ -L "$d" ]; then
    fail "$d is there, but halOS doesn't serve LoRA adapters. Remove it: sudo runuser -u halogen -- rm -rf -- $(printf '%q' "$d")"
  fi
done

# The files Halogen loads from the top of /srv/models, and everything under npu: the download
# container could write there, and Halogen's container would follow a link it left into whatever
# it points to. halOS never makes a link there (hf writes plain files, also in its .cache), so any
# link, or anything but files and folders, stops the start. One find each, stopping at the first.
m="${HALOGEN_MODELS_DIR:-/srv/models}"
for f in qwen38-flash-next-v2.hgn qwen38-flash-next-ngram.hgn qwen38-flash-next-drafter-r2-ht4.hgn qwen38-flash-next-drafter-r2.hgn qwen38-flash-next-vision.hgn tokenizer; do
  if [ -L "$m/$f" ]; then
    fail "$m/$f is a link. Restart Halogen (sudo halogenctl restart): the fetch removes it and downloads the file again"
  fi
done
for d in "$m/tokenizer" "$m/npu"; do
  if [ ! -d "$d" ] || [ -L "$d" ]; then continue; fi
  # A folder its owner can't list hides what is in it (find skips it with an error): that counts
  # too, as does find failing at all.
  if ! odd="$(find "$d" -mindepth 1 \( -type l -o \( ! -type f ! -type d \) -o \( -type d ! -perm -u=rx \) \) -print -quit 2>/dev/null)"; then
    fail "$d can't be read through. Restart Halogen (sudo halogenctl restart): the fetch opens it up and cleans it"
  elif [ -n "$odd" ]; then
    fail "$(printf '%s' "$odd" | tr -cd '[:print:]') is a link or not a plain file. Restart Halogen (sudo halogenctl restart): the fetch removes it and downloads what is missing"
  fi
done

mem_gib="$(awk '$1 == "MemTotal:" { printf "%d", $2 / 1048576 }' "$meminfo")"
# Under 100 GiB only Qwen3.8-27B fits (render-config serves it there by memory): the model its
# header names (bytes 40..103 of an HGN1 file), as Halogen's entrypoint reads it.
if [ "${mem_gib:-0}" -lt 100 ]; then
  ck="$(sed -n 's/^HALOGEN_CHECKPOINT=//p' "$effective" 2>/dev/null | tail -n 1)"; mid=""
  case "$ck" in /models/flash/*.hgn)
    f="${HALOGEN_MODELS_DIR:-/srv/models}/${ck#/models/}"
    if [ "$(timeout 5 head -c 4 -- "$f" 2>/dev/null)" = HGN1 ]; then
      mid="$(timeout 5 head -c 104 -- "$f" 2>/dev/null | tail -c 64 | tr -d '\0')"
    fi ;;
  esac
  [[ "$mid" == qwen3.8-27b-* ]] \
    || fail "the OS sees ${mem_gib:-0} GiB, too little for the Flash model. Set the BIOS UMA frame buffer to its explicit minimum, not Auto, or serve Qwen3.8-27B: sudo halogenctl flash use auto"
fi

if [ -n "$npu_models" ]; then
  if [ ! -e "$dev/accel/accel0" ]; then
    fail "$dev/accel/accel0 is missing. Check the IOMMU, amdxdna and NPU firmware"
  elif [ ! -r "$dev/accel/accel0" ] || [ ! -w "$dev/accel/accel0" ]; then
    fail "this service cannot open $dev/accel/accel0. Check its group with ls -l"
  fi
  grep -qw 'amd_iommu=off' "$cmdline" && fail "amd_iommu=off disables the NPU"
  "$clock" status >/dev/null 2>&1 \
    || fail "the fabric clock is not held. Check: systemctl status halogen-fabric-clock"
  memlock="${HALOGEN_MEMLOCK:-$(ulimit -Hl)}"
  [ "$memlock" = unlimited ] || fail "memlock is limited to $memlock KiB"
fi

for key in amdgpu.gttsize ttm.pages_limit; do
  grep -q "$key=" "$cmdline" || warn "$key is not set on the kernel command line"
done

for f in "$sysfs"/class/drm/card*/device/mem_info_gtt_used; do
  [ -r "$f" ] || continue
  used_gib=$(($(cat "$f") / 1073741824))
  if [ "${HALOGEN_SERVER_RUNNING:-0}" = 1 ]; then
    echo "preflight: $used_gib GiB of GTT in use, by the running server"
  elif [ "$used_gib" -ge 10 ]; then
    warn "$used_gib GiB of GTT is already in use. If no GPU process is running, reboot before starting"
  fi
done

[ "$failed" = 0 ] || exit 1
echo "preflight: ok"
