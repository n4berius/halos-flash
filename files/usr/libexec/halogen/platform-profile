#!/bin/bash
# The firmware's power profile (ACPI platform profile): low-power, balanced or performance.
# halosctl power saves the choice in /etc/halos/platform-profile; with no choice saved it is
# performance, as Halogen's own numbers were measured at full power (its docs/troubleshooting.md:
# about 70 W of package power at balanced against about 127 W at performance on one machine).
#   platform-profile apply   set the saved choice (at boot and after resume)
#   platform-profile check <name>   exit 0 when the firmware offers that profile
# Machines without the file (QEMU, some boards) have nothing to set: apply does nothing there.
set -euo pipefail
sys="${HALOGEN_SYS:-/sys}"
file="$sys/firmware/acpi/platform_profile"
choices_file="$sys/firmware/acpi/platform_profile_choices"
saved="${HALOS_PROFILE_FILE:-/etc/halos/platform-profile}"

# Only the three names, and only when this firmware lists it.
offered() {
  case "$1" in low-power|balanced|performance) ;; *) return 1 ;; esac
  [ -r "$choices_file" ] || return 1
  local c; read -ra c < "$choices_file" || true
  local x; for x in "${c[@]}"; do [ "$x" = "$1" ] && return 0; done
  return 1
}
# The saved choice: one word, or performance when none is saved.
choice() {
  local w=""
  [ ! -r "$saved" ] || read -r w < "$saved" || true
  echo "${w:-performance}"
}

case "${1:-}" in
  apply)
    [ -e "$file" ] || exit 0
    want="$(choice)"
    if ! offered "$want"; then
      echo "platform-profile: \"$(printf '%s' "$want" | tr -cd 'a-z-' | head -c 20)\" is not a profile this firmware offers ($(tr -cd 'a-z -' < "$choices_file" 2>/dev/null)); left at $(tr -cd 'a-z-' < "$file")" >&2
      exit 1
    fi
    [ "$(cat "$file")" = "$want" ] || echo "$want" > "$file"
    ;;
  check) offered "${2:-}" ;;
  *) echo "usage: platform-profile apply | check <name>" >&2; exit 2 ;;
esac
