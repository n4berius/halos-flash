#!/bin/bash
# Build the settings Halogen receives from /srv/configs/halogen.env. Only options this
# image allows pass through, so a typo or a locked setting cannot reach the server.
# The Flash checkpoint comes from /srv/configs/flash-checkpoint, which only halogenctl flash use
# writes: the official one, or a checkpoint flash pull downloaded and Halogen's verify passed.
# With no choice there (or auto), it goes by memory: under 100 GiB, Qwen3.8-27B (qwen3.8-27b).
# Request records (#107) are on only while sudo halogenctl records on has mounted /srv/logs/halogen
# at /records (a Quadlet drop-in only root writes); then the text kept defaults to none.
# The prompt cache on disk (HALOGEN_CACHE_DIR=/models/.prompt-cache, the folder /srv/models/.prompt-cache) is on
# unless sudo halogenctl cache off wrote "off" in /srv/configs/prompt-cache.
# Web search (Halogen's HALOGEN_WEB_SEARCH_URL) is on only while sudo halogenctl web-search has put
# Halogen on the halos-search network (root's drop-in), where the search container (bundled SearXNG
# or the relay to your own) stands at 10.89.250.2:8080; root's /etc/halos/web-search.env says which.
# The API key (/srv/configs/api-key, mounted at /run/secrets/halogen-api-key) is required unless
# sudo halogenctl api-key off made root's /etc/halos/api-key-off, which halogen can't write.
# Halogen's own draft head file (qwen38-flash-next-drafter-r2-ht4.hgn) drafts beside the official
# checkpoint on its own, and halOS names it for your own checkpoints too (HALOGEN_CK_OVERLAY, with
# the two rules Halogen's entrypoint sets beside it), unless /srv/configs/flash-drafter (sudo
# halogenctl flash drafter <name> ...) says off (the checkpoint's built-in head), official-r2
# (Halogen 0.20.6's qwen38-flash-next-drafter-r2.hgn, still in /srv/models) or names a draft head
# file the checkpoint's repository ships.
# Prints the path of the result. With --show, prints its contents instead.
set -uo pipefail
config="${HALOGEN_CONFIG_FILE:-/srv/configs/halogen.env}"
flash_choice="${HALOGEN_FLASH_FILE:-/srv/configs/flash-checkpoint}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
official=/models/qwen38-flash-next-v2.hgn
# Below this much memory (what the OS sees), no choice means Qwen3.8-27B: the Flash model's
# weights (about 68 GiB), its lookup table (47.7 GiB through the file cache) and its context
# don't fit. The selftest's memory line uses the same line.
flash_min_gib=100
auto_small=qwen3.8-27b
drafter=qwen38-flash-next-drafter-r2-ht4.hgn
drafter_choice="${HALOGEN_DRAFTER_CHOICE_FILE:-/srv/configs/flash-drafter}"
allowed="${HALOGEN_ALLOWED_FILE:-/usr/share/halogen/options.allowed}"
cache_choice="${HALOGEN_CACHE_CHOICE_FILE:-/srv/configs/prompt-cache}"
# Root's drop-in that mounts the cache folder read-only while it is off (halogenctl cache off).
cache_off_dropin="${HALOGEN_CACHE_OFF_DROPIN:-/etc/containers/systemd/users/halogen.container.d/15-prompt-cache.conf}"
# A fixed path, never from the environment: this runs under halogen's user manager, whose
# environment halogen can set (systemctl --user set-environment), and that must not open the API.
api_key_off=/etc/halos/api-key-off
records_dropin="${HALOGEN_RECORDS_DROPIN:-/etc/containers/systemd/users/970/halogen.container.d/20-records.conf}"
# Fixed too: it decides whether the key may be off (below), so halogen mustn't point it elsewhere.
search_dropin=/etc/containers/systemd/users/970/halogen.container.d/30-web-search.conf
# Fixed, as the API key's off file: halogen can't write /etc/halos, nor point this elsewhere.
search_conf=/etc/halos/web-search.env
runtime="${XDG_RUNTIME_DIR:-/run/user/970}/halogen"
output="$runtime/effective.env"
mkdir -p "$runtime" || exit 1
declare -A values=() where=()

ignore() { echo "halogen-config: ignored $1: $2" >&2; }

if [ -r "$config" ]; then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) ignore "'$line'" "it is not KEY=VALUE"; continue ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    if ! grep -qxF -- "$key" "$allowed"; then
      ignore "$key" "not an option this system allows"
      continue
    fi
    case "$value" in \"*\"|\'*\') value="${value:1:${#value}-2}" ;; esac
    if [ "$key" = HALOGEN_VISION_TOWER ] && [ -n "$value" ] && [ "$value" != 1 ]; then
      ignore "$key" "the only supported value is 1"
      continue
    fi
    # Halogen takes a file path here; halOS passes only none from halogen.env (the checkpoint's own
    # draft head), since a path would reach files nothing checked. The draft heads halOS names
    # itself (below) are the fetch's official file or one a pull hash-checked.
    if [ "$key" = HALOGEN_CK_OVERLAY ] && [ -n "$value" ] && [ "$value" != none ]; then
      ignore "$key" "the only value halOS accepts is none (the checkpoint's own draft head)"
      continue
    fi
    # The last line wins, but a setting written twice is usually a copy-paste left behind.
    if [ -n "${where[$key]:-}" ]; then
      echo "halogen-config: $key is set more than once in $config (lines ${where[$key]} and $n); line $n is used" >&2
    fi
    values["$key"]="$value"
    where["$key"]="$n"
  done < "$config"
else
  echo "halogen-config: cannot read $config, so Halogen uses its defaults" >&2
fi

# Which Flash checkpoint. Anything unexpected falls back to the official one, so Halogen starts.
checkpoint="$official"
choice="$(head -n 1 "$flash_choice" 2>/dev/null | tr -d '[:space:]')"
# No choice (or flash use auto): by memory. Below what the Flash model needs, Qwen3.8-27B, the
# checkpoint flash pull 27b makes (the fetch pulls it); else the official one. The same rule is
# in fetch-models and halogenctl (flash_auto).
if [ -z "$choice" ] || [ "$choice" = auto ]; then
  mem_gib="$(awk '$1 == "MemTotal:" { printf "%d", $2 / 1048576 }' "${HALOGEN_MEMINFO:-/proc/meminfo}" 2>/dev/null)"
  if [ "${mem_gib:-0}" -gt 0 ] && [ "$mem_gib" -lt "$flash_min_gib" ]; then
    choice="$auto_small"
    if [ -f "$models/flash/$choice/halos.info" ]; then
      echo "halogen-config: the OS sees $mem_gib GiB, less than the $flash_min_gib GiB the Flash model needs, so Halogen serves $choice (sudo halogenctl flash use official chooses Flash)" >&2
    else
      echo "halogen-config: the OS sees $mem_gib GiB, less than the $flash_min_gib GiB the Flash model needs, but $choice isn't downloaded yet (sudo halogenctl flash pull 27b); using the official one" >&2
      choice=official
    fi
  else
    choice=official
  fi
fi
case "$choice" in
  official) ;;
  *[!A-Za-z0-9._-]*|.*) echo "halogen-config: $flash_choice names '$choice', which is not a checkpoint name; using the official one" >&2 ;;
  *)
    info="$models/flash/$choice/halos.info"
    file="$(sed -n 's/^checkpoint=//p' "$info" 2>/dev/null | tail -n 1)"
    verified="$(sed -n 's/^verified=//p' "$info" 2>/dev/null | tail -n 1)"
    if [ ! -f "$info" ]; then
      echo "halogen-config: no checkpoint called $choice in $models/flash; using the official one" >&2
    elif [ "$verified" != pass ]; then
      echo "halogen-config: $choice has not passed Halogen's verify; using the official one" >&2
    elif ! [[ "$file" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] || [ ! -f "$models/flash/$choice/$file" ]; then
      echo "halogen-config: $choice is missing its checkpoint file; using the official one" >&2
    elif [ -L "$models/flash/$choice" ] || [ -L "$info" ] || [ -L "$models/flash/$choice/$file" ]; then
      # A link could lead to a file that changed after it was checked.
      echo "halogen-config: $choice holds links, not its own files; using the official one" >&2
    else
      checkpoint="/models/flash/$choice/$file"
      own_dir="$models/flash/$choice"; own_file="$file"
      # The model its header names (bytes 40..103 of an HGN1 file), where Halogen's entrypoint
      # reads it to pick an engine: Qwen3.8-27B (Halogen 0.21.0) by qwen3.8-27b-* (a file whose
      # header names none it refuses). Read into a variable, not piped into grep -q.
      mid=""
      if [ "$(timeout 5 head -c 4 -- "$own_dir/$own_file" 2>/dev/null)" = HGN1 ]; then
        mid="$(timeout 5 head -c 104 -- "$own_dir/$own_file" 2>/dev/null | tail -c 64 | tr -d '\0')"
      fi
      own_27b=0
      [[ "$mid" != qwen3.8-27b-* ]] || own_27b=1
      tower=qwen38-flash-next-vision.hgn
      [ "$own_27b" = 0 ] || tower=qwen38-27b-vision.hgn
      # HALOGEN_VISION_TOWER=1 looks beside the checkpoint, and a missing tower stops Halogen.
      if [ -n "${values[HALOGEN_VISION_TOWER]:-}" ] && [ ! -f "$models/flash/$choice/$tower" ]; then
        ignore HALOGEN_VISION_TOWER "$choice has no vision tower, so images stay off"
        unset 'values[HALOGEN_VISION_TOWER]'
      fi
    fi ;;
esac
values[HALOGEN_CHECKPOINT]="$checkpoint"
if [ "${own_27b:-0}" = 1 ]; then
  # Halogen 0.21.0 refuses to start the 27B with the composable context.
  if [ "${values[HALOGEN_COMPOSABLE_CONTEXT]:-}" = 1 ]; then
    ignore HALOGEN_COMPOSABLE_CONTEXT "Qwen3.8-27B can't use it in Halogen 0.21.0 (the prompt cache works as usual)"
    unset 'values[HALOGEN_COMPOSABLE_CONTEXT]'
  fi
  # The name Halogen gives the 27B when none is set (its entrypoint's own default), said here so
  # that halogenctl config and the benchmarks name the model being served.
  values[HALOGEN_MODEL_ID]="${values[HALOGEN_MODEL_ID]:-halogen-qwen3.8-27b}"
fi

# The draft head for your own checkpoint. Halogen's entrypoint picks the official one up only
# beside a checkpoint named qwen38-flash-next-*.hgn, so for any other it is named here. A draft
# head changes no answer (the model checks every drafted token), only the speed. The official one
# by default; flash drafter <name> off keeps the checkpoint's built-in head, and flash drafter
# <name> <file> picks a draft head file its repository ships (the pull listed it as drafter= in
# halos.info after checking its hash). HALOGEN_CK_OVERLAY holds one file, so a checkpoint with a
# quality sidecar (<checkpoint>.overlay.hgn) keeps the sidecar, and HALOGEN_CK_OVERLAY=none in
# halogen.env wins.
if [ -n "${own_dir:-}" ] && [ "$own_27b" = 1 ]; then
  # The 27B's engine takes no draft head file (the entrypoint's drafter_head skips it), so
  # nothing is named. A line left in flash-drafter changes nothing.
  :
elif [ -n "${own_dir:-}" ]; then
  want="$(N="$choice" awk -F= '$1 == ENVIRON["N"] { v = substr($0, length($1) + 2) } END { print v }' "$drafter_choice" 2>/dev/null)"
  [[ "$want" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || want=official
  head_path=""
  # A GGUF converted to .hgn (Halogen's convert mode) names it in its header (mid, above); such a
  # file takes no sidecar.
  if [ "$want" = off ]; then :
  elif [ -n "${values[HALOGEN_CK_OVERLAY]:-}" ]; then
    echo "halogen-config: $choice: halogen.env sets HALOGEN_CK_OVERLAY=${values[HALOGEN_CK_OVERLAY]}, which wins over the draft head choice ($want)" >&2
  elif [ -e "$own_dir/${own_file%.hgn}.overlay.hgn" ] || [ -L "$own_dir/${own_file%.hgn}.overlay.hgn" ]; then
    echo "halogen-config: $choice: it has a quality sidecar (${own_file%.hgn}.overlay.hgn), which takes the place a draft head would, so its built-in head drafts" >&2
  elif [[ "${mid,,}" == *gguf* ]]; then
    echo "halogen-config: $choice: a converted GGUF takes no draft head file, so its built-in head drafts" >&2
  # HALOGEN_CK_OVERLAY names a draft head only for a checkpoint that carries its own precision
  # (FLAGS.md: with a w4b-style one it selects the precision sidecar). Halogen's verify run by halOS
  # records that (flash pull, flash verify).
  elif [ "$(sed -n 's/^own_precision=//p' "$own_dir/halos.info" 2>/dev/null | tail -n 1)" != 1 ]; then
    echo "halogen-config: $choice: halOS doesn't know yet whether it carries its own precision, so its built-in head drafts (sudo halogenctl flash verify $choice finds out)" >&2
  else
    if [ "$want" = official-r2 ]; then
      # Halogen 0.20.6's official draft head, if it is still in /srv/models (the fetch checks its
      # hash like the other official files); else the current one.
      if [ ! -L "$models/qwen38-flash-next-drafter-r2.hgn" ] && [ -f "$models/qwen38-flash-next-drafter-r2.hgn" ] \
         && [ "$(timeout 5 head -c 4 -- "$models/qwen38-flash-next-drafter-r2.hgn" 2>/dev/null)" = HGN1 ]; then
        head_path=/models/qwen38-flash-next-drafter-r2.hgn
      else
        echo "halogen-config: $choice: Halogen 0.20.6's draft head (qwen38-flash-next-drafter-r2.hgn) isn't there, so the official one drafts" >&2
      fi
    elif [ "$want" != official ]; then
      # Only a file the pull listed and checked, a plain file in the checkpoint's own folder that
      # starts as a draft head does (HGN1, as Halogen checks); else the official one.
      if [[ "$want" =~ ^[A-Za-z0-9._-]*drafter[A-Za-z0-9._-]*\.hgn$ ]] && [ "$want" != "$own_file" ] \
         && sed -n 's/^drafter=//p' "$own_dir/halos.info" 2>/dev/null | grep -qxF -- "$want" \
         && [ ! -L "$own_dir/$want" ] && [ -f "$own_dir/$want" ] && [ "$(timeout 5 head -c 4 -- "$own_dir/$want" 2>/dev/null)" = HGN1 ]; then
        head_path="/models/flash/$choice/$want"
      else
        echo "halogen-config: $choice: its draft head $want isn't there (or isn't one from its pull), so the official one drafts" >&2
      fi
    fi
    if [ -z "$head_path" ]; then
      if [ -L "$models/$drafter" ] || [ ! -f "$models/$drafter" ] || [ "$(timeout 5 head -c 4 -- "$models/$drafter" 2>/dev/null)" != HGN1 ]; then
        echo "halogen-config: $choice: the official draft head isn't downloaded yet, so its built-in head drafts" >&2
      else
        head_path="/models/$drafter"
      fi
    fi
    if [ -n "$head_path" ]; then
      values[HALOGEN_CK_OVERLAY]="$head_path"
      # What Halogen's entrypoint sets when it finds a draft head itself (drafter_head).
      values[HALOGEN_MTP_GATE_RULE]=cost
      values[HALOGEN_SAMPLED_GATE]="${values[HALOGEN_SAMPLED_GATE]:-cost}"
    fi
  fi
  # Where halOS left HALOGEN_CK_OVERLAY unset, Halogen's entrypoint picks a draft head file by itself
  # when the checkpoint is named qwen38-flash-next-*.hgn (not w4b) and one with Halogen's own names
  # lies beside it, as a repository in Peonist's layout ships them. Then that would win over off and
  # over a quality sidecar (drafter_head runs before check_sidecar), so say it outright: the sidecar
  # by its path, else none (the built-in head).
  if [ -z "${values[HALOGEN_CK_OVERLAY]:-}" ]; then
    case "$own_file" in
      qwen38-flash-next-w4b.hgn) ;;
      qwen38-flash-next-*.hgn)
        if [ -e "$own_dir/$drafter" ] || [ -L "$own_dir/$drafter" ] || [ -e "$own_dir/qwen38-flash-next-drafter-r2.hgn" ] || [ -L "$own_dir/qwen38-flash-next-drafter-r2.hgn" ]; then
          if [ -f "$own_dir/${own_file%.hgn}.overlay.hgn" ] && [ ! -L "$own_dir/${own_file%.hgn}.overlay.hgn" ]; then
            values[HALOGEN_CK_OVERLAY]="/models/flash/$choice/${own_file%.hgn}.overlay.hgn"
          else
            values[HALOGEN_CK_OVERLAY]=none
          fi
        fi ;;
    esac
  fi
fi

# Request records. Halogen refuses to start on a text field it doesn't know, so check them here.
if [ -n "${values[HALOGEN_RECORD_GIB]:-}" ] && ! [[ "${values[HALOGEN_RECORD_GIB]}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
  ignore HALOGEN_RECORD_GIB "it must be a number of GiB, such as 2 or 0.5"; unset 'values[HALOGEN_RECORD_GIB]'
fi
if [ -n "${values[HALOGEN_RECORD_DAYS]:-}" ] && ! [[ "${values[HALOGEN_RECORD_DAYS]}" =~ ^[0-9]+$ ]]; then
  ignore HALOGEN_RECORD_DAYS "it must be a whole number of days (0 keeps everything)"; unset 'values[HALOGEN_RECORD_DAYS]'
fi
text="${values[HALOGEN_RECORD_TEXT]:-}"
if [ -n "$text" ] && ! [[ "$text" =~ ^(all|none|(prompt|reply|reasoning|args|results)(,(prompt|reply|reasoning|args|results))*)$ ]]; then
  ignore HALOGEN_RECORD_TEXT "use all, none, or a comma list of prompt, reply, reasoning, args and results; keeping none"
  text=""
fi
if [ -f "$records_dropin" ]; then
  values[HALOGEN_RECORD_DIR]=/records
  values[HALOGEN_RECORD_TEXT]="${text:-none}"
else
  # Off: nothing is mounted, so nothing about records reaches Halogen.
  unset 'values[HALOGEN_RECORD_TEXT]' 'values[HALOGEN_RECORD_GIB]' 'values[HALOGEN_RECORD_DAYS]'
fi

# Web search. HALOGEN_WEB_SEARCH_URL is blocked in halogen.env (gen-options.py): the address is
# always the search container's on halos-search, the only place Halogen's container can reach.
unset 'values[HALOGEN_WEB_SEARCH_URL]'
if [ -f "$search_dropin" ]; then
  smode="$(sed -n 's/^HALOS_WEB_SEARCH=//p' "$search_conf" 2>/dev/null | tail -n 1)"
  spath="$(sed -n 's/^HALOS_SEARCH_PATH=//p' "$search_conf" 2>/dev/null | tail -n 1)"
  case "$smode" in
    bundled) values[HALOGEN_WEB_SEARCH_URL]=http://10.89.250.2:8080 ;;
    # Your SearXNG's own path, if it has one: the relay passes it on as it is.
    external)
      if [[ "$spath" =~ ^(/[A-Za-z0-9._~-]+)*$ ]] && [[ "$spath/" != */./* ]] && [[ "$spath/" != */../* ]]; then values[HALOGEN_WEB_SEARCH_URL]="http://10.89.250.2:8080$spath"
      else echo "halogen-config: web search stays off: the path in $search_conf isn't plain (sudo halogenctl web-search external <url> again)" >&2; fi ;;
    *) echo "halogen-config: web search stays off: $search_conf names no mode (sudo halogenctl web-search off, then on again)" >&2 ;;
  esac
fi

# The prompt cache on disk. Halogen writes only under HALOGEN_CACHE_DIR; without the folder
# (prepare makes it) or after "cache off" its settings don't reach Halogen either.
if [ -n "${values[HALOGEN_CACHE_DISK_GIB]:-}" ] && ! [[ "${values[HALOGEN_CACHE_DISK_GIB]}" =~ ^[0-9]+$ ]]; then
  ignore HALOGEN_CACHE_DISK_GIB "it must be a whole number of GiB (0 is unbounded); using Halogen's 64"; unset 'values[HALOGEN_CACHE_DISK_GIB]'
fi
if [ -n "${values[HALOGEN_CACHE_PRUNE_OLD]:-}" ] && ! [[ "${values[HALOGEN_CACHE_PRUNE_OLD]}" =~ ^[01]$ ]]; then
  ignore HALOGEN_CACHE_PRUNE_OLD "it must be 0 or 1; using 1"; unset 'values[HALOGEN_CACHE_PRUNE_OLD]'
fi
# Halogen is told about the folder only while it is mounted writable: off is the choice file or
# the read-only drop-in, whichever is there (what Halogen does with a read-only cache folder isn't known).
if [ "$(head -n 1 "$cache_choice" 2>/dev/null | tr -cd '[:lower:]')" != off ] && [ ! -e "$cache_off_dropin" ] && [ -d "$models/.prompt-cache" ]; then
  values[HALOGEN_CACHE_DIR]=/models/.prompt-cache
  values[HALOGEN_CACHE_PRUNE_OLD]="${values[HALOGEN_CACHE_PRUNE_OLD]:-1}"
else
  unset 'values[HALOGEN_CACHE_DIR]' 'values[HALOGEN_CACHE_DISK_GIB]' 'values[HALOGEN_CACHE_PRUNE_OLD]'
fi

# The API key. Required unless root's off file is there: anything else (no file, a folder that
# can't be read) keeps it, so a mistake never opens the API. HALOGEN_API_KEY and _FILE are blocked
# in halogen.env (gen-options.py), so only this line sets them.
unset 'values[HALOGEN_API_KEY]' 'values[HALOGEN_API_KEY_FILE]'
# Never off beside web search: the search container reaches Halogen's API on halos-search, past the
# front door (halogenctl refuses both at once; this holds when they were made otherwise, say by hand).
if [ -f "$api_key_off" ] && [ -e "$search_dropin" ]; then
  echo "halogen-config: the API key stays on: web search is on, and its container reaches the API (sudo halogenctl web-search off first)" >&2
  values[HALOGEN_API_KEY_FILE]=/run/secrets/halogen-api-key
elif [ -f "$api_key_off" ]; then
  echo "halogen-config: the API key is off (sudo halogenctl api-key off): anyone who can reach port 8731 can use the API" >&2
else
  values[HALOGEN_API_KEY_FILE]=/run/secrets/halogen-api-key
fi

tmp="$output.new"
: > "$tmp" || exit 1
for key in "${!values[@]}"; do
  printf '%s=%s\n' "$key" "${values[$key]}" >> "$tmp"
done
sort -o "$tmp" "$tmp"
mv "$tmp" "$output"
if [ "${1:-}" = --show ]; then cat "$output"; else echo "$output"; fi
