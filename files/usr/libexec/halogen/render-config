#!/bin/bash
# Build the settings Halogen receives from /srv/configs/halogen.env. Only options this
# image allows pass through, so a typo or a locked setting cannot reach the server.
# The Flash checkpoint comes from /srv/configs/flash-checkpoint, which only halogenctl flash use
# writes: the official one, or a checkpoint flash pull downloaded and Halogen's verify passed.
# Prints the path of the result. With --show, prints its contents instead.
set -uo pipefail
config="${HALOGEN_CONFIG_FILE:-/srv/configs/halogen.env}"
flash_choice="${HALOGEN_FLASH_FILE:-/srv/configs/flash-checkpoint}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
official=/models/qwen38-flash-next-v2.hgn
allowed="${HALOGEN_ALLOWED_FILE:-/usr/share/halogen/options.allowed}"
runtime="${XDG_RUNTIME_DIR:-/run/user/970}/halogen"
output="$runtime/effective.env"
mkdir -p "$runtime" || exit 1
declare -A values=() where=()

ignore() { echo "halogen-config: ignored $1: $2" >&2; }

if [ -r "$config" ]; then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) ignore "'$line'" "it is not KEY=VALUE"; continue ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    if ! grep -qxF -- "$key" "$allowed"; then
      ignore "$key" "not an option this system allows"
      continue
    fi
    case "$value" in \"*\"|\'*\') value="${value:1:${#value}-2}" ;; esac
    if [ "$key" = HALOGEN_VISION_TOWER ] && [ -n "$value" ] && [ "$value" != 1 ]; then
      ignore "$key" "the only supported value is 1"
      continue
    fi
    # The last line wins, but a setting written twice is usually a copy-paste left behind.
    if [ -n "${where[$key]:-}" ]; then
      echo "halogen-config: $key is set more than once in $config (lines ${where[$key]} and $n); line $n is used" >&2
    fi
    values["$key"]="$value"
    where["$key"]="$n"
  done < "$config"
else
  echo "halogen-config: cannot read $config, so Halogen uses its defaults" >&2
fi

# Which Flash checkpoint. Anything unexpected falls back to the official one, so Halogen starts.
checkpoint="$official"
choice="$(head -n 1 "$flash_choice" 2>/dev/null | tr -d '[:space:]')"
case "$choice" in
  ''|official) ;;
  *[!A-Za-z0-9._-]*|.*) echo "halogen-config: $flash_choice names '$choice', which is not a checkpoint name; using the official one" >&2 ;;
  *)
    info="$models/flash/$choice/halos.info"
    file="$(sed -n 's/^checkpoint=//p' "$info" 2>/dev/null | tail -n 1)"
    verified="$(sed -n 's/^verified=//p' "$info" 2>/dev/null | tail -n 1)"
    if [ ! -f "$info" ]; then
      echo "halogen-config: no checkpoint called $choice in $models/flash; using the official one" >&2
    elif [ "$verified" != pass ]; then
      echo "halogen-config: $choice has not passed Halogen's verify; using the official one" >&2
    elif ! [[ "$file" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] || [ ! -f "$models/flash/$choice/$file" ]; then
      echo "halogen-config: $choice is missing its checkpoint file; using the official one" >&2
    elif [ -L "$models/flash/$choice" ] || [ -L "$info" ] || [ -L "$models/flash/$choice/$file" ]; then
      # A link could lead to a file that changed after it was checked.
      echo "halogen-config: $choice holds links, not its own files; using the official one" >&2
    else
      checkpoint="/models/flash/$choice/$file"
      # HALOGEN_VISION_TOWER=1 looks beside the checkpoint, and a missing tower stops Halogen.
      if [ -n "${values[HALOGEN_VISION_TOWER]:-}" ] && [ ! -f "$models/flash/$choice/qwen38-flash-next-vision.hgn" ]; then
        ignore HALOGEN_VISION_TOWER "$choice has no vision tower, so images stay off"
        unset 'values[HALOGEN_VISION_TOWER]'
      fi
    fi ;;
esac
values[HALOGEN_CHECKPOINT]="$checkpoint"

tmp="$output.new"
: > "$tmp" || exit 1
for key in "${!values[@]}"; do
  printf '%s=%s\n' "$key" "${values[$key]}" >> "$tmp"
done
sort -o "$tmp" "$tmp"
mv "$tmp" "$output"
if [ "${1:-}" = --show ]; then cat "$output"; else echo "$output"; fi
