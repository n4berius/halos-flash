#!/bin/bash
# HTTPS for halOS's front door (halos-proxy.service, Caddy on 8731 and 8732). Root only.
#
#   https mode                 off, self-signed or custom (from /etc/halos/https.env)
#   https names                the names and addresses a self-signed certificate covers
#   https env                  halos-proxy's ExecStartPre=+: writes /run/halos/proxy.env (which
#                              Caddyfile, which sites; root's folder, as systemd reads it as root)
#                              and, for custom, copies the certificate and key into
#                              $RUNTIME_DIRECTORY for Caddy's own user
#   https set <mode> [<name>...] writes /etc/halos/https.env
#   https install <cert> <key> checks a certificate and key, then keeps them in /etc/halos/https/
#   https ca                   the self-signed authority's root certificate (PEM), to trust it
#   https describe             one line per fact, for halosctl and the selftest
#
# /etc/halos/https.env is read as data, never sourced. Caddy's own state (the self-signed
# authority) belongs to its dynamic user; root only reads certificates out of it through openssl,
# which prints nothing but a certificate whatever the file is.
set -euo pipefail
LC_ALL=C
etc="${HALOS_HTTPS_ETC:-/etc/halos}"
conf="$etc/https.env"
certdir="$etc/https"
state="${HALOS_PROXY_STATE:-/var/lib/private/halos-proxy}"
root_ca="$state/caddy/pki/authorities/local/root.crt"
share="${HALOS_PROXY_SHARE:-/usr/share/halos/proxy}"
run="${HALOS_HTTPS_RUN:-/run/halos}"
die() { echo "https: $*" >&2; exit 1; }

value() { # value KEY: the last KEY=... line of the settings file, quotes stripped
  [ -r "$conf" ] || return 0
  sed -n "s/^[[:space:]]*$1=//p" "$conf" | tail -n 1 | tr -d "\"'" | tr -cd '[:graph:] '
}
mode() {
  local m; m="$(value HALOS_HTTPS)"
  case "$m" in self-signed|custom) echo "$m" ;; *) echo off ;; esac
}
# A host name or an IP address, nothing a Caddyfile could read as more than one word or a directive.
valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || [[ "$1" =~ ^[0-9A-Fa-f:.]+$ && "$1" == *:* ]]
}
names() {
  local h n seen=" "
  h="$(hostname 2> /dev/null || true)"
  {
    echo localhost; echo 127.0.0.1; echo ::1
    if [ -n "$h" ]; then echo "$h"; echo "${h%%.*}"; echo "${h%%.*}.local"; fi
    # This machine's addresses (hostname -I leaves out loopback and link-local).
    for n in $(hostname -I 2> /dev/null || true); do echo "$n"; done
    for n in $(value HALOS_HTTPS_NAMES); do echo "$n"; done
  } | while read -r n; do
    valid_name "$n" || continue
    case "$seen" in *" $n "*) continue ;; esac
    seen+="$n "; echo "$n"
  done
}
sites() { # sites PORT [v4]: Caddy site addresses for the self-signed names
  local n out=""
  while read -r n; do
    if [[ "$n" == *:* ]]; then [ "${2:-}" = v4 ] && continue; n="[$n]"; fi
    out+="${out:+, }https://$n:$1"
  done < <(names)
  echo "$out"
}

pem_cert() { openssl x509 -in "$1" -outform PEM 2> /dev/null; }
pubkey_of_cert() { openssl x509 -in "$1" -noout -pubkey 2> /dev/null; }
pubkey_of_key() { openssl pkey -in "$1" -pubout 2> /dev/null; }

case "${1:-}" in
  mode) mode ;;
  names) names ;;
  env)
    dir="${RUNTIME_DIRECTORY:?run by halos-proxy.service}"
    mkdir -p "$run"; chmod 0755 "$run"
    umask 077
    tmp="$(mktemp "$run/.proxy.env.XXXXXX")"
    case "$(mode)" in
      off)
        echo "HALOS_PROXY_CONFIG=$share/Caddyfile" > "$tmp" ;;
      self-signed)
        { echo "HALOS_PROXY_CONFIG=$share/Caddyfile.https"
          echo "HALOS_TLS=internal"
          echo "HALOS_API_SITES=\"$(sites 8731)\""
          echo "HALOS_DASH_SITES=\"$(sites 8732 v4)\""; } > "$tmp" ;;
      custom)
        # Fail closed: without its certificate, Caddy doesn't start, rather than serve the key in clear.
        for f in cert.pem key.pem; do
          [ -f "$certdir/$f" ] && [ ! -L "$certdir/$f" ] || { rm -f "$tmp"; die "HTTPS is set to custom, but $certdir/$f is missing: sudo halosctl https custom <cert> <key>, or sudo halosctl https off"; }
          c="$(mktemp "$dir/.$f.XXXXXX")"
          cat "$certdir/$f" > "$c"
          chown -h --reference="$dir" "$c"
          mv -fT "$c" "$dir/$f"
        done
        { echo "HALOS_PROXY_CONFIG=$share/Caddyfile.https"
          echo "HALOS_TLS=custom"
          echo "HALOS_API_SITES=https://:8731"
          echo "HALOS_DASH_SITES=https://:8732"; } > "$tmp" ;;
    esac
    chmod 0644 "$tmp"
    mv -fT "$tmp" "$run/proxy.env"
    ;;
  set)
    m="${2:-}"; shift 2 || true
    case "$m" in off|self-signed|custom) ;; *) die "set off|self-signed|custom [<name>...]" ;; esac
    for n in "$@"; do valid_name "$n" || die "not a host name or address: $n"; done
    if [ "$m" = custom ]; then
      [ -f "$certdir/cert.pem" ] && [ -f "$certdir/key.pem" ] || die "no certificate installed yet"
    fi
    mkdir -p "$etc"; umask 022
    tmp="$(mktemp "$etc/.https.env.XXXXXX")"
    { echo "# halOS HTTPS for 8731 and 8732: off, self-signed or custom. Change with sudo halosctl https."
      echo "HALOS_HTTPS=$m"
      echo "HALOS_HTTPS_NAMES=$*"; } > "$tmp"
    chmod 0644 "$tmp"; mv -fT "$tmp" "$conf"
    ;;
  install)
    cert="${2:?install <cert> <key>}"; key="${3:?install <cert> <key>}"
    pem_cert "$cert" > /dev/null || die "$cert isn't a PEM certificate"
    pubkey_of_key "$key" > /dev/null || die "$key isn't a private key (PEM, without a passphrase)"
    [ "$(pubkey_of_cert "$cert")" = "$(pubkey_of_key "$key")" ] || die "the key doesn't belong to the certificate"
    openssl x509 -in "$cert" -noout -checkend 0 > /dev/null 2>&1 || die "the certificate has expired"
    mkdir -p "$certdir"; chmod 0700 "$certdir"
    umask 077
    for pair in "cert.pem:$cert" "key.pem:$key"; do
      t="$(mktemp "$certdir/.new.XXXXXX")"; cat "${pair#*:}" > "$t"; mv -fT "$t" "$certdir/${pair%%:*}"
    done
    ;;
  ca)
    [ -e "$root_ca" ] || die "no self-signed authority yet (sudo halosctl https self-signed makes one)"
    pem_cert "$root_ca" || die "the self-signed authority's certificate can't be read"
    ;;
  describe)
    m="$(mode)"; echo "mode $m"
    case "$m" in
      self-signed)
        if [ -e "$root_ca" ] && f="$(openssl x509 -in "$root_ca" -noout -fingerprint -sha256 2> /dev/null)"; then
          echo "ca ${f#*=}"
          echo "ca_until $(openssl x509 -in "$root_ca" -noout -enddate | cut -d= -f2)"
        else echo "ca none"; fi
        echo "names $(names | paste -sd' ' -)" ;;
      custom)
        if [ -f "$certdir/cert.pem" ]; then
          echo "subject $(openssl x509 -in "$certdir/cert.pem" -noout -subject -nameopt RFC2253 2> /dev/null | cut -d= -f2-)"
          echo "until $(openssl x509 -in "$certdir/cert.pem" -noout -enddate 2> /dev/null | cut -d= -f2)"
          if openssl x509 -in "$certdir/cert.pem" -noout -checkend 1209600 > /dev/null 2>&1; then echo "expires later"
          else echo "expires soon"; fi
        else echo "subject none"; fi ;;
    esac
    ;;
  *) die "mode, names, env, set, install, ca or describe" ;;
esac
