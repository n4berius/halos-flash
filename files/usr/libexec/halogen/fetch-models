#!/bin/bash
# Runs as the halogen user before the server. Exit 0 means the server can start.
# Network failures retry forever. Problems a retry cannot fix exit non-zero.
set -uo pipefail

release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
render="${HALOGEN_RENDER:-/usr/libexec/halogen/render-config}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
helper="${HALOGEN_FETCH_HELPER:-/usr/libexec/halogen/fetch-in-container}"
needed_gib="${HALOGEN_MODELS_NEEDED_GIB:-125}"
max_wait="${HALOGEN_RETRY_MAX_S:-300}"
progress_s="${HALOGEN_PROGRESS_S:-60}"
hf_token="${HALOGEN_HF_TOKEN_FILE:-/srv/configs/hf-token}"
sums="${HALOGEN_WEIGHTS_SUMS:-/usr/share/halogen/weights.sha256}"

# shellcheck disable=SC1090
. "$release"

# On a new install, wait for first-boot setup (sudo halosctl setup), so the Hugging Face token
# and settings chosen there count. After the time limit, start with the defaults anyway.
state="${HALOGEN_STATE_DIR:-/var/lib/halogen}"
pending="$state/setup-pending"
setup_wait="${HALOGEN_SETUP_WAIT_S:-1800}"
if [ -e "$pending" ]; then
  echo "halogen-fetch: waiting for first-boot setup: sudo halosctl setup (or --skip). Without it, the download starts in $((setup_wait / 60)) minutes"
  # Counted from now on the shell's own clock, not the marker's time: the wall clock can jump
  # at first boot when it is set from the network.
  waited_from=$SECONDS
  while [ -e "$pending" ]; do
    if [ $((SECONDS - waited_from)) -ge "$setup_wait" ]; then
      echo "halogen-fetch: no setup after $((setup_wait / 60)) minutes; starting with the defaults"
      rm -f "$pending"; break
    fi
    sleep "${HALOGEN_SETUP_POLL_S:-10}"
  done
fi
flash_tool="${HALOGEN_FLASH_TOOL:-/usr/libexec/halogen/flash-checkpoint}"
flash_choice="${HALOGEN_FLASH_FILE:-/srv/configs/flash-checkpoint}"
# The settings for the official checkpoint: what is fetched doesn't depend on which checkpoint
# is chosen (the official vision tower stays, so going back downloads nothing).
effective="$(HALOGEN_FLASH_FILE=/dev/null "$render")" || exit 1
setting() { sed -n "s/^$1=//p" "$effective" | tail -n 1; }
npu_models="$(setting HALOGEN_NPU_MODELS)"
# The agent guard adds its two models when the server starts, so fetch them now: the server
# itself never downloads. Same rule as Halogen's start script.
case "$(setting HALOGEN_AGENT_GUARD | tr '[:upper:]' '[:lower:]')" in
  watch|hold)
    for guard in halogen-spotter-0.6b decider-4b; do
      case ",$npu_models," in *",$guard,"*) ;; ,,) npu_models="$guard" ;; *) npu_models="$npu_models,$guard" ;; esac
    done ;;
esac
vision="$(setting HALOGEN_VISION_TOWER)"
npu_dir="$models/npu"
# The stamp ("these models match this release") and the note of your checkpoints' NPU models
# live in halogen's own folder, which no container mounts: in /srv/models a download container
# could have forged "already downloaded". The old copies there are removed once new ones exist.
stamp="$state/fetch-stamp"
bases_note="$state/own-bases"

# Your own checkpoints (paths) are checked again when their files change.
own_models() {
  local id p
  for id in ${npu_models//,/ }; do
    case "$id" in /models/*) p="$models/${id#/models/}"; p="${p%:fast}"
      stat -c '%n %s %Y' "$p/config.json" "$p/model.safetensors" 2>/dev/null ;; esac
  done
}
want="$(printf '%s\n' "$HALOGEN_IMAGE" "$HALOGEN_WEIGHTS_REPO" "$HALOGEN_WEIGHTS_REVISION" "$npu_models" "$vision" "$(own_models)" | sha256sum | cut -d' ' -f1)"

# A download container an interrupted fetch left behind (it sits outside this service's cgroup,
# and bash as PID 1 ignores SIGTERM) still has the network, the token and /models writable: it
# goes before anything here trusts what is in the models folder.
podman rm -f -i -t 0 halogen-fetch-download > /dev/null 2>&1 || true

# Writes a new file from stdin, never through a link a download container left under that name
# (which could point at the API key): the name is removed, then created exclusively.
write_new() { rm -f -- "$1" && ( set -C; cat > "$1" ); }

# A link where one of the folders mounted into Halogen's container belongs is refused before
# anything is moved, made or mounted through it (prepare removes such links at boot, and
# Halogen's start refuses them: preflight).
for f in npu decider LFM custom flash; do
  if [ -L "$models/$f" ]; then
    echo "halogen-fetch: $models/$f is a link, not a folder: sudo systemctl restart halogen-prepare.service, then sudo halogenctl restart" >&2; exit 1
  fi
done
mkdir -p "$npu_dir" || exit 1

# Before 0.19, NPU models were kept per Halogen version (npu/0.18.23/<model>). Move them into
# the one folder, the current version's first. The fetch below checks every file against this
# image's record and downloads only what differs, so no model is fetched again needlessly.
for old in "$npu_dir/$HALOGEN_VERSION" "$npu_dir"/[0-9]*.[0-9]*.[0-9]*; do
  # A link with such a name is nobody's old folder: moving "its" models would move whatever
  # it points to into the folder the download container writes.
  if [ -L "$old" ]; then rm -f -- "$old"; continue; fi
  [ -d "$old" ] || continue
  for model in "$old"/*/; do
    if [ ! -d "$model" ] || [ -L "${model%/}" ]; then continue; fi
    [ -e "$npu_dir/$(basename "$model")" ] || mv "$model" "$npu_dir/$(basename "$model")"
  done
  rm -rf "$old"
  echo "halogen-fetch: moved NPU models from $old into $npu_dir"
done

wait_s=15
until podman image exists "$HALOGEN_IMAGE"; do
  podman pull "$HALOGEN_IMAGE" && break
  echo "halogen-fetch: image pull failed, retrying in ${wait_s}s"
  sleep "$wait_s"
  wait_s=$((wait_s * 2)); [ "$wait_s" -le "$max_wait" ] || wait_s="$max_wait"
done

# Your own Flash checkpoint was checked by the Halogen it was pulled with. After a Halogen
# update, check it again with this one before it is served; if it fails, render-config serves
# the official checkpoint and halogenctl status says why.
choice="$(head -n 1 "$flash_choice" 2>/dev/null | tr -cd 'A-Za-z0-9._-')"
case "$choice" in ''|official|[!A-Za-z0-9]*) ;; *)
  info="$models/flash/$choice/halos.info"
  if [ -f "$info" ] && [ "$(sed -n 's/^verified=//p' "$info" | tail -n 1)" = pass ] &&
     [ "$(sed -n 's/^verified_with=//p' "$info" | tail -n 1)" != "$HALOGEN_VERSION" ]; then
    echo "halogen-fetch: checking your Flash checkpoint $choice again with Halogen $HALOGEN_VERSION"
    "$flash_tool" verify "$choice" || echo "halogen-fetch: $choice failed the check, so Halogen serves the official checkpoint. Check it again: sudo halogenctl flash verify $choice" >&2
  fi ;;
esac

# The official files: the checkpoint, its lookup table, the vision tower when it is wanted, and
# the tokenizer. A link in place of one is never a download: it goes, and the file is fetched.
official=(qwen38-flash-next-v2.hgn qwen38-flash-next-ngram.hgn)
[ -z "$vision" ] || official+=(qwen38-flash-next-vision.hgn)
for f in "${official[@]}" tokenizer; do
  if [ -L "$models/$f" ]; then
    rm -f -- "$models/$f" || exit 1; echo "halogen-fetch: removed a link at $models/$f"
  fi
done
# A marker that the official files are still to be checked: set before a download that can write
# them, and when this machine has no stamp yet (an install from before the check, or one whose
# stamp is gone); removed only once every file matched. A fetch cut short leaves it, so the
# next one checks, whichever way it ended.
unchecked="$state/weights-unchecked"
[ -e "$stamp" ] || : | write_new "$unchecked" || exit 1
official_there() {
  local f
  [ ! -L "$models/tokenizer" ] || return 1
  for f in "${official[@]}" tokenizer/tokenizer.json; do
    if [ ! -f "$models/$f" ] || [ -L "$models/$f" ]; then return 1; fi
  done
  # A link (or anything but files and folders) under npu isn't the fast path either: the cleanup
  # after the download removes it (Halogen's start would refuse it: preflight).
  [ ! -d "$npu_dir" ] || [ -z "$(find "$npu_dir" -mindepth 1 \( -type l -o \( ! -type f ! -type d \) \) -print -quit 2>/dev/null)" ]
}

# A machine from before the note, or from before both moved out of /srv/models, fetches (and
# checks) once more, to write them: nothing is downloaded when the files are there.
# The models folder is a volume of its own: emptied or replaced, the stamp alone would be wrong.
if [ "$(cat "$stamp" 2>/dev/null)" = "$want" ] && [ -e "$bases_note" ] && [ ! -e "$unchecked" ] && official_there; then
  echo "halogen-fetch: models already match this release"
  exit 0
fi

# Your own Flash checkpoints don't count as room for this release's models.
have_gib="$(du -s --block-size=1G --exclude="$models/flash" --exclude="$models/.prompt-cache" "$models" 2>/dev/null | cut -f1)"
free_gib="$(df --output=avail --block-size=1G "$models" | tail -n 1 | tr -d ' ')"
if [ "$((${free_gib:-0} + ${have_gib:-0}))" -lt "$needed_gib" ]; then
  echo "halogen-fetch: ${free_gib:-0} GiB free in $models; the models need about $needed_gib GiB" >&2
  exit 1
fi

# The downloader prints nothing until a file is complete, so report the size on disk
# (partial files included) every minute. 0 turns the report off.
if [ "$progress_s" -gt 0 ]; then
  while sleep "$progress_s" > /dev/null 2>&1; do
    # Your own checkpoints count in this too, so past the estimate it reports only the size.
    now_gib="$(du -s --block-size=1G --exclude="$models/flash" --exclude="$models/.prompt-cache" "$models" 2>/dev/null | cut -f1)"
    if [ "${now_gib:-0}" -lt "$needed_gib" ]; then
      echo "halogen-fetch: ${now_gib:-0} GiB of about $needed_gib GiB downloaded"
    else
      echo "halogen-fetch: ${now_gib:-0} GiB in $models (your own checkpoints count too)"
    fi
  done &
  reporter=$!
  trap 'kill "$reporter" 2>/dev/null' EXIT
fi

# An optional Hugging Face token (halogenctl hf-token) gives faster, less limited downloads.
# It reaches the downloader as a read-only file, so it never shows in process lists.
token_args=()
if [ -s "$hf_token" ]; then
  token_args=(-v "$hf_token:/run/secrets/hf-token:ro" -e HF_TOKEN_PATH=/run/secrets/hf-token)
  echo "halogen-fetch: using your Hugging Face token"
else
  echo "halogen-fetch: no Hugging Face token; downloads are anonymous. Add one with: sudo halogenctl hf-token"
fi


# Which model each of your own NPU checkpoints was tuned from, asked of Halogen offline, with
# the models read-only and no token: a checkpoint is untrusted input to Halogen's parser, so it
# never sees the network or your token. The download container is only told the answers.
own_bases=""
# Halogen's prompt cache (conversation state) is hidden from these containers: none of them needs
# it, and the download one has network. An empty read-only tmpfs takes its place; notmpcopyup,
# or podman copies the folder's files into it. podman can't make the
# mount point on a read-only /models, so a missing folder is made first (this runs as halogen, as
# prepare does at boot). A link in its place is refused: the tmpfs would land on whatever it points
# to, and Halogen's start refuses it anyway (preflight).
if [ -L "$models/.prompt-cache" ]; then
  echo "$models/.prompt-cache is a link, not a folder. Remove it, then start again: sudo halogenctl restart" >&2; exit 1
fi
[ -d "$models/.prompt-cache" ] || mkdir -m 0700 "$models/.prompt-cache" || exit 1
hide_cache=(--tmpfs "/models/.prompt-cache:ro,size=4k,notmpcopyup")
# In the download container (network, the token, /models writable) each of those folders is a
# mount of its own: a mount point can't be renamed, removed or replaced from inside, so the
# container can't swap one for a link before Halogen's next start. Only npu is written by the
# download; the others are read-only there.
pin=()
[ ! -d "$models/npu" ] || [ -L "$models/npu" ] || pin+=(-v "$models/npu:/models/npu")
for f in decider LFM custom flash; do [ ! -d "$models/$f" ] || [ -L "$models/$f" ] || pin+=(-v "$models/$f:/models/$f:ro"); done
need_probe=""
# Split the way the download container does (commas and spaces), so no path slips past.
for id in ${npu_models//,/ }; do case "$id" in /*) need_probe=1 ;; esac; done
if [ -n "$need_probe" ]; then
  own_bases="$(podman run --rm --pull=never --read-only --tmpfs /tmp --network=none \
    --cap-drop=all --security-opt no-new-privileges --entrypoint bash \
    -e HOME=/tmp -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=1 -e FETCH_MODE=probe -e "NPU_MODELS=$npu_models" \
    -v "$models:/models:ro" "${hide_cache[@]}" -v "$helper:/fetch.sh:ro" "$HALOGEN_IMAGE" /fetch.sh)"
  case "$?" in
    0) ;;
    3) echo "halogen-fetch: the configured models cannot be fetched; fix /srv/configs/halogen.env" >&2; exit 1 ;;
    *) echo "halogen-fetch: could not check your own NPU checkpoints. Try again with: sudo halogenctl restart" >&2; exit 1 ;;
  esac
  # The probe read untrusted checkpoints, so its answers are checked here, outside it: only
  # "path=model" lines, with a plain model name, reach the download container.
  if printf '%s\n' "$own_bases" | grep -vE '^$|^/models/[^=]+=[A-Za-z0-9._-]+$' | grep -q .; then
    echo "halogen-fetch: Halogen's check of your own NPU checkpoints gave an answer halOS doesn't accept" >&2
    exit 1
  fi
fi
# Kept for halogenctl model list, which says which NPU model each of your checkpoints runs on.
# Only a note: nothing reads it to decide what to fetch or serve.
if printf '%s\n' "$own_bases" | write_new "$bases_note.new"; then mv -f "$bases_note.new" "$bases_note" || true; fi

# When they are all there, the download only adds NPU programs: the top of /models is then
# read-only to it, and only npu (its own mount) is writable. Otherwise it downloads the missing
# official files, and writes them where it likes: each is checked against the hashes this
# release carries (weights.sha256) once it is done.
top=":ro"
if ! official_there; then top=""; : | write_new "$unchecked" || exit 1; fi

wait_s=15
while :; do
  # Named, and replacing one an interrupted fetch left running: a download container must not
  # outlive its fetch with /srv/models still writable.
  podman run --rm --pull=never --read-only --tmpfs /tmp --name halogen-fetch-download --replace \
    --cap-drop=all --security-opt no-new-privileges --entrypoint bash \
    -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=0 -e HF_HUB_DISABLE_TELEMETRY=1 -e HF_HUB_DISABLE_PROGRESS_BARS=1 \
    -e "WEIGHTS_REPO=$HALOGEN_WEIGHTS_REPO" -e "WEIGHTS_REVISION=$HALOGEN_WEIGHTS_REVISION" \
    -e "NPU_MODELS=$npu_models" -e "OWN_BASES=$own_bases" -e "VISION=$vision" "${token_args[@]}" \
    -v "$models:/models$top" "${hide_cache[@]}" "${pin[@]}" -v "$helper:/fetch.sh:ro" \
    "$HALOGEN_IMAGE" /fetch.sh
  rc=$?
  case "$rc" in
    0) break ;;
    3) echo "halogen-fetch: the configured models cannot be fetched; fix /srv/configs/halogen.env" >&2; exit 1 ;;
  esac
  echo "halogen-fetch: download stopped (exit $rc), resuming in ${wait_s}s"
  sleep "$wait_s"
  wait_s=$((wait_s * 2)); [ "$wait_s" -le "$max_wait" ] || wait_s="$max_wait"
done
[ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null

# The NPU folder is the download container's to write, so after it only what this image's record
# (/opt/halogen/npu/models.txt, read offline from the pinned image) names stays: no link and
# nothing but files and folders anywhere under npu, and in the folder of each model the record
# knows, only its listed files (hf's own .cache/huggingface kept). Folders of models the record
# doesn't know (an older release's) are left for a rollback; Halogen loads only known models.
if ! pins_list="$(podman run --rm --pull=never --network=none --read-only --cap-drop=all \
    --security-opt no-new-privileges --entrypoint cat "$HALOGEN_IMAGE" /opt/halogen/npu/models.txt)"; then
  echo "halogen-fetch: cannot read the NPU model record from Halogen's image" >&2; exit 1
fi
allowed="$(awk '$1 == "file" { print $2 "/" $3 } $1 == "model" { print $2 "/" }' <<< "$pins_list")"
while IFS= read -r -d '' p; do
  rm -f -- "$p" && echo "halogen-fetch: removed ${p#"$models"/}, a link or not a plain file"
done < <(find "$npu_dir" -mindepth 1 \( -type l -o \( ! -type f ! -type d \) \) -print0 2>/dev/null)
for d in "$npu_dir"/*/; do
  id="${d%/}"; id="${id##*/}"
  grep -qxF -- "$id/" <<< "$allowed" || continue
  while IFS= read -r -d '' p; do
    rel="${p#"$npu_dir"/}"
    case "$rel" in "$id"/.cache/huggingface/*) continue ;; esac
    grep -qxF -- "$rel" <<< "$allowed" || { rm -f -- "$p" && echo "halogen-fetch: removed npu/$rel, which this release's record doesn't list"; }
  done < <(find "$d" -type f -print0)
done

# After a download that could write the official files, each is checked against this release's
# hashes. A file that differs (or a link) is removed and the fetch fails, so the next start
# downloads it again; for the tokenizer, tokenizer.json goes too, since that is what the
# download looks for.
if [ -e "$unchecked" ]; then
  echo "halogen-fetch: checking the official files against this release's hashes"
  bad=""
  # The download could also make the folders read-only to keep a link it planted (a failed rm
  # would then leave it, and what follows would go through it): they are opened up first, and
  # any removal that fails stops the fetch. chmod -R doesn't follow links.
  chmod u+rwx -- "$models" || exit 1
  if [ -L "$models/tokenizer" ]; then rm -f -- "$models/tokenizer" || exit 1; bad=" tokenizer"; fi
  [ ! -L "$models/tokenizer" ] || exit 1
  if [ -d "$models/tokenizer" ]; then chmod -R u+rwX -- "$models/tokenizer" || exit 1; fi
  # The vision tower too when it is kept but not wanted now: turned on later, it would be there
  # and never checked.
  check=("${official[@]}")
  if [ -z "$vision" ] && { [ -e "$models/qwen38-flash-next-vision.hgn" ] || [ -L "$models/qwen38-flash-next-vision.hgn" ]; }; then
    check+=(qwen38-flash-next-vision.hgn)
  fi
  for f in "${check[@]}" $(sed -n 's#^[0-9a-f]\{64\}  \(tokenizer/[A-Za-z0-9._-]*\)$#\1#p' "$sums"); do
    want_sum="$(awk -v f="$f" '$2 == f { print $1; exit }' "$sums")"
    if [ -z "$want_sum" ]; then echo "halogen-fetch: $sums has no hash for $f" >&2; exit 1; fi
    if [ -L "$models/$f" ] || [ ! -f "$models/$f" ] || [ "$(sha256sum < "$models/$f" | cut -d' ' -f1)" != "$want_sum" ]; then
      rm -f -- "$models/$f" || exit 1; bad="$bad $f"
      case "$f" in tokenizer/*) rm -f -- "$models/tokenizer/tokenizer.json" || exit 1 ;; esac
    fi
  done
  # Anything else in tokenizer/ isn't this release's (Halogen reads the folder whole): it goes.
  for f in "$models"/tokenizer/* "$models"/tokenizer/.[!.]*; do
    if [ ! -d "$models/tokenizer" ] || [ -L "$models/tokenizer" ]; then break; fi
    [ -e "$f" ] || [ -L "$f" ] || continue
    if ! grep -qxF "tokenizer/${f##*/}" < <(awk '/^[0-9a-f]{64}  /{print $2}' "$sums") || [ -L "$f" ] || [ ! -f "$f" ]; then
      rm -rf -- "$f" || exit 1; echo "halogen-fetch: removed tokenizer/${f##*/}, which isn't one of this release's files"
    fi
  done
  if [ -n "$bad" ]; then
    echo "halogen-fetch: these files didn't match this release's hashes and were removed:$bad. Download them again: sudo halogenctl restart" >&2
    exit 1
  fi
  rm -f -- "$unchecked"
fi

# Halogen's own checker reads back the checkpoint that was downloaded. It reads local files
# only, so it gets no network and no capabilities.
if ! podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" "${hide_cache[@]}" \
    --network=none --cap-drop=all --security-opt no-new-privileges \
    "$HALOGEN_IMAGE" verify /models/qwen38-flash-next-v2.hgn; then
  echo "halogen-fetch: the checkpoint failed verification; remove it and restart" >&2
  exit 1
fi

printf '%s\n' "$want" | write_new "$stamp.new" && mv "$stamp.new" "$stamp"
# The copies from before they moved here: never read again.
rm -f -- "$models/.fetch-stamp" "$models/.own-bases"
echo "halogen-fetch: models ready"
