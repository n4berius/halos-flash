#!/bin/bash
# Runs as the halogen user before the server. Exit 0 means the server can start.
# Network failures retry forever. Problems a retry cannot fix exit non-zero.
set -uo pipefail

release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
render="${HALOGEN_RENDER:-/usr/libexec/halogen/render-config}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
helper="${HALOGEN_FETCH_HELPER:-/usr/libexec/halogen/fetch-in-container}"
needed_gib="${HALOGEN_MODELS_NEEDED_GIB:-125}"
max_wait="${HALOGEN_RETRY_MAX_S:-300}"
progress_s="${HALOGEN_PROGRESS_S:-60}"
hf_token="${HALOGEN_HF_TOKEN_FILE:-/srv/configs/hf-token}"

# shellcheck disable=SC1090
. "$release"

# On a new install, wait for first-boot setup (sudo halosctl setup), so the Hugging Face token
# and settings chosen there count. After the time limit, start with the defaults anyway.
pending="${HALOGEN_STATE_DIR:-/var/lib/halogen}/setup-pending"
setup_wait="${HALOGEN_SETUP_WAIT_S:-1800}"
if [ -e "$pending" ]; then
  echo "halogen-fetch: waiting for first-boot setup: sudo halosctl setup (or --skip). Without it, the download starts in $((setup_wait / 60)) minutes"
  # Counted from now on the shell's own clock, not the marker's time: the wall clock can jump
  # at first boot when it is set from the network.
  waited_from=$SECONDS
  while [ -e "$pending" ]; do
    if [ $((SECONDS - waited_from)) -ge "$setup_wait" ]; then
      echo "halogen-fetch: no setup after $((setup_wait / 60)) minutes; starting with the defaults"
      rm -f "$pending"; break
    fi
    sleep "${HALOGEN_SETUP_POLL_S:-10}"
  done
fi
flash_tool="${HALOGEN_FLASH_TOOL:-/usr/libexec/halogen/flash-checkpoint}"
flash_choice="${HALOGEN_FLASH_FILE:-/srv/configs/flash-checkpoint}"
# The settings for the official checkpoint: what is fetched doesn't depend on which checkpoint
# is chosen (the official vision tower stays, so going back downloads nothing).
effective="$(HALOGEN_FLASH_FILE=/dev/null "$render")" || exit 1
setting() { sed -n "s/^$1=//p" "$effective" | tail -n 1; }
npu_models="$(setting HALOGEN_NPU_MODELS)"
# The agent guard adds its two models when the server starts, so fetch them now: the server
# itself never downloads. Same rule as Halogen's start script.
case "$(setting HALOGEN_AGENT_GUARD | tr '[:upper:]' '[:lower:]')" in
  watch|hold)
    for guard in halogen-spotter-0.6b decider-4b; do
      case ",$npu_models," in *",$guard,"*) ;; ,,) npu_models="$guard" ;; *) npu_models="$npu_models,$guard" ;; esac
    done ;;
esac
vision="$(setting HALOGEN_VISION_TOWER)"
npu_dir="$models/npu"
stamp="$models/.fetch-stamp"

# Your own checkpoints (paths) are checked again when their files change.
own_models() {
  local id p
  for id in ${npu_models//,/ }; do
    case "$id" in /models/*) p="$models/${id#/models/}"; p="${p%:fast}"
      stat -c '%n %s %Y' "$p/config.json" "$p/model.safetensors" 2>/dev/null ;; esac
  done
}
want="$(printf '%s\n' "$HALOGEN_IMAGE" "$HALOGEN_WEIGHTS_REPO" "$HALOGEN_WEIGHTS_REVISION" "$npu_models" "$vision" "$(own_models)" | sha256sum | cut -d' ' -f1)"

mkdir -p "$npu_dir" || exit 1

# Before 0.19, NPU models were kept per Halogen version (npu/0.18.23/<model>). Move them into
# the one folder, the current version's first. The fetch below checks every file against this
# image's record and downloads only what differs, so no model is fetched again needlessly.
for old in "$npu_dir/$HALOGEN_VERSION" "$npu_dir"/[0-9]*.[0-9]*.[0-9]*; do
  [ -d "$old" ] || continue
  for model in "$old"/*/; do
    [ -d "$model" ] || continue
    [ -e "$npu_dir/$(basename "$model")" ] || mv "$model" "$npu_dir/$(basename "$model")"
  done
  rm -rf "$old"
  echo "halogen-fetch: moved NPU models from $old into $npu_dir"
done

wait_s=15
until podman image exists "$HALOGEN_IMAGE"; do
  podman pull "$HALOGEN_IMAGE" && break
  echo "halogen-fetch: image pull failed, retrying in ${wait_s}s"
  sleep "$wait_s"
  wait_s=$((wait_s * 2)); [ "$wait_s" -le "$max_wait" ] || wait_s="$max_wait"
done

# Your own Flash checkpoint was checked by the Halogen it was pulled with. After a Halogen
# update, check it again with this one before it is served; if it fails, render-config serves
# the official checkpoint and halogenctl status says why.
choice="$(head -n 1 "$flash_choice" 2>/dev/null | tr -cd 'A-Za-z0-9._-')"
case "$choice" in ''|official|[!A-Za-z0-9]*) ;; *)
  info="$models/flash/$choice/halos.info"
  if [ -f "$info" ] && [ "$(sed -n 's/^verified=//p' "$info" | tail -n 1)" = pass ] &&
     [ "$(sed -n 's/^verified_with=//p' "$info" | tail -n 1)" != "$HALOGEN_VERSION" ]; then
    echo "halogen-fetch: checking your Flash checkpoint $choice again with Halogen $HALOGEN_VERSION"
    "$flash_tool" verify "$choice" || echo "halogen-fetch: $choice failed the check, so Halogen serves the official checkpoint. Check it again: sudo halogenctl flash verify $choice" >&2
  fi ;;
esac

# A machine from before the .own-bases note fetches (and checks) once more, to write it.
if [ "$(cat "$stamp" 2>/dev/null)" = "$want" ] && [ -e "$models/.own-bases" ]; then
  echo "halogen-fetch: models already match this release"
  exit 0
fi

# Your own Flash checkpoints don't count as room for this release's models.
have_gib="$(du -s --block-size=1G --exclude="$models/flash" --exclude="$models/.prompt-cache" "$models" 2>/dev/null | cut -f1)"
free_gib="$(df --output=avail --block-size=1G "$models" | tail -n 1 | tr -d ' ')"
if [ "$((${free_gib:-0} + ${have_gib:-0}))" -lt "$needed_gib" ]; then
  echo "halogen-fetch: ${free_gib:-0} GiB free in $models; the models need about $needed_gib GiB" >&2
  exit 1
fi

# The downloader prints nothing until a file is complete, so report the size on disk
# (partial files included) every minute. 0 turns the report off.
if [ "$progress_s" -gt 0 ]; then
  while sleep "$progress_s" > /dev/null 2>&1; do
    # Your own checkpoints count in this too, so past the estimate it reports only the size.
    now_gib="$(du -s --block-size=1G --exclude="$models/flash" --exclude="$models/.prompt-cache" "$models" 2>/dev/null | cut -f1)"
    if [ "${now_gib:-0}" -lt "$needed_gib" ]; then
      echo "halogen-fetch: ${now_gib:-0} GiB of about $needed_gib GiB downloaded"
    else
      echo "halogen-fetch: ${now_gib:-0} GiB in $models (your own checkpoints count too)"
    fi
  done &
  reporter=$!
  trap 'kill "$reporter" 2>/dev/null' EXIT
fi

# An optional Hugging Face token (halogenctl hf-token) gives faster, less limited downloads.
# It reaches the downloader as a read-only file, so it never shows in process lists.
token_args=()
if [ -s "$hf_token" ]; then
  token_args=(-v "$hf_token:/run/secrets/hf-token:ro" -e HF_TOKEN_PATH=/run/secrets/hf-token)
  echo "halogen-fetch: using your Hugging Face token"
else
  echo "halogen-fetch: no Hugging Face token; downloads are anonymous. Add one with: sudo halogenctl hf-token"
fi


# Which model each of your own NPU checkpoints was tuned from, asked of Halogen offline, with
# the models read-only and no token: a checkpoint is untrusted input to Halogen's parser, so it
# never sees the network or your token. The download container is only told the answers.
own_bases=""
need_probe=""
# Split the way the download container does (commas and spaces), so no path slips past.
for id in ${npu_models//,/ }; do case "$id" in /*) need_probe=1 ;; esac; done
if [ -n "$need_probe" ]; then
  own_bases="$(podman run --rm --pull=never --read-only --tmpfs /tmp --network=none \
    --cap-drop=all --security-opt no-new-privileges --entrypoint bash \
    -e HOME=/tmp -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=1 -e FETCH_MODE=probe -e "NPU_MODELS=$npu_models" \
    -v "$models:/models:ro" -v "$helper:/fetch.sh:ro" "$HALOGEN_IMAGE" /fetch.sh)"
  case "$?" in
    0) ;;
    3) echo "halogen-fetch: the configured models cannot be fetched; fix /srv/configs/halogen.env" >&2; exit 1 ;;
    *) echo "halogen-fetch: could not check your own NPU checkpoints. Try again with: sudo halogenctl restart" >&2; exit 1 ;;
  esac
  # The probe read untrusted checkpoints, so its answers are checked here, outside it: only
  # "path=model" lines, with a plain model name, reach the download container.
  if printf '%s\n' "$own_bases" | grep -vE '^$|^/models/[^=]+=[A-Za-z0-9._-]+$' | grep -q .; then
    echo "halogen-fetch: Halogen's check of your own NPU checkpoints gave an answer halOS doesn't accept" >&2
    exit 1
  fi
fi
# Kept for halogenctl model list, which says which NPU model each of your checkpoints runs on.
# Only a note: nothing reads it to decide what to fetch or serve.
if printf '%s\n' "$own_bases" > "$models/.own-bases.new"; then mv -f "$models/.own-bases.new" "$models/.own-bases" || true; fi

wait_s=15
while :; do
  podman run --rm --pull=never --read-only --tmpfs /tmp \
    --cap-drop=all --security-opt no-new-privileges --entrypoint bash \
    -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=0 -e HF_HUB_DISABLE_TELEMETRY=1 -e HF_HUB_DISABLE_PROGRESS_BARS=1 \
    -e "WEIGHTS_REPO=$HALOGEN_WEIGHTS_REPO" -e "WEIGHTS_REVISION=$HALOGEN_WEIGHTS_REVISION" \
    -e "NPU_MODELS=$npu_models" -e "OWN_BASES=$own_bases" -e "VISION=$vision" "${token_args[@]}" \
    -v "$models:/models" -v "$helper:/fetch.sh:ro" \
    "$HALOGEN_IMAGE" /fetch.sh
  rc=$?
  case "$rc" in
    0) break ;;
    3) echo "halogen-fetch: the configured models cannot be fetched; fix /srv/configs/halogen.env" >&2; exit 1 ;;
  esac
  echo "halogen-fetch: download stopped (exit $rc), resuming in ${wait_s}s"
  sleep "$wait_s"
  wait_s=$((wait_s * 2)); [ "$wait_s" -le "$max_wait" ] || wait_s="$max_wait"
done
[ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null

# Halogen's own checker reads back the checkpoint that was downloaded. It reads local files
# only, so it gets no network and no capabilities.
if ! podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" \
    --network=none --cap-drop=all --security-opt no-new-privileges \
    "$HALOGEN_IMAGE" verify /models/qwen38-flash-next-v2.hgn; then
  echo "halogen-fetch: the checkpoint failed verification; remove it and restart" >&2
  exit 1
fi

printf '%s\n' "$want" > "$stamp.new" && mv "$stamp.new" "$stamp"
echo "halogen-fetch: models ready"
