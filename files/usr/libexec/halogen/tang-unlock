#!/bin/bash
# Unlock the disk from a tang server on the network (#44), with clevis. The binding lives in the
# LUKS header: a key slot whose key clevis can get back only by asking the tang server (and, in
# "and" mode, this machine's TPM too). The initramfs module 90halos-tang-unlock looks for it at
# boot, starts the network only then, and lets clevis answer the passphrase prompt. Run by halosctl.
#   tang-unlock device            the encrypted volume (crypttab's first, as halogen-enroll-tpm)
#   tang-unlock thumbprints <url> the server's signing keys, their SHA-256 thumbprints, one a line
#   tang-unlock bound             "<url> <thumbprint>" for each server bound now, as recorded at bind
#   tang-unlock bind and|or|off <url> <thumbprint> [<url> <thumbprint>]...
#                                 one binding per server (any one server unlocks), replacing those
#                                 made before; and: each also needs the TPM; and/off: the TPM-only
#                                 unlock (systemd's) is removed, so it can't bypass the network; or:
#                                 the TPM-only unlock is enrolled when there is none
#   tang-unlock remove            remove every tang binding (the TPM-only unlock isn't put back)
#   tang-unlock mode [device]     and|or|off, or nothing when there is no tang binding
#   tang-unlock status [--short]  --short: "off", "unknown", or "on <and|or|off> <servers>"
#   tang-unlock secure-boot       exit 0 when Secure Boot is on (the TPM's PCR 7 then vouches for it)
# The existing passphrase is asked for by clevis, or read from $PASSWORD (as systemd-cryptenroll
# does). The passphrase slot is never touched.
set -euo pipefail
export LC_ALL=C
die() { echo "tang-unlock: $*" >&2; exit 1; }
# Test hooks are for the tests only: under sudo (sudo -E, an env_keep) they are ignored.
[ -z "${SUDO_COMMAND:-}" ] || unset HALOS_CRYPTTAB HALOS_TANG_RECORD HALOS_EFIVARS HALOS_FETCH_AS_ROOT
crypttab="${HALOS_CRYPTTAB:-/etc/crypttab}"
# The servers and keys bound, written at each bind: renew binds to the same keys again, and the
# selftest checks each server still signs with its key. Root's, on the encrypted disk.
record="${HALOS_TANG_RECORD:-/var/lib/halos/tang-unlock.keys}"
# What is shown on root's terminal: no control characters, even from a header someone changed.
clean() { tr -d '\000-\010\013-\037\177-\377'; }

device() {
  [ ! -e "$crypttab" ] || [ -r "$crypttab" ] || die "can't read $crypttab: run it with sudo"
  local d
  d="$(awk '/^[[:space:]]*(#|$)/ { next } { if ($2 ~ /^UUID=/) print "/dev/disk/by-uuid/" substr($2, 6); exit }' "$crypttab" 2> /dev/null || true)"
  [ -n "$d" ] || die "this disk isn't encrypted ($crypttab names no volume by UUID)"
  printf '%s\n' "$d"
}

# http(s)://host[:port][/path]: a host name, an IPv4 address or a bracketed IPv6 one. Nothing that
# a shell, curl's globbing or JSON could read as more than a URL.
url_ok() {
  # The initramfs has no mDNS, so a .local name never answers at boot (it would at bind time).
  case "$1" in *.local|*.local:*|*.local/*) return 1 ;; esac
  [[ "$1" =~ ^https?://([A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?|\[[0-9A-Fa-f:.]{2,45}\])(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,200})?$ ]]
}
# SHA-256 thumbprints only (43 characters): the older SHA-1 form is weaker, and tang-show-keys
# prints SHA-256 on current tang.
thp_ok() { [[ "$1" =~ ^[A-Za-z0-9_-]{43}$ ]]; }

# Secure Boot on, from the firmware's variable (4 attribute bytes, then 1 for on). The TPM's part
# of a binding is PCR 7, the Secure Boot state: with Secure Boot off it vouches for nothing.
secure_boot() {
  local v="${HALOS_EFIVARS:-/sys/firmware/efi/efivars}/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
  [ "$(od -An -tu1 -j4 -N1 "$v" 2> /dev/null | tr -d ' ')" = 1 ]
}

# What anyone on the network can send (a tang server answers over plain HTTP) is fetched and
# parsed by nobody, never root: curl and jose run without privileges.
as_nobody() {
  if [ "$(id -u)" = 0 ] && [ -z "${HALOS_FETCH_AS_ROOT:-}" ]; then
    setpriv --reuid=65534 --regid=65534 --clear-groups --no-new-privs -- env -C / "$@"
  else "$@"; fi
}

# The signing keys of the server's advertisement. Its signatures are checked by clevis at bind
# time against the thumbprint given; this is what a person compares with tang-show-keys.
thumbprints() {
  local url="$1" adv ver
  url_ok "$url" || die "not a tang server address: use http://<address>[:port], such as http://192.168.1.5:7500 (a .local name can't be found at boot)"
  adv="$(as_nobody curl -q -fsS --max-time 15 --max-filesize 65536 --proto =http,https --proto-redir =http,https \
    "${url%/}/adv")" || die "no answer from $url/adv: is the tang server running, and the address right?"
  ver="$(as_nobody jose fmt -j- -Og payload -SyOg keys -AUo- <<< "$adv" 2> /dev/null | as_nobody jose jwk use -i- -r -u verify -o- 2> /dev/null)" \
    || die "$url answered, but not with a tang advertisement"
  local s256 t
  s256="$(as_nobody jose jwk thp -i- -a S256 <<< "$ver")" || die "$url's advertisement has no signing key"
  [ -n "$s256" ] || die "$url's advertisement has no signing key"
  while IFS= read -r t; do thp_ok "$t" || die "$url's advertisement gave a key thumbprint that isn't one"; done <<< "$s256"
  printf '%s\n' "$s256"
}

# clevis luks list: "<slot>: <pin> '<json>'" per binding.
bindings() { clevis luks list -d "$1" 2> /dev/null || true; }
# The tang bindings only: "<slot> <and|plain> <url>" per line.
tang_slots() {
  local line slot json kind
  while IFS= read -r line; do
    [[ "$line" =~ ^([0-9]+):\ (tang|sss)\ \'(.*)\'$ ]] || continue
    slot="${BASH_REMATCH[1]}" json="${BASH_REMATCH[3]}"
    kind=plain
    jq -e '.pins? | has("tpm2")' <<< "$json" > /dev/null 2>&1 && kind=and
    jq -r '[.. | objects | .url? // empty] | .[]' <<< "$json" 2> /dev/null | clean | while IFS= read -r u; do
      printf '%s %s %s\n' "$slot" "$kind" "$u"
    done
  done < <(bindings "$1")
}
tpm_tokens() {
  cryptsetup luksDump --dump-json-metadata "$1" 2> /dev/null \
    | jq -r '.tokens | to_entries[] | select(.value.type == "systemd-tpm2") | "\(.key) \(.value.keyslots | join(" "))"' 2> /dev/null || true
}
# and|or|off from the bindings and systemd's TPM tokens; empty when there are none. A TPM-only
# token beside any tang binding is "or" whatever the bindings say: the TPM alone unlocks then.
# Fails (unknown) when the header has clevis tokens that can't be read, so callers fail closed.
mode_of() {
  local dev="$1" slots tokens
  slots="$(tang_slots "$dev")"
  if [ -z "$slots" ]; then
    tokens="$(cryptsetup luksDump --dump-json-metadata "$dev" 2> /dev/null | jq '[.tokens[] | select(.type == "clevis")] | length' 2> /dev/null)" \
      || { echo unknown; return 3; }
    [ "${tokens:-0}" = 0 ] || { echo unknown; return 3; }
    return 0
  fi
  if [ -n "$(tpm_tokens "$dev")" ]; then echo or
  elif grep -q '^[0-9]* and ' <<< "$slots"; then echo and
  else echo off; fi
}

# systemd's TPM-only unlock: its tokens and their key slots. Batch mode needs no passphrase.
remove_tpm() {
  local dev="$1" tok slots s
  while read -r tok slots; do
    [ -n "$tok" ] || continue
    for s in $slots; do cryptsetup luksKillSlot -q "$dev" "$s"; done
    cryptsetup token remove --token-id "$tok" "$dev"
  done < <(tpm_tokens "$dev")
}

# Removes the bindings made since $2 (the slots there before); those stay as they were.
undo_new() {
  local s
  for s in $(tang_slots "$1" | cut -d' ' -f1 | sort -un); do
    grep -qx "$s" <<< "$2" || clevis luks unbind -f -d "$1" -s "$s" > /dev/null 2>&1 || true
  done
}

bind() {
  local mode="$1"; shift
  case "$mode" in and|or|off) ;; *) die "bind and|or|off <url> <thumbprint>..." ;; esac
  if [ $# -lt 2 ] || [ $(($# % 2)) != 0 ]; then die "give each server's address and thumbprint"; fi
  local dev old cfg url thp pt rc=0 s pairs=()
  if [ "$mode" != off ] && ! secure_boot; then
    die "Secure Boot is off, so the TPM's part (PCR 7, the Secure Boot state) would vouch for nothing. Turn Secure Boot on in the firmware settings, or use --tpm off (the server alone); nothing changed"
  fi
  dev="$(device)"
  old="$(tang_slots "$dev" | cut -d' ' -f1 | sort -un)"
  # The existing passphrase once, for every binding (clevis would ask for each).
  if [ -n "${PASSWORD+x}" ]; then pt="$PASSWORD"
  else
    [ -t 0 ] || die "the disk's passphrase is needed: run it in a terminal"
    IFS= read -rsp "The disk's passphrase (as typed at boot): " pt; echo
  fi
  # Not handed on to clevis, curl and the rest in their environment.
  unset PASSWORD
  printf '%s' "$pt" | cryptsetup open --test-passphrase --key-file - "$dev" 2> /dev/null || die "that isn't the disk's passphrase; nothing changed"
  # Stopped part way (Ctrl-C, a dropped SSH session): the bindings this run made go again.
  trap 'pt=""; undo_new "$dev" "$old"; die "stopped; the bindings made before stay as they were"' INT TERM HUP
  while [ $# -gt 0 ]; do
    url="$1" thp="$2"; shift 2
    url_ok "$url" || die "not a tang server address: $url"
    thp_ok "$thp" || die "not a SHA-256 key thumbprint (43 characters, as tang-show-keys prints it): $thp"
    pairs+=("$url $thp")
    cfg="$(jq -cn --arg u "$url" --arg t "$thp" '{url: $u, thp: $t}')"
    if [ "$mode" = and ]; then
      # TPM and tang: both shares of two are needed. PCR 7 is the Secure Boot state, as halogen-enroll-tpm.
      cfg="$(jq -cn --argjson t "$cfg" '{t: 2, pins: {tpm2: {pcr_bank: "sha256", pcr_ids: "7"}, tang: [$t]}}')"
      printf '%s' "$pt" | clevis luks bind -f -k - -d "$dev" sss "$cfg" || rc=$?
    else
      printf '%s' "$pt" | clevis luks bind -f -k - -d "$dev" tang "$cfg" || rc=$?
    fi
    [ "$rc" = 0 ] || break
  done
  # "or" means the TPM alone unlocks too: enroll it when it isn't (as halogen-enroll-tpm does).
  if [ "$rc" = 0 ] && [ "$mode" = or ] && [ -z "$(tpm_tokens "$dev")" ]; then
    PASSWORD="$pt" systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=7 "$dev" > /dev/null || rc=$?
    url="the TPM"
  fi
  pt=""
  if [ "$rc" != 0 ]; then
    undo_new "$dev" "$old"
    die "binding to ${url} failed (above); nothing changed"
  fi
  trap - INT TERM HUP
  # The keys bound, for renew and the selftest (written whole, then moved in).
  mkdir -p "$(dirname "$record")"
  ( umask 077; printf '%s\n' "${pairs[@]}" > "$record.new" ) && mv -f "$record.new" "$record" \
    || echo "couldn't record the servers' keys in $record; renew will ask for them again" >&2
  # The new bindings work; then the old ones go, as halogen-enroll-tpm replaces its binding.
  for s in $old; do clevis luks unbind -f -d "$dev" -s "$s" > /dev/null || echo "couldn't remove the old binding in slot $s" >&2; done
  if [ "$mode" != or ]; then
    remove_tpm "$dev" || die "the tang binding is made, but the TPM-only unlock couldn't be removed, so the TPM alone still unlocks the disk. Run it again, or see: sudo halosctl tang-unlock"
  fi
}

remove() {
  local dev s
  dev="$(device)"
  for s in $(tang_slots "$dev" | cut -d' ' -f1 | sort -un); do clevis luks unbind -f -d "$dev" -s "$s" > /dev/null; done
  rm -f "$record"
}

# The recorded keys of the servers bound now: a record that names another server set is stale.
bound() {
  local dev urls rec
  dev="$(device)"
  urls="$(tang_slots "$dev" | cut -d' ' -f3 | sort -u)"
  [ -n "$urls" ] && [ -f "$record" ] && [ ! -L "$record" ] || return 0
  rec="$(head -c 8192 "$record" | clean)"
  while read -r u t; do url_ok "$u" && thp_ok "$t" || return 0; done <<< "$rec"
  [ "$(cut -d' ' -f1 <<< "$rec" | sort -u)" = "$urls" ] || return 0
  printf '%s\n' "$rec"
}

status() {
  local dev mode slots
  dev="$(device 2> /dev/null)" || { [ "${1:-}" = --short ] && echo off || echo "Off: the disk isn't encrypted."; return 0; }
  # mode_of exits 3 on a clevis binding it can't read (made by hand or another tool): say so,
  # rather than stop here with nothing printed (set -e).
  mode="$(mode_of "$dev")" || mode=unknown
  if [ "$mode" = unknown ]; then
    if [ "${1:-}" = --short ]; then echo unknown
    else echo "Unknown: $dev has a clevis binding halOS can't read. See: sudo clevis luks list -d $dev"; fi
    return 0
  fi
  slots="$(tang_slots "$dev")"
  if [ "${1:-}" = --short ]; then
    if [ -z "$mode" ]; then echo off; else echo "on $mode $(cut -d' ' -f3 <<< "$slots" | sort -u | paste -sd' ' -)"; fi
    return 0
  fi
  if [ -z "$mode" ]; then echo "Off: no tang server unlocks $dev."; return 0; fi
  case "$mode" in
    and) echo "On: $dev unlocks at boot when this machine's TPM agrees and a tang server answers." ;;
    or) echo "On: $dev unlocks at boot with the TPM, or else when a tang server answers." ;;
    off) echo "On: $dev unlocks at boot when a tang server answers (no TPM)." ;;
  esac
  cut -d' ' -f3 <<< "$slots" | sort -u | sed 's/^/  server: /'
  echo "  Without them it asks for the passphrase, at the keyboard or over SSH (sudo halosctl ssh-unlock)."
}

cmd="${1:-status}"; [ $# = 0 ] || shift
case "$cmd" in
  device) device ;;
  thumbprints) [ $# = 1 ] || die "thumbprints <url>"; thumbprints "$1" ;;
  bound) bound ;;
  secure-boot) secure_boot ;;
  bind) bind "$@" ;;
  remove) remove ;;
  mode) d="${1:-$(device)}"; mode_of "$d" ;;   # exit 3: unknown
  status) status "${1:-}" ;;
  *) die "unknown command: $cmd" ;;
esac
