#!/usr/bin/python3 -I
# tool-eval-bench (github.com/SeraphimSerapis/tool-eval-bench, MIT), the tool-calling benchmark
# behind `halogenctl bench tools`, from its pinned source in /usr/lib/halos/tool-eval-bench.
# -I: no user site folder, no current folder on the path, no PYTHON* variables.
import ctypes
import sys

import dotenv

# Its CLI reads a .env file in the current folder or any folder above it, which could add a
# proxy (and send the API key through it) or headers. halOS passes everything on the command
# line, so no .env file is ever read (security audit of #173).
dotenv.load_dotenv = lambda *args, **kwargs: False

# Not dumpable: a crash record (systemd-coredump) would put the environment, the API key
# included, in the journal, and /proc/<pid>/environ becomes root's (as the dashboard, #101).
if ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0) != 0:  # PR_SET_DUMPABLE, 0
    sys.exit("tool-eval-bench: cannot make the process non-dumpable")

sys.path.insert(0, "/usr/lib/halos/tool-eval-bench")
from tool_eval_bench.cli.bench import main  # noqa: E402

sys.exit(main())
