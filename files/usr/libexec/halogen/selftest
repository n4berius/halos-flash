#!/bin/bash
# The beta hardware checklist in one command. Run as root by: halogenctl selftest
# It only reads: it changes nothing, restarts nothing and prints no secret, serial number or
# network address, so its output can be shared as it is.
set -uo pipefail
release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
sys="${HALOGEN_SYSFS:-/sys}"
dev="${HALOGEN_DEV:-/dev}"
cmdline="${HALOGEN_CMDLINE:-/proc/cmdline}"
meminfo="${HALOGEN_MEMINFO:-/proc/meminfo}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
logs="${HALOGEN_LOGS_DIR:-/srv/logs}"
records_dropin="${HALOGEN_RECORDS_DROPIN:-/etc/containers/systemd/users/970/halogen.container.d/20-records.conf}"
clock="${HALOGEN_CLOCK:-/usr/libexec/halogen/halogen-fabric-clock}"
port="${HALOGEN_API_PORT:-8731}"
# Halogen itself, behind halos-proxy (Caddy) on this machine only.
local_port="${HALOS_API_LOCAL_PORT:-18731}"
# shellcheck disable=SC1090
. "$release"
npu=0; [ "${HALOGEN_VARIANT:-}" = npu ] && npu=1
fails=0; warns=0; passes=0; skips=0

say() {
  case "$1" in
    PASS) passes=$((passes + 1)) ;; FAIL) fails=$((fails + 1)) ;;
    WARN) warns=$((warns + 1)) ;; SKIP) skips=$((skips + 1)) ;;
  esac
  # Some of what is reported comes from scripts run as halogen: no control characters (but tab
  # and line breaks) reach root's terminal.
  printf '%-4s %s: %s\n' "$1" "$2" "$(printf '%s' "$3" | tr -d '\000-\010\013-\037\177')"
}
have() { command -v "$1" > /dev/null 2>&1; }
# Every outside command gets a time limit, so one stuck tool can't stop the report.
# Files the halogen user owns are read as halogen, never as root (see prepare).
as_owner() { runuser -u halogen -- "$@" 2>/dev/null; }
# No input: some of these run as halogen, and must not get root's terminal.
run() { timeout "${HALOGEN_SELFTEST_TIMEOUT:-20}" "$@" < /dev/null 2>&1; }

echo "halOS self-check, $(date -u '+%Y-%m-%d %H:%M UTC')"
echo "Edition: ${HALOGEN_VARIANT:-unknown}, Halogen ${HALOGEN_VERSION:-unknown}"
echo "Board: $(cat "$sys/class/dmi/id/board_vendor" "$sys/class/dmi/id/board_name" 2>/dev/null | paste -sd' ' -), BIOS $(cat "$sys/class/dmi/id/bios_version" 2>/dev/null)"
echo "Kernel: $(uname -r)"
images=""
if have bootc; then
  images="$(run bootc status --format=humanreadable)"
  echo "Images:"; printf '%s\n' "$images" | grep -iE 'booted|rollback|staged|image|version' | sed 's/^/  /' | head -n 8
fi
echo

# --- Boot and kernel
if have mokutil; then
  out="$(run mokutil --sb-state)"
  case "$out" in
    *"SecureBoot enabled"*) say PASS secure-boot "Secure Boot is on" ;;
    *) say WARN secure-boot "Secure Boot is not on ($(printf '%s' "$out" | head -n 1))" ;;
  esac
else say SKIP secure-boot "mokutil is not installed"; fi

# halOS images are signed (#46): bootc checks them only when the image spec asks it to and the
# policy requires halOS's key. Installs from before turn it on with their next halosctl upgrade.
policy="${HALOS_POLICY:-/etc/containers/policy.json}"
if have bootc && have jq; then
  # stderr apart: a bootc warning would break the JSON.
  spec="$(timeout "${HALOGEN_SELFTEST_TIMEOUT:-20}" bootc status --format=json --format-version=1 2>/dev/null < /dev/null |
    jq -r '.spec.image // {} | "\(.signature // "" | if type == "string" then . else "other" end) \(.image // "")"' 2>/dev/null)"
  sig="${spec%% *}"; followed="${spec#* }"
  if ! jq -e '.default == [{"type": "reject"}] and any(.transports.docker["ghcr.io/n4berius/halos-flash"][]?; .type == "sigstoreSigned")' "$policy" > /dev/null 2>&1; then
    say WARN image-signatures "$policy doesn't require halOS's signature; restore it: sudo cp /usr/etc/containers/policy.json /etc/containers/policy.json"
  elif [ "$sig" = containerPolicy ] && [[ "$followed" =~ ^ghcr\.io/n4berius/halos-flash[:@] ]]; then
    say PASS image-signatures "updates are taken only when signed with halOS's key"
  elif [ "$sig" = containerPolicy ]; then
    say WARN image-signatures "this machine follows an image that isn't halOS's ($(printf '%s' "$followed" | head -c 80)), so no signature is checked"
  else say WARN image-signatures "updates aren't checked for halOS's signature yet (bootc: ${sig:-unknown}); the next sudo halosctl upgrade turns it on"; fi
else say SKIP image-signatures "bootc or jq is not installed"; fi
# The files the check depends on are halOS's own: /etc is changeable, /usr/etc holds the image's
# copies. A policy in root's home would take the place of the system one for bootc's pulls.
etc="${HALOS_ETC:-/etc}"; usretc="${HALOS_USR_ETC:-/usr/etc}"
changed=""
for f in containers/policy.json containers/registries.d/halos-flash.yaml pki/containers/halos-flash.pub; do
  [ -e "$usretc/$f" ] || continue
  cmp -s "$etc/$f" "$usretc/$f" || changed+=" /etc/$f"
done
# The same for auditd's whole folder (rules, auditd.conf, plugins: programs auditd runs as root) and
# for how Halogen's container is started.
cchanged=""
while IFS= read -r f; do
  cmp -s "$etc/$f" "$usretc/$f" || cchanged+=" /etc/$f"
done < <(cd "$usretc" 2>/dev/null && find audit containers/systemd ! -type d 2>/dev/null | head -n 200)
# Anything halOS's image doesn't have, in /etc/audit or among the Quadlet files, changes them too.
# Excused by full path, not by name: only the one drop-in "halogenctl records on" writes, and it
# must hold exactly that mount.
rec="containers/systemd/users/970/halogen.container.d/20-records.conf"
extra=""
while IFS= read -r f; do
  [ -e "$usretc/$f" ] || [ "$f" = "$rec" ] || extra+="/etc/$f "
done < <(cd "$etc" 2>/dev/null && find audit containers/systemd ! -type d 2>/dev/null | head -n 200 | tr -cd '[:print:]\n')
if [ -e "$etc/$rec" ] && [ "$(grep -v -e '^#' -e '^$' -e '^\[Container\]$' "$etc/$rec")" != 'Volume=/srv/logs/halogen:/records:noexec,nosuid,nodev' ]; then extra+="/etc/$rec (not what halogenctl records on writes) "; fi
if [ ! -e "$usretc/audit/rules.d/50-halos.rules" ]; then
  say SKIP config-files "the image's copies in $usretc are missing, so there is nothing to compare with"
elif [ -n "$cchanged" ]; then
  say WARN config-files "changed from halOS's copy:$cchanged (restore each with: sudo cp /usr/etc/<path> /etc/<path>, then reboot)"
elif [ -n "$extra" ]; then
  say WARN config-files "files halOS didn't put there add audit rules or change Halogen's container: $extra"
else say PASS config-files "the audit rules and Halogen's container definition are the image's own"; fi
rootpolicy="${HALOS_ROOT_POLICY:-/root/.config/containers/policy.json}"
if [ ! -e "$usretc/containers/policy.json" ]; then
  say SKIP signature-files "the image's copies in $usretc are missing, so there is nothing to compare with"
elif [ -n "$changed" ]; then
  say WARN signature-files "changed from halOS's copy:$changed (restore each with: sudo cp /usr/etc/<path> /etc/<path>)"
elif [ -e "$rootpolicy" ]; then
  say WARN signature-files "$rootpolicy replaces the system's signature policy for root; remove it unless you meant it"
else say PASS signature-files "the signature policy, registry settings and halOS's key are the image's own"; fi

line="$(cat "$cmdline")"
for want in amdgpu.gttsize=126976 ttm.pages_limit=32505856; do
  case " $line " in *" $want "*) say PASS "kernel-${want%%=*}" "$want is set" ;;
    *) say FAIL "kernel-${want%%=*}" "$want is missing from the kernel command line" ;; esac
done
if [ "$npu" = 1 ]; then
  case " $line " in *" iommu=pt "*) say PASS kernel-iommu "iommu=pt keeps the NPU available" ;;
    *) say FAIL kernel-iommu "iommu=pt is missing; the NPU needs the IOMMU on" ;; esac
  case " $line " in *" amd_iommu=off "*) say FAIL kernel-iommu-off "amd_iommu=off disables the NPU" ;; esac
else
  case " $line " in *" amd_iommu=off "*) say PASS kernel-iommu "amd_iommu=off, for the no-NPU edition's faster prefill" ;;
    *) say WARN kernel-iommu "amd_iommu=off is missing; prefill is 13-16% slower without it" ;; esac
fi

mem_gib="$(awk '$1 == "MemTotal:" { printf "%d", $2 / 1048576 }' "$meminfo")"
if [ "${mem_gib:-0}" -ge 100 ]; then say PASS memory "the OS sees ${mem_gib} GiB"
else say FAIL memory "the OS sees ${mem_gib:-0} GiB; set the BIOS UMA frame buffer to its minimum, not Auto"; fi

# --- System health
if have systemctl; then
  out="$(run systemctl --failed --no-legend --plain | awk 'NF { print $1 }')"
  if [ -z "$out" ]; then say PASS failed-units "no failed system services"
  else say FAIL failed-units "failed: $(printf '%s' "$out" | paste -sd' ' -)"; fi
fi
if have getenforce; then
  mode="$(run getenforce)"
  if [ "$mode" = Enforcing ]; then say PASS selinux "SELinux is enforcing"
  else say WARN selinux "SELinux is $mode"; fi
fi
if have journalctl; then
  # The image has no audit daemon: journald keeps the audit records, and the kernel log may hold
  # copies. Only the denial, the program and the SELinux types are shown, never paths or
  # addresses, and a denial logged twice counts once.
  out="$(run journalctl -b --no-pager -o cat _TRANSPORT=audit + _TRANSPORT=kernel)"
  # bootc tests its own SELinux rights at every run (halosctl version, the login status): it runs
  # chcon with a label no policy has, invalid_bootcinstall_testlabel_t, expecting the refusal
  # (bootc's lsm.rs). That denial is followed within a few records by the SELINUX_ERR naming the
  # label, so a chcon mac_admin denial is dropped only when that line follows it within 4 records;
  # each such line drops one denial, the latest held, so another chcon denial just before stays.
  denials="$(printf '%s\n' "$out" | awk '
    /avc: +denied +\{ mac_admin \}/ && /comm="chcon"/ { held[++n] = $0; left = 4; next }
    /invalid_context="[^"]*:invalid_bootcinstall_testlabel_t:/ { if (n) n--; next }
    { print; if (n && --left == 0) { for (i = 1; i <= n; i++) print held[i]; n = 0 } }
    END { for (i = 1; i <= n; i++) print held[i] }' | grep -E 'avc: +denied' | while IFS= read -r l; do
    printf '%s\n' "$l" | grep -oE 'avc: +denied +\{[^}]*\}|comm="[^"]*"|scontext=[^ ]+|tcontext=[^ ]+|tclass=[^ ]+' | paste -sd' ' -
  done | sort -u)"
  if [ -z "$denials" ]; then say PASS selinux-denials "no SELinux denials since boot"
  else
    say FAIL selinux-denials "$(printf '%s\n' "$denials" | wc -l) different denials since boot, for example:"
    printf '%s\n' "$denials" | head -n 5 | sed 's/^/       /'
  fi
  missing="$(printf '%s\n' "$out" | sed -nE 's/.*[Ff]irmware load for ([^ ]+) failed.*/\1/p; s/.*failed to load (firmware )?([^ ]+).*/\2/p' | sort -u)"
  if [ -z "$missing" ]; then say PASS firmware "no missing firmware reported since boot"
  else
    say WARN firmware "missing firmware reported (a removed firmware package may be needed):"
    printf '%s\n' "$missing" | head -n 8 | sed 's/^/       /'
  fi
fi
if have firewall-cmd && [ "$(run firewall-cmd --state)" != running ]; then
  say FAIL firewall "firewalld is not running: sudo systemctl start firewalld"
elif have firewall-cmd; then
  zone="$(run firewall-cmd --get-default-zone)"
  services="$(run firewall-cmd --zone="$zone" --list-services)"
  case " $services " in *" halogen "*) say PASS firewall "port $port is open in the $zone zone (open: $services)" ;;
    *) say FAIL firewall "the halogen service is not open in the $zone zone (open: $services)" ;; esac
fi

# --- Disk encryption
crypt="$(lsblk -rno PATH,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')"
if [ -z "$crypt" ]; then
  say INFO luks "no encrypted volume (fine if you chose not to encrypt)"
else
  say PASS luks "encrypted: $(printf '%s' "$crypt" | paste -sd' ' -)"
  for d in $crypt; do
    out="$(run cryptsetup luksDump "$d")"
    tokens="$(printf '%s\n' "$out" | grep -cE '^[[:space:]]*[0-9]+: systemd-tpm2' || true)"
    case "$tokens" in
      1) say PASS luks-tpm "$d unlocks with the TPM (one binding)" ;;
      0) say INFO luks-tpm "$d asks for its passphrase at boot. To unlock with the TPM: sudo halogen-enroll-tpm" ;;
      *) say WARN luks-tpm "$d has $tokens TPM bindings; run sudo halogen-enroll-tpm to keep one" ;;
    esac
  done
  # Unlock over SSH at boot (#13), the way when the TPM can't.
  st="$(run "${HALOS_SSH_UNLOCK:-/usr/libexec/halogen/ssh-unlock}" status --short | head -n 1)"
  case "$st" in
    "on "*)
      rc=0; run "${HALOS_SSH_UNLOCK:-/usr/libexec/halogen/ssh-unlock}" verify > /dev/null || rc=$?
      case "$rc" in
        0) say PASS ssh-unlock "the disk can also be unlocked over SSH at boot (${st#on } key(s), as recorded); details: sudo halosctl ssh-unlock" ;;
        124) say WARN ssh-unlock "reading the EFI partition took too long; run it again" ;;
        2) say INFO ssh-unlock "unlocks over SSH at boot (${st#on } key(s)); keep their fingerprints to notice a change: sudo halosctl ssh-unlock record" ;;
        *) say WARN ssh-unlock "the SSH unlock keys or host key on the EFI partition differ from the record on the encrypted disk; check: sudo halosctl ssh-unlock" ;;
      esac ;;
    off) say INFO ssh-unlock "not set up; to type the passphrase from another computer at boot: sudo halosctl ssh-unlock on" ;;
    *) say WARN ssh-unlock "its state couldn't be read: $st" ;;
  esac
fi
if [ -e "$dev/tpmrm0" ] || [ -e "$dev/tpm0" ]; then say PASS tpm "a TPM is present"
else say INFO tpm "no TPM found"; fi

# --- GPU and NPU access
group_of() { stat -c %G "$1" 2>/dev/null; }
if [ -e "$dev/kfd" ]; then
  g="$(group_of "$dev/kfd")"
  if [ "$g" = halogen ]; then say PASS gpu-kfd "$dev/kfd belongs to the halogen group"
  else say FAIL gpu-kfd "$dev/kfd belongs to group $g, not halogen"; fi
else say FAIL gpu-kfd "$dev/kfd is missing, so the GPU driver is not ready"; fi
render=""
for r in "$dev"/dri/renderD*; do [ -e "$r" ] && render="$r" && break; done
if [ -n "$render" ]; then
  g="$(group_of "$render")"
  if [ "$g" = halogen ]; then say PASS gpu-render "$render belongs to the halogen group"
  else say FAIL gpu-render "$render belongs to group $g, not halogen"; fi
else say FAIL gpu-render "no GPU render node in $dev/dri"; fi
if have amd-smi; then
  out="$(run amd-smi list)"; rc=$?
  if [ "$rc" = 0 ] && [[ $'\n'"$out" == *$'\n'"GPU: "[0-9]* ]]; then say PASS amd-smi "amd-smi sees the GPU"
  else say WARN amd-smi "amd-smi sees no GPU: $(printf '%s\n' "$out" | tail -n 1 | cut -c1-120)"; fi
fi
if [ "$npu" = 1 ]; then
  if [ -e "$dev/accel/accel0" ]; then
    g="$(group_of "$dev/accel/accel0")"
    label="$(stat -c %C "$dev/accel/accel0" 2>/dev/null)"
    if [ "$g" = halogen ]; then say PASS npu-device "$dev/accel/accel0 belongs to the halogen group"
    else say FAIL npu-device "$dev/accel/accel0 belongs to group $g, not halogen"; fi
    case "$label" in *:dri_device_t:*) say PASS npu-label "the NPU has the SELinux type the container may use" ;;
      *) say FAIL npu-label "the NPU's SELinux label is $label, not dri_device_t" ;; esac
  else say FAIL npu-device "$dev/accel/accel0 is missing; check the IOMMU and NPU firmware"; fi
  if "$clock" status > /dev/null 2>&1; then say PASS fabric-clock "the GPU fabric clock is held"
  else say FAIL fabric-clock "the GPU fabric clock is not held: systemctl status halogen-fabric-clock"; fi
fi
# The firmware's power profile, as chosen with halosctl power (performance when none is chosen).
if [ -r "$sys/firmware/acpi/platform_profile" ]; then
  pnow="$(tr -cd 'a-z-' < "$sys/firmware/acpi/platform_profile")"; pwant=""
  [ ! -r "${HALOS_PROFILE_FILE:-/etc/halos/platform-profile}" ] || pwant="$(tr -cd 'a-z-' < "${HALOS_PROFILE_FILE:-/etc/halos/platform-profile}")"
  pwant="${pwant:-performance}"
  if [ "$pnow" = "$pwant" ]; then say PASS power-profile "the firmware power profile is $pnow, as chosen"
  else say WARN power-profile "the firmware power profile is $pnow, not $pwant as chosen: sudo halosctl power $pwant"; fi
else say SKIP power-profile "the firmware offers no power profile"; fi

# --- Halogen
if have systemctl; then
  state="$(run systemctl is-active halogen-prepare.service)"
  if [ "$state" = active ]; then say PASS prepare "halogen-prepare ran"
  else say FAIL prepare "halogen-prepare is $state"; fi
  user() { run systemctl --user --machine=halogen@.host "$@"; }
  state="$(user is-active halogen.service)"
  running=0; [ "$state" = active ] && running=1
  case "$state" in
    active) say PASS server "Halogen is running" ;;
    activating|deactivating) say WARN server "Halogen is $state; follow it with sudo halogenctl fetch-logs or logs" ;;
    # Just after boot Halogen waits, inactive, with a start queued until the fetch step is done.
    inactive)
      job="$(user show -p Job --value halogen.service)"; fetch="$(user is-active halogen-fetch.service)"
      case "$job" in ''|*[!0-9]*) job="" ;; esac
      if as_owner test -e "${HALOGEN_STATE_DIR:-/var/lib/halogen}/setup-pending"; then
        say WARN server "Halogen waits for first-boot setup: sudo halosctl setup (or --skip). Without it, it starts by itself within 30 minutes"
      elif [ "$fetch" = failed ]; then
        say FAIL server "the download and check step failed, so Halogen did not start; see sudo halogenctl fetch-logs"
      elif [ -n "$job" ] || [ "$fetch" = activating ]; then
        say WARN server "Halogen is waiting for the download and check step; follow it with sudo halogenctl fetch-logs and run this again when it is done"
      else say FAIL server "Halogen is stopped; start it with sudo halogenctl start, see sudo halogenctl logs"; fi ;;
    *) say FAIL server "Halogen is $state; see sudo halogenctl logs" ;;
  esac
fi
if [ -f "$models/.fetch-stamp" ]; then say PASS models "the models for this release are downloaded and checked"
else say WARN models "the models are not all downloaded yet; see sudo halogenctl fetch-logs"; fi
if have systemd-run; then
  out="$(run systemd-run --machine=halogen@.host --user --pipe --wait --quiet --setenv=HALOGEN_SERVER_RUNNING="${running:-0}" /usr/libexec/halogen/preflight)"
  case "$out" in *"preflight: ok"*) say PASS preflight "Halogen's own host checks pass" ;;
    *) why="$(printf '%s\n' "$out" | grep -E 'FAIL|warning' | paste -sd';' -)"
       say FAIL preflight "$(printf '%s' "${why:-$(printf '%s\n' "$out" | tail -n 1)}" | cut -c1-200)" ;; esac
fi

# halos-proxy (Caddy) answers the network on 8731 and 8732; the API checks below go through it.
if have systemctl; then
  # Any HTTP answer counts (Halogen may still be starting): it is Caddy that must answer.
  pcode="$(curl -sS -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/health" 2>/dev/null)"
  if [ "$(run systemctl is-active halos-proxy.service)" = active ] && [ -n "$pcode" ] && [ "$pcode" != 000 ]; then
    say PASS proxy "Caddy answers on 8731 (API) and 8732 (dashboard)"
  else say FAIL proxy "halos-proxy.service isn't running, so nothing answers on 8731 or 8732: sudo systemctl status halos-proxy"; fi
fi
# HTTPS (sudo halosctl https): which mode, whether Caddy answers in it, and its certificate.
front=http; insecure=()
https="${HALOS_HTTPS_HELPER:-/usr/libexec/halogen/https}"
if [ -x "$https" ] && have curl; then
  facts="$(run "$https" describe)"
  fact() { sed -n "s/^$1 //p" <<< "$facts"; }
  case "$(fact mode)" in
    self-signed)
      front=https; insecure=(-k)
      cafile="$(mktemp)"
      if [ "$(fact ca)" = none ] || ! run "$https" ca > "$cafile"; then
        say WARN https "on (self-signed), but Caddy hasn't made its authority yet: sudo systemctl status halos-proxy"
      elif code="$(curl -sS -m 5 --cacert "$cafile" -o /dev/null -w '%{http_code}' "https://127.0.0.1:$port/health" 2>/dev/null)" && [ "$code" != 000 ]; then
        say PASS https "on, self-signed; authority's fingerprint $(fact ca | cut -c1-23)… (sudo halosctl https)"
      else say WARN https "on (self-signed), but 127.0.0.1:$port doesn't answer with halOS's authority: sudo journalctl -u halos-proxy"; fi
      rm -f "$cafile"
      # The certificate covers the addresses Caddy saw when it started; halos-https-refresh.timer
      # restarts it within a minute for a new one.
      missing="$(run "$https" uncovered | paste -sd' ' -) "
      if [ -n "${missing% }" ]; then say WARN https-names "not covered by the certificate yet: ${missing% } (halos-https-refresh.timer restarts Caddy within a minute; now: sudo systemctl restart halos-proxy)"; fi ;;
    custom)
      front=https; insecure=(-k)
      if [ "$(fact expires)" = ended ]; then
        say FAIL https "your certificate ($(fact subject)) ended $(fact until), so apps refuse it: sudo halosctl https custom <new certificate> <key>"
      elif [ "$(fact expires)" != later ]; then
        say WARN https "your certificate ($(fact subject)) expires $(fact until), within 14 days: sudo halosctl https custom <new certificate> <key>"
      elif code="$(curl -sS -k -m 5 -o /dev/null -w '%{http_code}' "https://127.0.0.1:$port/health" 2>/dev/null)" && [ "$code" != 000 ]; then
        say PASS https "on, with your certificate for $(fact subject), until $(fact until)"
      else say WARN https "on (your certificate), but 127.0.0.1:$port doesn't answer over HTTPS: sudo journalctl -u halos-proxy"; fi ;;
    letsencrypt)
      front=https; insecure=(-k)
      first="$(fact public)"; first="${first%% *}"
      if [ "$(fact until)" = none ]; then
        say FAIL https "on (Let's Encrypt for $(fact public)), but Caddy serves no certificate for $first yet: sudo journalctl -u halos-proxy"
      elif [ "$(fact expires)" = ended ]; then
        say FAIL https "the Let's Encrypt certificate for $first ended $(fact until), so renewing failed: sudo journalctl -u halos-proxy"
      elif [ "$(fact expires)" != later ]; then
        say WARN https "the Let's Encrypt certificate for $first ends $(fact until), within 10 days, so renewing is failing: sudo journalctl -u halos-proxy"
      elif [ "$(fact staging)" = yes ]; then
        say WARN https "on, with Let's Encrypt's staging (test) certificate for $first, which apps don't trust: sudo halosctl https letsencrypt $(fact provider) $(fact public)"
      # Checked as an app would: the system's trust store, the name, the chain.
      elif code="$(curl -sS -m 5 --resolve "$first:$port:127.0.0.1" -o /dev/null -w '%{http_code}' "https://$first:$port/health" 2>/dev/null)" && [ "$code" != 000 ]; then
        say PASS https "on, Let's Encrypt for $(fact public) (DNS: $(fact provider)), until $(fact until)"
      else say WARN https "on (Let's Encrypt), but $first:$port doesn't answer with a certificate this machine trusts: sudo journalctl -u halos-proxy"; fi
      missing="$(run "$https" uncovered | paste -sd' ' -) "
      if [ -n "${missing% }" ]; then say WARN https-names "local addresses not covered by halOS's authority yet: ${missing% } (halos-https-refresh.timer restarts Caddy within a minute)"; fi ;;
    invalid) say FAIL https "HALOS_HTTPS in /etc/halos/https.env isn't off, self-signed, custom or letsencrypt, so Caddy won't start: sudo halosctl https off, or self-signed" ;;
    *) say INFO https "off: apps use plain http:// (sudo halosctl https self-signed turns it on)" ;;
  esac
fi
# Halogen directly on 127.0.0.1, and IPv6 through Caddy (Halogen itself is published on IPv4 only).
# Through Caddy in HTTPS mode, the certificate isn't the question here (the https check is).
health() { curl -sS -g -m 5 "${@:2}" -o /dev/null -w '%{http_code}' "$1/health" 2>/dev/null; }
if have curl; then
  code="$(health "http://127.0.0.1:$local_port")"
  # While Halogen isn't running (first boot is still downloading), the API can't answer yet.
  miss=FAIL; [ "${running:-0}" = 1 ] || miss=WARN
  if [ "$code" = 200 ]; then say PASS api-ipv4 "Halogen answers on 127.0.0.1:$local_port"
  else say "$miss" api-ipv4 "Halogen does not answer on 127.0.0.1:$local_port (${code:-no answer})"; fi
  code="$(health "$front://[::1]:$port" "${insecure[@]}")"
  if [ "$code" = 200 ]; then say PASS api-ipv6 "the API answers on [::1]:$port through Caddy"
  else say WARN api-ipv6 "Caddy does not pass the API on [::1]:$port (${code:-no answer}); fine if IPv6 is off"; fi
  if [ -r "$configs/api-key" ]; then
    # The key goes in a private file, so it never shows in the process list or the report.
    header="$(mktemp)"; trap 'rm -f "$header"' EXIT
    printf 'Authorization: Bearer %s\n' "$(as_owner cat "$configs/api-key")" > "$header"
    out="$(curl -sS -m 10 -H @"$header" "http://127.0.0.1:$local_port/v1/models" 2>/dev/null)"
    rm -f "$header"
    ids="$(printf '%s' "$out" | python3 -c 'import json,sys; print(" ".join(m["id"] for m in json.load(sys.stdin)["data"]))' 2>/dev/null)"
    if [ -n "$ids" ]; then say PASS api-models "serving: $ids"
    else say "$miss" api-models "the API key was not accepted, or no models are served"; fi
  fi
fi

# --- Dashboard (halos-dashboard.service, Quaternion's halogen-dashboard on port 8732)
if have systemctl && have curl; then
  if [ "$(run systemctl is-enabled halos-dashboard.service)" != enabled ]; then
    say INFO dashboard "off; a live page of Halogen's load on port 8732: sudo halosctl dashboard on"
  elif [ "$(curl -sS -m 5 "${insecure[@]}" -o /dev/null -w '%{http_code}' "$front://127.0.0.1:8732/healthz" 2>/dev/null)" = 200 ]; then
    say PASS dashboard "answers on port 8732 (state and address: sudo halosctl dashboard)"
    # The address filter and the IP counters are the same BPF program on its cgroup, which systemd
    # skips quietly when it can't load or attach it. The curl above went through that cgroup, so an
    # attached program has counted more than 0 bytes.
    ipin="$(run systemctl show -p IPIngressBytes --value halos-dashboard.service)"
    deny="$(run systemctl show -p IPAddressDeny --value halos-dashboard.service)"
    allow="$(run systemctl show -p IPAddressAllow --value halos-dashboard.service)"
    if [[ "$ipin" =~ ^[0-9]+$ ]] && [ "$ipin" != 0 ] && [ "$ipin" != 18446744073709551615 ] && [[ " $deny " == *" 0.0.0.0/0 "* ]]; then
      say PASS dashboard-filter "the address filter is on; the dashboard takes connections only from: ${allow:-nothing}"
    else say WARN dashboard-filter "the address filter isn't active, so the dashboard takes connections from anywhere; check the kernel's BPF support and any drop-in: systemctl cat halos-dashboard"; fi
    # Not dumpable (dashboard-nodump.so): the kernel then gives the process's /proc files to root.
    pid="$(run systemctl show -p MainPID --value halos-dashboard.service)"
    if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [ "$(stat -c %u "/proc/$pid/environ" 2>/dev/null)" = 0 ]; then
      say PASS dashboard-nodump "a crash can't put the API key in the journal"
    else say WARN dashboard-nodump "the dashboard is dumpable, so a crash would put the API key in the journal: sudo systemctl restart halos-dashboard; if it stays, see systemctl cat halos-dashboard and journalctl -u halos-dashboard"; fi
  else say WARN dashboard "halos-dashboard.service doesn't answer on port 8732: sudo journalctl -u halos-dashboard"; fi
fi
# --- Model folders
old="$(find "$models/npu" -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9]+\.[0-9]+\.[0-9]+' -printf '%f ' 2>/dev/null)"
if [ "$npu" != 1 ] || [ ! -d "$models/npu" ]; then :
elif [ -z "$old" ]; then say PASS npu-folder "NPU models are in one folder"
else say WARN npu-folder "old version folders remain in $models/npu: $old(restart Halogen to move them)"; fi
if [ "$npu" = 1 ]; then
  for f in decider LFM custom; do
    d="$models/$f"
    if [ ! -d "$d" ]; then say FAIL "folder-$f" "$d is missing"; continue; fi
    owner="$(stat -c %U "$d")"; label="$(stat -c %C "$d" 2>/dev/null)"
    if [ "$owner" != halogen ]; then say FAIL "folder-$f" "$d belongs to $owner, not halogen"
    else case "$label" in *container_file_t*|'') say PASS "folder-$f" "$d is ready for your own checkpoints" ;;
      *) say FAIL "folder-$f" "$d has SELinux label $label, not container_file_t" ;; esac; fi
  done
fi
d="$models/flash"
if [ ! -d "$d" ]; then say FAIL folder-flash "$d is missing"
elif [ "$(stat -c %U "$d")" != halogen ]; then say FAIL folder-flash "$d belongs to $(stat -c %U "$d"), not halogen"
else
  label="$(stat -c %C "$d" 2>/dev/null)"
  case "$label" in *container_file_t*|'') say PASS folder-flash "$d is ready for your own Flash checkpoints" ;;
    *) say FAIL folder-flash "$d has SELinux label $label, not container_file_t" ;; esac
fi
# Which Flash checkpoint Halogen serves (halogenctl flash use), read as halogen like the rest.
flash="$(as_owner head -n 1 "$configs/flash-checkpoint" | tr -cd 'A-Za-z0-9._-')"
if [ -z "$flash" ] || [ "$flash" = official ]; then say INFO flash "serving the official Flash checkpoint"
else
  from="$(as_owner sed -n 's/^repo=//p' "$models/flash/$flash/halos.info" | tail -n 1 | tr -cd '[:print:]' | cut -c1-100)"
  # What Halogen gets: render-config serves the official checkpoint if yours is missing or failed.
  rendered="$(run systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config --show)"
  why="$(printf '%s\n' "$rendered" | grep '^halogen-config: .*official one' | tail -n 1 | sed 's/^halogen-config: //' | tr -cd '[:print:]')"
  if grep -q "^HALOGEN_CHECKPOINT=/models/flash/$flash/" <<< "$rendered"; then why=""
  elif [ -z "$why" ]; then why="see sudo halogenctl config"; fi
  if [ -n "$why" ]; then say WARN flash "you chose your own Flash checkpoint $flash, but Halogen serves the official one: $why"
  elif [ "${running:-1}" = 1 ]; then say INFO flash "serving your own Flash checkpoint $flash${from:+ ($from)}"
  else say WARN flash "your own Flash checkpoint $flash is chosen and Halogen is not running. If it refused it (sudo halogenctl logs), go back: sudo halogenctl flash use official"; fi
fi
meta="$models/.cache/huggingface/download/qwen38-flash-next-v2.hgn.metadata"
# Read as halogen: the fetch container writes this folder, so a link there must not reach root's files.
[ ! -r "$meta" ] || say INFO weights "downloaded from weights commit $(as_owner head -n 1 "$meta" | cut -c1-12); pinned: ${HALOGEN_WEIGHTS_REVISION:-unknown}"
free="$(df --output=avail --block-size=1G "$models" 2>/dev/null | tail -n 1 | tr -d ' ')"
[ -z "$free" ] || say INFO disk "${free} GiB free for models"
# Halogen's container is read-only; its scratch folders must be on disk, not in memory (a prompt-cache
# snapshot there can reach 26.6 GiB). Asked inside the running container, as halogen.
if [ "${running:-0}" = 1 ]; then
  # As halogen with setpriv, not through --machine=halogen@.host (that route failed on freyja), and
  # from / : setpriv keeps the caller's folder, and podman stops when halogen can't enter it (sudo
  # from an admin's home did that on freyja).
  huid="$(id -u halogen 2> /dev/null || echo 970)"
  # prlimit: podman exec applies the container's memlock limit (unlimited) to what it starts, and
  # halogen may not raise its own; root raises it before dropping to halogen (freyja: "crun:
  # setrlimit RLIMIT_MEMLOCK: Operation not permitted").
  fstypes="$(run prlimit --memlock=unlimited:unlimited -- setpriv --reuid="$huid" --regid="$huid" --clear-groups env -C / HOME=/var/lib/halogen XDG_RUNTIME_DIR="/run/user/$huid" \
    podman exec halogen stat -f -c '%n %T' /tmp /var/tmp /root | tr -cd '[:print:]\n')"
  if [ "$(grep -c -E '^/(tmp|var/tmp|root) ' <<< "$fstypes")" != 3 ]; then say WARN scratch "couldn't see where Halogen's /tmp, /var/tmp and /root are: ${fstypes:-no answer}"
  elif grep -q tmpfs <<< "$fstypes"; then say FAIL scratch "Halogen's scratch folders are in memory, not on disk: $(tr '\n' ' ' <<< "$fstypes")"
  else say PASS scratch "Halogen's /tmp, /var/tmp and /root are on disk"; fi
fi

# Halogen's request records (#107): the folder prepare makes, and whether recording is on.
d="$logs/halogen"
if [ ! -d "$d" ]; then say FAIL folder-logs "$d is missing (halogen-prepare makes it at boot)"
elif [ "$(stat -c %U "$d")" != halogen ]; then say FAIL folder-logs "$d belongs to $(stat -c %U "$d"), not halogen"
else
  label="$(stat -c %C "$d" 2>/dev/null)"
  where="its own volume"; [ "$(findmnt -n -o TARGET --target "$logs" 2>/dev/null)" = "$(readlink -f "$logs")" ] || where="the /var volume"
  case "$label" in *container_file_t*|'') say PASS folder-logs "$d is ready for request records, on $where" ;;
    *) say FAIL folder-logs "$d has SELinux label $label, not container_file_t" ;; esac
fi
# Halogen's own counts (written, dropped, size), when it answers; nothing when it doesn't record.
rr="$(curl -sS -m 5 "http://127.0.0.1:$local_port/health" 2>/dev/null | jq -c '.request_records // empty' 2>/dev/null | tr -cd '[:print:]' | cut -c1-200)"
if [ ! -f "$records_dropin" ]; then
  if [ -n "$rr" ]; then say WARN records "off, but Halogen still keeps records (an off cut short?): sudo halogenctl records off"
  else say INFO records "off (sudo halogenctl records on keeps a line per request, counts only)"; fi
else
  used="$(as_owner timeout "${HALOGEN_SELFTEST_TIMEOUT:-20}" du -sh "$d" | cut -f1 | tr -cd '[:print:]')"
  # The mount must be in halogen's generated unit; without it Halogen would write inside its container.
  # Asked over halogen's own socket, as halogenctl records does: systemctl cat refuses
  # --machine=halogen@.host ("Cannot remotely cat units"), so that reading always came back empty
  # and the line warned about a mount that was there (freyja).
  huid="$(id -u halogen 2> /dev/null || echo 970)"
  unit_text="$(run setpriv --reuid="$huid" --regid="$huid" --clear-groups env -C / XDG_RUNTIME_DIR="/run/user/$huid" systemctl --user cat halogen.service)"
  mounted="$(grep -c -F 'srv/logs/halogen:/records' <<< "$unit_text")"
  if [ "${mounted:-0}" = 0 ]; then say WARN records "on, but Halogen's service doesn't mount $d: sudo halogenctl records off, then on"
  elif [ -n "$rr" ]; then say PASS records "on, ${used:-?} in $d; Halogen reports $rr"
  elif [ "${running:-0}" = 1 ]; then say WARN records "on, but Halogen's /health has no request_records: is the mount in place? sudo halogenctl restart"
  else say INFO records "on, ${used:-?} in $d (Halogen isn't running)"; fi
fi
# The prompt cache on disk (Halogen's HALOGEN_CACHE_DIR): on unless sudo halogenctl cache off.
# Halogen refuses a folder on tmpfs or an overlay and then keeps the cache in memory only.
pc="$models/.prompt-cache"
if [ "$(as_owner head -n 1 "$configs/prompt-cache" | tr -cd '[:lower:]')" = off ]; then
  say INFO prompt-cache "off: conversations are read again in full after a restart (sudo halogenctl cache on)"
elif ! as_owner test -d "$pc"; then
  say WARN prompt-cache "$pc is missing, so Halogen can't start with it: sudo systemctl restart halogen-prepare.service"
else
  pcfs="$(as_owner stat -f -c %T "$pc" | tr -cd '[:alnum:]')"; pcused="$(run runuser -u halogen -- du -sh "$pc" 2>/dev/null | cut -f1 | tr -cd '[:alnum:].,')"
  case "$pcfs" in
    tmpfs|overlayfs|ramfs) say WARN prompt-cache "$pc is on $pcfs, which Halogen refuses: the cache stays in memory only" ;;
    *) say PASS prompt-cache "on, ${pcused:-?} in $pc (conversations survive a restart of Halogen)" ;;
  esac
fi

# --- Logs (#107): the audit log, the journal and room on /var/log
logdir="${HALOS_LOG_DIR:-/var/log}"
if have systemctl && have auditctl; then
  astate="$(run systemctl is-active auditd.service)"
  rules="$(run auditctl -l)"; astatus="$(run auditctl -s)"
  nrules="$(grep -c -E -- ' (-k |-F key=)' <<< "$rules")"
  afree="$(df --output=avail --block-size=1M "$logdir/audit" 2>/dev/null | tail -n 1 | tr -d ' ')"
  alost="$(sed -n 's/^lost \([0-9][0-9]*\)$/\1/p' <<< "$astatus" | head -n 1)"
  # Every rule halOS ships must be loaded (-i skips one that can't load). A file that doesn't
  # exist yet, such as /etc/ld.so.preload, is still watched through its folder, so only a missing
  # folder excuses a rule.
  amissing=""
  while read -r p; do
    [ -d "${p%/*}" ] || continue
    grep -q -E -- "(^-w |path=)$p " <<< "$rules" || amissing+=" $p"
  done < <(sed -n -E -e 's/^-w ([^ ]+) .*/\1/p' -e 's/^-a always,exit -F path=([^ ]+) .*/\1/p' "${HALOS_AUDIT_RULES:-/etc/audit/rules.d/50-halos.rules}" 2>/dev/null)
  # The login uid of Halogen's own service manager: the rule that leaves Halogen out of auditing
  # matches it. Anything but its own uid, and Halogen's processes are audited (slower).
  huid="$(id -u halogen 2> /dev/null || echo 970)"
  hmgr="$(run systemctl show -p MainPID --value "user@$huid.service")"
  hlogin="$(cat "${HALOGEN_PROC:-/proc}/$hmgr/loginuid" 2>/dev/null)"
  # The rules are locked (-e 2), so a fix on the running system isn't possible: a reboot loads them again.
  if [ "$astate" != active ]; then say WARN audit "auditd is $astate: sudo systemctl start auditd, and sudo journalctl -u auditd"
  elif grep -qx -- '-a never,task' <<< "$rules"; then say WARN audit "auditd runs with Fedora's rule that turns system-call auditing off, so halOS's watches see nothing: reboot to load halOS's rules"
  elif grep -qx 'enabled 0' <<< "$astatus"; then say WARN audit "auditd runs, but auditing is switched off in the kernel, so nothing is recorded: sudo auditctl -e 1, or reboot"
  elif [ -n "$amissing" ]; then say WARN audit "auditd runs, but halOS's rules for these aren't loaded:$amissing (reboot to load them; sudo journalctl -b -u audit-rules says why)"
  elif grep -q -- ',exclude' <<< "$rules"; then say WARN audit "a rule keeps some kinds of record out of the audit log (sudo auditctl -l | grep exclude), which halOS never sets: reboot to load halOS's rules"
  elif [ "$(grep -c -- '^-a never,' <<< "$rules")" -gt 1 ]; then say WARN audit "more than Halogen's own processes are left out of auditing (sudo auditctl -l | grep never): reboot to load halOS's rules"
  elif ! grep -qx -- "-a never,task -F uid=$huid -F auid=$huid" <<< "$rules"; then say WARN audit "auditd runs, but the rule that leaves Halogen's own processes out isn't loaded, so auditing may slow it: reboot to load halOS's rules"
  elif [ -n "$hlogin" ] && [ "$hlogin" != "$huid" ]; then say WARN audit "Halogen's service manager has login uid $hlogin, not $huid, so Halogen's own processes are audited, which may slow it: report this"
  elif grep -qx 'enabled 1' <<< "$astatus"; then say WARN audit "auditd runs with halOS's rules, but they aren't locked (root could switch auditing off unnoticed): reboot"
  elif [ -n "$afree" ] && [ "$afree" -lt "${HALOS_AUDIT_MIN_FREE_MB:-250}" ]; then say WARN audit "only ${afree} MB free on $logdir/audit: below 200 MB auditd stops recording until it is restarted with more room"
  elif [ "${alost:-0}" -gt 0 ]; then say WARN audit "the kernel dropped ${alost} audit records since boot (a burst, or something flooding the log): sudo aureport --summary shows what is busy, and sudo auditctl --reset-lost clears the count"
  else say PASS audit "auditd keeps $logdir/audit/audit.log, ${nrules} rules loaded and locked (read them with: sudo ausearch -i -k halos-config)"; fi
  # Halogen's own processes aren't audited, so look for what a break-in through Halogen would leave
  # to start again later: halOS puts nothing in these folders of halogen's (its units are in /usr and /etc).
  hhome="${HALOGEN_HOME:-/var/lib/halogen}"
  planted="$(as_owner timeout 20 env -C / find "$hhome/.config/systemd" "$hhome/.config/containers/systemd" "$hhome/.config/environment.d" \
    "$hhome/.config/autostart" "$hhome/.local/share/systemd" "$hhome/.config/containers/containers.conf" "$hhome/.config/containers/containers.conf.d" \
    -mindepth 0 ! -type d < /dev/null | head -n 5 | tr -cd '[:print:]\n' | tr '\n' ' ')"
  if ! as_owner test -d "$hhome"; then say SKIP halogen-autostart "couldn't look in $hhome as the halogen user"
  elif [ -n "$planted" ]; then say WARN halogen-autostart "the halogen user has its own services or settings, which halOS never creates: $planted"
  else say PASS halogen-autostart "the halogen user has no services or start-up settings of its own"; fi
else say SKIP audit "auditd isn't installed"; fi
jsize="$(run journalctl --disk-usage | grep -oE '[0-9.]+[KMGT]' | head -n 1)"
lfree="$(df --output=avail --block-size=1M "$logdir" 2>/dev/null | tail -n 1 | tr -d ' ')"
if [ -n "$lfree" ] && [ "$lfree" -lt "${HALOS_LOG_MIN_FREE_MB:-512}" ]; then
  say WARN logs "only ${lfree} MB free on $logdir (journal ${jsize:-?}): sudo journalctl --vacuum-size=1G"
else say INFO logs "journal ${jsize:-?}, at most 4 GB kept for 90 days; ${lfree:-?} MB free on $logdir"; fi

# --- Network (names, state and drivers only: no addresses)
for n in "$sys"/class/net/*; do
  name="$(basename "$n")"
  [ -e "$n/device" ] || continue
  driver="$(basename "$(readlink -f "$n/device/driver")" 2>/dev/null)"
  state="$(cat "$n/operstate" 2>/dev/null)"; speed="$(cat "$n/speed" 2>/dev/null || true)"
  if [ "$state" = up ]; then say INFO "net-$name" "up, driver $driver${speed:+, $speed Mb/s}"
  else say INFO "net-$name" "$state, driver $driver"; fi
done

echo
echo "Summary: $passes passed, $warns warnings, $fails failed, $skips skipped"
echo "Still to do by hand: a soak test (several hours of real load), and bootc switch, upgrade"
echo "and rollback keeping the TPM unlock and /srv."
[ "$fails" = 0 ]
