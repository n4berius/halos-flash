#!/bin/bash
# halogenctl bench: measure the running server with Halogen's own sweep tool (the one its
# published numbers come from), and save a report with what the numbers depend on.
# Runs as halogen. Usage: bench [--quick]
# The sweep is an HTTP client, so it needs no GPU, no restart and no models mounted: it runs in
# the pinned Halogen image with host networking only, to reach Halogen itself at 127.0.0.1:18731
# (behind halos-proxy: the numbers are Halogen's own, and the proxy's access log stays quiet).
set -euo pipefail
die() { echo "halogenctl bench: $*" >&2; exit 1; }
unset HALOS_RELEASE HALOGEN_VERSION HALOGEN_VARIANT HALOGEN_IMAGE
# shellcheck source=/dev/null
. "${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
render="${HALOGEN_RENDER:-/usr/libexec/halogen/render-config}"
sys="${HALOGEN_SYS:-/sys}"
cmdline="${HALOGEN_CMDLINE:-/proc/cmdline}"
api=http://127.0.0.1:18731

# Prefill sizes, generation length and repeats. The full run takes a few minutes.
pp=512,2048,8192,32768; tg=128; reps=3; kind=full
case "${1:-}" in
  '') ;;
  --quick) pp=2048; reps=1; kind=quick ;;
  *) die "usage: halogenctl bench [--quick]" ;;
esac

[ -n "${HALOGEN_IMAGE:-}" ] || die "no Halogen image named in the release file"
podman image exists "$HALOGEN_IMAGE" || die "Halogen's image isn't here yet; let the first download finish (sudo halogenctl fetch-logs)"
curl -sf -m 5 -o /dev/null "$api/health" || die "Halogen isn't answering on $api. Check: sudo halogenctl status"
[ -r "$configs/api-key" ] || die "cannot read $configs/api-key"

# What the numbers depend on. Printable characters only: some of it comes from firmware.
clean() { tr -cd '[:print:]' | sed 's/^ *//; s/ *$//'; }
dmi() { { clean < "$sys/class/dmi/id/$1"; } 2>/dev/null || true; }
karg() { tr ' ' '\n' < "$cmdline" | grep -E "^$1(=|$)" | clean || true; }
settings="$("$render" --show 2>/dev/null | grep -E '^HALOGEN_[A-Z0-9_]+=' | grep -vE '_(KEY|TOKEN)[A-Z_]*=' | tr -cd '[:print:]\n' || true)"
checkpoint="$(sed -n 's/^HALOGEN_CHECKPOINT=//p' <<< "$settings" | tail -n 1)"
case "$checkpoint" in /models/flash/*/*) flash="${checkpoint#/models/flash/}"; flash="${flash%%/*} (your own)" ;; *) flash=official ;; esac
# The clock unit runs once at boot and exits, so ask the clock script, as the selftest does.
if "${HALOGEN_CLOCK:-/usr/libexec/halogen/halogen-fabric-clock}" status > /dev/null 2>&1; then fabric=yes; else fabric=no; fi
profile="$({ clean < "$sys/firmware/acpi/platform_profile"; } 2>/dev/null || true)"
cache="$(sed -n 's/^HALOGEN_PROMPT_CACHE=//p' <<< "$settings" | tail -n 1)"

stamp="$(date -u +%Y%m%d-%H%M%S)"
dir="$configs/bench"
umask 027
mkdir -p "$dir"
raw="$dir/.$stamp.raw"
trap 'rm -f "$raw" "$raw.json"' EXIT

echo "Measuring Halogen ($kind run: prefill $pp tokens, generation $tg tokens over Halogen's ten"
echo "prompt shapes, $reps time(s) each). Other requests are slower meanwhile."
# The key goes in through the environment, not the command line, so ps never shows it.
# The tool runs through bench-cold.py, which gives this run's prompts a new first word: the tool
# sends the same prompts every time, and Halogen's prompt cache (kept on disk) would otherwise
# answer them from the second run on, in a fraction of a second at any length.
cold="$(cat "${HALOGEN_BENCH_COLD:-/usr/share/halogen/bench-cold.py}")" || die "cannot read bench-cold.py"
HALOGEN_API_KEY="$(head -n 1 "$configs/api-key")" podman run --rm --pull=never --network=host \
  --read-only --tmpfs /tmp --cap-drop=all --security-opt no-new-privileges -e HALOGEN_API_KEY \
  --entrypoint python3 "$HALOGEN_IMAGE" -I -c "$cold" /halogen/tools/halogen-bench.py \
  --api "$api" -p "$pp" -n "$tg" -r "$reps" --json > "$raw" \
  || die "the measurement failed; see above, and sudo halogenctl logs"
# The tool prints two header lines before its JSON. Keep the JSON, with every control character
# taken out of its text: it came from the server, and ends up on root's terminal.
if ! sed -n '/^{/,$p' "$raw" | jq 'walk(if type == "string" then gsub("[[:cntrl:]]"; "") else . end)' > "$raw.json" 2>/dev/null ||
   ! jq -e '.rows | length > 0' "$raw.json" > /dev/null 2>&1; then
  die "the measurement returned no results it could read; its output was: $(head -c 300 "$raw" | tr -cd '[:print:]\n')"
fi

# The newest earlier report of the same kind (full or quick), to compare with. Reports are
# halogen's own files, but one may have been edited, so only a readable one with rows counts.
# Reports from before bench-cold.py (no halos_cold), and runs the cache mostly answered, are
# skipped: their prompt reading came from the prompt cache.
prev=/dev/null
while IFS= read -r f; do
  if [ ! -f "$f" ] || [ -L "$f" ]; then continue; fi
  # One JSON value, of the shape this script writes (a hand-edited one is skipped, not trusted).
  if jq -e -s --arg run "$kind" 'length == 1 and (.[0] | type == "object" and .run == $run
       and (.bench | type == "object") and (.bench.rows | type == "array" and length > 0 and all(type == "object"))
       and (.bench.halos_cold | type == "object")
       and ([.bench.halos_cold.passes[]? | select((.cached | numbers) * 2 > (.tokens | numbers))] | length == 0)
       and ((.system // {}) | type == "object") and ((.system.settings // []) | type == "array"))' \
       "$f" > /dev/null 2>&1; then prev="$f"; break; fi
done < <(find "$dir" -maxdepth 1 -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}\.json' -printf '%f\n' 2>/dev/null \
         | sort -r | sed "s|^|$dir/|")
prev_name=""
[ "$prev" = /dev/null ] || prev_name="$(basename "$prev")"

jq --arg date "$(date -u '+%Y-%m-%d %H:%M UTC')" --arg kind "$kind" \
   --arg halos "${HALOS_RELEASE:-unknown}" --arg edition "${HALOGEN_VARIANT:-unknown}" \
   --arg halogen "${HALOGEN_VERSION:-unknown}" --arg image "$HALOGEN_IMAGE" \
   --arg kernel "$(uname -r | clean)" --arg board "$(dmi board_vendor) $(dmi board_name)" \
   --arg bios "$(dmi bios_version)" --arg gtt "$(karg amdgpu.gttsize)" \
   --arg iommu "$(karg iommu; karg amd_iommu)" --arg fabric "$fabric" --arg profile "$profile" \
   --arg flash "$flash" --arg settings "$settings" --arg cache "${cache:-default}" --arg prev "$prev_name" '
  {date: $date, run: $kind,
   system: {halos: $halos, edition: $edition, halogen: $halogen, image: $image, kernel: $kernel,
            board: $board, bios: $bios, gttsize: $gtt, iommu: $iommu, fabric_clock: $fabric,
            platform_profile: $profile, flash_checkpoint: $flash, prompt_cache: $cache,
            settings: ($settings | split("\n") | map(select(length > 0)))},
   compared_with: (if $prev == "" then null else $prev end),
   bench: .}' "$raw.json" > "$dir/$stamp.json"

# The report: results first, in plain units, then what changed since the last run. The details
# (board, kernel, every setting) go only into the saved text file.
# shellcheck disable=SC2016 # jq's own variables
report='
def th: if length > 3 then (.[0:length-3] | th) + "," + .[length-3:] else . end;
def d1: fabs * 10 | round | tostring | if length == 1 then "0." + . else .[0:-1] + "." + .[-1:] end;
def speed: if . < 100 then d1 else (round | tostring | th) end;
def secs: if . < 10 then d1 else (round | tostring | th) end + " s";
def pct: (if . * 10 | round > 0 then "+" elif . * 10 | round < 0 then "-" else "" end) + d1 + "%";
def size: if . >= 1024 and . % 1024 == 0 then "\(. / 1024)K" else tostring end;
def rpad($n): tostring | . + ([range(0; $n - length)] | map(" ") | join(""));
def lpad($n): tostring | ([range(0; $n - length)] | map(" ") | join("")) + .;
def clean: tostring | gsub("[[:cntrl:]]"; "");
def num: (.test | clean | ltrimstr("pp") | ltrimstr("tg") | tonumber? ) // null;
def nz: if type == "number" then . else 0 end;
($prev[0] // null) as $p
# The same test'"'"'s mean in the last run, when it has a usable one.
| def oldmean: (.test) as $t
    | if $p == null then null
      else [$p.bench.rows[] | select(.test == $t) | .mean | select(type == "number" and . > 0)][0] end;
# Faster, slower or about the same as the last run. Noise: 2%, or for reading two standard errors
# of the mean of this run, whichever is more. For writing the spread is mostly the gap between
# prompt types, which is the same in every run, so only the 2% counts ($samples null).
  def verdict($samples):
    (.mean | nz) as $m | oldmean as $old
    | (if $m > 0 then 100 * (.stdev | nz) / $m else 0 end) as $spread
    | if $old == null then null else
        (100 * ($m - $old) / $old) as $d
        | (if $samples == null then 2 else [2, 2 * $spread / ([$samples, 1] | max | sqrt)] | max end) as $noise
        | if ($d | fabs) < $noise then "about the same" elif $d > 0 then "faster" else "slower" end
      end;
  def line($samples):
    (.mean | nz) as $m | (num) as $n
    | (if $m > 0 then 100 * (.stdev | nz) / $m else 0 end) as $spread
    | (if $n == null then (.test | clean) else "\($n | size) tokens" end | rpad(12))
      + ("\($m | speed) tok/s" | lpad(13))
      + ("±\($spread | d1)%" | lpad(9))
      + (if $m > 0 then ((.tokens // $n // 0 | nz) / $m | secs) else "" end | lpad(9))
      + (if $p == null then "" else
           oldmean as $old
           | if $old == null then "    (not in the last run)" else
               (100 * ($m - $old) / $old) as $d
               | "   " + ($d | pct | lpad(7)) + "  " + verdict($samples)
             end
         end);
def table($label; $rows; $samples):
  "  " + ($label | rpad(12)) + ("Speed" | lpad(13)) + ("Spread" | lpad(9)) + ("Time" | lpad(9))
  + (if $p == null then "" else "   Last run" end),
  ($rows[] | "  " + line($samples));
[.bench.rows[] | select(.test | clean | startswith("pp"))] as $pp
| [.bench.rows[] | select(.test | clean | startswith("tg"))] as $tg
| [.bench.rows[] | select(.test | clean | (startswith("pp") or startswith("tg")) | not)] as $other
| .system as $s
| "halOS benchmark, \(.date), \(.run) run (\($reps) pass\(if $reps == 1 then "" else "es" end) per test)",
  "",
  ( [ (if ($pp | length) > 0 then
         ($pp | map(.mean | nz) | [min, max]) as [$lo, $hi]
         | "reads prompts at \(if ($lo | round) == ($hi | round) then ($lo | speed) else "\($lo | speed) to \($hi | speed)" end) tok/s" else empty end),
      (if ($tg | length) > 0 then "writes answers at \($tg[0].mean | nz | speed) tok/s" else empty end) ]
    | if length > 0 then "In short: Halogen " + join(" and ") + "." else empty end ),
  (if $p == null then empty else
     ([$pp[] | verdict($reps)] + [$tg[] | verdict(null)] | map(select(. != null))) as $v
     | ($v | map(select(. == "faster")) | length) as $f | ($v | map(select(. == "slower")) | length) as $sl
     | "Since the last \(.run) run: "
       + (if $f == 0 and $sl == 0 then "no change beyond the normal variation."
          else ([(if $f > 0 then "\($f) test\(if $f == 1 then "" else "s" end) faster" else empty end),
                 (if $sl > 0 then "\($sl) test\(if $sl == 1 then "" else "s" end) slower" else empty end)] | join(", ")) + "."
          end)
   end),
  ( ( [.bench.halos_cold.passes // [] | .[] | select(type == "object")
       | select((.cached | nz) * 2 > (.tokens | nz))] | length ) as $warm
    | if $warm > 0 then
        "Warning: \($warm) prompt-reading pass\(if $warm == 1 then " was" else "es were" end) mostly"
        + " answered from the prompt cache, so the reading speeds are too high. Run the benchmark again."
      else empty end ),
  "",
  (if ($pp | length) > 0 then
     "Reading the prompt (prefill): how long before the answer starts",
     table("Prompt"; $pp; $reps), "" else empty end),
  (if ($tg | length) > 0 then
     "Writing the answer (generation): mean over Halogen'"'"'s 10 prompt types",
     table("Answer"; $tg; null), "" else empty end),
  (if ($other | length) > 0 then "Other", table("Test"; $other; $reps), "" else empty end),
  (if $p == null then "No earlier \(.run) run to compare with. The next run will be compared with this one."
   else
     ($p.system // {}) as $o
     | [ ["halOS", "halos"], ["Halogen", "halogen"], ["edition", "edition"], ["kernel", "kernel"],
         ["BIOS", "bios"], ["GTT size", "gttsize"], ["IOMMU", "iommu"], ["fabric clock held", "fabric_clock"],
         ["power profile", "platform_profile"], ["Flash checkpoint", "flash_checkpoint"] ]
     | map(.[1] as $k | select(($o[$k] // "" | clean) != ($s[$k] // "" | clean))
           | "\(.[0]) \($o[.[1]] // "?" | clean | gsub("\n"; " ")) -> \($s[.[1]] // "?" | clean | gsub("\n"; " "))")
     + ( (($o.settings // []) | map(clean)) as $a | ($s.settings | map(clean)) as $b
         | ($a + $b | map(split("=")[0]) | unique) as $names
         | [ $names[] as $n
             | ([$a[] | select(startswith($n + "=")) | .[($n | length) + 1:]][0] // "unset") as $x
             | ([$b[] | select(startswith($n + "=")) | .[($n | length) + 1:]][0] // "unset") as $y
             | select($x != $y) | "\($n) \($x) -> \($y)" ] )
     | "Last run: \($p.date // "?" | clean) (\($input_prev | clean)). "
       + (if length == 0 then "Nothing in the setup changed since then."
          else "Changed since then:\n" + (map("  " + .) | join("\n")) end)
   end),
  "",
  "Setup: halOS \($s.halos) (\($s.edition) edition), Halogen \($s.halogen), Flash checkpoint \($s.flash_checkpoint),",
  "  draft head \([.bench.rows[] | .drafter // "default" | clean] | unique | join("/"))"
  + ", power profile \(if $s.platform_profile == "" then "not reported" else $s.platform_profile end),"
  + " fabric clock \(if $s.fabric_clock == "yes" then "held" else "NOT held" end).",
  "",
  "Speed is tokens per second, measured end to end over HTTP with Halogen'"'"'s own tool. Time is",
  "how long that length takes at that speed. Spread is the variation between passes (one standard",
  "deviation); for writing it is mostly the prompt type, since code is written about twice as fast",
  "as prose. \"About the same\" means the change is within the normal variation between runs.",
  "The prompt cache was on, as Halogen runs, but each run uses prompts that are new to it:",
  "compare reading speeds with the \"cache on (a cold request)\" rows in Halogen'"'"'s",
  "docs/performance.md."
'
# If an earlier report still trips the comparison, show this run without it rather than lose it.
summary="$(jq -r --argjson reps "$reps" --slurpfile prev "$prev" --arg input_prev "$prev_name" "$report" "$dir/$stamp.json" 2>/dev/null)" \
  || summary="$(jq -r --argjson reps "$reps" --slurpfile prev /dev/null --arg input_prev "" "$report" "$dir/$stamp.json")" \
  || die "could not write the report"
{
  printf '%s\n' "$summary"
  echo
  echo "Details"
  jq -r '.system | "  Board:   \(.board), BIOS \(.bios)",
    "  Kernel:  \(.kernel); \(.gttsize); \(.iommu | gsub("\n"; " "))",
    "  Image:   \(.image)",
    "  Prompt cache: \(.prompt_cache)",
    "  Settings:", (if (.settings | length) == 0 then "    defaults" else (.settings[] | "    " + .) end)' "$dir/$stamp.json"
} > "$dir/$stamp.txt"
printf '%s\n' "$summary"
echo
echo "Saved: $dir/$stamp.txt (with the board, kernel and every setting) and $stamp.json"
