#!/bin/bash
# Runs inside the pinned Halogen image, which records each NPU model's repo,
# revision, sizes and hashes. Exit 3 means retrying will not help.
# FETCH_MODE=probe: only ask Halogen which model each of your own checkpoints was tuned from, and
# print "path=base" lines. fetch-models runs that in an offline container with the models
# read-only and no token (a checkpoint is untrusted input to Halogen's parser), then passes the
# lines to the download container as OWN_BASES, which never probes.
set -uo pipefail
pins="${HALOGEN_PINS:-/opt/halogen/npu/models.txt}"
root="${HALOGEN_MODELS_ROOT:-/models}"
npu_bin="${HALOGEN_NPU_BIN:-/usr/local/bin/halogen-npu}"

[ -f "$pins" ] || { echo "fetch: this image has no NPU record at $pins" >&2; exit 3; }

model_key() { awk -v id="$1" -v k="$2" '$1 == "model" && $2 == id { for (i = 3; i <= NF; i++) if (index($i, k "=") == 1) { print substr($i, length(k) + 2); exit } }' "$pins"; }
model_files() { awk -v id="$1" '$1 == "file" && $2 == id { print $3, $4, $5 }' "$pins"; }

# hf with its upgrade adverts, lock chatter and anonymous-use warning removed: this
# image pins its hf version, and fetch-models already says whether a token is in use.
hf_quiet() {
  hf "$@" 2>&1 | grep --line-buffered -v -e '^Hint: ' -e '^To update, run: hf update' \
    -e 'Still waiting to acquire lock' -e 'sending unauthenticated requests to the HF Hub'
  return "${PIPESTATUS[0]}"
}

# Which model your own checkpoint (an id that is a path, maybe ending in :fast) was tuned from.
probe_base() {
  local p="${1%:fast}" info base
  p="$root/${p#/models/}"
  if [ ! -f "$p/config.json" ]; then
    echo "fetch: $1 is not a checkpoint folder (no config.json). Pull one with: sudo halogenctl model pull <repo>" >&2
    return 1
  fi
  info="$("$npu_bin" probe "$p" 2>&1)" || { echo "fetch: $1: $info" >&2; return 1; }
  base="$(printf '%s\n' "$info" | tr ' ' '\n' | sed -n 's/^base=//p' | head -n 1)"
  [[ "$base" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "fetch: $1: Halogen could not tell which model it was tuned from" >&2; return 1; }
  echo "$base"
}
if [ "${FETCH_MODE:-}" = probe ]; then
  for id in ${NPU_MODELS//,/ }; do
    case "$id" in
      /*) [[ "$id" != *=* ]] || { echo "fetch: $id: a path can't contain =" >&2; exit 3; }
          base="$(probe_base "$id")" || exit 3
          echo "$id=$base" ;;
    esac
  done
  exit 0
fi

flash_files="qwen38-flash-next-v2.hgn qwen38-flash-next-ngram.hgn"
[ -z "$VISION" ] || flash_files="$flash_files qwen38-flash-next-vision.hgn"
missing=""
for f in $flash_files; do [ -f "$root/$f" ] || missing="$missing $f"; done
if [ -n "$missing" ]; then
  echo "fetch: downloading$missing from $WEIGHTS_REPO"
  # shellcheck disable=SC2086
  hf_quiet download "$WEIGHTS_REPO" $missing --revision "$WEIGHTS_REVISION" --local-dir "$root" || exit 1
fi
if [ ! -f "$root/tokenizer/tokenizer.json" ]; then
  hf_quiet download "$WEIGHTS_REPO" --include 'tokenizer/*' --revision "$WEIGHTS_REVISION" --local-dir "$root" || exit 1
fi

# Your own checkpoint (a path) runs on the NPU programs of the model it was tuned from.
# Halogen reads which one from the checkpoint; fetch those programs, never weights.
# Each entry is id:part, where part is all, devices, vis or aud, as Halogen checks them.
# The base comes from the offline probe (OWN_BASES); this container never probes.
own_parts() {
  local fast=0 base own vb ab
  [ "${1%:fast}" != "$1" ] && fast=1
  base="$(printf '%s\n' "${OWN_BASES:-}" | awk -v id="$1" 'index($0, id "=") == 1 { print substr($0, length(id) + 2); exit }')"
  [[ "$base" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "fetch: $1 was not probed before the download" >&2; return 1; }
  [ "$fast" = 0 ] || base="$base-fast"
  # Some models have no download of their own and reuse others' programs (LFM3-Omni-2B does),
  # so ask only that the image knows the model.
  awk -v id="$base" '$1 == "model" && $2 == id { found = 1 } END { exit !found }' "$pins" \
    || { echo "fetch: $1 is a $base, which this image has no NPU programs for" >&2; return 1; }
  own="$(model_key "$base" devices)"; own="${own:-$base}"
  echo "fetch: $1 is a $base; fetching its NPU programs" >&2
  echo "$own:devices"
  vb="$(model_key "$base" vis)"
  if [ -z "$vb" ] && [ "$own" != "$base" ] && model_files "$base" | grep -q '^vis/'; then vb="$base"; fi
  [ -z "$vb" ] || echo "$vb:vis"
  ab="$(model_key "$base" aud)"
  [ -z "$ab" ] || echo "$ab:aud"
}

ids=""
unknown=""
for id in ${NPU_MODELS//,/ }; do
  case "$id" in
    /*)
      parts="$(own_parts "$id")" || exit 3
      ids="$ids $(printf '%s\n' "$parts" | tr '\n' ' ')"
      continue ;;
  esac
  if [ -z "$(model_key "$id" repo)" ]; then unknown="$unknown $id"; continue; fi
  ids="$ids $id:all"
  own="$(model_key "$id" devices)"
  [ -z "$own" ] || ids="$ids $own:devices"
done
if [ -n "$unknown" ]; then
  # Check every name before stopping, so one edit can fix them all.
  for id in $unknown; do echo "fetch: this image has no record of NPU model $id" >&2; done
  echo "fetch: NPU models this image can download (names are case-sensitive):" >&2
  awk '$1 == "model" { print "fetch:   " $2 }' "$pins" >&2
  exit 3
fi

# A model wanted whole also covers any of its parts.
# shellcheck disable=SC2086
wanted="$(printf '%s\n' $ids | awk -F: 'NF { if ($2 == "all") all[$1] = 1; else part[$1] = part[$1] " " $2; order[++n] = $1 }
  END { for (i = 1; i <= n; i++) { id = order[i]; if (seen[id]++) continue
    print id, (id in all) ? "all" : part[id] } }')"

files_for() {
  local id="$1" parts="$2"
  if [ "$parts" = all ]; then model_files "$id"; return; fi
  model_files "$id" | while read -r path size sha; do
    for part in $parts; do
      case "$part:$path" in devices:devices/*|devices:vis/*|devices:aud/*|vis:vis/*|aud:aud/*) echo "$path $size $sha"; break ;; esac
    done
  done
}

while read -r id parts; do
  [ -n "$id" ] || continue
  dir="$root/npu/$id"
  repo="$(model_key "$id" repo)"
  revision="$(model_key "$id" revision)"
  list="$(files_for "$id" "$parts")"
  need=""
  while read -r path size sha; do
    [ -n "$path" ] || continue
    if [ -f "$dir/$path" ] && [ "$(wc -c < "$dir/$path")" = "$size" ] \
       && [ "$(sha256sum "$dir/$path" | cut -d' ' -f1)" = "$sha" ]; then
      continue
    fi
    rm -f "$dir/$path"
    need="$need $path"
  done <<< "$list"
  if [ -z "$need" ]; then
    echo "fetch: $id is present"
    continue
  fi
  [ -n "$repo" ] || { echo "fetch: this image names no download for $id, which has missing files:$need" >&2; exit 3; }
  echo "fetch: downloading $id from $repo${revision:+ at $revision}"
  mkdir -p "$dir"
  # shellcheck disable=SC2086
  hf_quiet download "$repo" $need ${revision:+--revision "$revision"} --local-dir "$dir" >/dev/null < /dev/null || exit 1
  while read -r path size sha; do
    [ -n "$path" ] || continue
    [ "$(sha256sum "$dir/$path" | cut -d' ' -f1)" = "$sha" ] \
      || { echo "fetch: $id/$path does not match the image's record" >&2; exit 1; }
  done <<< "$list"
done <<< "$wanted"
echo "fetch: complete"
