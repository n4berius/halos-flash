#!/bin/bash
# Your own Flash checkpoints in /srv/models/flash/<name>, beside the official one. Runs as
# the halogen user; halogenctl flash pull and flash verify start it.
#   flash-checkpoint pull <hf-repo> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn>]
#   flash-checkpoint verify <name>
#   flash-checkpoint check-prepare <name>   (checks the name, downloads the test text)
#   flash-checkpoint check <name>           (halogenctl stops Halogen first: ppl needs the GPU)
#   flash-checkpoint convert-prepare <hf-repo> [--revision <rev>] [--as <name>]
#   flash-checkpoint convert-run <name> [--threads <n>] [--keep-source]   (halogenctl flash convert)
#   flash-checkpoint sandbox-check          (the converter's sandbox with probes in it; the VM test)
# Everything runs in the pinned Halogen image: hf and Python list and download, and Halogen's
# own tools read the checkpoint back. Only the files Halogen loads are downloaded.
set -uo pipefail
release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
hf_token="${HALOGEN_HF_TOKEN_FILE:-/srv/configs/hf-token}"
progress_s="${HALOGEN_PROGRESS_S:-30}"
# shellcheck disable=SC1090
. "$release"

table=qwen38-flash-next-ngram.hgn
vision=qwen38-flash-next-vision.hgn
die() { echo "$*" >&2; exit 1; }
flash_choice="${HALOGEN_FLASH_FILE:-/srv/configs/flash-checkpoint}"
valid_name() {
  case "$1" in [A-Za-z0-9]*) ;; *) return 1 ;; esac
  case "$1" in *[!A-Za-z0-9._-]*|official) return 1 ;; esac
}
[ "${1:-}" = sandbox-check ] || podman image exists "$HALOGEN_IMAGE" \
  || die "The Halogen image isn't downloaded yet. Let the first boot finish: sudo halogenctl fetch-logs"

token_args=()
[ ! -s "$hf_token" ] || token_args=(-v "$hf_token:/run/secrets/hf-token:ro" -e HF_TOKEN_PATH=/run/secrets/hf-token)
# Online, for listing and downloading: no capabilities, a read-only image, and only the mounts
# in $mounts (none for the listing, the checkpoint's own folder for the download).
mounts=()
online() {
  podman run --rm -i --pull=never --read-only --tmpfs /tmp --cap-drop=all --security-opt no-new-privileges \
    -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=0 -e HF_HUB_DISABLE_TELEMETRY=1 -e HF_HUB_DISABLE_PROGRESS_BARS=1 \
    "${token_args[@]}" "${mounts[@]}" --entrypoint "$1" "$HALOGEN_IMAGE" "${@:2}"
}
# Halogen's own tools on a downloaded file: offline, no capabilities, read-only models, and
# exactly the flags the fetch gives the official verify. --ipc=host stays: Halogen's docs run
# its tools with it, because without it SELinux refuses the container the GPU on Fedora.
# Halogen's prompt cache (conversation state) is hidden from these containers: none of them needs
# it, and the download one has network. An empty read-only tmpfs takes its place; notmpcopyup,
# or podman copies the folder's files into it. podman can't make the
# mount point on a read-only /models, so a missing folder is made first (this runs as halogen, as
# prepare does at boot). A link in its place is refused: the tmpfs would land on whatever it points
# to, and Halogen's start refuses it anyway (preflight).
if [ -L "$models/.prompt-cache" ]; then
  echo "$models/.prompt-cache is a link, not a folder. Remove it, then start again: sudo halogenctl restart" >&2; exit 1
fi
[ -d "$models/.prompt-cache" ] || mkdir -m 0700 "$models/.prompt-cache" || exit 1
hide_cache=(--tmpfs "/models/.prompt-cache:ro,size=4k,notmpcopyup")
offline() {
  podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" "${hide_cache[@]}" \
    --network=none --cap-drop=all --security-opt no-new-privileges "$@"
}
info_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n 1; }

# verify every .hgn of a checkpoint folder with Halogen's verify, and record the answer.
# Halogen reads tokenizer/tokenizer.json beside the checkpoint and won't start without it. Some
# repositories ship only a chat template and settings there (Signal-3.8-Flash-Next-HGN-v2 does):
# the vocabulary files then come from the official tokenizer, the model's own, and the
# repository's chat template and settings stay. A folder with none at all gets the official one.
fill_tokenizer() {
  local dir="$1" f added=""
  [ ! -L "$dir/tokenizer" ] || { echo "$dir/tokenizer is a link; pull it again." >&2; return 1; }
  [ ! -f "$dir/tokenizer/tokenizer.json" ] || return 0
  [ -f "$models/tokenizer/tokenizer.json" ] || { echo "The official tokenizer is missing; let the download finish (sudo halogenctl fetch-logs)." >&2; return 1; }
  if [ ! -d "$dir/tokenizer" ]; then cp -r "$models/tokenizer" "$dir/tokenizer" || return 1; return 0; fi
  # A repository with a vocabulary of its own says it differs from the official one: halOS
  # can't build its tokenizer.json, and mixing the two would tokenize wrongly without a word.
  # Files identical to the official ones are the copies an earlier check added.
  for f in "$dir"/tokenizer/vocab.json "$dir"/tokenizer/merges.txt "$dir"/tokenizer/tokenizer.model "$dir"/tokenizer/*.tiktoken; do
    if [ -f "$f" ] && [ ! -L "$f" ] && [ -f "$models/tokenizer/$(basename "$f")" ] \
       && [ "$(sha256sum < "$f")" = "$(sha256sum < "$models/tokenizer/$(basename "$f")")" ]; then continue; fi
    if [ -e "$f" ] || [ -L "$f" ]; then
      echo "Its tokenizer/ has a vocabulary of its own ($(basename "$f")) but no tokenizer.json, which halOS can't build." >&2
      return 1
    fi
  done
  for f in tokenizer.json vocab.json merges.txt; do
    if [ -f "$models/tokenizer/$f" ] && [ ! -e "$dir/tokenizer/$f" ] && [ ! -L "$dir/tokenizer/$f" ]; then
      cp "$models/tokenizer/$f" "$dir/tokenizer/$f" || return 1
      added+=" $f"
    fi
  done
  echo "Its tokenizer/ has no tokenizer.json, so the official vocabulary was added (${added# }); its own chat template and settings stay."
}

verify_dir() {
  local name="$1" dir="$models/flash/$1" info="$models/flash/$1/halos.info" f result=pass checked=0
  # A link could point at a file that changes after it was checked, so links are never checked.
  if [ -L "$dir" ] || [ -L "$info" ]; then echo "$dir holds links; pull it again." >&2; return 1; fi
  if ! fill_tokenizer "$dir" || [ ! -f "$dir/tokenizer/tokenizer.json" ]; then
    echo "So $dir/tokenizer has no tokenizer.json, which Halogen needs to start." >&2; result=fail
  fi
  for f in "$dir"/*.hgn; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    if [ -L "$f" ] || [ ! -f "$f" ]; then echo "$(basename "$f") is not a plain file." >&2; result=fail; continue; fi
    # Halogen's verify takes the checkpoint and its sidecars, not the lookup table, which the
    # pull checks against the repository's hash instead (as the fetch does for the official one).
    [ "$(basename "$f")" != "$table" ] || continue
    checked=$((checked + 1))
    echo "Checking $(basename "$f") with Halogen's verify..."
    if ! offline "$HALOGEN_IMAGE" verify "/models/flash/$name/$(basename "$f")"; then result=fail; fi
  done
  [ "$checked" -gt 0 ] || { echo "$dir holds no checkpoint." >&2; result=fail; }
  { grep -v -e '^verified=' -e '^verified_with=' -e '^verified_at=' "$info"
    echo "verified=$result"
    echo "verified_with=$HALOGEN_VERSION"
    echo "verified_at=$(date -u '+%Y-%m-%d %H:%M UTC')"; } > "$info.new" && mv -f "$info.new" "$info" || return 1
  [ "$result" = pass ]
}

# Quality against the official checkpoint, with Halogen's ppl on the public wikitext-2 test split
# (the corpus Halogen's own docs compare with): perplexity, and per-token KL and top-1 agreement
# against a reference dump of the official checkpoint, made once per Halogen version.
corpus_sha="${HALOGEN_CORPUS_SHA:-bbf94c53a05abe9ee670d3b6343608095822c85e26de37c70b24fc571964574a}"
corpus_url="${HALOGEN_CORPUS_URL:-https://datasets-server.huggingface.co/rows?dataset=Salesforce/wikitext&config=wikitext-2-raw-v1&split=test}"
check_dir="$models/flash/.check"
# The text is not ours to ship. Hugging Face's dataset viewer serves its rows; joined, they are
# byte for byte the text Halogen's docs build from the parquet file, checked by its hash.
get_corpus() {
  local out="$check_dir/wikitext-2-raw-test.txt" tmp offset total
  [ "$(sha256sum 2>/dev/null < "$out" | cut -d' ' -f1)" != "$corpus_sha" ] || return 0
  echo "Downloading the test text (wikitext-2, about 1.3 MB)..."
  tmp="$out.part"; : > "$tmp" || return 1
  offset=0; total=1
  while [ "$offset" -lt "$total" ]; do
    # The test split is 4,358 rows (44 pages); a far larger count is not this text.
    [ "$offset" -lt 10000 ] || { rm -f "$tmp"; echo "The test text is longer than it should be; not used." >&2; return 1; }
    # curl's own messages stay quiet: --retry rides out a passing server error, and only a final
    # failure is reported, below.
    page="$(curl -fs -m 60 --retry 3 --max-filesize 2M "$corpus_url&offset=$offset&length=100")" || { rm -f "$tmp"; echo "Could not download the test text." >&2; return 1; }
    total="$(jq -r '.num_rows_total // 0' <<< "$page")"
    jq -j '.rows[].row.text' <<< "$page" >> "$tmp" || { rm -f "$tmp"; return 1; }
    offset=$((offset + 100))
  done
  [ "$(sha256sum < "$tmp" | cut -d' ' -f1)" = "$corpus_sha" ] || { rm -f "$tmp"; echo "The test text didn't match its known hash; not used." >&2; return 1; }
  mv -f "$tmp" "$out"
}
# Halogen's ppl: the GPU, no network or capabilities, the models read-only. The folder for the
# text and the reference dump is writable only for the official run ($2 = rw), which writes the
# dump; a custom checkpoint's run only reads it. Both runs read the official tokenizer, mounted
# where Halogen's tools look, so they score the same tokens, whatever tokenizer a repository
# ships. The prose goes to the terminal; the --json object to $1.
ppl() {
  local json="$1" mode="$2"; shift 2
  podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" "${hide_cache[@]}" -v "$check_dir:/models/flash/.check:$mode" \
    -v "$models/tokenizer:/tokenizer:ro" -e HALOGEN_TOKENIZER=/tokenizer \
    --network=none --cap-drop=all --security-opt no-new-privileges "$HALOGEN_IMAGE" ppl "$@" --json > "$json"
}
# What can be checked before Halogen stops: the checkpoint is there and verified, and the text.
check_prepare() {
  local name="$1" info="$models/flash/$1/halos.info" file
  file="$(info_get "$info" checkpoint)"
  if ! [[ "$file" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] || [ ! -f "$models/flash/$name/$file" ]; then die "$name is missing its checkpoint file; pull it again."; fi
  [ "$(info_get "$info" verified)" = pass ] || die "$name has not passed Halogen's verify: sudo halogenctl flash verify $name"
  [ -f "$models/tokenizer/tokenizer.json" ] || die "the official tokenizer is missing; let the download finish (sudo halogenctl fetch-logs)"
  mkdir -p "$check_dir" || die "cannot create $check_dir"
  get_corpus || exit 1
}
check_dir_run() {
  local name="$1" info="$models/flash/$1/halos.info" file ref refjson json p op kl top1 kmean p99 tokens
  check_prepare "$name"
  file="$(info_get "$info" checkpoint)"
  ref="$check_dir/official-$HALOGEN_VERSION.ref"; refjson="$check_dir/official-$HALOGEN_VERSION.json"
  if [ ! -s "$ref" ] || ! jq -e '.ppl' "$refjson" > /dev/null 2>&1; then
    rm -f "$check_dir"/official-*.ref "$check_dir"/official-*.json
    echo "Measuring the official checkpoint first (once per Halogen version)..."
    ppl "$refjson.new" rw /models/qwen38-flash-next-v2.hgn --corpus /models/flash/.check/wikitext-2-raw-test.txt \
      --ref-out "/models/flash/.check/official-$HALOGEN_VERSION.ref.new" \
      || { rm -f "$refjson.new" "$ref.new"; die "Halogen's ppl failed on the official checkpoint (above)."; }
    if ! mv -f "$ref.new" "$ref" || ! mv -f "$refjson.new" "$refjson"; then die "cannot save the reference"; fi
  fi
  echo "Measuring $name against it..."
  json="$models/flash/$name/check.json"
  ppl "$json.new" ro "/models/flash/$name/$file" --corpus /models/flash/.check/wikitext-2-raw-test.txt \
    --ref "/models/flash/.check/official-$HALOGEN_VERSION.ref" --worst 5 \
    || { rm -f "$json.new"; die "Halogen's ppl failed on $name (above)."; }
  mv -f "$json.new" "$json"
  num() { jq -r "$1 // empty" "$2" | grep -E '^-?[0-9.]+(e-?[0-9]+)?$' | head -n 1; }
  p="$(num .ppl "$json")"; op="$(num .ppl "$refjson")"; kl="$(num .ref.kl.median "$json")"
  kmean="$(num .ref.kl.mean "$json")"; p99="$(num .ref.kl.p99 "$json")"; top1="$(num .ref.top1_agreement "$json")"
  if [ -z "$p" ] || [ -z "$op" ] || [ -z "$kl" ] || [ -z "$top1" ]; then die "Halogen's ppl gave no usable numbers; see $json"; fi
  { grep -v -e '^checked' "$info"
    echo "checked_with=$HALOGEN_VERSION"
    echo "checked_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo "checked_ppl=$p"; echo "checked_official_ppl=$op"
    echo "checked_kl_median=$kl"; echo "checked_top1=$top1"; } > "$info.new" || die "cannot write $info"
  mv -f "$info.new" "$info" || die "cannot write $info"
  # top1_agreement may be a fraction or a percentage; show a percentage. The rest is rounded for
  # reading; halos.info and check.json keep every digit.
  top1="$(awk -v t="$top1" 'BEGIN { if (t <= 1) t *= 100; printf "%.1f", t }')"
  r() { awk -v v="$1" -v d="$2" 'BEGIN { if (v == "") print "?"; else printf "%." d "f", v }'; }
  p="$(r "$p" 2)"; op="$(r "$op" 2)"; kl="$(r "$kl" 3)"; kmean="$(r "$kmean" 3)"; p99="$(r "$p99" 2)"
  echo
  tokens="$(num .tokens "$json")"
  echo "$name against the official checkpoint, on the wikitext-2 test text (${tokens:-?} tokens):"
  printf '  perplexity           %-10s official %s   (lower: the text surprises it less)\n' "$p" "$op"
  printf '  same next token      %s%%            (how often both would write the same word)\n' "$top1"
  printf '  KL divergence        median %s, mean %s, p99 %s\n' "$kl" "${kmean:-?}" "${p99:-?}"
  echo
  echo "How to read it: a median KL of a few hundredths is the ordinary difference between two"
  echo "quantizations of the same model. A much larger median, or a mean far above the median, means"
  echo "it answers differently in places: fine for a fine-tune, a warning for a plain conversion."
  echo "Halogen's docs explain each number: https://github.com/peonist-ai/halogen-flash-server/blob/main/docs/checkpoint-tools.md"
  echo "Details, with the 5 places they disagree most: $json"
}

# What a repository holds at a revision: the exact commit in $commit, then each file's size and
# hash in $files (name, size, LFS sha256, git blob id; tab-separated).
list_repo() {
  local repo="$1" revision="$2" listing err
  echo "Looking up $repo at $revision..."
  listing="$(online python3 - "$repo" "$revision" <<'PY'
import sys
from huggingface_hub import HfApi
repo, rev = sys.argv[1], sys.argv[2]
try:
    info = HfApi().model_info(repo, revision=rev, files_metadata=True)
except Exception as e:
    print("error " + " ".join(str(e).split())[:300])
    sys.exit(0)
print("commit", info.sha)
for s in info.siblings or []:
    if any(c.isspace() for c in s.rfilename):
        continue
    lfs = getattr(s, "lfs", None)
    sha = (lfs.get("sha256") if isinstance(lfs, dict) else getattr(lfs, "sha256", None)) if lfs is not None else None
    # Git's own id for files kept outside LFS (small ones, such as the tokenizer's).
    blob = getattr(s, "blob_id", None)
    print("\t".join(["file", s.rfilename, str(s.size if s.size is not None else -1), sha or "-", blob or "-"]))
PY
)" || die "Could not reach Hugging Face. Is the network up?"
  err="$(sed -n 's/^error //p' <<< "$listing")"
  [ -z "$err" ] || die "Hugging Face did not answer for $repo at $revision: $err
(A private or gated repository needs a token: sudo halogenctl hf-token)"
  commit="$(sed -n 's/^commit //p' <<< "$listing")"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "Hugging Face gave no commit for $repo at $revision"
  files="$(awk -F'\t' '$1 == "file" { print $2 "\t" $3 "\t" $4 "\t" $5 }' <<< "$listing")"
}
size_of() { awk -F'\t' -v f="$1" '$1 == f { print $2; exit }' <<< "$files"; }
sha_of() { awk -F'\t' -v f="$1" '$1 == f { print $3; exit }' <<< "$files"; }
blob_of() { awk -F'\t' -v f="$1" '$1 == f { print $4; exit }' <<< "$files"; }
has() { [ -n "$(size_of "$1")" ]; }
gib() { awk -v b="$1" 'BEGIN { printf "%.1f GiB", b / 1073741824 }'; }
# Each file must be exactly what the repository holds at that commit (Hugging Face's own hashes).
check_hashes() { # dir file...
  local dir="$1" f s b got; shift
  for f in "$@"; do
    s="$(sha_of "$f")"; b="$(blob_of "$f")"
    if [ "$s" != - ]; then got="$(sha256sum "$dir/$f" | cut -d' ' -f1)"
    elif [ "$b" != - ]; then got="$({ printf 'blob %d\0' "$(stat -c %s "$dir/$f")"; cat "$dir/$f"; } | sha1sum | cut -d' ' -f1)"; s="$b"
    else die "$repo lists no hash for $f, so it can't be checked."; fi
    [ "$got" = "$s" ] || die "$f does not match $repo's hash. Run it again to download it afresh."
  done
}


# --- Converting full-precision weights (halogenctl flash convert) -------------------------------
# A repository of BF16 safetensors (the format models are trained and published in) becomes a
# Halogen checkpoint here, with bf16-to-hgn (github.com/Quat3rnion/bf16-to-hgn, MIT or Apache-2.0,
# built into the image from a pinned commit, CPU only). Only Qwen3.8 Flash Next weights convert,
# and only complete ones: the repository's own MTP head, vision tower and tokenizer are used and
# nothing official is put in their place. The weights download into $convert_dir/<name>/source
# (about 360 GB), convert into flash/<name> (about 119 GB) and are deleted afterwards unless kept.
converter="${HALOS_BF16_TO_HGN:-/usr/libexec/halogen/bf16-to-hgn}"
convert_dir="$models/flash/.convert"
# The files the converter needs besides the weights, and the optional ones it copies when there.
convert_assets_required=(config.json tokenizer.json tokenizer_config.json chat_template.jinja merges.txt generation_config.json)
convert_assets_optional=(vocab.json special_tokens_map.json added_tokens.json preprocessor_config.json video_preprocessor_config.json processor_config.json)
# The output, in bytes: about 119 GB for the v2 profile (bf16-to-hgn's README), plus its own 5%
# and 64 MiB reserve, plus room to spare.
convert_out_bytes="${HALOS_CONVERT_OUT_BYTES:-128000000000}"
# What the converter writes (about 119 GB), for the progress line; the space check keeps a margin.
convert_plan_bytes=119000000000

# The converter parses files anyone on Hugging Face can write, with C++ inside, so it runs as a
# unit of its own under halogen's service manager: no network and no sockets at all (a socket of
# the service manager could start an unrestricted unit), no access to /srv/configs (the API key
# and HF token), halogen's home (its container images) or the manager's runtime folder, the
# models read-only, and write access only to this conversion's work folder. It stops with the
# conversion, and is the first thing the kernel ends when memory runs short, not Halogen.
sandboxed() {
  local w m c l
  w="$(readlink -f "$work")"; m="$(readlink -f "$models")"; c="$(readlink -f "${HALOGEN_CONFIGS_DIR:-/srv/configs}")"
  # No devices (the converter is CPU only; the halogen user could otherwise open the GPU and NPU
  # Halogen is using), not the shared memory Halogen's container shares with the host, not the
  # journal, and not /sysroot, a second path to /var on some installs. (The user manager already
  # gives a sandboxed unit its own user namespace, which keeps other halogen processes' /proc
  # entries closed to it; PrivateUsers only says so.)
  # No sockets: PrivateNetwork takes the network away, and the calls that make a socket are
  # refused too, io_uring's included (it makes one without calling socket(); the converter and its
  # libraries use none of these: no io_uring in its Cargo.lock or source at the pinned commit).
  # That keeps it off the socket files it can still see, such as the system D-Bus.
  # RestrictAddressFamilies=none said the same in the first version, but systemd-run rejects that
  # value ("Invalid argument", systemd 262), so every conversion would have stopped here, after
  # its download. Only 64-bit system calls; it may not change kernel settings or control groups
  # (Halogen's are its own user's).
  # The request records (client conversations, when on) are hidden too: the converter reads
  # weights nobody vouches for and needs only the models and its work folder.
  l="$(readlink -f "${HALOGEN_LOGS_DIR:-/srv/logs}")"
  # Bound to the conversion's unit, so it stops with it (sandbox-check has no such unit).
  local bound=(-p BindsTo=halogen-flash-convert.service -p After=halogen-flash-convert.service)
  [ -z "${SANDBOX_UNBOUND:-}" ] || bound=()
  "${HALOS_SYSTEMD_RUN:-systemd-run}" --user --wait --pipe --collect --quiet "${bound[@]}" \
    -p PrivateNetwork=yes -p "SystemCallFilter=~socket socketpair io_uring_setup io_uring_enter io_uring_register" \
    -p SystemCallErrorNumber=EAFNOSUPPORT -p SystemCallArchitectures=native -p NoNewPrivileges=yes \
    -p ProtectControlGroups=yes -p ProtectKernelTunables=yes \
    -p PrivateUsers=yes -p PrivateDevices=yes \
    -p ProtectSystem=strict -p "ReadOnlyPaths=$m" -p "ReadWritePaths=$w" \
    -p "InaccessiblePaths=-$c -${HOME:-/var/lib/halogen} -/run/user/$(id -u) -$m/.prompt-cache -$l -/dev/shm -/sysroot -/var/log" \
    -p PrivateTmp=yes -p PrivateIPC=yes -p RestrictNamespaces=yes -p LockPersonality=yes \
    -p MemoryDenyWriteExecute=yes -p Nice=10 -p CPUWeight=20 -p OOMScoreAdjust=900 \
    "$@" < /dev/null
}

# The weight files the index names: the converter reads exactly these, flat beside it.
index_shards() {
  local s
  jq -r '.weight_map | [.[]] | unique[]' "$1" 2> /dev/null | while IFS= read -r s; do
    [[ "$s" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.safetensors$ ]] || { echo "BAD $(printf '%s' "$s" | tr -cd '[:print:]' | head -c 80)"; continue; }
    echo "$s"
  done
}

convert_prepare() {
  local repo="" revision=main name="" src f missing=() idx cfg weights=0 need free n shards=() size
  while [ $# -gt 0 ]; do
    case "$1" in
      --revision|--as) [ $# -ge 2 ] || die "$1 needs a value"
        if [ "$1" = --revision ]; then revision="$2"; else name="$2"; fi; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) repo="$1"; shift ;;
    esac
  done
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || die "usage: halogenctl flash convert <hf-repo, such as someone/My-Flash-BF16> [--revision <rev>] [--as <name>]"
  [[ "$revision" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "'$revision' is not a branch, tag or commit"
  name="${name:-${repo##*/}}"
  valid_name "$name" || die "'$name' can't be a checkpoint name: use letters, digits, '.', '_' or '-', not 'official' (pick one with --as)"
  [ ! -e "$models/flash/$name" ] || die "$models/flash/$name already exists. Pick another name with --as, or remove it first: sudo halogenctl flash remove $name"
  [ -x "$converter" ] || die "This image has no converter ($converter)."
  list_repo "$repo" "$revision"
  has model.safetensors.index.json || die "$repo has no model.safetensors.index.json, so it isn't a safetensors checkpoint this can convert."
  for f in "${convert_assets_required[@]}"; do has "$f" || missing+=("$f"); done
  [ "${#missing[@]}" = 0 ] || die "$repo lacks ${missing[*]}, which the converter needs beside the weights."

  # The small files first, to check the model before the big download.
  src="$convert_dir/$name/source"
  # Files left by another repository or commit under this name would end up in the result
  # (the converter copies every optional tokenizer file it finds), so they go first.
  if [ -f "$convert_dir/$name/convert.info" ] && { [ "$(info_get "$convert_dir/$name/convert.info" repo)" != "$repo" ] \
      || [ "$(info_get "$convert_dir/$name/convert.info" commit)" != "$commit" ]; }; then
    rm -rf "${convert_dir:?}/$name"
  fi
  mkdir -p "$src" || exit 1
  mounts=(-v "$src:/models/flash/.convert/$name/source")
  n=(model.safetensors.index.json "${convert_assets_required[@]}")
  for f in "${convert_assets_optional[@]}"; do ! has "$f" || n+=("$f"); done
  online hf download "$repo" "${n[@]}" --revision "$commit" --local-dir "/models/flash/.convert/$name/source" < /dev/null > /dev/null 2>&1 \
    || die "Could not download $repo's small files. Run it again to retry."
  check_hashes "$src" "${n[@]}"
  cfg="$src/config.json"; idx="$src/model.safetensors.index.json"
  jq -e '.model_type == "qwen4_exp" and ((.architectures // []) | index("Qwen4ExpForConditionalGeneration") != null)' "$cfg" > /dev/null 2>&1 \
    || die "$repo isn't Qwen3.8 Flash Next weights ($(jq -r '"model_type " + (.model_type // "none")' "$cfg" 2>/dev/null)). bf16-to-hgn converts only that model."
  # The converter substitutes nothing: an MTP head and a vision tower must be in the weights.
  # (In Hugging Face's names the head is mtp.*, the vision tower model.visual.*.)
  jq -e '.weight_map | keys | any(startswith("mtp.")) and any(startswith("model.visual."))' "$idx" > /dev/null 2>&1 \
    || die "$repo's weights have no $(jq -e '.weight_map | keys | any(startswith("mtp."))' "$idx" > /dev/null 2>&1 && echo "vision tower (model.visual.*)" || echo "MTP head (mtp.*)"). The converter needs the complete model, so it can't convert this one."
  mapfile -t shards < <(index_shards "$idx")
  [ "${#shards[@]}" -gt 0 ] || die "$repo's index names no weight files."
  for f in "${shards[@]}"; do
    case "$f" in BAD\ *) die "$repo's index names a weights file the converter doesn't read (${f#BAD }): in a subfolder, or with an unusual name." ;; esac
    size="$(size_of "$f")"; [ -n "$size" ] || die "$repo's index names $f, which the repository doesn't have."
    [ "$(stat -c %s "$src/$f" 2> /dev/null)" = "$size" ] || weights=$((weights + size))
  done
  need=$((weights + convert_out_bytes))
  free="$(df --output=avail --block-size=1 "$models" | tail -n 1 | tr -d ' ')"
  if [ "$need" -gt "$(( ${free:-0} - 1073741824 ))" ]; then
    die "$repo needs $(gib "$need") ($(gib "$weights") of weights to download, about $(gib "$convert_out_bytes") for the result) and $models has $(gib "${free:-0}") free."
  fi
  { echo "repo=$repo"; echo "revision=$revision"; echo "commit=$commit"; } > "$convert_dir/$name/convert.info" || exit 1
  echo "name=$name"
  echo "download=$(gib "$weights")"
  echo "result=about $(gib "$convert_out_bytes")"
}

convert_run() {
  local name="$1" threads="" keep=0 info repo commit src out started reporter f shards=() rc
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --threads)
        if ! [[ "${2:-}" =~ ^[0-9]{1,2}$ ]] || [ "$2" -lt 1 ] || [ "$2" -gt 64 ]; then die "--threads takes 1 to 64"; fi
        threads="$2"; shift 2 ;;
      --keep-source) keep=1; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  valid_name "$name" || die "bad name"
  work="$convert_dir/$name"; info="$work/convert.info"; src="$work/source"; out="$models/flash/$name"; staged="$work/out/$name"
  [ -f "$info" ] || die "Nothing prepared for $name: start with sudo halogenctl flash convert <repo>"
  repo="$(info_get "$info" repo)"; commit="$(info_get "$info" commit)"
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "$info names no repository"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "$info names no commit"
  [ ! -e "$out" ] || die "$out already exists. Remove it first: sudo halogenctl flash remove $name"
  # By default half the cores, at most 16; --threads as given.
  if [ -z "$threads" ]; then threads=$(( $(nproc) / 2 )); [ "$threads" -ge 1 ] || threads=1; [ "$threads" -le 16 ] || threads=16; fi

  # The weights, resumable, then checked against the repository's hashes.
  list_repo "$repo" "$commit"
  mapfile -t shards < <(index_shards "$src/model.safetensors.index.json")
  [ "${#shards[@]}" -gt 0 ] || die "$repo's index names no weight files."
  for f in "${shards[@]}"; do case "$f" in BAD\ *) die "$repo's index names a weights file the converter doesn't read." ;; esac; done
  # The converter refuses weight files its index doesn't name.
  for f in "$src"/*.safetensors; do
    [ -e "$f" ] || continue
    case " ${shards[*]} " in *" ${f##*/} "*) ;; *) rm -f "$f" ;; esac
  done
  mounts=(-v "$src:/models/flash/.convert/$name/source")
  echo "Downloading ${#shards[@]} weight files of $repo at commit ${commit:0:12} into $src. An interrupted download resumes."
  if [ "$progress_s" -gt 0 ]; then
    while sleep "$((progress_s * 10))" > /dev/null 2>&1; do echo "  $(du -sh "$src" 2>/dev/null | cut -f1) downloaded so far"; done &
    reporter=$!
  fi
  online hf download "$repo" "${shards[@]}" --revision "$commit" --local-dir "/models/flash/.convert/$name/source" < /dev/null 2>&1 \
    | grep --line-buffered -v -e '^Hint: ' -e 'hf update' -e 'Still waiting to acquire lock' -e 'sending unauthenticated requests' -e "^/models/flash/.convert/$name/source\$"
  rc="${PIPESTATUS[0]}"
  [ -z "${reporter:-}" ] || kill "$reporter" 2> /dev/null
  [ "$rc" = 0 ] || die "The download stopped. Start the conversion again to resume it."
  echo "Checking the weights against $repo's hashes..."
  check_hashes "$src" "${shards[@]}"
  rm -rf "$src/.cache"

  # The converter writes only inside the work folder: its staging folder goes beside --output,
  # and a conversion stopped part-way leaves one it never resumes.
  rm -rf "${work:?}/out"; mkdir -p "$work/out" || exit 1
  started="$(date -u +%s)"
  echo "Converting on the CPU with $threads threads. This takes many hours, likely a day or more;"
  echo "Halogen keeps serving meanwhile, more slowly. Progress is logged every 10 minutes."
  # About how far: the converter writes its output into files of their final size, filling them
  # in as it goes, so the space actually used grows with the work done.
  ( while sleep 600; do
      used="$(du -sk "$work/out" 2> /dev/null | awk '{ print $1 + 0 }')"
      echo "  converted about $(awk -v k="$used" -v t="$convert_plan_bytes" 'BEGIN { printf "%.0f GB of about %.0f GB", k * 1024 / 1e9, t / 1e9 }'), $(( ($(date -u +%s) - started) / 3600 ))h$(( ($(date -u +%s) - started) / 60 % 60 ))m so far"
    done ) &
  reporter=$!
  sandboxed "$converter" convert --source "$src" --output "$staged" --profile v2 --threads "$threads" \
    > "$work/convert.json" 2> "$work/convert.err"
  rc=$?
  kill "$reporter" 2> /dev/null
  tr -d '\000-\010\013-\037\177' < "$work/convert.err" | tail -n 20
  [ "$rc" = 0 ] || die "The conversion failed (above). The downloaded weights stay in $src: start it again to retry, or remove them: sudo halogenctl flash convert-stop $name"
  echo "Converted in $(( ($(date -u +%s) - started) / 3600 )) hours. Checking every value it wrote against the weights..."
  sandboxed "$converter" verify --source "$src" --output "$staged" > "$work/verify.json" 2> "$work/verify.err" \
    || { tr -d '\000-\010\013-\037\177' < "$work/verify.err" | tail -n 20; die "bf16-to-hgn's verify failed (above); the result is not used."; }
  # Into place only now, and never over anything.
  if ! mv -T -n "$staged" "$out" || [ -e "$staged" ]; then die "Could not move the result to $out."; fi
  cp "$work/convert.json" "$out/convert-report.json" 2> /dev/null || true

  { echo "repo=$repo"
    echo "revision=$(info_get "$info" revision)"
    echo "commit=$commit"
    echo "checkpoint=model.hgn"
    echo "converted_with=bf16-to-hgn ${BF16_TO_HGN_COMMIT:-unknown}, profile v2"
    echo "pulled_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo "verified=no"; } > "$out/halos.info.new" && mv -f "$out/halos.info.new" "$out/halos.info" || exit 1
  verify_dir "$name" || die "$name failed Halogen's verify (above), so it can't be used. Remove it: sudo halogenctl flash remove $name"
  if [ "$keep" = 1 ]; then echo "The downloaded weights stay in $src (--keep-source)."
  else rm -rf "${convert_dir:?}/$name"; echo "The downloaded weights were removed, to free the space."; fi
  echo "$name is ready: converted from $repo at commit ${commit:0:12}, checked by bf16-to-hgn and Halogen's verify."
  echo "A converted model hasn't been measured for quality yet: run sudo halogenctl flash check $name before serving it."
}

case "${1:-}" in
  check|check-prepare)
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash check <name>, as sudo halogenctl flash list shows it"
    [ -f "$models/flash/$name/halos.info" ] || die "No checkpoint called $name. See: sudo halogenctl flash list"
    if [ -L "$models/flash/$name" ] || [ -L "$models/flash/$name/halos.info" ]; then die "$models/flash/$name holds links; pull it again."; fi
    if [ "$1" = check-prepare ]; then check_prepare "$name"; else check_dir_run "$name"; fi
    exit 0 ;;
  verify)
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash verify <name>, as sudo halogenctl flash list shows it"
    [ -f "$models/flash/$name/halos.info" ] || die "No checkpoint called $name. See: sudo halogenctl flash list"
    if verify_dir "$name"; then echo "$name passed Halogen's verify."
    else die "$name failed Halogen's verify (above), so it can't be used. Pull it again, or remove it: sudo halogenctl flash remove $name"; fi
    exit 0 ;;
  sandbox-check)
    # The converter's real sandbox, with the converter's --help in it and a few probes: the VM
    # install test runs this, since no conversion runs there and a property systemd-run refuses
    # would otherwise first show after a 360 GB download. Prints what it finds; 0 when all hold.
    # As halogen only, and through no link: root must not make or remove folders here.
    [ "$(id -un)" = halogen ] || die "sandbox-check runs as the halogen user"
    work="$convert_dir/.sandbox-check"
    for d in "$models/flash" "$convert_dir" "$work"; do [ ! -L "$d" ] || die "$d is a link"; done
    mkdir -p "$convert_dir" || exit 1
    mkdir "$work" || die "couldn't make $work (left from an earlier run? rmdir it)"
    command -v python3 > /dev/null || die "sandbox-check needs python3 for its socket probe"
    # shellcheck disable=SC2016 # expanded by the sandboxed shell, from its arguments
    SANDBOX_UNBOUND=1 sandboxed /bin/sh -c '
      r=0; no() { echo "sandbox-check: $1"; r=1; }
      touch "$1/probe" 2>/dev/null || no "the work folder is not writable"
      if touch "$2/.sandbox-probe" 2>/dev/null; then rm -f "$2/.sandbox-probe"; no "the models are writable"; fi
      if [ -e /dev/kfd ] || [ -e /dev/ttyS0 ] || [ -e /dev/accel ]; then no "devices are in reach"; fi
      for p in /var/log /dev/shm "$4" "$5"; do if [ -r "$p" ]; then no "$p is readable"; fi; done
      if [ "$(grep -c : /proc/self/net/dev)" != 1 ]; then no "it has a network: $(grep -o "^ *[a-z0-9]*:" /proc/self/net/dev | tr -d " \n")"; fi
      python3 -c "import socket; socket.socket(socket.AF_UNIX)" 2>/dev/null; s=$?
      if [ "$s" = 0 ]; then no "a socket could be made"; fi
      python3 -c "pass" || no "python3 does not run here, so the socket probe proves nothing"
      "$3" --help > /dev/null 2>&1 || no "the converter does not start"
      exit "$r"' sh "$(readlink -f "$work")" "$(readlink -f "$models")" "$converter" "/run/user/$(id -u)" "$(readlink -f "${HALOGEN_CONFIGS_DIR:-/srv/configs}")"
    r=$?; rm -f "$work/probe"; rmdir "$work" 2> /dev/null
    if [ "$r" = 0 ]; then echo "sandbox-check: ok"; fi
    exit "$r" ;;
  convert-prepare) shift; convert_prepare "$@"; exit 0 ;;
  convert-run) shift; convert_run "$@"; exit 0 ;;
  pull) shift ;;
  *) die "usage: flash-checkpoint pull <hf-repo> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn>] | verify <name> | check-prepare <name> | check <name>" ;;
esac

repo=""; revision=main; name=""; want_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --revision|--as|--file)
      [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --revision) revision="$2" ;; --as) name="$2" ;; --file) want_file="$2" ;; esac
      shift 2 ;;
    -*) die "unknown option $1" ;;
    *) repo="$1"; shift ;;
  esac
done
case "$repo" in
  */*) ;;
  *) die "usage: halogenctl flash pull <hf-repo, such as someone/My-Flash-HGN> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn>]" ;;
esac
[[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "'$repo' is not a Hugging Face repository name"
[[ "$revision" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "'$revision' is not a branch, tag or commit"
name="${name:-${repo##*/}}"
valid_name "$name" || die "'$name' can't be a checkpoint name: use letters, digits, '.', '_' or '-', not 'official' (pick one with --as)"
dir="$models/flash/$name"
info="$dir/halos.info"
if [ -f "$info" ] && [ "$(info_get "$info" repo)" != "$repo" ]; then
  die "$name already holds $(info_get "$info" repo). Pick another name with --as, or remove it first: sudo halogenctl flash remove $name"
fi
[ -f "$models/tokenizer/tokenizer.json" ] \
  || die "The official model isn't downloaded yet. Let the first boot finish: sudo halogenctl fetch-logs"

list_repo "$repo" "$revision"

# The checkpoint: a .hgn in the repository's top folder that isn't one of its companions.
candidates="$(cut -f1 <<< "$files" | grep -E '^[A-Za-z0-9._-]+\.hgn$' | grep -vE 'ngram|vision|mtp|overlay' || true)"
if [ -n "$want_file" ]; then
  grep -qxF -- "$want_file" <<< "$candidates" \
    || die "$repo has no checkpoint called $want_file. Its checkpoints: $(tr '\n' ' ' <<< "$candidates")"
  checkpoint="$want_file"
else
  case "$(grep -c . <<< "$candidates")" in
    0) if grep -qiE '^[^[:space:]]+\.gguf[[:space:]]' <<< "$files"; then
         die "$repo holds GGUF files, not a Halogen .hgn checkpoint. halogenctl can't pull a GGUF yet."
       fi
       die "$repo has no Halogen .hgn checkpoint in its top folder." ;;
    1) checkpoint="$candidates" ;;
    *) die "$repo holds several checkpoints. Pick one with --file: $(tr '\n' ' ' <<< "$candidates")" ;;
  esac
fi
wanted=("$checkpoint")
overlay="${checkpoint%.hgn}.overlay.hgn"
! has "$overlay" || wanted+=("$overlay")
! has "$vision" || wanted+=("$vision")
mapfile -t tokenizer < <(cut -f1 <<< "$files" | grep -E '^tokenizer/[A-Za-z0-9._-]+\.(json|jinja|txt|model|tiktoken)$' || true)
wanted+=("${tokenizer[@]}")

# Enough room for everything still missing, the lookup table included until we know.
need=0; sized=("${wanted[@]}")
! has "$table" || sized+=("$table")
for f in "${sized[@]}"; do
  s="$(size_of "$f")"; [ "${s:-0}" -gt 0 ] || continue
  [ "$(stat -c %s "$dir/$f" 2>/dev/null)" = "$s" ] || need=$((need + s))
done
free="$(df --output=avail --block-size=1 "$models" | tail -n 1 | tr -d ' ')"
if [ "$need" -gt "$(( ${free:-0} - 1073741824 ))" ]; then
  die "$repo needs $(gib "$need") more and $models has $(gib "${free:-0}") free."
fi

if [ "$(head -n 1 "$flash_choice" 2>/dev/null | tr -d '[:space:]')" = "$name" ]; then
  die "$name is the checkpoint Halogen serves. Switch first (sudo halogenctl flash use official), then pull it again."
fi
mkdir -p "$dir" || exit 1
mounts=(-v "$dir:/models/flash/$name")
# From the first byte until the checks pass, the folder counts as unchecked.
# A new download also makes an earlier flash check's numbers stale.
if [ -f "$info" ]; then
  { grep -v -e '^verified' -e '^checked' "$info"; echo "verified=no"; } > "$info.new" && mv -f "$info.new" "$info" || exit 1
fi
rm -f "$dir/check.json"
echo "Downloading $checkpoint from $repo at commit ${commit:0:12} into $dir ($(gib "$need") to fetch). An interrupted download resumes."
if [ "$progress_s" -gt 0 ]; then
  while sleep "$progress_s" > /dev/null 2>&1; do echo "  $(du -sh "$dir" 2>/dev/null | cut -f1) so far"; done &
  reporter=$!
  trap 'kill "$reporter" 2>/dev/null' EXIT
fi
fetch() {
  online hf download "$repo" "$@" --revision "$commit" --local-dir "/models/flash/$name" < /dev/null \
    2>&1 | grep --line-buffered -v -e '^Hint: ' -e 'hf update' -e 'Still waiting to acquire lock' \
      -e 'sending unauthenticated requests' -e "^/models/flash/$name\$"
  [ "${PIPESTATUS[0]}" = 0 ] || die "The download stopped. Run the same command again to resume it."
}
fetch "${wanted[@]}"

# Does the checkpoint carry the model's lookup table, or need it beside it? Halogen's server
# binary says, the same way its start script asks.
facts="$(offline --entrypoint /usr/local/bin/flash_serve "$HALOGEN_IMAGE" --resident-gib "/models/flash/$name/$checkpoint" 2>/dev/null \
  | grep -E '^[0-9]+\.[0-9] [01]( [01]){0,2}( [0-9]+\.[0-9])?$' | tail -n 1)"
own_table="$(awk '{ print $2 }' <<< "$facts")"
if [ "$own_table" = 1 ]; then
  echo "The checkpoint carries its own lookup table."
elif has "$table"; then
  # A table from an earlier pull that this commit doesn't have goes first (a link is removed,
  # never written through, so the official table is never touched).
  if [ -e "$dir/$table" ] && [ "$(sha256sum "$dir/$table" | cut -d' ' -f1)" != "$(sha_of "$table")" ]; then
    rm -f -- "$dir/$table"
  fi
  # Many builds of the same model share the official table. Then the same file is linked in
  # (a hard link: no extra disk, and Halogen sees a plain file), not downloaded again.
  if [ "$(stat -c %s "$models/$table" 2>/dev/null)" = "$(size_of "$table")" ] && [ ! -e "$dir/$table" ] &&
     [ "$(sha256sum "$models/$table" | cut -d' ' -f1)" = "$(sha_of "$table")" ]; then
    ln "$models/$table" "$dir/$table" && echo "Its lookup table is the official one, so that file is shared rather than downloaded."
  fi
  if [ ! -e "$dir/$table" ]; then
    echo "Downloading its lookup table, $table ($(gib "$(size_of "$table")"))."
    fetch "$table"
  fi
  wanted+=("$table")
elif [ "$own_table" = 0 ]; then
  die "$checkpoint needs a lookup table ($table) beside it, and $repo has none. It can't run."
else
  echo "Note: Halogen couldn't say whether $checkpoint needs a lookup table, and $repo has none." \
       "If Halogen asks for one at start, go back with: sudo halogenctl flash use official"
fi
[ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null

echo "Checking the files against $repo's hashes..."
check_hashes "$dir" "${wanted[@]}"

# Files from an earlier pull that this commit doesn't have would still be loaded (an old
# quality sidecar beside a new checkpoint), so they go.
for f in "$dir"/*.hgn; do
  [ -e "$f" ] || [ -L "$f" ] || continue
  keep=0; for w in "${wanted[@]}"; do [ "$w" != "$(basename "$f")" ] || keep=1; done
  [ "$keep" = 1 ] || { echo "Removing $(basename "$f") from an earlier pull."; rm -f -- "$f"; }
done
if [ "${#tokenizer[@]}" -gt 0 ]; then
  for f in "$dir"/tokenizer/* "$dir"/tokenizer/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    keep=0; for w in "${tokenizer[@]}"; do [ "$w" != "tokenizer/$(basename "$f")" ] || keep=1; done
    [ "$keep" = 1 ] || rm -rf -- "$f"
  done
fi

# Halogen finds tokenizer/ beside the checkpoint. A repository without one gets the official
# tokenizer, copied rather than linked; Halogen checks its chat template at start.
if [ "${#tokenizer[@]}" = 0 ]; then
  echo "$repo has no tokenizer/, so the official tokenizer is copied in."
  rm -rf "$dir/tokenizer" && cp -r "$models/tokenizer" "$dir/tokenizer" || exit 1
fi

{ echo "repo=$repo"
  echo "revision=$revision"
  echo "commit=$commit"
  echo "checkpoint=$checkpoint"
  echo "pulled_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
  echo "verified=no"; } > "$info.new" && mv -f "$info.new" "$info" || exit 1

if ! verify_dir "$name"; then
  die "$name failed Halogen's verify (above), so it can't be used. Remove it: sudo halogenctl flash remove $name"
fi
echo "$name is ready: $checkpoint from $repo at commit ${commit:0:12}, checked by Halogen's verify."
echo "name=$name"
