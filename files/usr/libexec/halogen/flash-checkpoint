#!/bin/bash
# Your own Flash checkpoints in /srv/models/flash/<name>, beside the official one. Runs as
# the halogen user; halogenctl flash pull and flash verify start it.
#   flash-checkpoint pull <hf-repo> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn|build.gguf>] [--keep-gguf]
#   flash-checkpoint verify <name>
#   flash-checkpoint use <name>|official    (halogenctl flash use, after it asked; writes the choice)
#   flash-checkpoint remove <name>          (halogenctl flash remove, after it asked)
#   flash-checkpoint check-prepare <name>   (checks the name, downloads the test text)
#   flash-checkpoint check <name>           (halogenctl stops Halogen first: ppl needs the GPU)
#   flash-checkpoint convert-prepare <hf-repo> [--revision <rev>] [--as <name>]
#   flash-checkpoint convert-run <name> [--threads <n>] [--keep-source]   (halogenctl flash convert)
#   flash-checkpoint sandbox-check          (the converter's sandbox with probes in it; the VM test)
# Everything runs in the pinned Halogen image: hf and Python list and download, and Halogen's
# own tools read the checkpoint back. Only the files Halogen loads are downloaded.
set -uo pipefail
release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
hf_token="${HALOGEN_HF_TOKEN_FILE:-/srv/configs/hf-token}"
progress_s="${HALOGEN_PROGRESS_S:-30}"
state="${HALOGEN_STATE_DIR:-/var/lib/halogen}"
# shellcheck disable=SC1090
. "$release"

table=qwen38-flash-next-ngram.hgn
vision=qwen38-flash-next-vision.hgn
vision27=qwen38-27b-vision.hgn
die() { echo "$*" >&2; exit 1; }
# podman and its conmon would inherit the pull lock (fd 9) and hold it after a hard kill, for as
# long as a leftover container runs: every podman call closes it.
podman() { command podman "$@" 9>&- 6>&-; }
# GPU work run as halogen: a GGUF conversion and a flash check's measurement must not overlap
# (both use the GPU; halogenctl's own GPU lock is root's and covers only its own commands). Held
# on fd 6 until this ends (7 is the drafter list's lock). A conversion waits for a check; a check refuses (75) while a
# conversion runs, since halogenctl has stopped Halogen for it.
gpu_work() {
  exec 6>> "$state/gpu-work.lock" || die "Can't open the GPU lock in $state."
  if [ "$1" = wait ]; then
    flock -n 6 && return 0
    echo "Waiting for a flash check to finish using the GPU..."
    flock 6 || die "Can't take the GPU lock in $state."
  else
    flock -n 6 || { echo "A GGUF conversion is using the GPU (halogenctl flash pull). Wait for it to end, then try again." >&2; exit 75; }
  fi
}
# Says who holds a pull lock: the process group written in it, with a way to stop it, when that
# is still one of this user's (a pull stopped with Ctrl-C goes on in the background).
lock_busy() {
  local g
  g="$(head -c 16 -- "$1" 2>/dev/null | tr -cd 0-9)"
  # Only a real process group of this user's, and never 1 (kill -- -1 signals everything).
  if [ -n "$g" ] && [ "$g" -gt 1 ] && [ "$(ps -o pgid= -p "$g" 2>/dev/null | tr -cd 0-9)" = "$g" ] \
     && [ "$(stat -c %u "/proc/$g" 2>/dev/null)" = "$(id -u)" ]; then
    echo "Another $2 is running. One stopped with Ctrl-C goes on in the background; to stop it: sudo kill -- -$g" >&2
    exit 75
  fi
  echo "Another $2 is running. Wait for it to end, then try again." >&2
  exit 75
}
flash_choice="${HALOGEN_FLASH_FILE:-${HALOGEN_CONFIGS_DIR:-/srv/configs}/flash-checkpoint}"
# Your own checkpoints that use the official draft head (flash drafter <name> on), one name a line.
drafter_choice="${HALOGEN_DRAFTER_CHOICE_FILE:-${HALOGEN_CONFIGS_DIR:-/srv/configs}/flash-drafter}"
valid_name() {
  case "$1" in [A-Za-z0-9]*) ;; *) return 1 ;; esac
  # off and official-r2 are flash drafter choices: a checkpoint of that name would be read as one.
  case "$1" in *[!A-Za-z0-9._-]*|official|off|official-r2) return 1 ;; esac
}
case "${1:-}" in
  sandbox-check|use|remove|drafter|convert-clear) ;;
  *) podman image exists "$HALOGEN_IMAGE" || die "The Halogen image isn't downloaded yet. Let the first boot finish: sudo halogenctl fetch-logs" ;;
esac

token_args=()
[ ! -s "$hf_token" ] || token_args=(-v "$hf_token:/run/secrets/hf-token:ro" -e HF_TOKEN_PATH=/run/secrets/hf-token)
# Online, for listing and downloading: no capabilities, a read-only image, and only the mounts
# in $mounts (none for the listing, the checkpoint's own folder for the download).
mounts=()
# Each online container of a pull (or a conversion's download) is named after the checkpoint: a
# leftover one (an interrupted pull: outside this command's process tree, with the network and
# the checkpoint's folder writable) is replaced, and the last one is removed when this ends.
# (Containers run in pipelines and $(...), so the name is worked out again at exit, from the
# checkpoint's name and the kind: a pull never removes a conversion's container, and only a
# pull or conversion removes one at all, never verify or check.)
ctr_kind=pull-flash
ctr_owned=""
ctr_for() { [[ "${name:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && echo "halogen-$ctr_kind-$name"; }
cleanup() {
  local c
  [ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null
  if [ -n "$ctr_owned" ] && c="$(ctr_for)"; then podman rm -f -i -t 0 "$c" > /dev/null 2>&1 || true; fi
}
trap cleanup EXIT
trap 'exit 130' INT; trap 'exit 143' TERM HUP
# One command on a checkpoint at a time (#119): pull, conversion, verify, check, use and remove
# all take the name's lock, so none sees the folder or its halos.info half-written by another, a
# removal can't take away the checkpoint a switch just chose, and a pull can't start replacing the
# one being switched to. A second pull would also replace the first's container, and the first's
# end would remove the second's. Taken before anything is removed or started, and held until this
# ends; one that is taken already is a busy message (exit 75), never a wait.
name_lock() {
  local lock="$state/pull-flash-$1.lock"
  exec 9>> "$lock" || die "Can't open the checkpoint lock in $state."
  flock -n 9 || lock_busy "$lock" "pull, check or other command on $1"
  # The process group only for a pull or a conversion ($2 = owned), the ones that go on in the
  # background after Ctrl-C; any other command leaves the lock empty, so one it blocks says
  # "wait", never names a group to stop.
  if [ "${2:-}" = owned ]; then ps -o pgid= -p "$$" 2>/dev/null | tr -cd 0-9 > "$lock" || true
  else : > "$lock" || true; fi
}
# In a subshell of its own, with the client in the background: a stop (TERM, HUP or INT) is acted
# on at once, not after the client returns (it waits on a container that may ignore the signal),
# and a named container goes with it.
online() (
  local c="" ctr_args=()
  if [ -n "$ctr_owned" ] && c="$(ctr_for)"; then ctr_args=(--name "$c" --replace); fi
  trap '[ -z "$c" ] || podman rm -f -i -t 0 "$c" > /dev/null 2>&1; exit 143' TERM HUP
  trap '[ -z "$c" ] || podman rm -f -i -t 0 "$c" > /dev/null 2>&1; exit 130' INT
  podman run --rm -i --pull=never "${ctr_args[@]}" --read-only --tmpfs /tmp --cap-drop=all --security-opt no-new-privileges \
    -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=0 -e HF_HUB_DISABLE_TELEMETRY=1 -e HF_HUB_DISABLE_PROGRESS_BARS=1 \
    "${token_args[@]}" "${mounts[@]}" --entrypoint "$1" "$HALOGEN_IMAGE" "${@:2}" <&0 &
  wait "$!"
)
# Halogen's own tools on a downloaded file: offline, no capabilities, read-only models, and
# exactly the flags the fetch gives the official verify. --ipc=host stays: Halogen's docs run
# its tools with it, because without it SELinux refuses the container the GPU on Fedora.
# Halogen's prompt cache (conversation state) is hidden from these containers: none of them needs
# it, and the download one has network. An empty read-only tmpfs takes its place; notmpcopyup,
# or podman copies the folder's files into it. podman can't make the
# mount point on a read-only /models, so a missing folder is made first (this runs as halogen, as
# prepare does at boot). A link in its place is refused: the tmpfs would land on whatever it points
# to, and Halogen's start refuses it anyway (preflight).
# Not for use, remove, drafter and sandbox-check, which start no container: going back to the official
# checkpoint must work whatever stands there.
case "${1:-}" in
  sandbox-check|use|remove|drafter|convert-clear) ;;
  *)
    if [ -L "$models/.prompt-cache" ]; then
      echo "$models/.prompt-cache is a link, not a folder. Remove it, then start again: sudo halogenctl restart" >&2; exit 1
    fi
    [ -d "$models/.prompt-cache" ] || mkdir -m 0700 "$models/.prompt-cache" || exit 1 ;;
esac
hide_cache=(--tmpfs "/models/.prompt-cache:ro,size=4k,notmpcopyup")
# A folder is mounted into a container only when no link stands in its path: podman follows a
# link at a mount source, and a container that can write a folder here (Halogen's own, or an
# earlier download) could plant one that points at /srv/configs. The folder must be exactly where
# its name says, under the real /srv/models.
# Writes a new file from stdin, never through a link a download container left under that name:
# the name is removed, then created exclusively.
write_new() { rm -f -- "$1" && ( set -C; cat > "$1" ); }
# Sets a checkpoint's draft head choice in the list (name=official|off|<file>, one a line; a
# checkpoint not listed uses the official one), or drops its line when the value is empty. Only
# well-formed lines are kept, so a line someone added by hand can't pass anything odd along.
# Written fresh and moved into place, as the checkpoint choice is.
drafter_set() {
  local list
  # One list for every name, so two of these on different checkpoints take turns (each name's
  # own lock doesn't cover the list). Held until this ends.
  exec 7>> "$state/flash-drafter.lock" || die "Can't open the draft head lock in $state."
  flock -w 30 7 || die "Another flash drafter or remove is saving the list. Try again."
  list="$( { { grep -E '^[A-Za-z0-9][A-Za-z0-9._-]*=[A-Za-z0-9][A-Za-z0-9._-]*$' -- "$drafter_choice" 2> /dev/null || true; } \
      | N="$1" awk -F= '$1 != ENVIRON["N"]'
    [ -z "$2" ] || printf '%s=%s\n' "$1" "$2"; } | sort -u)"
  if ! { [ -z "$list" ] || printf '%s\n' "$list"; } | ( umask 027; write_new "$drafter_choice.new" ) \
    || ! mv -T -f -- "$drafter_choice.new" "$drafter_choice"; then
    rm -f -- "$drafter_choice.new"
    die "Couldn't save the choice in $drafter_choice (is something other than a file there?)."
  fi
}
plain_dir() { [ -d "$1" ] && [ "$(realpath -e -- "$1" 2>/dev/null)" = "$(realpath -e -- "$models")/${1#"$models"/}" ]; }
# mkdir -p under the models folder that never goes through a link: each step is looked at first.
mk_plain() {
  local rel="${1#"$models"/}" p="$models" c parts
  [ "$rel" != "$1" ] || return 1
  IFS=/ read -ra parts <<< "$rel"
  for c in "${parts[@]}"; do
    p="$p/$c"
    [ ! -L "$p" ] || return 1
    [ -d "$p" ] || mkdir "$p" || return 1
  done
  plain_dir "$1"
}
offline() {
  podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" "${hide_cache[@]}" \
    --network=none --cap-drop=all --security-opt no-new-privileges "$@"
}
info_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n 1; }
info_get_all() { sed -n "s/^$2=//p" "$1" 2>/dev/null; }
# The model a .hgn file declares (header bytes 40..103 of an HGN1 file, where Halogen's
# entrypoint reads it: hgn_model_id).
# Only NULs are dropped, as there: a byte it would keep must not make another answer here.
model_id_of() {
  [ "$(timeout 5 head -c 4 -- "$1" 2>/dev/null)" = HGN1 ] || return 0
  timeout 5 head -c 104 -- "$1" 2>/dev/null | tail -c 64 | tr -d '\0'
}
# Halogen 0.21.0 serves Qwen3.8-27B from the same image, with an engine of its own. Its entrypoint
# (engine_for_checkpoint) picks that engine by the model the header names, qwen3.8-27b-*; it
# refuses a file whose header names none (the qwen38-27b-*.hgn name counts only for a file not
# there yet, as the pull's first guess). The 27B takes no lookup table and no draft head file,
# and its vision tower is qwen38-27b-vision.hgn.
is_27b_file() { [[ "$(model_id_of "$1")" == qwen3.8-27b-* ]]; }
# The ids the entrypoint calls companions, not checkpoints: verify passes them, a start refuses them.
is_companion_id() {
  case "$1" in qwen3.8-flash-next-mtp*|qwen3.8-flash-next-ngram*|qwen3.8-flash-next-vision*|qwen3.8-flash-next-drafter*|qwen3.8-27b-vision*) return 0 ;; esac
  return 1
}
# The checkpoint file of a folder's halos.info, when it is a plain file there.
ck_file() {
  local ck; ck="$(info_get "$models/flash/$1/halos.info" checkpoint)"
  [[ "$ck" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] && [ -f "$models/flash/$1/$ck" ] && [ ! -L "$models/flash/$1/$ck" ] || return 1
  printf '%s\n' "$models/flash/$1/$ck"
}
# The names a draft head file a repository ships may have (as the pull picks them).
is_drafter_name() { [[ "$1" =~ ^[A-Za-z0-9._-]*drafter[A-Za-z0-9._-]*\.hgn$ ]]; }

# verify every .hgn of a checkpoint folder with Halogen's verify, and record the answer.
# Halogen reads tokenizer/tokenizer.json beside the checkpoint and won't start without it. Some
# repositories ship only a chat template and settings there (Signal-3.8-Flash-Next-HGN-v2 does):
# the vocabulary files then come from the official tokenizer, the model's own, and the
# repository's chat template and settings stay. A folder with none at all gets the official one.
fill_tokenizer() {
  local dir="$1" f added=""
  [ ! -L "$dir/tokenizer" ] || { echo "$dir/tokenizer is a link; pull it again." >&2; return 1; }
  [ ! -f "$dir/tokenizer/tokenizer.json" ] || return 0
  # The official tokenizer's files are copied into the checkpoint, where the next download
  # container can read them: a link among them could point at something private.
  if [ -L "$models/tokenizer" ] || [ -n "$(find "$models/tokenizer" -maxdepth 1 -type l 2>/dev/null | head -n 1)" ]; then
    echo "The official tokenizer folder holds a link; download it again (sudo rm -r $models/tokenizer, then sudo halogenctl restart)." >&2; return 1
  fi
  [ -f "$models/tokenizer/tokenizer.json" ] || { echo "The official tokenizer is missing; let the download finish (sudo halogenctl fetch-logs)." >&2; return 1; }
  if [ ! -d "$dir/tokenizer" ]; then cp -r -P "$models/tokenizer" "$dir/tokenizer" || return 1; return 0; fi
  # A repository with a vocabulary of its own says it differs from the official one: halOS
  # can't build its tokenizer.json, and mixing the two would tokenize wrongly without a word.
  # Files identical to the official ones are the copies an earlier check added.
  for f in "$dir"/tokenizer/vocab.json "$dir"/tokenizer/merges.txt "$dir"/tokenizer/tokenizer.model "$dir"/tokenizer/*.tiktoken; do
    if [ -f "$f" ] && [ ! -L "$f" ] && [ -f "$models/tokenizer/$(basename "$f")" ] \
       && [ "$(sha256sum < "$f")" = "$(sha256sum < "$models/tokenizer/$(basename "$f")")" ]; then continue; fi
    if [ -e "$f" ] || [ -L "$f" ]; then
      echo "Its tokenizer/ has a vocabulary of its own ($(basename "$f")) but no tokenizer.json, which halOS can't build." >&2
      return 1
    fi
  done
  for f in tokenizer.json vocab.json merges.txt; do
    if [ -f "$models/tokenizer/$f" ] && [ ! -e "$dir/tokenizer/$f" ] && [ ! -L "$dir/tokenizer/$f" ]; then
      cp -P "$models/tokenizer/$f" "$dir/tokenizer/$f" || return 1
      added+=" $f"
    fi
  done
  echo "Its tokenizer/ has no tokenizer.json, so the official vocabulary was added (${added# }); its own chat template and settings stay."
}

verify_dir() {
  local name="$1" dir="$models/flash/$1" info="$models/flash/$1/halos.info" f result=pass checked=0 ck own=unknown facts model=""
  # A link could point at a file that changes after it was checked, so links are never checked.
  if [ -L "$dir" ] || [ -L "$info" ]; then echo "$dir holds links; pull it again." >&2; return 1; fi
  ck="$(info_get "$info" checkpoint)"
  if [[ "$ck" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] && [ -f "$dir/$ck" ] && [ ! -L "$dir/$ck" ]; then
    if is_27b_file "$dir/$ck"; then model=qwen3.8-27b; else model=qwen3.8-flash-next; fi
    if is_companion_id "$(model_id_of "$dir/$ck")"; then
      echo "$ck is a companion file (its header says $(model_id_of "$dir/$ck" | tr -cd '[:print:]')), not a checkpoint: Halogen won't serve it." >&2; result=fail
    fi
  fi
  # The official tokenizer is Flash-Next's: a 27B must bring its own.
  if [ "$model" = qwen3.8-27b ] && [ ! -f "$dir/tokenizer/tokenizer.json" ]; then
    echo "$dir/tokenizer has no tokenizer.json, and halOS has none for Qwen3.8-27B." >&2; result=fail
  elif [ "$model" != qwen3.8-27b ] && { ! fill_tokenizer "$dir" || [ ! -f "$dir/tokenizer/tokenizer.json" ]; }; then
    echo "So $dir/tokenizer has no tokenizer.json, which Halogen needs to start." >&2; result=fail
  fi
  for f in "$dir"/*.hgn; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    if [ -L "$f" ] || [ ! -f "$f" ]; then echo "$(basename "$f") is not a plain file." >&2; result=fail; continue; fi
    # Halogen's verify takes the checkpoint and its sidecars, not the lookup table, which the
    # pull checks against the repository's hash instead (as the fetch does for the official one).
    [ "$(basename "$f")" != "$table" ] || continue
    # So are draft head files the repository ships (flash drafter <name> <file>): Halogen's verify
    # isn't run on the official draft head either. Only names a draft head can have, never the
    # checkpoint: a drafter= line can't take a file out of the check.
    if is_drafter_name "$(basename "$f")" && [ "$(basename "$f")" != "$(info_get "$info" checkpoint)" ] \
       && info_get_all "$info" drafter | grep -qxF -- "$(basename "$f")"; then continue; fi
    checked=$((checked + 1))
    echo "Checking $(basename "$f") with Halogen's verify..."
    if ! offline "$HALOGEN_IMAGE" verify "/models/flash/$name/$(basename "$f")"; then result=fail; fi
  done
  [ "$checked" -gt 0 ] || { echo "$dir holds no checkpoint." >&2; result=fail; }
  # Whether the checkpoint carries its own precision choices, as Halogen's server binary says (the
  # third field of --resident-gib; its start script reads it the same way). Only then does
  # HALOGEN_CK_OVERLAY name a draft head; otherwise it selects a precision sidecar, so render-config
  # names the official draft head only with own_precision=1.
  # The 27B takes no draft head file, so its own precision doesn't matter; --resident-gib is
  # Flash-Next's binary, which doesn't read it.
  if [ "$model" = qwen3.8-flash-next ]; then
    facts="$(offline --entrypoint /usr/local/bin/flash_serve "$HALOGEN_IMAGE" --resident-gib "/models/flash/$name/$ck" 2>/dev/null \
      | grep -E '^[0-9]+\.[0-9] [01]( [01]){0,2}( [0-9]+\.[0-9])?$' | tail -n 1)"
    if [ -n "$facts" ]; then own="$(awk '{ print ($3 == "" ? 0 : $3) }' <<< "$facts")"; fi
  fi
  { grep -v -e '^verified=' -e '^verified_with=' -e '^verified_at=' -e '^own_precision=' -e '^model=' "$info"
    echo "own_precision=$own"
    [ -z "$model" ] || echo "model=$model"
    echo "verified=$result"
    echo "verified_with=$HALOGEN_VERSION"
    echo "verified_at=$(date -u '+%Y-%m-%d %H:%M UTC')"; } | write_new "$info.new" && mv -f "$info.new" "$info" || return 1
  [ "$result" = pass ]
}

# Quality against the official checkpoint, with Halogen's ppl on the public wikitext-2 test split
# (the corpus Halogen's own docs compare with): perplexity, and per-token KL and top-1 agreement
# against a reference dump of the official checkpoint, made once per Halogen version.
corpus_sha="${HALOGEN_CORPUS_SHA:-bbf94c53a05abe9ee670d3b6343608095822c85e26de37c70b24fc571964574a}"
corpus_url="${HALOGEN_CORPUS_URL:-https://datasets-server.huggingface.co/rows?dataset=Salesforce/wikitext&config=wikitext-2-raw-v1&split=test}"
check_dir="$models/flash/.check"
# The text is not ours to ship. Hugging Face's dataset viewer serves its rows; joined, they are
# byte for byte the text Halogen's docs build from the parquet file, checked by its hash.
get_corpus() {
  local out="$check_dir/wikitext-2-raw-test.txt" tmp offset total
  [ "$(sha256sum 2>/dev/null < "$out" | cut -d' ' -f1)" != "$corpus_sha" ] || return 0
  echo "Downloading the test text (wikitext-2, about 1.3 MB)..."
  tmp="$out.part"; : | write_new "$tmp" || return 1
  offset=0; total=1
  while [ "$offset" -lt "$total" ]; do
    # The test split is 4,358 rows (44 pages); a far larger count is not this text.
    [ "$offset" -lt 10000 ] || { rm -f "$tmp"; echo "The test text is longer than it should be; not used." >&2; return 1; }
    # curl's own messages stay quiet: --retry rides out a passing server error, and only a final
    # failure is reported, below.
    page="$(curl -fs -m 60 --retry 3 --max-filesize 2M "$corpus_url&offset=$offset&length=100")" || { rm -f "$tmp"; echo "Could not download the test text." >&2; return 1; }
    total="$(jq -r '.num_rows_total // 0' <<< "$page")"
    jq -j '.rows[].row.text' <<< "$page" >> "$tmp" || { rm -f "$tmp"; return 1; }
    offset=$((offset + 100))
  done
  [ "$(sha256sum < "$tmp" | cut -d' ' -f1)" = "$corpus_sha" ] || { rm -f "$tmp"; echo "The test text didn't match its known hash; not used." >&2; return 1; }
  mv -f "$tmp" "$out"
}
# Halogen's ppl: the GPU, no network or capabilities, the models read-only. The folder for the
# text and the reference dump is writable only for the official run ($2 = rw), which writes the
# dump; a custom checkpoint's run only reads it. Both runs read the official tokenizer, mounted
# where Halogen's tools look, so they score the same tokens, whatever tokenizer a repository
# ships. The prose goes to the terminal; the --json object to $1.
ppl() {
  local json="$1" mode="$2"; shift 2
  if ! plain_dir "$check_dir" || ! plain_dir "$models/tokenizer"; then die "$check_dir or $models/tokenizer isn't a plain folder under $models (a link stands in its path)."; fi
  podman run --rm --pull=never --device /dev/kfd --device /dev/dri --group-add keep-groups \
    --ipc=host --ulimit memlock=-1:-1 -v "$models:/models:ro" "${hide_cache[@]}" -v "$check_dir:/models/flash/.check:$mode" \
    -v "$models/tokenizer:/tokenizer:ro" -e HALOGEN_TOKENIZER=/tokenizer \
    --network=none --cap-drop=all --security-opt no-new-privileges "$HALOGEN_IMAGE" ppl "$@" --json > "$json"
}
# What can be checked before Halogen stops: the checkpoint is there and verified, and the text.
check_prepare() {
  local name="$1" info="$models/flash/$1/halos.info" file
  file="$(info_get "$info" checkpoint)"
  if ! [[ "$file" =~ ^[A-Za-z0-9._-]+\.hgn$ ]] || [ ! -f "$models/flash/$name/$file" ]; then die "$name is missing its checkpoint file; pull it again."; fi
  [ "$(info_get "$info" verified)" = pass ] || die "$name has not passed Halogen's verify: sudo halogenctl flash verify $name"
  [ -f "$models/tokenizer/tokenizer.json" ] || die "the official tokenizer is missing; let the download finish (sudo halogenctl fetch-logs)"
  mkdir -p "$check_dir" || die "cannot create $check_dir"
  get_corpus || exit 1
}
check_dir_run() {
  local name="$1" info="$models/flash/$1/halos.info" file ref refjson json p op kl top1 kmean p99 tokens
  check_prepare "$name"
  file="$(info_get "$info" checkpoint)"
  ref="$check_dir/official-$HALOGEN_VERSION.ref"; refjson="$check_dir/official-$HALOGEN_VERSION.json"
  if [ ! -s "$ref" ] || ! jq -e '.ppl' "$refjson" > /dev/null 2>&1; then
    rm -f "$check_dir"/official-*.ref "$check_dir"/official-*.json
    echo "Measuring the official checkpoint first (once per Halogen version)..."
    ppl "$refjson.new" rw /models/qwen38-flash-next-v2.hgn --corpus /models/flash/.check/wikitext-2-raw-test.txt \
      --ref-out "/models/flash/.check/official-$HALOGEN_VERSION.ref.new" \
      || { rm -f "$refjson.new" "$ref.new"; die "Halogen's ppl failed on the official checkpoint (above)."; }
    if ! mv -f "$ref.new" "$ref" || ! mv -f "$refjson.new" "$refjson"; then die "cannot save the reference"; fi
  fi
  echo "Measuring $name against it..."
  json="$models/flash/$name/check.json"
  ppl "$json.new" ro "/models/flash/$name/$file" --corpus /models/flash/.check/wikitext-2-raw-test.txt \
    --ref "/models/flash/.check/official-$HALOGEN_VERSION.ref" --worst 5 \
    || { rm -f "$json.new"; die "Halogen's ppl failed on $name (above)."; }
  mv -f "$json.new" "$json"
  num() { jq -r "$1 // empty" "$2" | grep -E '^-?[0-9.]+(e-?[0-9]+)?$' | head -n 1; }
  p="$(num .ppl "$json")"; op="$(num .ppl "$refjson")"; kl="$(num .ref.kl.median "$json")"
  kmean="$(num .ref.kl.mean "$json")"; p99="$(num .ref.kl.p99 "$json")"; top1="$(num .ref.top1_agreement "$json")"
  if [ -z "$p" ] || [ -z "$op" ] || [ -z "$kl" ] || [ -z "$top1" ]; then die "Halogen's ppl gave no usable numbers; see $json"; fi
  { grep -v -e '^checked' "$info"
    echo "checked_with=$HALOGEN_VERSION"
    echo "checked_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo "checked_ppl=$p"; echo "checked_official_ppl=$op"
    echo "checked_kl_median=$kl"; echo "checked_top1=$top1"; } | write_new "$info.new" || die "cannot write $info"
  mv -f "$info.new" "$info" || die "cannot write $info"
  # top1_agreement may be a fraction or a percentage; show a percentage. The rest is rounded for
  # reading; halos.info and check.json keep every digit.
  top1="$(awk -v t="$top1" 'BEGIN { if (t <= 1) t *= 100; printf "%.1f", t }')"
  r() { awk -v v="$1" -v d="$2" 'BEGIN { if (v == "") print "?"; else printf "%." d "f", v }'; }
  p="$(r "$p" 2)"; op="$(r "$op" 2)"; kl="$(r "$kl" 3)"; kmean="$(r "$kmean" 3)"; p99="$(r "$p99" 2)"
  echo
  tokens="$(num .tokens "$json")"
  echo "$name against the official checkpoint, on the wikitext-2 test text (${tokens:-?} tokens):"
  printf '  perplexity           %-10s official %s   (lower: the text surprises it less)\n' "$p" "$op"
  printf '  same next token      %s%%            (how often both would write the same word)\n' "$top1"
  printf '  KL divergence        median %s, mean %s, p99 %s\n' "$kl" "${kmean:-?}" "${p99:-?}"
  echo
  echo "How to read it: a median KL of a few hundredths is the ordinary difference between two"
  echo "quantizations of the same model. A much larger median, or a mean far above the median, means"
  echo "it answers differently in places: fine for a fine-tune, a warning for a plain conversion."
  echo "Halogen's docs explain each number: https://github.com/peonist-ai/halogen-flash-server/blob/main/docs/checkpoint-tools.md"
  echo "Details, with the 5 places they disagree most: $json"
}

# What a repository holds at a revision: the exact commit in $commit, then each file's size and
# hash in $files (name, size, LFS sha256, git blob id; tab-separated).
list_repo() {
  local repo="$1" revision="$2" listing err
  echo "Looking up $repo at $revision..."
  listing="$(online python3 - "$repo" "$revision" <<'PY'
import sys
from huggingface_hub import HfApi
repo, rev = sys.argv[1], sys.argv[2]
try:
    info = HfApi().model_info(repo, revision=rev, files_metadata=True)
except Exception as e:
    print("error " + " ".join(str(e).split())[:300])
    sys.exit(0)
print("commit", info.sha)
for s in info.siblings or []:
    if any(c.isspace() for c in s.rfilename):
        continue
    lfs = getattr(s, "lfs", None)
    sha = (lfs.get("sha256") if isinstance(lfs, dict) else getattr(lfs, "sha256", None)) if lfs is not None else None
    # Git's own id for files kept outside LFS (small ones, such as the tokenizer's).
    blob = getattr(s, "blob_id", None)
    print("\t".join(["file", s.rfilename, str(s.size if s.size is not None else -1), sha or "-", blob or "-"]))
PY
)" || die "Could not reach Hugging Face. Is the network up?"
  err="$(sed -n 's/^error //p' <<< "$listing")"
  [ -z "$err" ] || die "Hugging Face did not answer for $repo at $revision: $err
(A private or gated repository needs a token: sudo halogenctl hf-token)"
  commit="$(sed -n 's/^commit //p' <<< "$listing")"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "Hugging Face gave no commit for $repo at $revision"
  files="$(awk -F'\t' '$1 == "file" { print $2 "\t" $3 "\t" $4 "\t" $5 }' <<< "$listing")"
}
size_of() { awk -F'\t' -v f="$1" '$1 == f { print $2; exit }' <<< "$files"; }
sha_of() { awk -F'\t' -v f="$1" '$1 == f { print $3; exit }' <<< "$files"; }
blob_of() { awk -F'\t' -v f="$1" '$1 == f { print $4; exit }' <<< "$files"; }
has() { [ -n "$(size_of "$1")" ]; }
gib() { awk -v b="$1" 'BEGIN { printf "%.1f GiB", b / 1073741824 }'; }
# Each file must be exactly what the repository holds at that commit (Hugging Face's own hashes).
check_hashes() { # dir file...
  local dir="$1" f s b got; shift
  for f in "$@"; do
    s="$(sha_of "$f")"; b="$(blob_of "$f")"
    if [ "$s" != - ]; then got="$(sha256sum "$dir/$f" | cut -d' ' -f1)"
    elif [ "$b" != - ]; then got="$({ printf 'blob %d\0' "$(stat -c %s "$dir/$f")"; cat "$dir/$f"; } | sha1sum | cut -d' ' -f1)"; s="$b"
    else die "$repo lists no hash for $f, so it can't be checked."; fi
    [ "$got" = "$s" ] || die "$f does not match $repo's hash. Run it again to download it afresh."
  done
}


# --- Converting full-precision weights (halogenctl flash convert) -------------------------------
# A repository of BF16 safetensors (the format models are trained and published in) becomes a
# Halogen checkpoint here, with bf16-to-hgn (github.com/Quat3rnion/bf16-to-hgn, MIT or Apache-2.0,
# built into the image from a pinned commit, CPU only). Only Qwen3.8 Flash Next weights convert,
# and only complete ones: the repository's own MTP head, vision tower and tokenizer are used and
# nothing official is put in their place. The weights download into $convert_dir/<name>/source
# (about 360 GB), convert into flash/<name> (about 119 GB) and are deleted afterwards unless kept.
converter="${HALOS_BF16_TO_HGN:-/usr/libexec/halogen/bf16-to-hgn}"
convert_dir="$models/flash/.convert"
# The files the converter needs besides the weights, and the optional ones it copies when there.
convert_assets_required=(config.json tokenizer.json tokenizer_config.json chat_template.jinja merges.txt generation_config.json)
convert_assets_optional=(vocab.json special_tokens_map.json added_tokens.json preprocessor_config.json video_preprocessor_config.json processor_config.json)
# The output, in bytes: about 119 GB for the v2 profile (bf16-to-hgn's README), plus its own 5%
# and 64 MiB reserve, plus room to spare.
convert_out_bytes="${HALOS_CONVERT_OUT_BYTES:-128000000000}"
# What the converter writes (about 119 GB), for the progress line; the space check keeps a margin.
convert_plan_bytes=119000000000

# The converter parses files anyone on Hugging Face can write, with C++ inside, so it runs as a
# unit of its own under halogen's service manager: no network and no sockets at all (a socket of
# the service manager could start an unrestricted unit), no access to /srv/configs (the API key
# and HF token), halogen's home (its container images) or the manager's runtime folder, the
# models read-only, and write access only to this conversion's work folder. It stops with the
# conversion, and is the first thing the kernel ends when memory runs short, not Halogen.
sandboxed() {
  local w m c l
  w="$(readlink -f "$work")"; m="$(readlink -f "$models")"; c="$(readlink -f "${HALOGEN_CONFIGS_DIR:-/srv/configs}")"
  # No devices (the converter is CPU only; the halogen user could otherwise open the GPU and NPU
  # Halogen is using), not the shared memory Halogen's container shares with the host, not the
  # journal, and not /sysroot, a second path to /var on some installs. (The user manager already
  # gives a sandboxed unit its own user namespace, which keeps other halogen processes' /proc
  # entries closed to it; PrivateUsers only says so.)
  # No sockets: PrivateNetwork takes the network away, and the calls that make a socket are
  # refused too, io_uring's included (it makes one without calling socket(); the converter and its
  # libraries use none of these: no io_uring in its Cargo.lock or source at the pinned commit).
  # That keeps it off the socket files it can still see, such as the system D-Bus.
  # RestrictAddressFamilies=none said the same in the first version, but systemd-run rejects that
  # value ("Invalid argument", systemd 262), so every conversion would have stopped here, after
  # its download. Only 64-bit system calls; it may not change kernel settings or control groups
  # (Halogen's are its own user's).
  # The request records (client conversations, when on) are hidden too: the converter reads
  # weights nobody vouches for and needs only the models and its work folder.
  l="$(readlink -f "${HALOGEN_LOGS_DIR:-/srv/logs}")"
  # Bound to the conversion's unit, so it stops with it (sandbox-check has no such unit).
  local bound=(-p BindsTo=halogen-flash-convert.service -p After=halogen-flash-convert.service)
  [ -z "${SANDBOX_UNBOUND:-}" ] || bound=()
  "${HALOS_SYSTEMD_RUN:-systemd-run}" --user --wait --pipe --collect --quiet "${bound[@]}" \
    -p PrivateNetwork=yes -p "SystemCallFilter=~socket socketpair io_uring_setup io_uring_enter io_uring_register" \
    -p SystemCallErrorNumber=EAFNOSUPPORT -p SystemCallArchitectures=native -p NoNewPrivileges=yes \
    -p ProtectControlGroups=yes -p ProtectKernelTunables=yes \
    -p PrivateUsers=yes -p PrivateDevices=yes \
    -p ProtectSystem=strict -p "ReadOnlyPaths=$m" -p "ReadWritePaths=$w" \
    -p "InaccessiblePaths=-$c -${HOME:-/var/lib/halogen} -/run/user/$(id -u) -$m/.prompt-cache -$l -/dev/shm -/sysroot -/var/log" \
    -p PrivateTmp=yes -p PrivateIPC=yes -p RestrictNamespaces=yes -p LockPersonality=yes \
    -p MemoryDenyWriteExecute=yes -p Nice=10 -p CPUWeight=20 -p OOMScoreAdjust=900 \
    "$@" < /dev/null
}

# The weight files the index names: the converter reads exactly these, flat beside it.
index_shards() {
  local s
  jq -r '.weight_map | [.[]] | unique[]' "$1" 2> /dev/null | while IFS= read -r s; do
    [[ "$s" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.safetensors$ ]] || { echo "BAD $(printf '%s' "$s" | tr -cd '[:print:]' | head -c 80)"; continue; }
    echo "$s"
  done
}

convert_prepare() {
  local repo="" revision=main name="" src f missing=() idx cfg weights=0 need free n shards=() size ctr_kind=convert ctr_owned=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --revision|--as) [ $# -ge 2 ] || die "$1 needs a value"
        if [ "$1" = --revision ]; then revision="$2"; else name="$2"; fi; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) repo="$1"; shift ;;
    esac
  done
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || die "usage: halogenctl flash convert <hf-repo, such as someone/My-Flash-BF16> [--revision <rev>] [--as <name>]"
  [[ "$revision" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "'$revision' is not a branch, tag or commit"
  name="${name:-${repo##*/}}"
  valid_name "$name" || die "'$name' can't be a checkpoint name: use letters, digits, '.', '_' or '-', not 'official' (pick one with --as)"
  name_lock "$name" owned; ctr_owned=1
  [ ! -e "$models/flash/$name" ] || die "$models/flash/$name already exists. Pick another name with --as, or remove it first: sudo halogenctl flash remove $name"
  [ -x "$converter" ] || die "This image has no converter ($converter)."
  list_repo "$repo" "$revision"
  has model.safetensors.index.json || die "$repo has no model.safetensors.index.json, so it isn't a safetensors checkpoint this can convert."
  for f in "${convert_assets_required[@]}"; do has "$f" || missing+=("$f"); done
  [ "${#missing[@]}" = 0 ] || die "$repo lacks ${missing[*]}, which the converter needs beside the weights."

  # The small files first, to check the model before the big download.
  src="$convert_dir/$name/source"
  # Files left by another repository or commit under this name would end up in the result
  # (the converter copies every optional tokenizer file it finds), so they go first.
  if [ -e "$convert_dir" ] && ! plain_dir "$convert_dir"; then die "$convert_dir isn't a plain folder under $models (a link stands in its path)."; fi
  if [ -e "$convert_dir/$name/gguf.info" ]; then
    die "A GGUF pull's download is stored under the name $name. Pick another name with --as, or delete it: sudo halogenctl flash convert-stop $name"
  fi
  if [ -f "$convert_dir/$name/convert.info" ] && { [ "$(info_get "$convert_dir/$name/convert.info" repo)" != "$repo" ] \
      || [ "$(info_get "$convert_dir/$name/convert.info" commit)" != "$commit" ]; }; then
    rm -rf "${convert_dir:?}/$name"
  fi
  mk_plain "$src" || die "$src isn't a plain folder under $models (a link stands in its path)."
  mounts=(-v "$src:/models/flash/.convert/$name/source")
  n=(model.safetensors.index.json "${convert_assets_required[@]}")
  for f in "${convert_assets_optional[@]}"; do ! has "$f" || n+=("$f"); done
  online hf download "$repo" "${n[@]}" --revision "$commit" --local-dir "/models/flash/.convert/$name/source" < /dev/null > /dev/null 2>&1 \
    || die "Could not download $repo's small files. Run it again to retry."
  check_hashes "$src" "${n[@]}"
  cfg="$src/config.json"; idx="$src/model.safetensors.index.json"
  jq -e '.model_type == "qwen4_exp" and ((.architectures // []) | index("Qwen4ExpForConditionalGeneration") != null)' "$cfg" > /dev/null 2>&1 \
    || die "$repo isn't Qwen3.8 Flash Next weights ($(jq -r '"model_type " + (.model_type // "none")' "$cfg" 2>/dev/null)). bf16-to-hgn converts only that model."
  # The converter substitutes nothing: an MTP head and a vision tower must be in the weights.
  # (In Hugging Face's names the head is mtp.*, the vision tower model.visual.*.)
  jq -e '.weight_map | keys | any(startswith("mtp.")) and any(startswith("model.visual."))' "$idx" > /dev/null 2>&1 \
    || die "$repo's weights have no $(jq -e '.weight_map | keys | any(startswith("mtp."))' "$idx" > /dev/null 2>&1 && echo "vision tower (model.visual.*)" || echo "MTP head (mtp.*)"). The converter needs the complete model, so it can't convert this one."
  mapfile -t shards < <(index_shards "$idx")
  [ "${#shards[@]}" -gt 0 ] || die "$repo's index names no weight files."
  for f in "${shards[@]}"; do
    case "$f" in BAD\ *) die "$repo's index names a weights file the converter doesn't read (${f#BAD }): in a subfolder, or with an unusual name." ;; esac
    size="$(size_of "$f")"; [ -n "$size" ] || die "$repo's index names $f, which the repository doesn't have."
    [ "$(stat -c %s "$src/$f" 2> /dev/null)" = "$size" ] || weights=$((weights + size))
  done
  need=$((weights + convert_out_bytes))
  free="$(df --output=avail --block-size=1 "$models" | tail -n 1 | tr -d ' ')"
  if [ "$need" -gt "$(( ${free:-0} - 1073741824 ))" ]; then
    die "$repo needs $(gib "$need") ($(gib "$weights") of weights to download, about $(gib "$convert_out_bytes") for the result) and $models has $(gib "${free:-0}") free."
  fi
  { echo "repo=$repo"; echo "revision=$revision"; echo "commit=$commit"; } > "$convert_dir/$name/convert.info" || exit 1
  echo "name=$name"
  echo "download=$(gib "$weights")"
  echo "result=about $(gib "$convert_out_bytes")"
}

convert_run() {
  local name="$1" threads="" keep=0 info repo commit src out started reporter f shards=() rc ctr_kind=convert ctr_owned=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --threads)
        if ! [[ "${2:-}" =~ ^[0-9]{1,2}$ ]] || [ "$2" -lt 1 ] || [ "$2" -gt 64 ]; then die "--threads takes 1 to 64"; fi
        threads="$2"; shift 2 ;;
      --keep-source) keep=1; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  valid_name "$name" || die "bad name"
  name_lock "$name" owned; ctr_owned=1
  work="$convert_dir/$name"; info="$work/convert.info"; src="$work/source"; out="$models/flash/$name"; staged="$work/out/$name"
  [ -f "$info" ] || die "Nothing prepared for $name: start with sudo halogenctl flash convert <repo>"
  repo="$(info_get "$info" repo)"; commit="$(info_get "$info" commit)"
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "$info names no repository"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "$info names no commit"
  [ ! -e "$out" ] || die "$out already exists. Remove it first: sudo halogenctl flash remove $name"
  # By default half the cores, at most 16; --threads as given.
  if [ -z "$threads" ]; then threads=$(( $(nproc) / 2 )); [ "$threads" -ge 1 ] || threads=1; [ "$threads" -le 16 ] || threads=16; fi

  # The weights, resumable, then checked against the repository's hashes.
  list_repo "$repo" "$commit"
  plain_dir "$src" || die "$src isn't a plain folder under $models (a link stands in its path)."
  mapfile -t shards < <(index_shards "$src/model.safetensors.index.json")
  [ "${#shards[@]}" -gt 0 ] || die "$repo's index names no weight files."
  for f in "${shards[@]}"; do case "$f" in BAD\ *) die "$repo's index names a weights file the converter doesn't read." ;; esac; done
  # The converter refuses weight files its index doesn't name.
  for f in "$src"/*.safetensors; do
    [ -e "$f" ] || continue
    case " ${shards[*]} " in *" ${f##*/} "*) ;; *) rm -f "$f" ;; esac
  done
  mounts=(-v "$src:/models/flash/.convert/$name/source")
  echo "Downloading ${#shards[@]} weight files of $repo at commit ${commit:0:12} into $src. An interrupted download resumes."
  if [ "$progress_s" -gt 0 ]; then
    while sleep "$((progress_s * 10))" > /dev/null 2>&1; do echo "  $(du -sh "$src" 2>/dev/null | cut -f1) downloaded so far"; done 9>&- &
    reporter=$!
  fi
  online hf download "$repo" "${shards[@]}" --revision "$commit" --local-dir "/models/flash/.convert/$name/source" < /dev/null 2>&1 \
    | grep --line-buffered -v -e '^Hint: ' -e 'hf update' -e 'Still waiting to acquire lock' -e 'sending unauthenticated requests' -e "^/models/flash/.convert/$name/source\$"
  rc="${PIPESTATUS[0]}"
  [ -z "${reporter:-}" ] || kill "$reporter" 2> /dev/null
  [ "$rc" = 0 ] || die "The download stopped. Start the conversion again to resume it."
  echo "Checking the weights against $repo's hashes..."
  check_hashes "$src" "${shards[@]}"
  rm -rf "$src/.cache"

  # The converter writes only inside the work folder: its staging folder goes beside --output,
  # and a conversion stopped part-way leaves one it never resumes.
  rm -rf "${work:?}/out"; mkdir -p "$work/out" || exit 1
  started="$(date -u +%s)"
  echo "Converting on the CPU with $threads threads. This takes many hours, likely a day or more;"
  echo "Halogen keeps serving meanwhile, more slowly. Progress is logged every 10 minutes."
  # About how far: the converter writes its output into files of their final size, filling them
  # in as it goes, so the space actually used grows with the work done.
  ( while sleep 600; do
      used="$(du -sk "$work/out" 2> /dev/null | awk '{ print $1 + 0 }')"
      echo "  converted about $(awk -v k="$used" -v t="$convert_plan_bytes" 'BEGIN { printf "%.0f GB of about %.0f GB", k * 1024 / 1e9, t / 1e9 }'), $(( ($(date -u +%s) - started) / 3600 ))h$(( ($(date -u +%s) - started) / 60 % 60 ))m so far"
    done ) 9>&- &
  reporter=$!
  sandboxed "$converter" convert --source "$src" --output "$staged" --profile v2 --threads "$threads" \
    > "$work/convert.json" 2> "$work/convert.err"
  rc=$?
  kill "$reporter" 2> /dev/null
  tr -d '\000-\010\013-\037\177' < "$work/convert.err" | tail -n 20
  [ "$rc" = 0 ] || die "The conversion failed (above). The downloaded weights stay in $src: start it again to retry, or remove them: sudo halogenctl flash convert-stop $name"
  echo "Converted in $(( ($(date -u +%s) - started) / 3600 )) hours. Checking every value it wrote against the weights..."
  sandboxed "$converter" verify --source "$src" --output "$staged" > "$work/verify.json" 2> "$work/verify.err" \
    || { tr -d '\000-\010\013-\037\177' < "$work/verify.err" | tail -n 20; die "bf16-to-hgn's verify failed (above); the result is not used."; }
  # Into place only now, and never over anything.
  if ! mv -T -n "$staged" "$out" || [ -e "$staged" ]; then die "Could not move the result to $out."; fi
  cp "$work/convert.json" "$out/convert-report.json" 2> /dev/null || true

  { echo "repo=$repo"
    echo "revision=$(info_get "$info" revision)"
    echo "commit=$commit"
    echo "checkpoint=model.hgn"
    echo "converted_with=bf16-to-hgn ${BF16_TO_HGN_COMMIT:-unknown}, profile v2"
    echo "pulled_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo "verified=no"; } | write_new "$out/halos.info.new" && mv -f "$out/halos.info.new" "$out/halos.info" || exit 1
  verify_dir "$name" || die "$name failed Halogen's verify (above), so it can't be used. Remove it: sudo halogenctl flash remove $name"
  if [ "$keep" = 1 ]; then echo "The downloaded weights stay in $src (--keep-source)."
  else rm -rf "${convert_dir:?}/$name"; echo "The downloaded weights were removed, to free the space."; fi
  echo "$name is ready: converted from $repo at commit ${commit:0:12}, checked by bf16-to-hgn and Halogen's verify."
  echo "A converted model hasn't been measured for quality yet: run sudo halogenctl flash check $name before serving it."
}

# --- GGUF repositories (flash pull of a llama.cpp GGUF, #61) -------------------------------------
# Halogen reads a GGUF of Qwen3.8 Flash Next itself, and its image's convert mode writes the same
# lossless repack out once as a complete .hgn, with the lookup table and the draft head folded in
# (Halogen's docs/gguf.md, "Convert a GGUF once"). So a GGUF repository is pulled as: its shards at
# an exact commit into flash/.convert/<name>/gguf, checked against Hugging Face's hashes; the
# engine's draft head from Halogen's weights repository at the pinned revision, checked the same
# way (a GGUF carries none Halogen can run); then convert, offline, into a new folder that becomes
# flash/<name>/model.hgn, and Halogen's verify, as for any .hgn. The shards go afterwards, unless
# --keep-gguf. The work folder is the one flash convert uses, so flash convert-stop <name> deletes
# what a failed pull left.
mtp_head=qwen38-flash-next-mtp.hgn
# Quantizations Halogen refuses by name at start (gguf.md: Q4_1, Q2_K, Q3_K and the IQ2/IQ1
# families), a plain Q5_0 (stops at its first gate/up expert) and a plain Q6_K (refused on
# ssm_out), and full precision (BF16/F16/F32: not among the types gguf.md lists, and larger than
# the machine's memory): refused before a download of 50 GB or more that would only fail later.
gguf_refused_re='(^|[-_.])(Q4_1|Q5_0|Q6_K|Q2_K(_[A-Z]+)?|Q3_K(_[A-Z]+)?|IQ1_[A-Z]+|IQ2_[A-Z]+|TQ[12]_0|BF16|F16|F32)([-_.]|$)'
# The output is the repack (about the size of the GGUF: nothing is requantized) plus the lookup
# table at Halogen's own precision (27 GB): an IQ4_XS of 91 GB gives about 106 GB. GGUF size plus
# this, to be safe.
gguf_out_extra="${HALOS_GGUF_OUT_EXTRA:-34359738368}"

# The repository's GGUF builds, one a line: the build's name, a tab, then its files in order. A
# split build (<base>-00001-of-00003.gguf) is listed only when every shard is there. A projector
# (mmproj), a llama.cpp draft head (…-MTP-draft.gguf) and an importance matrix are not models.
gguf_builds() {
  cut -f1 <<< "$files" | grep -E '^([A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\.gguf$' | grep -viE 'mmproj|draft|imatrix' | sort | awk '
    { f = $0
      if (match(f, /-[0-9][0-9][0-9][0-9][0-9]-of-[0-9][0-9][0-9][0-9][0-9]\.gguf$/)) {
        key = substr(f, 1, RSTART - 1); idx = substr(f, RSTART + 1, 5) + 0; tot = substr(f, RSTART + 10, 5) + 0
      } else { key = substr(f, 1, length(f) - 5); idx = 1; tot = 1 }
      if (!(key in t)) { t[key] = tot; order[++n] = key } else if (t[key] != tot) bad[key] = 1
      if (idx < 1 || idx > tot || seen[key SUBSEP idx]++) bad[key] = 1
      c[key]++; fl[key] = fl[key] (fl[key] == "" ? "" : " ") f }
    END { for (i = 1; i <= n; i++) { k = order[i]; if (!(k in bad) && c[k] == t[k]) print k "\t" fl[k] } }'
}
# Removes anything in a folder a download container could write that isn't a plain file of its
# own: a link, a FIFO (hashing it would hang), a hard link to a file elsewhere.
# A container owns the folder it had as its mount root, and could have made it or a folder in it
# unreadable or unwritable: opened up first (chmod doesn't follow links).
open_up() { [ ! -e "$1" ] || [ -L "$1" ] || chmod -R u+rwX -- "$1"; }
gguf_sweep() {
  [ -d "$1" ] || return 0
  open_up "$1" || return 1
  find "$1" -mindepth 1 \( -type l -o \( ! -type f ! -type d \) -o \( -type f -links +1 \) \) -exec rm -f -- {} + || return 1
  [ -z "$(find "$1" -mindepth 1 \( -type l -o \( ! -type f ! -type d \) -o \( -type f -links +1 \) \) -print -quit)" ]
}
gguf_fetch() { # repo commit dir-in-container file...
  local r="$1" c="$2" d="$3"; shift 3
  online hf download "$r" "$@" --revision "$c" --local-dir "$d" < /dev/null \
    2>&1 | grep --line-buffered -v -e '^Hint: ' -e 'hf update' -e 'Still waiting to acquire lock' \
      -e 'sending unauthenticated requests' -e "^$d\$"
  [ "${PIPESTATUS[0]}" = 0 ] || die "The download stopped. Run the same command again to resume it."
}

# Halogen's convert in a container named like the pull's others, run as online() runs them: a
# stopped pull removes it at once (bash holds its traps while a foreground command runs), and the
# next pull of the name removes a leftover one. It sees only this pull's work folder (the hashed
# shards and draft head, read-only) at /models, which Halogen's image has, and writes only the new
# checkpoint's folder (whose mount point already stands in the work folder, so nothing is made
# under the read-only root); not the other models, the official files or the prompt cache. Its
# scratch places are as in halogen.container: /tmp, /var/tmp and /root on disk (anonymous volumes,
# removed with the container; podman's read-only tmpfs off, or it may mount one beside them),
# /run a tmpfs, the host's /dev/shm writable again. The GPU devices and --ipc=host stay as
# Halogen's docs run convert (whether repack needs them is for a run on the machine).
gguf_convert() (
  local c=""
  c="$(ctr_for)" || exit 1
  trap 'podman rm -f -i -t 0 "$c" > /dev/null 2>&1; exit 143' TERM HUP
  trap 'podman rm -f -i -t 0 "$c" > /dev/null 2>&1; exit 130' INT
  podman run --rm --pull=never --name "$c" --replace --oom-score-adj=1000 \
    --device /dev/kfd --device /dev/dri --group-add keep-groups --ipc=host --ulimit memlock=-1:-1 \
    --read-only --read-only-tmpfs=false --tmpfs /run -v /tmp -v /var/tmp -v /root -v /dev/shm:/dev/shm \
    --network=none --cap-drop=all --security-opt no-new-privileges \
    -v "$work:/models:ro,noexec,nosuid,nodev" -v "$out:/models/out/$name:noexec,nosuid,nodev" \
    -e "HALOGEN_MTP_HEAD=/models/head/$mtp_head" "$HALOGEN_IMAGE" convert "$1" "$2" < /dev/null &
  wait "$!"
)

gguf_pull() {
  local builds key="" shards=() f s total=0 dl=0 need free work src hd out base ufiles ucommit hsha hsize wcommit rc
  local -A keep=()
  local get=()
  builds="$(gguf_builds)"
  [ -n "$builds" ] || die "$repo has GGUF files, but no complete model build among them (a split build needs every shard)."
  if [ -n "$want_file" ]; then
    # The build's name, or any one of its files.
    while IFS=$'\t' read -r k fl; do
      if [ "$k" = "$want_file" ] || [ "$k.gguf" = "$want_file" ] || [[ " $fl " == *" $want_file "* ]]; then key="$k"; read -ra shards <<< "$fl"; break; fi
    done <<< "$builds"
    [ -n "$key" ] || die "$repo has no GGUF build called $want_file. Its builds: $(cut -f1 <<< "$builds" | tr '\n' ' ')"
  elif [ "$(grep -c . <<< "$builds")" = 1 ]; then
    key="$(cut -f1 <<< "$builds")"; read -ra shards <<< "$(cut -f2 <<< "$builds")"
  else
    die "$repo holds several GGUF builds. Pick one with --file (its name, or any of its files): $(cut -f1 <<< "$builds" | tr '\n' ' ')"
  fi
  base="${key##*/}"
  if [[ "${base^^}" =~ $gguf_refused_re ]]; then
    die "$base is a quantization Halogen can't read (it refuses Q4_1, Q2_K, Q3_K, IQ1, IQ2, plain Q5_0 and Q6_K builds, and full precision).
Pick another build with --file, such as an IQ4_XS or IQ4_NL one. Halogen's list: https://github.com/peonist-ai/halogen-flash-server/blob/main/docs/gguf.md"
  fi
  [ ! -e "$dir" ] || die "$dir already exists. Pick another name with --as, or remove it first: sudo halogenctl flash remove $name"

  # The engine's draft head, from Halogen's weights repository at the revision this release pins.
  ufiles="$files"; ucommit="$commit"
  list_repo "$HALOGEN_WEIGHTS_REPO" "$HALOGEN_WEIGHTS_REVISION"
  hsha="$(sha_of "$mtp_head")"; hsize="$(size_of "$mtp_head")"; wcommit="$commit"
  files="$ufiles"; commit="$ucommit"
  if ! [[ "$hsha" =~ ^[0-9a-f]{64}$ ]] || [ -z "$hsize" ]; then
    die "Halogen's weights repository has no $mtp_head at the pinned revision, and a GGUF needs it to convert."
  fi

  work="$convert_dir/$name"; src="$work/gguf"; hd="$work/head"; out="$work/out/$name"
  if [ -e "$convert_dir" ] && ! plain_dir "$convert_dir"; then die "$convert_dir isn't a plain folder under $models (a link stands in its path)."; fi
  if [ -e "$work/convert.info" ]; then
    die "The full-precision weights of a flash convert are stored under the name $name. Pick another name with --as, or delete them: sudo halogenctl flash convert-stop $name"
  fi
  # Shards an earlier pull of another repository, commit or build left under this name go first;
  # those of the same build are kept, so a pull that failed resumes without a new download.
  if [ -e "$work" ] && { [ "$(info_get "$work/gguf.info" repo)" != "$repo" ] || [ "$(info_get "$work/gguf.info" commit)" != "$commit" ] \
      || [ "$(info_get "$work/gguf.info" build)" != "$key" ]; }; then
    plain_dir "$work" || die "$work isn't a plain folder under $models (a link stands in its path)."
    open_up "$work"; rm -rf -- "$work" || die "Couldn't delete $work."
  fi
  for f in "$src" "$hd"; do mk_plain "$f" || die "$f isn't a plain folder under $models (a link stands in its path)."; done
  if ! { echo "repo=$repo"; echo "revision=$revision"; echo "commit=$commit"; echo "build=$key"; } | write_new "$work/gguf.info.new" \
     || ! mv -f "$work/gguf.info.new" "$work/gguf.info"; then die "Couldn't write $work/gguf.info."; fi
  if ! gguf_sweep "$src" || ! gguf_sweep "$hd"; then die "Couldn't clean $work."; fi

  for f in "${shards[@]}"; do
    s="$(size_of "$f")"; [[ "$s" =~ ^[0-9]+$ ]] || die "$repo lists no size for $f."
    [[ "$(sha_of "$f")" =~ ^[0-9a-f]{64}$ ]] || die "$repo lists no sha256 for $f, so it can't be checked."
    total=$((total + s)); keep["$f"]=1
    # A shard already there at its size (a pull that failed later) isn't downloaded again; every
    # one is hashed below, and one that doesn't match is removed, so the next pull fetches it.
    [ "$(stat -c %s "$src/$f" 2>/dev/null)" = "$s" ] || { dl=$((dl + s)); get+=("$f"); }
  done
  [ "$(stat -c %s "$hd/$mtp_head" 2>/dev/null)" = "$hsize" ] || dl=$((dl + hsize))
  need=$((dl + total + gguf_out_extra))
  free="$(df --output=avail --block-size=1 "$models" | tail -n 1 | tr -d ' ')"
  if [ "$need" -gt "$(( ${free:-0} - 1073741824 ))" ]; then
    die "$key needs $(gib "$need") ($(gib "$dl") to download, about $(gib "$((total + gguf_out_extra))") for the converted checkpoint) and $models has $(gib "${free:-0}") free."
  fi

  echo "Downloading the GGUF build $key (${#shards[@]} file(s), $(gib "$dl") to fetch) from $repo at commit ${commit:0:12} into $src. An interrupted download resumes."
  if [ "$progress_s" -gt 0 ]; then
    while sleep "$progress_s" > /dev/null 2>&1; do echo "  $(du -sh "$work" 2>/dev/null | cut -f1) so far"; done 9>&- &
    reporter=$!
  fi
  mounts=(-v "$src:/models/flash/.convert/$name/gguf")
  [ "${#get[@]}" = 0 ] || gguf_fetch "$repo" "$commit" "/models/flash/.convert/$name/gguf" "${get[@]}"
  if [ "$(stat -c %s "$hd/$mtp_head" 2>/dev/null)" != "$hsize" ]; then
    echo "Downloading Halogen's draft head, $mtp_head ($(gib "$hsize")), which the conversion folds in."
    mounts=(-v "$hd:/models/flash/.convert/$name/head")
    gguf_fetch "$HALOGEN_WEIGHTS_REPO" "$wcommit" "/models/flash/.convert/$name/head" "$mtp_head"
  fi
  [ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null
  mounts=()

  # The download containers had these folders writable: only plain files of their own are hashed
  # or given to the conversion, and nothing else is left beside the shards.
  rm -rf -- "$src/.cache" "$hd/.cache"
  if ! gguf_sweep "$src" || ! gguf_sweep "$hd"; then die "Couldn't clean $work."; fi
  while IFS= read -r -d '' f; do
    [ -n "${keep["${f#"$src"/}"]:-}" ] || rm -f -- "$f"
  done < <(find "$src" -mindepth 1 -type f -print0)
  echo "Checking the files against the repositories' hashes..."
  for f in "${shards[@]}"; do
    if [ "$(sha256sum "$src/$f" | cut -d' ' -f1)" != "$(sha_of "$f")" ]; then
      rm -f -- "$src/$f"; die "$f does not match $repo's hash. Run it again to download it afresh."
    fi
  done
  [ "$(sha256sum "$hd/$mtp_head" | cut -d' ' -f1)" = "$hsha" ] \
    || { rm -f -- "$hd/$mtp_head"; die "$mtp_head does not match the weights repository's hash. Run it again to download it afresh."; }

  # The conversion: Halogen's own convert mode in the pinned image, offline and without
  # capabilities, the models read-only, writable only the new checkpoint's folder. Halogen keeps
  # serving meanwhile; should memory run short, the kernel ends the conversion, not Halogen.
  open_up "$work/out"; rm -rf -- "$work/out" || die "Couldn't delete $work/out."
  mk_plain "$out" || die "$out isn't a plain folder under $models (a link stands in its path)."
  gpu_work wait
  echo "Converting $key into Halogen's format (a few minutes to about ten on an NVMe disk)..."
  gguf_convert "/models/gguf/${shards[0]}" "/models/out/$name/model.hgn"
  rc=$?
  if [ "$rc" = 137 ]; then
    die "The conversion ran out of memory. Stop Halogen for the few minutes it takes (sudo halogenctl stop), pull again (the download is kept), then: sudo halogenctl start"
  elif [ "$rc" != 0 ]; then
    die "Halogen's convert failed (above). The download stays in $src: pull again to retry, or delete it: sudo halogenctl flash convert-stop $name"
  fi
  # Only the checkpoint goes into place.
  open_up "$out" || exit 1
  find "$out" -mindepth 1 -maxdepth 1 ! -name model.hgn -exec rm -rf -- {} + || exit 1
  if [ -L "$out/model.hgn" ] || [ ! -f "$out/model.hgn" ] || [ "$(head -c 4 "$out/model.hgn")" != HGN1 ]; then
    die "Halogen's convert wrote no checkpoint. The download stays in $src: pull again to retry, or delete it: sudo halogenctl flash convert-stop $name"
  fi
  # Whatever mode the container gave it (a setuid or executable bit), it is plain data.
  chmod 0640 -- "$out/model.hgn" || die "Couldn't set $out/model.hgn's mode."
  { echo "repo=$repo"
    echo "revision=$revision"
    echo "commit=$commit"
    echo "checkpoint=model.hgn"
    echo "gguf=$key"
    echo "converted_with=Halogen $HALOGEN_VERSION convert, draft head $HALOGEN_WEIGHTS_REPO@${wcommit:0:12}"
    echo "pulled_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo "verified=no"; } | write_new "$out/halos.info.new" && mv -f "$out/halos.info.new" "$out/halos.info" || exit 1
  # Into place only now, and never over anything.
  if ! mv -T -n "$out" "$dir" || [ -e "$out" ]; then die "Could not move the result to $dir."; fi
  # The download goes only once the result passed: a verify that fails for another reason (the
  # official tokenizer missing, say) must not cost the next pull a new download.
  if ! verify_dir "$name"; then
    die "$name failed Halogen's verify (above), so it can't be used. Remove it: sudo halogenctl flash remove $name
The download stays in $src; delete it with: sudo halogenctl flash convert-stop $name"
  fi
  if [ "$keep_gguf" = 1 ]; then
    open_up "$hd"; open_up "$work/out"; rm -rf -- "$hd" "$work/out"
    echo "The GGUF stays in $src (--keep-gguf). Delete it with: sudo halogenctl flash convert-stop $name"
  else
    open_up "$work"; rm -rf -- "$work"
  fi
  echo "$name is ready: $key from $repo at commit ${commit:0:12}, converted by Halogen and checked by its verify."
  echo "Halogen's draft head is folded in, and it has no vision tower (it answers text only)."
  echo "To compare its quality with the official checkpoint: sudo halogenctl flash check $name"
  echo "name=$name"
}

case "${1:-}" in
  check|check-prepare)
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash check <name>, as sudo halogenctl flash list shows it"
    [ -f "$models/flash/$name/halos.info" ] || die "No checkpoint called $name. See: sudo halogenctl flash list"
    if [ -L "$models/flash/$name" ] || [ -L "$models/flash/$name/halos.info" ]; then die "$models/flash/$name holds links; pull it again."; fi
    name_lock "$name"
    # The check measures against the official Qwen3.8-Flash-Next checkpoint: another model's
    # numbers against it say nothing.
    if f="$(ck_file "$name")" && is_27b_file "$f"; then
      die "$name is a Qwen3.8-27B checkpoint. flash check compares a checkpoint with the official Qwen3.8-Flash-Next one, so it can't check this model."
    fi
    gpu_work refuse
    if [ "$1" = check-prepare ]; then check_prepare "$name"; else check_dir_run "$name"; fi
    exit 0 ;;
  verify)
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash verify <name>, as sudo halogenctl flash list shows it"
    [ -f "$models/flash/$name/halos.info" ] || die "No checkpoint called $name. See: sudo halogenctl flash list"
    name_lock "$name"
    if verify_dir "$name"; then echo "$name passed Halogen's verify."
    else die "$name failed Halogen's verify (above), so it can't be used. Pull it again, or remove it: sudo halogenctl flash remove $name"; fi
    exit 0 ;;
  sandbox-check)
    # The converter's real sandbox, with the converter's --help in it and a few probes: the VM
    # install test runs this, since no conversion runs there and a property systemd-run refuses
    # would otherwise first show after a 360 GB download. Prints what it finds; 0 when all hold.
    # As halogen only, and through no link: root must not make or remove folders here.
    [ "$(id -un)" = halogen ] || die "sandbox-check runs as the halogen user"
    work="$convert_dir/.sandbox-check"
    for d in "$models/flash" "$convert_dir" "$work"; do [ ! -L "$d" ] || die "$d is a link"; done
    mkdir -p "$convert_dir" || exit 1
    mkdir "$work" || die "couldn't make $work (left from an earlier run? rmdir it)"
    command -v python3 > /dev/null || die "sandbox-check needs python3 for its socket probe"
    # shellcheck disable=SC2016 # expanded by the sandboxed shell, from its arguments
    SANDBOX_UNBOUND=1 sandboxed /bin/sh -c '
      r=0; no() { echo "sandbox-check: $1"; r=1; }
      touch "$1/probe" 2>/dev/null || no "the work folder is not writable"
      if touch "$2/.sandbox-probe" 2>/dev/null; then rm -f "$2/.sandbox-probe"; no "the models are writable"; fi
      if [ -e /dev/kfd ] || [ -e /dev/ttyS0 ] || [ -e /dev/accel ]; then no "devices are in reach"; fi
      for p in /var/log /dev/shm "$4" "$5"; do if [ -r "$p" ]; then no "$p is readable"; fi; done
      if [ "$(grep -c : /proc/self/net/dev)" != 1 ]; then no "it has a network: $(grep -o "^ *[a-z0-9]*:" /proc/self/net/dev | tr -d " \n")"; fi
      python3 -c "import socket; socket.socket(socket.AF_UNIX)" 2>/dev/null; s=$?
      if [ "$s" = 0 ]; then no "a socket could be made"; fi
      python3 -c "pass" || no "python3 does not run here, so the socket probe proves nothing"
      "$3" --help > /dev/null 2>&1 || no "the converter does not start"
      exit "$r"' sh "$(readlink -f "$work")" "$(readlink -f "$models")" "$converter" "/run/user/$(id -u)" "$(readlink -f "${HALOGEN_CONFIGS_DIR:-/srv/configs}")"
    r=$?; rm -f "$work/probe"; rmdir "$work" 2> /dev/null
    if [ "$r" = 0 ]; then echo "sandbox-check: ok"; fi
    exit "$r" ;;
  use)
    # Under the name's lock, after halogenctl asked: the checks it made before asking are made
    # again, since a pull, a removal or a failed verify may have come in between (#119).
    name="${2:-}"
    if [ "$name" != official ]; then
      valid_name "$name" || die "usage: halogenctl flash use <name>|official"
      name_lock "$name"
      d="$models/flash/$name"
      if ! plain_dir "$d" || [ ! -f "$d/halos.info" ] || [ -L "$d/halos.info" ]; then
        die "No checkpoint called $name (any more). See: sudo halogenctl flash list"
      fi
      if [ "$(info_get "$d/halos.info" verified)" != pass ]; then
        die "$name has not passed Halogen's verify (any more), so it can't be used. Check it: sudo halogenctl flash verify $name"
      fi
    fi
    # Written fresh, never through whatever stands at the name; -T, or a folder there would
    # take the file inside it and the switch would seem to work.
    if ! printf '%s\n' "$name" | ( umask 027; write_new "$flash_choice.new" ) || ! mv -T -f -- "$flash_choice.new" "$flash_choice"; then
      rm -f -- "$flash_choice.new"
      die "Couldn't save the choice in $flash_choice (is something other than a file there?)."
    fi
    exit 0 ;;
  drafter)
    # flash drafter <name> official|official-r2|off|<file>: which draft head your own checkpoint drafts with
    # (render-config passes it to Halogen): the official one (the default), the checkpoint's
    # built-in head, or a draft head file its repository ships (listed as drafter= in halos.info
    # by the pull, which checked it against the repository's hash). Under the name's lock, so a
    # removal or a new pull can't come between the check and the write.
    name="${2:-}"; want="${3:-}"
    if ! valid_name "$name" || ! [[ "$want" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then die "usage: halogenctl flash drafter <name> official|official-r2|off|<file>"; fi
    name_lock "$name"
    d="$models/flash/$name"
    if ! plain_dir "$d" || [ ! -f "$d/halos.info" ] || [ -L "$d/halos.info" ]; then
      die "No checkpoint called $name (any more). See: sudo halogenctl flash list"
    fi
    # The 27B's engine takes no draft head file (its entrypoint's drafter_head skips it), and
    # render-config names none for it; official only drops a line left from before.
    if [ "$want" != official ] && f="$(ck_file "$name")" && is_27b_file "$f"; then
      die "$name is a Qwen3.8-27B checkpoint, which takes no draft head file: Halogen runs it as it ships."
    fi
    case "$want" in
      official|off) ;;
      # Halogen 0.20.6's official draft head, kept in /srv/models after the upgrade (the fetch
      # still checks its hash).
      official-r2)
        if [ -L "$models/qwen38-flash-next-drafter-r2.hgn" ] || [ ! -f "$models/qwen38-flash-next-drafter-r2.hgn" ]; then
          die "$models/qwen38-flash-next-drafter-r2.hgn isn't there, so official-r2 can't be chosen."
        fi ;;
      *) if ! is_drafter_name "$want" || [ "$want" = "$(info_get "$d/halos.info" checkpoint)" ] \
            || ! info_get_all "$d/halos.info" drafter | grep -qxF -- "$want" || [ -L "$d/$want" ] || [ ! -f "$d/$want" ]; then
           die "$name has no draft head called $want. Its own: $(info_get_all "$d/halos.info" drafter | tr '\n' ' ')(or official, official-r2, off)"
         fi ;;
    esac
    # The official one is the default, so it needs no line.
    if [ "$want" = official ]; then drafter_set "$name" ""; else drafter_set "$name" "$want"; fi
    exit 0 ;;
  remove)
    # Under the name's lock, after halogenctl asked: still there, still a plain folder, and not
    # the one chosen meanwhile (#119). As halogen, so a link can't steer the removal.
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash remove <name> (the official checkpoint is always kept)"
    name_lock "$name"
    d="$models/flash/$name"
    plain_dir "$d" || die "No checkpoint called $name (any more). See: sudo halogenctl flash list"
    if [ "$(head -n 1 -- "$flash_choice" 2> /dev/null | tr -cd 'A-Za-z0-9._-')" = "$name" ]; then
      die "$name is the active checkpoint (it was chosen meanwhile). Switch first: sudo halogenctl flash use official"
    fi
    rm -rf -- "$d" || die "Couldn't delete all of $d."
    # A checkpoint pulled later under the same name starts with the official draft head.
    if grep -q -- "^$name=" "$drafter_choice" 2> /dev/null; then drafter_set "$name" ""; fi
    echo "Deleted $name."
    exit 0 ;;
  convert-clear)
    # halogenctl flash convert-stop <name>, after it asked: what flash convert or a GGUF pull left
    # in flash/.convert/<name>, deleted under the name's lock, so never under a running one.
    name="${2:-}"
    valid_name "$name" || die "usage: halogenctl flash convert-stop [<name>]"
    name_lock "$name"
    d="$convert_dir/$name"
    { [ -e "$convert_dir" ] || [ -L "$convert_dir" ]; } || die "Nothing downloaded for $name."
    plain_dir "$convert_dir" || die "$convert_dir isn't a plain folder under $models (a link stands in its path)."
    { [ -e "$d" ] || [ -L "$d" ]; } || die "Nothing downloaded for $name."
    if [ -L "$d" ]; then rm -f -- "$d"; else open_up "$d"; rm -rf -- "$d" || die "Couldn't delete all of $d."; fi
    echo "Deleted the downloaded weights for $name."
    exit 0 ;;
  convert-prepare) shift; convert_prepare "$@"; exit 0 ;;
  convert-run) shift; convert_run "$@"; exit 0 ;;
  pull) shift ;;
  *) die "usage: flash-checkpoint pull <hf-repo> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn|build.gguf>] [--keep-gguf] | verify <name> | check-prepare <name> | check <name>" ;;
esac

repo=""; revision=main; name=""; want_file=""; keep_gguf=0
while [ $# -gt 0 ]; do
  case "$1" in
    --keep-gguf) keep_gguf=1; shift ;;
    --revision|--as|--file)
      [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --revision) revision="$2" ;; --as) name="$2" ;; --file) want_file="$2" ;; esac
      shift 2 ;;
    -*) die "unknown option $1" ;;
    *) repo="$1"; shift ;;
  esac
done
# Peonist's own Qwen3.8-27B (Halogen 0.21.0's second model, for a machine short of memory):
# flash pull 27b, served as qwen3.8-27b unless --as names another.
if [ "$repo" = 27b ]; then
  repo="${HALOGEN_27B_REPO:-peonist-ai/halogen-qwen3.8-27b-ht4}"; name="${name:-qwen3.8-27b}"
fi
case "$repo" in
  */*) ;;
  *) die "usage: halogenctl flash pull <hf-repo, such as someone/My-Flash-HGN, or 27b for Qwen3.8-27B> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn|build.gguf>] [--keep-gguf]" ;;
esac
[[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "'$repo' is not a Hugging Face repository name"
[[ "$revision" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "'$revision' is not a branch, tag or commit"
name="${name:-${repo##*/}}"
valid_name "$name" || die "'$name' can't be a checkpoint name: use letters, digits, '.', '_' or '-', not 'official' (pick one with --as)"
name_lock "$name" owned; ctr_owned=1
podman rm -f -i -t 0 "halogen-pull-flash-$name" > /dev/null 2>&1 || true
dir="$models/flash/$name"
info="$dir/halos.info"
if [ -f "$info" ] && [ "$(info_get "$info" repo)" != "$repo" ]; then
  die "$name already holds $(info_get "$info" repo). Pick another name with --as, or remove it first: sudo halogenctl flash remove $name"
fi
[ -f "$models/tokenizer/tokenizer.json" ] \
  || die "The official model isn't downloaded yet. Let the first boot finish: sudo halogenctl fetch-logs"

list_repo "$repo" "$revision"

# The checkpoint: a .hgn in the repository's top folder that isn't one of its companions.
candidates="$(cut -f1 <<< "$files" | grep -E '^[A-Za-z0-9._-]+\.hgn$' | grep -vE 'ngram|vision|mtp|overlay|drafter' || true)"
# A GGUF build (named with --file, or the repository has no .hgn checkpoint) is converted once.
if { [ -n "$want_file" ] && [[ "$want_file" != *.hgn ]] && [ -n "$(gguf_builds)" ]; } \
   || { [ -z "$want_file" ] && [ -z "$candidates" ] && grep -qE '^[^[:space:]]+\.gguf[[:space:]]' <<< "$files"; }; then
  gguf_pull
  exit 0
fi
[ "$keep_gguf" = 0 ] || die "--keep-gguf is for a GGUF repository; $repo holds a Halogen checkpoint."
if [ -n "$want_file" ]; then
  grep -qxF -- "$want_file" <<< "$candidates" \
    || die "$repo has no checkpoint called $want_file. Its checkpoints: $(tr '\n' ' ' <<< "$candidates")"
  checkpoint="$want_file"
else
  case "$(grep -c . <<< "$candidates")" in
    0) die "$repo has no Halogen .hgn checkpoint in its top folder." ;;
    1) checkpoint="$candidates" ;;
    *) die "$repo holds several checkpoints. Pick one with --file: $(tr '\n' ' ' <<< "$candidates")" ;;
  esac
fi
# Qwen3.8-27B or Flash-Next: by the name until the header is here (as Halogen picks when the
# header names no model), then by the header. The companions differ (see is_27b_file).
ck27=0; [[ "$checkpoint" != qwen38-27b-*.hgn ]] || ck27=1
companions() {
  if [ "$ck27" = 1 ]; then
    ck_vision="$vision27"; drafters=()
  else
    ck_vision="$vision"
    # Draft head files the repository ships beside the checkpoint (a third party's drafter). They
    # are downloaded and checked like the rest, but used only after sudo halogenctl flash drafter
    # <name> <file>: by default the official draft head drafts.
    mapfile -t drafters < <(cut -f1 <<< "$files" | grep -E '^[A-Za-z0-9._-]*drafter[A-Za-z0-9._-]*\.hgn$' || true)
  fi
}
companions
wanted=("$checkpoint")
overlay="${checkpoint%.hgn}.overlay.hgn"
! has "$overlay" || wanted+=("$overlay")
! has "$ck_vision" || wanted+=("$ck_vision")
mapfile -t tokenizer < <(cut -f1 <<< "$files" | grep -E '^tokenizer/[A-Za-z0-9._-]+\.(json|jinja|txt|model|tiktoken)$' || true)
wanted+=("${tokenizer[@]}")

# Enough room for everything still missing, the lookup table, draft heads and both models' vision
# towers included until the header says which model this is.
need=0; sized=("${wanted[@]}")
mapfile -t -O "${#sized[@]}" sized < <(cut -f1 <<< "$files" | grep -E '^[A-Za-z0-9._-]*drafter[A-Za-z0-9._-]*\.hgn$' || true)
for f in "$table" "$vision" "$vision27"; do ! has "$f" || [ "$f" = "$ck_vision" ] || sized+=("$f"); done
for f in "${sized[@]}"; do
  s="$(size_of "$f")"; [ "${s:-0}" -gt 0 ] || continue
  [ "$(stat -c %s "$dir/$f" 2>/dev/null)" = "$s" ] || need=$((need + s))
done
free="$(df --output=avail --block-size=1 "$models" | tail -n 1 | tr -d ' ')"
if [ "$need" -gt "$(( ${free:-0} - 1073741824 ))" ]; then
  die "$repo needs $(gib "$need") more and $models has $(gib "${free:-0}") free."
fi

if [ "$(head -n 1 "$flash_choice" 2>/dev/null | tr -d '[:space:]')" = "$name" ]; then
  die "$name is the checkpoint Halogen serves. Switch first (sudo halogenctl flash use official), then pull it again."
fi
mk_plain "$dir" || die "$dir isn't a plain folder under $models (a link stands in its path). Remove the link, then pull again."
# A table an earlier pull hard-linked to the official one goes before the download container
# gets this folder: through it, the container could write the official file. A copy follows below.
if [ -L "$dir/$table" ] || [ "$(stat -c %h "$dir/$table" 2>/dev/null || echo 1)" != 1 ]; then rm -f -- "$dir/$table"; fi
# The same for draft head files (a copy of the official one is never a link, but one made by hand
# could be), and anything at such a name that isn't a plain file (a FIFO would hang the hashing).
for f in "$dir"/*drafter*.hgn; do
  [ -e "$f" ] || [ -L "$f" ] || continue
  if [ -L "$f" ] || [ ! -f "$f" ] || [ "$(stat -c %h "$f" 2>/dev/null || echo 2)" != 1 ]; then rm -rf -- "$f" || exit 1; fi
done
mounts=(-v "$dir:/models/flash/$name")
# From the first byte until the checks pass, the folder counts as unchecked.
# A new download also makes an earlier flash check's numbers stale.
if [ -f "$info" ]; then
  { grep -v -e '^verified' -e '^checked' "$info"; echo "verified=no"; } | write_new "$info.new" && mv -f "$info.new" "$info" || exit 1
fi
rm -f "$dir/check.json"
echo "Downloading $checkpoint from $repo at commit ${commit:0:12} into $dir ($(gib "$need") to fetch). An interrupted download resumes."
if [ "$progress_s" -gt 0 ]; then
  while sleep "$progress_s" > /dev/null 2>&1; do echo "  $(du -sh "$dir" 2>/dev/null | cut -f1) so far"; done 9>&- &
  reporter=$!
fi
fetch() {
  online hf download "$repo" "$@" --revision "$commit" --local-dir "/models/flash/$name" < /dev/null \
    2>&1 | grep --line-buffered -v -e '^Hint: ' -e 'hf update' -e 'Still waiting to acquire lock' \
      -e 'sending unauthenticated requests' -e "^/models/flash/$name\$"
  [ "${PIPESTATUS[0]}" = 0 ] || die "The download stopped. Run the same command again to resume it."
}
fetch "${wanted[@]}"

# The header decides, as it does for Halogen. A checkpoint whose name said otherwise gets the
# other model's vision tower (and draft heads) instead; the first one is removed below with the
# other files this pull doesn't want.
was27="$ck27"; ck27=0
! is_27b_file "$dir/$checkpoint" || ck27=1
if [ "$ck27" != "$was27" ]; then
  old_vision="$ck_vision"; companions
  for i in "${!wanted[@]}"; do [ "${wanted[$i]}" != "$old_vision" ] || unset 'wanted[i]'; done
  wanted=("${wanted[@]}")
  if has "$ck_vision"; then fetch "$ck_vision"; wanted+=("$ck_vision"); fi
fi
if [ "$ck27" = 1 ]; then echo "$checkpoint is a Qwen3.8-27B checkpoint: Halogen serves it with its 27B engine."; fi

# Draft head files. A copy of an official one (Peonist's layout ships the draft head beside the
# checkpoint) is copied, not downloaded, as the lookup table below is: a reflink where the
# filesystem can, never a link (the next pull's container gets this folder writable).
for f in "${drafters[@]}"; do
  # The download container had this folder: only a plain file of its own is hashed or kept.
  if [ -L "$dir/$f" ] || { [ -e "$dir/$f" ] && { [ ! -f "$dir/$f" ] || [ "$(stat -c %h "$dir/$f")" != 1 ]; }; }; then rm -rf -- "${dir:?}/$f" || exit 1; fi
  if [ -e "$dir/$f" ] && [ "$(sha256sum "$dir/$f" | cut -d' ' -f1)" != "$(sha_of "$f")" ]; then rm -f -- "$dir/$f"; fi
  if [ ! -e "$dir/$f" ]; then
    for o in qwen38-flash-next-drafter-r2-ht4.hgn qwen38-flash-next-drafter-r2.hgn; do
      if [ -f "$models/$o" ] && [ ! -L "$models/$o" ] && [ "$(stat -c %s "$models/$o")" = "$(size_of "$f")" ] &&
         [ "$(sha256sum "$models/$o" | cut -d' ' -f1)" = "$(sha_of "$f")" ]; then
        if cp --reflink=auto -- "$models/$o" "$dir/$f"; then echo "Its draft head $f is the official $o, so that file is copied rather than downloaded."; break
        else rm -f -- "$dir/$f"; fi
      fi
    done
  fi
  if [ ! -e "$dir/$f" ]; then
    echo "Downloading its draft head, $f ($(gib "$(size_of "$f")"))."
    fetch "$f"
  fi
  wanted+=("$f")
done

# Does the checkpoint carry the model's lookup table, or need it beside it? Halogen's server
# binary says, the same way its start script asks. The 27B takes none.
if [ "$ck27" = 1 ]; then
  [ ! -L "$dir/$table" ] || rm -f -- "$dir/$table"
else
facts="$(offline --entrypoint /usr/local/bin/flash_serve "$HALOGEN_IMAGE" --resident-gib "/models/flash/$name/$checkpoint" 2>/dev/null \
  | grep -E '^[0-9]+\.[0-9] [01]( [01]){0,2}( [0-9]+\.[0-9])?$' | tail -n 1)"
own_table="$(awk '{ print $2 }' <<< "$facts")"
if [ "$own_table" = 1 ]; then
  echo "The checkpoint carries its own lookup table."
elif has "$table"; then
  # A table from an earlier pull that this commit doesn't have goes first (a link is removed,
  # never written through, so the official table is never touched).
  if [ -e "$dir/$table" ] && [ "$(sha256sum "$dir/$table" | cut -d' ' -f1)" != "$(sha_of "$table")" ]; then
    rm -f -- "$dir/$table"
  fi
  # Many builds of the same model share the official table. Then it is copied, not downloaded
  # again: a reflink copy where the filesystem can (XFS, as the installers make: no extra disk),
  # else a plain copy. Either way it is a file of its own, never a hard link: the next pull's
  # container gets this folder writable, and would reach the official table through one.
  [ ! -L "$dir/$table" ] || rm -f -- "$dir/$table"
  if [ "$(stat -c %s "$models/$table" 2>/dev/null)" = "$(size_of "$table")" ] && [ ! -e "$dir/$table" ] &&
     [ "$(sha256sum "$models/$table" | cut -d' ' -f1)" = "$(sha_of "$table")" ]; then
    if cp --reflink=auto -- "$models/$table" "$dir/$table"; then
      echo "Its lookup table is the official one, so that file is copied rather than downloaded."
    else rm -f -- "$dir/$table"; fi
  fi
  if [ ! -e "$dir/$table" ]; then
    echo "Downloading its lookup table, $table ($(gib "$(size_of "$table")"))."
    fetch "$table"
  fi
  wanted+=("$table")
elif [ "$own_table" = 0 ]; then
  die "$checkpoint needs a lookup table ($table) beside it, and $repo has none. It can't run."
else
  echo "Note: Halogen couldn't say whether $checkpoint needs a lookup table, and $repo has none." \
       "If Halogen asks for one at start, go back with: sudo halogenctl flash use official"
fi
fi
[ -z "${reporter:-}" ] || kill "$reporter" 2>/dev/null

echo "Checking the files against $repo's hashes..."
check_hashes "$dir" "${wanted[@]}"

# Files from an earlier pull that this commit doesn't have would still be loaded (an old
# quality sidecar beside a new checkpoint), so they go.
for f in "$dir"/*.hgn; do
  [ -e "$f" ] || [ -L "$f" ] || continue
  keep=0; for w in "${wanted[@]}"; do [ "$w" != "$(basename "$f")" ] || keep=1; done
  [ "$keep" = 1 ] || { echo "Removing $(basename "$f"), which this checkpoint doesn't use."; rm -f -- "$f"; }
done
# The pull's container could leave a link in place of tokenizer/: nothing is removed through it.
[ ! -L "$dir/tokenizer" ] || die "$dir/tokenizer is a link, not a folder. Remove the link (sudo rm $dir/tokenizer), then pull again."
if [ "${#tokenizer[@]}" -gt 0 ]; then
  for f in "$dir"/tokenizer/* "$dir"/tokenizer/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    keep=0; for w in "${tokenizer[@]}"; do [ "$w" != "tokenizer/$(basename "$f")" ] || keep=1; done
    [ "$keep" = 1 ] || rm -rf -- "$f" || exit 1
  done
fi

# Halogen finds tokenizer/ beside the checkpoint. A repository without one gets the official
# tokenizer, copied rather than linked; Halogen checks its chat template at start.
if [ "${#tokenizer[@]}" = 0 ] && [ "$ck27" = 1 ]; then
  die "$repo has no tokenizer/, and the official one is Qwen3.8-Flash-Next's, not Qwen3.8-27B's. It can't run."
elif [ "${#tokenizer[@]}" = 0 ]; then
  echo "$repo has no tokenizer/, so the official tokenizer is copied in."
  # The official tokenizer must be a folder of plain files: a link there would be copied as one.
  if [ -L "$models/tokenizer" ] || [ -n "$(find "$models/tokenizer" -maxdepth 1 -type l 2>/dev/null | head -n 1)" ]; then
    die "The official tokenizer folder holds a link; download it again (sudo rm -r $models/tokenizer, then sudo halogenctl restart)."
  fi
  rm -rf "$dir/tokenizer" || exit 1
  cp -r -P "$models/tokenizer" "$dir/tokenizer" || exit 1
fi

{ echo "repo=$repo"
  echo "revision=$revision"
  echo "commit=$commit"
  echo "checkpoint=$checkpoint"
  for f in "${drafters[@]}"; do echo "drafter=$f"; done
  echo "pulled_at=$(date -u '+%Y-%m-%d %H:%M UTC')"
  echo "verified=no"; } | write_new "$info.new" && mv -f "$info.new" "$info" || exit 1

if ! verify_dir "$name"; then
  die "$name failed Halogen's verify (above), so it can't be used. Remove it: sudo halogenctl flash remove $name"
fi
echo "$name is ready: $checkpoint from $repo at commit ${commit:0:12}, checked by Halogen's verify."
if [ "$ck27" = 1 ]; then
  echo "Served, it answers to the model name halogen-qwen3.8-27b (unless HALOGEN_MODEL_ID sets another): apps that name halogen-qwen3.8-flash-next must change it."
fi
if [ "${#drafters[@]}" -gt 0 ]; then
  echo "$repo also ships its own draft head: ${drafters[*]}. Halogen's official draft head drafts by default;"
  echo "to try the repository's instead: sudo halogenctl flash drafter $name ${drafters[0]}"
fi
echo "name=$name"
