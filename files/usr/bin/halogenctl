#!/bin/bash
# Admin wrapper for the rootless Halogen service. Run with sudo.
set -euo pipefail
unit() { systemctl --user --machine=halogen@.host "$@"; }
# A start you ask for always runs. halogen.service allows 3 starts in 15 minutes so a crashing
# GPU can't restart forever, but your own restarts counted towards that too, and a few in a row
# locked Halogen out ("start of the service was attempted too often"). reset-failed clears it.
start_halogen() { unit reset-failed halogen.service 2>/dev/null || true; unit "$1" halogen.service; }
# Files under /srv/configs and /srv/models belong to halogen, so read and write them as halogen, never as root:
# a link planted there then can't reach anything halogen couldn't already.
as_owner() { runuser -u halogen -- "$@"; }
configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
# logs and fetch-logs keep following only on a terminal, so `| tail` and `> file` finish.
# An optional second argument sets how many lines to show (default 100).
follow=(); [ ! -t 1 ] || follow=(-f)
lines="${2:-100}"

models="${HALOGEN_MODELS_DIR:-/srv/models}"
flash_choice="$configs/flash-checkpoint"
official=qwen38-flash-next-v2.hgn
# The Flash checkpoint halogenctl flash use chose: official, or a name under /srv/models/flash.
chosen_flash() {
  local c; c="$(as_owner head -n 1 "$flash_choice" 2>/dev/null | tr -cd 'A-Za-z0-9._-')" || true
  echo "${c:-official}"
}
# Printable characters only: the fetch containers can write in /srv/models.
# Which Flash checkpoint Halogen serves, as render-config decides it, and why it fell back to
# the official one if it did. Prints the name (official or yours), then the reason, if any.
served_flash() {
  local out ck
  out="$(systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config --show 2>&1)" || true
  ck="$(sed -n 's/^HALOGEN_CHECKPOINT=//p' <<< "$out" | tail -n 1)"
  case "$ck" in
    /models/flash/*/*) ck="${ck#/models/flash/}"; echo "${ck%%/*}" ;;
    /models/"$official"|'') echo official ;;
    *) echo unknown ;;
  esac
  why="$(grep '^halogen-config: .*official one' <<< "$out" | tail -n 1 | sed 's/^halogen-config: //' | tr -cd '[:print:]' || true)"
  echo "${why:-see sudo halogenctl config and sudo halogenctl logs}"
}
# Allowed settings halogen.env sets on more than one line (the last one is used). Prints a note,
# or nothing. Settings this system ignores anyway are left to render-config's messages.
duplicate_settings() {
  local d
  d="$( { as_owner grep -oE '^[[:space:]]*HALOGEN_[A-Z0-9_]+=' "$configs/halogen.env" 2>/dev/null || true; } \
    | tr -d '= \t' | sort | uniq -d \
    | { grep -xF -f "${HALOGEN_ALLOWED_FILE:-/usr/share/halogen/options.allowed}" || true; } | tr '\n' ' ')"
  [ -z "$d" ] || printf '\nSet more than once in halogen.env (only the last line counts): %s\nDelete the older lines (sudo nano %s/halogen.env), then: sudo halogenctl restart\n' "${d% }" "$configs"
}
flash_info() { as_owner sed -n "s/^$2=//p" "$models/flash/$1/halos.info" 2>/dev/null | tail -n 1 | tr -cd '[:print:]' || true; }

case "${1:-status}" in
  status)
    unit --no-pager status halogen-fetch.service halogen.service || true
    c="$(chosen_flash)"
    if [ "$c" != official ]; then
      s="$(served_flash)"; served="$(head -n 1 <<< "$s")"
      echo
      if [ "$served" = "$c" ]; then
        echo "Flash checkpoint: $c, your own ($(flash_info "$c" repo)). If Halogen won't start with it"
        echo "(sudo halogenctl logs), go back to the official one: sudo halogenctl flash use official"
      else
        echo "Flash checkpoint: you chose $c, but Halogen serves the official one: $(sed -n 2p <<< "$s")"
      fi
    fi
    duplicate_settings ;;
  start|restart) start_halogen "$1" ;;
  stop) unit stop halogen.service ;;
  logs) exec journalctl --no-pager "${follow[@]}" -n "$lines" _SYSTEMD_USER_UNIT=halogen.service + _SYSTEMD_USER_UNIT=halogen-fetch.service ;;
  fetch-logs) exec journalctl --no-pager "${follow[@]}" -n "$lines" _SYSTEMD_USER_UNIT=halogen-fetch.service ;;
  doctor)
    # Runs under the service manager, so it sees the service's real limits.
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config >/dev/null
    # While Halogen runs, the GTT it holds is expected, not a leftover from a crash.
    running=0; ! unit --quiet is-active halogen.service || running=1
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet \
      --setenv=HALOGEN_SERVER_RUNNING="$running" /usr/libexec/halogen/preflight
    ;;
  config)
    # Shows what Halogen receives. Ignored lines are explained above the list.
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config --show
    echo "--- locked ---"
    grep -v '^#' "${HALOGEN_LOCKED_FILE:-/usr/share/halogen/locked.env}"
    duplicate_settings
    ;;
  options)
    # Every option this release offers (the edition's template), and whether halogen.env has it.
    # --new: only the ones halogen.env doesn't mention yet, set or commented.
    template="${HALOGEN_ENV_TEMPLATE:-/usr/share/halogen/halogen.env.default}"
    case "${2:-}" in ''|--new) ;; *) echo "usage: halogenctl options [--new]" >&2; exit 2 ;; esac
    # Without sudo (runuser refuses) or with no readable halogen.env, every option would look new.
    as_owner test -r "$configs/halogen.env" 2>/dev/null \
      || { echo "Cannot read $configs/halogen.env. Run it with sudo: sudo halogenctl options ${2:-}" >&2; exit 1; }
    mine="$( { as_owner grep -oE '^#?[[:space:]]*HALOGEN_[A-Z0-9_]+=' "$configs/halogen.env" 2>/dev/null || true; } | tr -d '#= \t' | sort -u | tr '\n' ' ')"
    set_now="$( { as_owner grep -oE '^[[:space:]]*HALOGEN_[A-Z0-9_]+=' "$configs/halogen.env" 2>/dev/null || true; } | tr -d '= \t' | sort -u | tr '\n' ' ')"
    awk -v only_new="$([ "${2:-}" = --new ] && echo 1 || echo 0)" -v mine="$mine" -v set_now="$set_now" '
      BEGIN { n = split(mine, a, " "); for (i = 1; i <= n; i++) have[a[i]] = 1
              n = split(set_now, b, " "); for (i = 1; i <= n; i++) on[b[i]] = 1 }
      /^## / { section = substr($0, 4); next }
      /^# / { desc = substr($0, 3); next }
      match($0, /^#?HALOGEN_[A-Z0-9_]+=/) {
        name = substr($0, RSTART, RLENGTH); gsub(/[#=]/, "", name)
        state = (name in on) ? "set" : (name in have) ? "commented" : "new"
        if (!only_new || state == "new") {
          if (section != shown) { printf "\n%s\n", section; shown = section }
          printf "  %-34s %-10s %s\n", name, state, desc; count++
        }
        desc = ""; next
      }
      END {
        if (only_new && !count) print "Nothing new: halogen.env mentions every option this release offers."
        else printf "\nset: in effect from halogen.env. commented: in the file, switched off. new: not in your file yet.\nCopy a line from /srv/configs/halogen.env.example into halogen.env, then: sudo halogenctl restart\n"
      }' "$template"
    duplicate_settings
    ;;
  selftest)
    # The beta checklist in one go. It changes nothing and prints nothing private.
    [ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo halogenctl selftest" >&2; exit 1; }
    exec /usr/libexec/halogen/selftest
    ;;
  api-key) as_owner cat "$configs/api-key"; echo ;;
  hf-token)
    # Store a Hugging Face read token for model downloads. It is never printed.
    token="$configs/hf-token"
    if [ "${2:-}" = --remove ]; then as_owner rm -f "$token"; echo "Removed the Hugging Face token."; exit 0; fi
    read -rsp "Hugging Face read token (from huggingface.co/settings/tokens): " value; echo
    case "$value" in
      hf_?*) ;;
      *) echo "That doesn't look like a token; they start with hf_. Nothing saved." >&2; exit 1 ;;
    esac
    # shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
    printf '%s\n' "$value" | as_owner sh -c 'umask 077; cat > "$1.new" && mv -f "$1.new" "$1"' sh "$token"
    echo "Saved. The next download uses it: sudo halogenctl restart"
    ;;
  flash)
    # Your own Flash checkpoints under /srv/models/flash, beside the official one, which is
    # always kept so going back needs no download.
    as_halogen() { systemd-run --machine=halogen@.host --user --pipe --wait --quiet "$@"; }
    valid() { case "$1" in [A-Za-z0-9]*) ;; *) return 1 ;; esac; case "$1" in *[!A-Za-z0-9._-]*) return 1 ;; esac; }
    restart_now() {
      # $1: what to say before asking. --yes skips the question.
      if [ "$yes" != 1 ]; then
        [ -t 0 ] || { echo "Nothing changed: add --yes to confirm without a terminal." >&2; exit 1; }
        read -rp "$1 This restarts Halogen, which stops answering for a few minutes. Go ahead? [y/N] " answer
        [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Nothing changed."; exit 1; }
      fi
    }
    yes=0; args=()
    for a in "${@:2}"; do if [ "$a" = --yes ]; then yes=1; else args+=("$a"); fi; done
    set -- flash "${args[@]}"
    case "${2:-list}" in
      pull)
        shift 2
        out="$(as_halogen /usr/libexec/halogen/flash-checkpoint pull "$@" | tee /dev/stderr)" || exit 1
        name="$(sed -n 's/^name=//p' <<< "$out" | tail -n 1)"
        valid "$name" || exit 1
        echo
        echo "To serve it: sudo halogenctl flash use $name"
        ;;
      verify)
        valid "${3:-}" || { echo "usage: halogenctl flash verify <name>" >&2; exit 2; }
        as_halogen /usr/libexec/halogen/flash-checkpoint verify "$3"
        ;;
      check)
        # Halogen's ppl loads the model, which needs the GPU to itself: Halogen stops meanwhile.
        name="${3:-}"
        if ! valid "$name" || [ "$name" = official ]; then echo "usage: halogenctl flash check <name> [--yes]" >&2; exit 2; fi
        [ -n "$(flash_info "$name" repo)" ] || { echo "No checkpoint called $name. See: sudo halogenctl flash list" >&2; exit 1; }
        if [ "$(unit is-active halogen-fetch.service 2>/dev/null)" = activating ]; then
          echo "Halogen is downloading models (sudo halogenctl fetch-logs). Check $name when that is done." >&2; exit 1
        fi
        echo "This measures $name against the official checkpoint on a public test text (wikitext-2),"
        echo "with Halogen's ppl. It needs the GPU, so Halogen stops answering for about 15 to 30 minutes"
        echo "(longest the first time on a Halogen version, when the official checkpoint is measured too)."
        if [ "$yes" != 1 ]; then
          [ -t 0 ] || { echo "Nothing changed: add --yes to confirm without a terminal." >&2; exit 1; }
          read -rp "Stop Halogen and measure $name? [y/N] " answer
          [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Nothing changed."; exit 1; }
        fi
        # Before Halogen stops: the name, the verify result and the test text (downloaded once).
        as_halogen /usr/libexec/halogen/flash-checkpoint check-prepare "$name" < /dev/null
        # From here on Halogen comes back whatever happens: Ctrl-C, a dropped SSH session, a
        # closed pipe. The measurement is stopped first, so it never holds the GPU beside Halogen;
        # Halogen is started before anything is printed, since printing to a closed terminal fails.
        # A Halogen you stopped yourself stays stopped.
        was_running=0; ! unit is-active --quiet halogen.service || was_running=1
        trap 'exit 130' INT TERM HUP
        trap 'set +e; unit stop halogen-flash-check.service > /dev/null 2>&1
              if [ "$was_running" = 1 ]; then start_halogen start > /dev/null 2>&1
                { echo; echo "Halogen is starting again; follow it with: sudo halogenctl logs"; } 2> /dev/null
              else { echo; echo "Halogen was not running before the check, so it is left stopped."; } 2> /dev/null; fi' EXIT
        unit stop halogen.service
        # A named unit the trap can stop, ended after 3 hours if ppl hangs. Its output comes back
        # through a pipe with control characters taken out, so the script (run as halogen) never
        # holds root's terminal and the decoded tokens it prints can't drive it.
        systemd-run --machine=halogen@.host --user --pipe --wait --quiet --unit=halogen-flash-check --collect \
          -p RuntimeMaxSec=3h /usr/libexec/halogen/flash-checkpoint check "$name" < /dev/null 2>&1 | sed -u 's/[[:cntrl:]]//g'
        ;;
      list)
        c="$(chosen_flash)"; s="$(served_flash)"; served="$(head -n 1 <<< "$s")"
        mark() { if [ "$1" = "$served" ]; then echo yes; else echo no; fi; }
        printf '  %-24s %-8s %-7s %-22s %s\n' NAME SIZE ACTIVE VERIFIED SOURCE
        size="$( { as_owner du -ch "$models/$official" "$models/qwen38-flash-next-ngram.hgn" 2>/dev/null || true; } | tail -n 1 | cut -f1)"
        printf '  %-24s %-8s %-7s %-22s %s\n' official "${size:-?}" "$(mark official)" "at every start" \
          "$(sed -n 's/^HALOGEN_WEIGHTS_REPO=//p' "${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}" 2>/dev/null)"
        for dir in "$models"/flash/*/; do
          [ -d "$dir" ] || continue
          name="$(basename "$dir")"; valid "$name" || continue
          case "$(flash_info "$name" verified)" in
            pass) v="yes, with $(flash_info "$name" verified_with)" ;;
            fail) v="FAILED" ;;
            no) v="not yet" ;;
            *) v="incomplete pull" ;;
          esac
          commit="$(flash_info "$name" commit)"
          printf '  %-24s %-8s %-7s %-22s %s\n' "$name" "$( { as_owner du -sh "$dir" 2>/dev/null || true; } | cut -f1)" "$(mark "$name")" "$v" \
            "$(flash_info "$name" repo)${commit:+ at ${commit:0:12}}"
        done
        checks=""
        for dir in "$models"/flash/*/; do
          [ -d "$dir" ] || continue
          name="$(basename "$dir")"; valid "$name" || continue
          p="$(flash_info "$name" checked_ppl)"; [ -n "$p" ] || continue
          t="$(awk -v t="$(flash_info "$name" checked_top1)" 'BEGIN { if (t <= 1) t *= 100; printf "%.1f", t }')"
          checks+="$(printf '  %-24s perplexity %s (official %s), same next token %s%%, KL median %s, with Halogen %s' "$name" "$p" \
            "$(flash_info "$name" checked_official_ppl)" "$t" "$(flash_info "$name" checked_kl_median)" "$(flash_info "$name" checked_with)")"$'\n'
        done
        if [ -n "$checks" ]; then echo; echo "Quality against the official checkpoint (sudo halogenctl flash check <name>):"; printf '%s' "$checks"; fi
        echo
        [ "$c" = "$served" ] || echo "You chose $c, but Halogen serves the official checkpoint: $(sed -n 2p <<< "$s")"
        echo "ACTIVE: the checkpoint Halogen serves. Switch with: sudo halogenctl flash use <name>"
        echo "Add one with: sudo halogenctl flash pull <Hugging Face repo>"
        ;;
      use)
        name="${3:-}"
        valid "$name" || { echo "usage: halogenctl flash use <name>|official [--yes]" >&2; exit 2; }
        [ "$name" != "$(chosen_flash)" ] || { echo "$name is already the active checkpoint."; exit 0; }
        if [ "$name" != official ]; then
          [ -n "$(flash_info "$name" repo)" ] || { echo "No checkpoint called $name. See: sudo halogenctl flash list" >&2; exit 1; }
          if [ "$(flash_info "$name" verified)" != pass ]; then
            echo "$name has not passed Halogen's verify, so it can't be used. Check it: sudo halogenctl flash verify $name" >&2; exit 1
          fi
          echo "$name: $(flash_info "$name" checkpoint) from $(flash_info "$name" repo), commit $(flash_info "$name" commit | cut -c1-12)."
          echo "halOS can't judge a checkpoint's answers. Compare them with the official model's before relying on it."
        fi
        restart_now "Switch Halogen to $name?"
        # shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
        printf '%s\n' "$name" | as_owner sh -c 'umask 027; cat > "$1.new" && mv -f "$1.new" "$1"' sh "$flash_choice"
        start_halogen restart
        echo "Switched to $name. Halogen is starting; follow it with: sudo halogenctl logs"
        [ "$name" = official ] || echo "If it doesn't start, go back with: sudo halogenctl flash use official"
        ;;
      remove)
        name="${3:-}"
        valid "$name" || { echo "usage: halogenctl flash remove <name>" >&2; exit 2; }
        [ "$name" != official ] || { echo "The official checkpoint is always kept, so going back needs no download." >&2; exit 1; }
        dir="$models/flash/$name"
        as_owner test -d "$dir" || { echo "No checkpoint called $name. See: sudo halogenctl flash list" >&2; exit 1; }
        [ "$name" != "$(chosen_flash)" ] || { echo "$name is in use. Switch first: sudo halogenctl flash use official" >&2; exit 1; }
        if [ "$yes" != 1 ]; then
          [ -t 0 ] || { echo "Nothing changed: add --yes to confirm without a terminal." >&2; exit 1; }
          read -rp "Delete $dir ($(as_owner du -sh "$dir" | cut -f1))? [y/N] " answer
          [ "$answer" = y ] || [ "$answer" = Y ] || exit 0
        fi
        # As halogen: a folder link planted by a container must not let root delete through it.
        as_owner rm -rf -- "$dir" && echo "Deleted $name."
        ;;
      *) echo "usage: halogenctl flash pull <hf-repo> [--revision <rev>] [--as <name>] [--file <checkpoint.hgn>] | list | use <name>|official [--yes] | verify <name> | check <name> [--yes] | remove <name> [--yes]" >&2; exit 2 ;;
    esac
    ;;
  model)
    # Your own NPU checkpoints under /srv/models/{decider,LFM,custom}.
    as_halogen() { systemd-run --machine=halogen@.host --user --pipe --wait --quiet "$@"; }
    in_use() { as_halogen /usr/libexec/halogen/render-config --show 2>/dev/null | grep '^HALOGEN_NPU_MODELS=' | tr '=,' '\n' | sed 's/:fast$//' | grep -qxF -- "$1"; }
    case "${2:-list}" in
      pull)
        shift 2
        out="$(as_halogen /usr/libexec/halogen/model-pull "$@" | tee /dev/stderr)" || exit 1
        path="$(sed -n 's/^path=//p' <<< "$out")"
        [ -n "$path" ] || exit 1
        entry="$path"; ! grep -qx 'fast=1' <<< "$out" || entry="$path or $path:fast (faster, small quality cost)"
        echo
        echo "To serve it, add $entry to HALOGEN_NPU_MODELS in /srv/configs/halogen.env, for example:"
        if in_use "$path"; then echo "  It is already there. To use the new files: sudo halogenctl restart"; exit 0; fi
        line="$(as_owner grep '^HALOGEN_NPU_MODELS=' "$configs/halogen.env" | tail -n 1 || true)"
        new="HALOGEN_NPU_MODELS=${line#HALOGEN_NPU_MODELS=}"; new="${new%,}"
        [ "$new" = HALOGEN_NPU_MODELS= ] && new="$new$path" || new="$new,$path"
        echo "  $new"
        if [ -t 0 ]; then
          read -rp "Make that change and restart Halogen now? [y/N] " answer
          if [ "$answer" = y ] || [ "$answer" = Y ]; then
            # Replace the last HALOGEN_NPU_MODELS line, or add one, as halogen. awk takes the new
            # line as data (ENVIRON), so nothing in the file's old value can run as a command.
            # shellcheck disable=SC2016 # expanded by the halogen shell and awk
            NEW="$new" as_owner sh -c 'umask 027; f=$1
              n="$(grep -n "^HALOGEN_NPU_MODELS=" "$f" | tail -n 1 | cut -d: -f1)"
              N="${n:-0}" awk '"'"'NR == ENVIRON["N"] { print ENVIRON["NEW"]; done = 1; next } { print }
                END { if (!done) print ENVIRON["NEW"] }'"'"' "$f" > "$f.new" && mv -f "$f.new" "$f"' sh "$configs/halogen.env"
            start_halogen restart
            echo "Restarted. The first start converts the checkpoint for the NPU (about a minute)."
          fi
        fi
        ;;
      list)
        # What HALOGEN_NPU_MODELS serves now (one read, not one per model), without :fast.
        # Each read may fail (no npu folder yet, the halogen user's services down): still list.
        active="$( { as_halogen /usr/libexec/halogen/render-config --show 2>/dev/null || true; } | sed -n 's/^HALOGEN_NPU_MODELS=//p' | tr ',' '\n' | sed 's/:fast$//')"
        used() { if grep -qxF -- "$1" <<< "$active"; then echo yes; else echo no; fi; }
        echo "Your own checkpoints (/srv/models/decider, LFM and custom):"
        n=0
        for dir in "$models"/decider/*/ "$models"/LFM/*/ "$models"/custom/*/; do
          [ -d "$dir" ] || continue
          dir="${dir%/}"; rel="${dir#"$models"/}"
          # Halogen's container can write these folders, so a name is printed only when it is plain
          # (no terminal control codes reach your screen).
          [[ "$(basename "$dir")" =~ ^[A-Za-z0-9._-]+$ ]] || continue
          [ "$n" -gt 0 ] || printf '  %-28s %-8s %-8s %s\n' NAME FOLDER SIZE "IN USE"
          printf '  %-28s %-8s %-8s %s\n' "$(basename "$dir")" "${rel%%/*}" "$(as_owner du -sh "$dir" | cut -f1)" "$(used "/models/$rel")"
          n=$((n + 1))
        done
        [ "$n" -gt 0 ] || echo "  None yet. Add one with: sudo halogenctl model pull <Hugging Face repo>"
        echo
        echo "Halogen's NPU models (/srv/models/npu):"
        names="$( { find "$models/npu" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || true; } | { grep -E '^[A-Za-z0-9._-]+$' || true; } | sort)"
        if [ -z "$names" ]; then echo "  None downloaded yet."
        else
          printf '  %-28s %s\n' NAME "IN USE"
          while read -r name; do printf '  %-28s %s\n' "$name" "$(used "$name")"; done <<< "$names"
        fi
        echo
        echo "IN USE: listed in HALOGEN_NPU_MODELS (sudo halogenctl config). Halogen may add others itself,"
        echo "such as the agent guard's models."
        ;;
      remove)
        name="${3:-}"
        # Only a plain model name: anything else could reach outside the three folders.
        case "$name" in
          *[!A-Za-z0-9._-]*|.*|'') echo "usage: halogenctl model remove <name>, as sudo halogenctl model list shows it" >&2; exit 2 ;;
        esac
        dir=""
        for kind in decider LFM custom; do
          if [ -d "$models/$kind/$name" ]; then dir="$models/$kind/$name"; break; fi
        done
        [ -n "$dir" ] || { echo "No model called $name. See: sudo halogenctl model list" >&2; exit 1; }
        if in_use "/models/${dir#"$models"/}"; then
          echo "$name is in HALOGEN_NPU_MODELS. Take it out of /srv/configs/halogen.env first." >&2; exit 1
        fi
        [ -t 0 ] || { echo "Run this in a terminal: it asks before deleting." >&2; exit 1; }
        read -rp "Delete $dir ($(as_owner du -sh "$dir" | cut -f1))? [y/N] " answer
        [ "$answer" = y ] || [ "$answer" = Y ] || exit 0
        # As halogen: a folder link planted by a container must not let root delete through it.
        as_owner rm -rf -- "$dir" && echo "Deleted $name."
        ;;
      *) echo "usage: halogenctl model pull <hf-repo> [--revision <rev>] [--as <name>] | list | remove <name>" >&2; exit 2 ;;
    esac
    ;;
  bench)
    # Halogen's own sweep against the running server; the report goes to /srv/configs/bench.
    case "${2:-}" in ''|--quick) ;; *) echo "usage: halogenctl bench [--quick]" >&2; exit 2 ;; esac
    [ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo halogenctl bench ${2:-}" >&2; exit 1; }
    # Its output comes back through a pipe, so the script (run as halogen) never holds root's
    # terminal for the minutes it runs.
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/bench ${2:+"$2"} < /dev/null 2>&1 | cat
    ;;
  *) echo "usage: halogenctl status|start|stop|restart|logs [lines]|fetch-logs [lines]|doctor|selftest|bench [--quick]|config|options [--new]|api-key|hf-token [--remove]|model pull|list|remove|flash pull|list|use|verify|check|remove" >&2; exit 2 ;;
esac
