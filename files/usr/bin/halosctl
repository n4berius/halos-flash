#!/bin/bash
# halOS admin tool for the OS: which release you run, updates, release channels and rollback.
# halogenctl handles the Halogen server and its models. Run with sudo.
set -euo pipefail
# The image's own release file is the only source of these; never take them from outside.
unset HALOS_RELEASE HALOGEN_VERSION HALOGEN_VARIANT HALOGEN_IMAGE
# shellcheck source=/dev/null
. "${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
history="${HALOS_HISTORY:-/var/lib/halos/history}"
repo_default=ghcr.io/n4berius/halos-flash
suffix=""; [ "${HALOGEN_VARIANT:-npu}" = npu ] || suffix="-no-npu"

usage() {
  cat <<'U'
usage: halosctl version
       halosctl upgrade [--check] [--reboot] [--yes]
       halosctl switch alpha|beta|rc|release|edge [--reboot] [--yes]
       halosctl rollback [--to <version>] [--reboot] [--yes]
       halosctl npu on|off [--reboot] [--yes]
       halosctl power [low-power|balanced|performance]
       halosctl history
       halosctl setup [--skip]

Channels: alpha, beta and rc are test releases; release (stable) is for production; edge is
every change to main. Each channel also gets newer releases of the more stable ones.
npu off moves to the no-NPU edition (IOMMU off, faster prefill); npu on moves back. Both keep
the channel or release, and /srv: the NPU models stay on disk.
Changes apply at the next reboot, which stops Halogen. --reboot does it at once.
power is the firmware's power profile, and applies at once and at every boot: performance (the
default) lets the chip draw the most power, so Halogen runs fastest; balanced and low-power draw
less, run cooler and quieter, and serve slower. Without a name it shows the profile.
U
}

die() { echo "halosctl: $*" >&2; exit 1; }
case "${1:-}" in help|-h|--help) usage; exit 0 ;; esac
[ "$(id -u)" = 0 ] || die "run it with sudo"

# bootc's status, read once per state (load again after a change). The helpers below run in
# $(...) subshells, so the cache must be filled here, in the main shell.
status_json=""
load() { status_json="$(bootc status --format=json --format-version=1)"; }
status() { printf '%s' "$status_json"; }
queued() { [ "$(status | jq -r '.status.rollbackQueued // false')" = true ]; }
# Field of a deployment (booted, staged or rollback): ref, version, digest or timestamp.
# Printable characters only: the version comes from the image's label.
field() {
  status | jq -r --arg d "$1" --arg f "$2" '.status[$d] // empty | .image // empty |
    {ref: .image.image, version: .version, digest: .imageDigest, timestamp: .timestamp}[$f] // empty' |
    tr -cd '[:print:]'
}
describe() { local r v; r="$(field "$1" ref)"; v="$(field "$1" version)"; [ -n "$r" ] && echo "$r${v:+ ($v)}"; }

booted_ref() { field booted ref; }
repo() {
  local r; r="$(booted_ref)"; r="${r%@*}"; r="${r%:*}"
  case "$r" in */halos-flash) echo "$r" ;; *) echo "$repo_default" ;; esac
}
# The channel the booted image follows, or empty when it is pinned to one exact release.
channel() {
  local t; t="$(field "${1:-booted}" ref)"; t="${t##*/}"
  case "$t" in *:*) t="${t##*:}" ;; *) return 0 ;; esac
  t="${t%-no-npu}"
  case "$t" in alpha|beta|rc|stable|edge) echo "$t" ;; latest) echo stable ;; esac
}

# What boots next: the staged image if there is one, else the running one.
next_dep() { if [ -n "$(field staged ref)" ]; then echo staged; else echo booted; fi; }
# The edition of what boots next, as a tag suffix, so switch and rollback --to keep an edition
# change staged by npu on|off. A staged image pinned by digest (from rollback --to, or npu on|off
# on a pinned machine) names no edition in its ref, so its edition label is read from the
# registry. "?" when it has none (images from before the label), "!" when the registry can't be
# reached: guessing could turn the IOMMU off, or leave it off, against what was asked.
next_suffix() {
  local d t; d="$(next_dep)"
  [ "$d" = staged ] || { echo "$suffix"; return; }
  t="$(field staged ref)"; t="${t##*/}"
  case "$t" in
    *@*) # Pinned by digest: the image's edition label says which (images built since it was added carry it).
      case "$(staged_edition)" in npu) echo "" ;; no-npu) echo "-no-npu" ;; error) echo "!" ;; *) echo "?" ;; esac ;;
    *:*-no-npu) echo "-no-npu" ;; *:*) echo "" ;; *) echo "?" ;; esac
}
edition_label='{{index .Labels "io.github.n4berius.halos.edition"}}'
auth_args() { [ ! -r /etc/ostree/auth.json ] || echo --authfile /etc/ostree/auth.json; }
# The edition label of the staged image (its ref is bound to one digest), nothing when it has
# none, or "error" when the registry can't be asked.
staged_edition() {
  local auth ref out; read -ra auth <<< "$(auth_args)"
  ref="$(field staged ref)"
  [[ "$ref" =~ @sha256:[0-9a-f]{64}$ ]] || return 0
  out="$(skopeo inspect "${auth[@]}" --no-tags --format "$edition_label" "docker://$ref" 2>/dev/null)" || { echo error; return 0; }
  printf '%s' "$out" | tr -cd 'a-z-'
}
# next_suffix, or stop when it can't be told. Call it in the main shell, not in $(...).
need_suffix() {
  sfx="$(next_suffix)"
  [ "$sfx" != "!" ] || die "a change pinned to one exact build is staged for the next boot: $(describe staged).
Its edition couldn't be read from the registry: check the network, or reboot to it first, then run this again."
  [ "$sfx" != "?" ] || die "a change pinned to one exact build is staged for the next boot: $(describe staged).
Its edition can't be told (it was built before images carried an edition label), so reboot to it first, then run this again."
}
# Is there an AMD NPU (XDNA) in this machine? Read from PCI, which works on either edition.
has_npu() {
  local d
  for d in "${HALOGEN_SYS:-/sys}"/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x1022 ] || continue
    # The PCI ids the kernel's amdxdna driver takes (Strix Halo is 17f0).
    case "$(cat "$d/device" 2>/dev/null)" in 0x1502|0x17f0|0x17f2|0x17f3|0x1b0b|0x1b0c) return 0 ;; esac
  done
  return 1
}

record() {
  mkdir -p "$(dirname "$history")"
  printf '%s  %-8s  %s -> %s  (by %s)\n' "$(date -u '+%Y-%m-%d %H:%M UTC')" "$1" "$2" "$3" \
    "${SUDO_USER:-root}" >> "$history"
}

yes=0; sfx=""; reboot=0; check=0; skip=0; to=""
confirm() {
  [ "$yes" = 1 ] && return 0
  [ -t 0 ] || die "nothing changed: add --yes to confirm without a terminal"
  local a; read -rp "$1 [y/N] " a
  case "$a" in y|Y|yes|YES) ;; *) echo "Nothing changed."; exit 1 ;; esac
}
finish() {
  if [ "$reboot" = 1 ]; then
    if [ "$(systemctl --user --machine=halogen@.host is-active halogen-fetch.service 2>/dev/null)" = activating ]; then
      echo "Not rebooting: Halogen is downloading models (sudo halogenctl fetch-logs). Reboot when it is done."
      return 0
    fi
    echo "Rebooting now."; systemctl reboot
  else
    echo "It applies at the next reboot, which stops Halogen for a few minutes: sudo systemctl reboot"
  fi
}
# Exact digest, edition label and release of an image in the registry, as
# "<digest> <edition> <release>". skopeo prints a missing label as an empty string, so the edition
# is empty, and the line has two spaces there, on images from before the label. Uses bootc's
# registry login, if there is one (a private package).
remote() {
  local auth out; read -ra auth <<< "$(auth_args)"
  if ! out="$(skopeo inspect "${auth[@]}" --no-tags \
      --format "{{.Digest}} $edition_label {{index .Labels \"org.opencontainers.image.version\"}}" "docker://$1" 2>&1)"; then
    printf '%s\n' "$out" | tr -cd '[:print:]\n' | tail -n 3 >&2
    die "could not read $1 from the registry. Is there a release for it yet, and is the network up?"
  fi
  printf '%s' "$out" | tr -cd '[:print:]'
}
# Switch to another image, after showing from -> to and asking. With "pin", switch to its
# exact digest, so the machine stays on that build even if the tag is ever pushed again.
switch_to() {
  local what="$1" target="$2" pin="${3:-}" info digest from staged rest edition release want=npu
  info="$(remote "$target")"; digest="${info%% *}"; rest="${info#* }"
  edition="${rest%% *}"; release="${rest#* }"
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "the registry gave no usable digest for $target"
  # The tag names an edition; the image's label must agree, when it has one.
  case "$target" in *-no-npu) want=no-npu ;; esac
  case "$edition" in
    npu|no-npu) [ "$edition" = "$want" ] || die "$target is the $edition edition in the registry, not $want; nothing changed" ;;
  esac
  from="$(describe booted)"
  echo "Now:   $from"
  [ -z "$(field staged ref)" ] || echo "Staged for the next boot, and replaced by this: $(describe staged)"
  echo "After: $target ($release)"
  confirm "Switch to it?"
  if [ -n "$pin" ]; then bootc switch "$(repo)@$digest"; else bootc switch "$target"; fi
  load
  staged="$(describe staged || echo "$target ($release)")"
  if [ -n "$(field staged digest)" ] && [ "$(field staged digest)" != "$digest" ]; then
    echo "Note: the image changed in the registry just now; staged instead: $staged"
  fi
  record "$what" "$from" "$staged"
  finish
}

cmd="${1:-version}"; [ $# = 0 ] || shift
case "$cmd" in history|setup|power) ;; *) load ;; esac
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y) yes=1 ;;
    --reboot) reboot=1 ;;
    --check) check=1 ;;
    --skip) skip=1 ;;
    --to) [ $# -ge 2 ] || die "--to needs a version, such as 0.19.0-alpha.1"; to="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done

case "$cmd" in switch|npu|power) ;; *) [ "${#args[@]}" = 0 ] ;; esac || die "unexpected ${args[0]} (for an older release: halosctl rollback --to <version>)"

case "$cmd" in
  version)
    ch="$(channel)"
    echo "halOS ${HALOS_RELEASE:-$(field booted version)}, ${HALOGEN_VARIANT:-unknown} edition"
    if [ -n "$ch" ]; then echo "Channel:   $ch"
    else echo "Channel:   none, pinned to this release (follow one with: sudo halosctl switch beta)"; fi
    echo "Halogen:   ${HALOGEN_VERSION:-unknown} (${HALOGEN_IMAGE:-unknown})"
    echo "Image:     $(booted_ref)"
    echo "Digest:    $(field booted digest)"
    echo "Built:     $(field booted timestamp)"
    if queued; then echo "Next boot: $(describe rollback) (rollback queued)"
    else echo "Next boot: $(describe staged || echo "no change staged")"; fi
    echo "Rollback:  $(describe rollback || echo "none")"
    ;;
  upgrade)
    [ -n "$(channel)" ] || echo "Note: this machine is pinned to one release, so an upgrade finds nothing newer. To follow new releases: sudo halosctl switch <channel>"
    if ! found="$(bootc upgrade --check 2>&1)"; then printf '%s\n' "$found" >&2; die "bootc could not check for updates"; fi
    printf '%s\n' "$found"
    # bootc says "No changes in: <image>" when nothing newer is in the registry than what this
    # machine already has, which includes an update staged earlier. Then there is nothing to
    # stage, so don't ask. Any other answer (an update, or wording we don't know) goes on.
    if grep -qi '^No changes in' <<< "$found"; then
      if [ -n "$(field staged digest)" ] && [ "$(field staged digest)" != "$(field booted digest)" ]; then
        echo "An update is already staged: $(describe staged). Reboot to use it: sudo systemctl reboot"
      else echo "Already up to date."; fi
      exit 0
    fi
    [ "$check" = 0 ] || exit 0
    from="$(describe booted)"; before="$(field staged digest)"
    echo "Now:   $from"
    confirm "Download and stage the newest release on this channel?"
    bootc upgrade
    load; after="$(field staged digest)"
    if [ -z "$after" ] || [ "$after" = "$before" ]; then echo "No new update was staged."; exit 0; fi
    record upgrade "$from" "$(describe staged)"
    # ISO times sort as text. An older build means the channel moved back; say so before a reboot.
    if [[ "$(field staged timestamp)" < "$(field booted timestamp)" ]]; then
      echo "Warning: the staged image was built before the one running ($(field staged timestamp) vs $(field booted timestamp))."
      echo "Its channel may have moved back. Check with sudo halosctl version before rebooting."
    fi
    finish
    ;;
  switch)
    [ "${#args[@]}" = 1 ] || die "which channel? alpha, beta, rc, release or edge"
    case "${args[0]}" in
      alpha|beta|rc|edge) ch="${args[0]}" ;;
      release|stable|latest) ch=stable ;;
      *) die "unknown channel ${args[0]}: use alpha, beta, rc, release or edge" ;;
    esac
    # Compared with what boots next: a staged switch to another channel can be undone this way.
    [ "$ch" != "$(channel "$(next_dep)")" ] || { echo "Already on $ch. For its newest release: sudo halosctl upgrade"; exit 0; }
    need_suffix
    switch_to switch "$(repo):$ch$sfx"
    ;;
  rollback)
    if [ -n "$to" ]; then
      [[ "$to" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]] || die "not a release: $to (such as 0.19.0-alpha.1)"
      echo "This pins the machine to $to; follow a channel again later with: sudo halosctl switch <channel>"
      need_suffix
      switch_to rollback "$(repo):$to$sfx" pin
      exit 0
    fi
    ! queued || die "a rollback is already queued. Reboot to apply it (sudo systemctl reboot), or undo it with: sudo bootc rollback"
    target="$(describe rollback)" || die "there is no previous image to go back to. Older releases: sudo halosctl history, then halosctl rollback --to <version>"
    from="$(describe booted)"
    echo "Now:   $from"
    echo "After: $target"
    staged="$(describe staged || true)"
    [ -z "$staged" ] || echo "This drops the update staged for the next boot: $staged"
    confirm "Go back to it?"
    bootc rollback
    record rollback "$from" "$target"
    finish
    ;;
  npu)
    [ "${#args[@]}" = 1 ] || die "npu on or npu off?"
    case "${args[0]}" in
      on) want=npu; new="" ;;
      off) want=no-npu; new="-no-npu" ;;
      *) die "npu on or npu off, not ${args[0]}" ;;
    esac
    ! queued || die "a rollback is queued for the next boot. Reboot first, then run this again."
    next="$(next_dep)"; need_suffix
    now="npu"; [ "$sfx" = "" ] || now="no-npu"
    [ "$want" != "$now" ] || { echo "Already the $want edition$([ "$next" = staged ] && echo " at the next boot")."; exit 0; }
    # Keep the channel, or the exact release the machine is pinned to.
    ch="$(channel "$next")"
    if [ -n "$ch" ]; then target="$(repo):$ch$new"; pin=""
    else
      tag="$(field "$next" ref)"; tag="${tag##*/}"
      # Pinned by digest: the release that boots next is its version label (a staged rollback --to
      # keeps its own release), not necessarily the one running.
      case "$tag" in *@*) tag="$(field "$next" version)" ;; *:*) tag="${tag##*:}"; tag="${tag%-no-npu}" ;; *) tag="" ;; esac
      [ -n "$tag" ] || tag="${HALOS_RELEASE:-}"
      [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]] \
        || die "this machine follows no channel and its release ($tag) has no tag for the other edition. Follow a channel first: sudo halosctl switch <channel>"
      target="$(repo):$tag$new"; pin=pin
      # A plain version tag (0.19.0) moves with stable releases and weekly rebuilds: keep following it.
      if [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then pin=""; fi
    fi
    if [ "$want" = no-npu ]; then
      echo "The no-NPU edition turns the IOMMU off: Halogen measured 13-16% faster prefill, and no"
      echo "NPU models run. The IOMMU stops plugged-in devices from reading memory. Without it, a device"
      echo "plugged into a USB4/Thunderbolt port or PCIe slot can read all of it, including the disk"
      echo "encryption key while the machine runs. Use it only where nobody untrusted can touch the machine."
      echo "Your NPU models and checkpoints stay in /srv/models, so npu on needs no new download."
      echo "HALOGEN_NPU_* settings in halogen.env are ignored on this edition."
    else
      if ! has_npu; then
        echo "Warning: this machine shows no AMD NPU, so the NPU edition's NPU models can't run here."
      fi
      echo "The NPU edition keeps the IOMMU on, which the NPU needs. Its first start downloads any"
      echo "NPU models not already in /srv/models/npu."
    fi
    switch_to "npu-${args[0]}" "$target" ${pin:+"$pin"}
    ;;
  power)
    acpi="${HALOGEN_SYS:-/sys}/firmware/acpi"; pp="${HALOS_PLATFORM_PROFILE:-/usr/libexec/halogen/platform-profile}"
    saved_file="${HALOS_PROFILE_FILE:-/etc/halos/platform-profile}"
    [ -e "$acpi/platform_profile" ] || die "this machine's firmware offers no power profile (no $acpi/platform_profile), so there is nothing to set"
    now="$(tr -cd 'a-z-' < "$acpi/platform_profile")"
    offers="$( { tr -cd 'a-z -' < "$acpi/platform_profile_choices"; } 2>/dev/null || true)"
    chosen=""; [ ! -r "$saved_file" ] || chosen="$(tr -cd 'a-z-' < "$saved_file")"
    if [ "${#args[@]}" = 0 ]; then
      echo "Power profile: $now"
      echo "Chosen:        ${chosen:-performance (the default)}"
      [ "$now" = "${chosen:-performance}" ] || echo "They differ: something changed it since boot. Set it again with: sudo halosctl power ${chosen:-performance}"
      echo "Offered:       $offers"
      echo "Change it with: sudo halosctl power low-power|balanced|performance (applies at once, no restart)"
      exit 0
    fi
    [ "${#args[@]}" = 1 ] || die "one profile: low-power, balanced or performance"
    if [ "$reboot$yes$check$skip" != 0000 ] || [ -n "$to" ]; then die "power applies at once and takes no options"; fi
    want="${args[0]}"
    case "$want" in low-power|balanced|performance) ;; *) die "unknown profile: use low-power, balanced or performance" ;; esac
    "$pp" check "$want" || die "this firmware does not offer $want (it offers: $offers); nothing changed"
    if [ "$want" = "$now" ] && [ "$want" = "${chosen:-performance}" ]; then echo "Already $want."; exit 0; fi
    mkdir -p "$(dirname "$saved_file")"
    printf '%s\n' "$want" > "$saved_file.new" && mv -f "$saved_file.new" "$saved_file"
    record power "$now" "$want"
    "$pp" apply || die "saved $want, but the firmware did not take it; it is tried again at the next boot"
    echo "Power profile: $want, now and at every boot. Halogen keeps running; no restart needed."
    [ "$want" = performance ] || echo "Halogen serves slower at $want than at performance (sudo halogenctl bench measures it)."
    ;;
  history)
    if [ -s "$history" ]; then cat "$history"; else echo "No changes recorded yet. Changes made with halosctl are listed here."; fi
    ;;
  setup)
    # First-boot setup: how the disk unlocks, a Hugging Face token, settings. Each step can be
    # skipped, and it can run again at any time. On a new install the first download waits for
    # it (up to 30 minutes); finishing or --skip lets the download start.
    state="${HALOGEN_STATE_DIR:-/var/lib/halogen}"; configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
    as_halogen() { runuser -u halogen -- "$@"; }
    pending=0; ! as_halogen test -e "$state/setup-pending" || pending=1
    release_fetch() {
      [ "$pending" = 1 ] || return 0
      as_halogen rm -f "$state/setup-pending"
      echo "The first download (about 130 GB) starts now. The login screen shows its progress;"
      echo "follow the details with: sudo halogenctl fetch-logs"
    }
    if [ "$skip" = 1 ]; then
      release_fetch; [ "$pending" = 1 ] || echo "Setup isn't pending; nothing to skip."
      exit 0
    fi
    [ -t 0 ] || die "setup asks questions, so run it in a terminal (or: sudo halosctl setup --skip)"
    # y or n in any case; Enter takes the default; anything else asks again.
    ask() {
      local a
      while :; do
        read -rp "$1 " a || return 1
        case "${a,,}" in y|yes) return 0 ;; n|no) return 1 ;; '') [ "$2" = y ]; return ;; esac
        echo "   Please answer y or n."
      done
    }
    echo "halOS setup. Each step can be skipped; run sudo halosctl setup again any time."

    echo; echo "1. How the disk unlocks at boot"
    crypt="$(lsblk -rno PATH,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')"
    if [ -z "$crypt" ]; then echo "   The disk isn't encrypted, so there is nothing to unlock."
    elif [ ! -e "${HALOGEN_DEV:-/dev}/tpmrm0" ] && [ ! -e "${HALOGEN_DEV:-/dev}/tpm0" ]; then echo "   No TPM found: you type the passphrase at each boot."
    elif [ "$(cryptsetup luksDump "$(head -n 1 <<< "$crypt")" 2>/dev/null | grep -cE '^[[:space:]]*[0-9]+: systemd-tpm2')" -gt 0 ]; then
      echo "   It unlocks with the TPM already. After a BIOS or Secure Boot change: sudo halogen-enroll-tpm"
    elif echo "   With the TPM this machine unlocks its own disk: that protects a disk taken out of it, not" \
              "the machine taken whole (INSTALL.md, section 8)." && \
         ask "   Unlock with the TPM, so no passphrase is needed while Secure Boot and the BIOS stay the same? [Y/n]" y; then
      halogen-enroll-tpm || echo "   That didn't work; the passphrase still unlocks the disk. Try again later: sudo halogen-enroll-tpm"
    else echo "   Kept: you type the passphrase at each boot."; fi

    echo; echo "2. Hugging Face token (optional: higher download limits, and access to gated repositories)"
    echo "   It stays on this machine, in /srv/configs, and is never printed."
    if as_halogen test -s "$configs/hf-token"; then echo "   A token is saved. Change it with: sudo halogenctl hf-token"
    elif ask "   Add one now? Create it at huggingface.co/settings/tokens (read access is enough). [y/N]" n; then
      halogenctl hf-token > /dev/null || true
      if as_halogen test -s "$configs/hf-token"; then echo "   Saved."; fi
    else echo "   Skipped. Add one later with: sudo halogenctl hf-token"; fi

    echo; echo "3. Settings"
    echo "   Halogen's defaults suit most people. Every option, with what it does: sudo halogenctl options"
    if ask "   Open /srv/configs/halogen.env in an editor now? [y/N]" n; then
      # As sudoedit does: root edits a private copy, and the copy goes back as halogen. Nothing of
      # halogen's (its home, an editor startup file) runs on root's terminal, and root never
      # opens halogen's files itself.
      editor="$(command -v "${EDITOR:-nano}" || command -v vi || true)"
      [ -n "$editor" ] || die "no editor found; edit it with: sudo halogenctl options, then the file"
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      as_halogen cat "$configs/halogen.env" > "$tmp/halogen.env" || die "could not read $configs/halogen.env"
      cp "$tmp/halogen.env" "$tmp/before"
      if "$editor" "$tmp/halogen.env" && ! cmp -s "$tmp/before" "$tmp/halogen.env"; then
        # shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
        as_halogen sh -c 'umask 027; cat > "$1.new" && mv -f "$1.new" "$1"' sh "$configs/halogen.env" < "$tmp/halogen.env"
        echo "   Saved. What Halogen will get: sudo halogenctl config"
      else echo "   No change."; fi
      rm -rf "$tmp"; trap - EXIT
    else echo "   Kept the defaults."; fi

    echo
    if [ "$pending" = 1 ]; then release_fetch
    elif ask "Restart Halogen now, so the changes apply? It stops answering for a few minutes. [y/N]" n; then
      halogenctl restart && echo "Restarting. The login screen shows when it is ready."
    else echo "Apply changes later with: sudo halogenctl restart"; fi
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
