#!/bin/bash
# halOS admin tool for the OS: which release you run, updates, release channels and rollback.
# halogenctl handles the Halogen server and its models. Run with sudo.
set -euo pipefail
# The image's own release file is the only source of these; never take them from outside.
unset HALOS_RELEASE HALOGEN_VERSION HALOGEN_VARIANT HALOGEN_IMAGE
# shellcheck source=/dev/null
. "${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
history="${HALOS_HISTORY:-/var/lib/halos/history}"
repo_default=ghcr.io/n4berius/halos-flash
suffix=""; [ "${HALOGEN_VARIANT:-npu}" = npu ] || suffix="-no-npu"

usage() {
  cat <<'U'
usage: halosctl version
       halosctl upgrade [--check] [--reboot] [--yes]
       halosctl switch alpha|beta|rc|release|edge [--reboot] [--yes]
       halosctl rollback [--to <version>] [--reboot] [--yes]
       halosctl npu on|off [--reboot] [--yes]
       halosctl power [low-power|balanced|performance]
       halosctl history
       halosctl setup [--skip]
       halosctl ssh-unlock [on [--github|--gitlab|--codeberg <user>]... [--key '<public key>'] | off | record] [--yes]
       halosctl ssh-passwords [on|off] [--yes]
       halosctl dashboard [on|off]
       halosctl https [self-signed [<name>...] | custom <certificate> <key> | off | ca] [--yes]
       halosctl https letsencrypt <cloudflare|duckdns|porkbun|namecheap> <name>... [--email <address>] [--staging] [--yes]
       halosctl https forget-dns [--yes]

Channels: alpha, beta and rc are test releases; release (stable) is for production; edge is
every change to main. Each channel also gets newer releases of the more stable ones.
npu off moves to the no-NPU edition (IOMMU off, faster prefill); npu on moves back. Both keep
the channel or release, and /srv: the NPU models stay on disk.
Changes apply at the next reboot, which stops Halogen. --reboot does it at once.
power is the firmware's power profile, and applies at once and at every boot: performance (the
default) lets the chip draw the most power, so Halogen runs fastest; balanced and low-power draw
less, run cooler and quieter, and serve slower. Without a name it shows the profile.
ssh-unlock on lets the keys of your GitHub, GitLab or Codeberg account (or a key you give) unlock
an encrypted disk over SSH at boot, when the TPM can't; off turns it off; alone it shows the state.
ssh-passwords off allows SSH logins only with keys (your account needs one first); on allows
passwords again. The console login always takes the password.
dashboard is a live web page of Halogen's load and health on port 8732 (Quaternion's
halogen-dashboard), open to your network and without a login; off stops it.
https turns on HTTPS for both (8731 and 8732): self-signed uses halOS's own authority, which your
apps must trust once (ca prints it); custom takes your certificate and key (PEM). Plain http://
then redirects to https://. letsencrypt gets certificates apps already trust for public names
(such as halos.example.com) through your DNS provider's API; it asks for the provider's
credentials, and --staging tries Let's Encrypt's test service first. off goes back to plain HTTP;
alone it shows the state.
U
}

die() { echo "halosctl: $*" >&2; exit 1; }
# y or n in any case; Enter takes the default; anything else asks again.
ask() {
  local a
  while :; do
    read -rp "$1 " a || return 1
    case "${a,,}" in y|yes) return 0 ;; n|no) return 1 ;; '') [ "$2" = y ]; return ;; esac
    echo "   Please answer y or n."
  done
}
case "${1:-}" in help|-h|--help) usage; exit 0 ;; esac
[ "$(id -u)" = 0 ] || die "run it with sudo"

# bootc's status, read once per state (load again after a change). The helpers below run in
# $(...) subshells, so the cache must be filled here, in the main shell.
status_json=""
load() { status_json="$(bootc status --format=json --format-version=1)"; }
status() { printf '%s' "$status_json"; }
queued() { [ "$(status | jq -r '.status.rollbackQueued // false')" = true ]; }
# Field of a deployment (booted, staged or rollback): ref, version, digest or timestamp.
# Printable characters only: the version comes from the image's label.
field() {
  status | jq -r --arg d "$1" --arg f "$2" '.status[$d] // empty | .image // empty |
    {ref: .image.image, version: .version, digest: .imageDigest, timestamp: .timestamp}[$f] // empty' |
    tr -cd '[:print:]'
}
describe() { local r v; r="$(field "$1" ref)"; v="$(field "$1" version)"; [ -n "$r" ] && echo "$r${v:+ ($v)}"; }

booted_ref() { field booted ref; }
# bootc checks images against containers-policy.json only when the machine's image spec asks it to
# (#46): "containerPolicy", set by --enforce-container-sigpolicy. Installs from before it are
# "insecure" until one switch with the flag; upgrade does that once.
verified() { [ "$(status | jq -r '.spec.image.signature // "" | if type == "string" then . else "other" end')" = containerPolicy ]; }
policy="${HALOS_POLICY:-/etc/containers/policy.json}"
# The shipped policy: nothing is accepted by default, halOS's images only with halOS's signature.
# bootc refuses --enforce-container-sigpolicy when the default accepts anything; say why first.
need_policy() {
  jq -e '.default == [{"type": "reject"}] and
    any(.transports.docker["ghcr.io/n4berius/halos-flash"][]?; .type == "sigstoreSigned" and
      .keyPath == "/etc/pki/containers/halos-flash.pub")' "$policy" > /dev/null 2>&1 \
    || die "$policy doesn't require halOS's signature, so bootc would refuse to check it. Restore halOS's copy: sudo cp /usr/etc/containers/policy.json /etc/containers/policy.json"
  local key="${HALOS_KEY:-/etc/pki/containers/halos-flash.pub}" image_key="${HALOS_IMAGE_KEY:-/usr/etc/pki/containers/halos-flash.pub}"
  [ ! -e "$image_key" ] || cmp -s "$key" "$image_key" \
    || die "$key isn't halOS's key. Restore it: sudo cp $image_key $key"
}
sig_flag=--enforce-container-sigpolicy
repo() {
  local r; r="$(booted_ref)"; r="${r%@*}"; r="${r%:*}"
  case "$r" in */halos-flash) echo "$r" ;; *) echo "$repo_default" ;; esac
}
# The channel the booted image follows, or empty when it is pinned to one exact release.
channel() {
  local t; t="$(field "${1:-booted}" ref)"; t="${t##*/}"
  case "$t" in *:*) t="${t##*:}" ;; *) return 0 ;; esac
  t="${t%-no-npu}"
  case "$t" in alpha|beta|rc|stable|edge) echo "$t" ;; latest) echo stable ;; esac
}

# What boots next: the staged image if there is one, else the running one.
next_dep() { if [ -n "$(field staged ref)" ]; then echo staged; else echo booted; fi; }
# The edition of what boots next, as a tag suffix, so switch and rollback --to keep an edition
# change staged by npu on|off. A staged image pinned by digest (from rollback --to, or npu on|off
# on a pinned machine) names no edition in its ref, so its edition label is read from the
# registry. "?" when it has none (images from before the label), "!" when the registry can't be
# reached: guessing could turn the IOMMU off, or leave it off, against what was asked.
next_suffix() {
  local d t; d="$(next_dep)"
  [ "$d" = staged ] || { echo "$suffix"; return; }
  t="$(field staged ref)"; t="${t##*/}"
  case "$t" in
    *@*) # Pinned by digest: the image's edition label says which (images built since it was added carry it).
      case "$(staged_edition)" in npu) echo "" ;; no-npu) echo "-no-npu" ;; error) echo "!" ;; *) echo "?" ;; esac ;;
    *:*-no-npu) echo "-no-npu" ;; *:*) echo "" ;; *) echo "?" ;; esac
}
edition_label='{{index .Labels "io.github.n4berius.halos.edition"}}'
auth_args() { [ ! -r /etc/ostree/auth.json ] || echo --authfile /etc/ostree/auth.json; }
# The edition label of the staged image (its ref is bound to one digest), nothing when it has
# none, or "error" when the registry can't be asked.
staged_edition() {
  local auth ref out; read -ra auth <<< "$(auth_args)"
  ref="$(field staged ref)"
  [[ "$ref" =~ @sha256:[0-9a-f]{64}$ ]] || return 0
  out="$(skopeo inspect "${auth[@]}" --no-tags --format "$edition_label" "docker://$ref" 2>/dev/null)" || { echo error; return 0; }
  printf '%s' "$out" | tr -cd 'a-z-'
}
# next_suffix, or stop when it can't be told. Call it in the main shell, not in $(...).
need_suffix() {
  sfx="$(next_suffix)"
  [ "$sfx" != "!" ] || die "a change pinned to one exact build is staged for the next boot: $(describe staged).
Its edition couldn't be read from the registry: check the network, or reboot to it first, then run this again."
  [ "$sfx" != "?" ] || die "a change pinned to one exact build is staged for the next boot: $(describe staged).
Its edition can't be told (it was built before images carried an edition label), so reboot to it first, then run this again."
}
# Is there an AMD NPU (XDNA) in this machine? Read from PCI, which works on either edition.
has_npu() {
  local d
  for d in "${HALOGEN_SYS:-/sys}"/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x1022 ] || continue
    # The PCI ids the kernel's amdxdna driver takes (Strix Halo is 17f0).
    case "$(cat "$d/device" 2>/dev/null)" in 0x1502|0x17f0|0x17f2|0x17f3|0x1b0b|0x1b0c) return 0 ;; esac
  done
  return 1
}

record() {
  mkdir -p "$(dirname "$history")"
  printf '%s  %-8s  %s -> %s  (by %s)\n' "$(date -u '+%Y-%m-%d %H:%M UTC')" "$1" "$2" "$3" \
    "${SUDO_USER:-root}" >> "$history"
}

yes=0; sfx=""; reboot=0; check=0; skip=0; to=""; question=""; email=""; staging=0
confirm() {
  [ "$yes" = 1 ] && return 0
  [ -t 0 ] || die "nothing changed: add --yes to confirm without a terminal"
  local a; read -rp "$1 [y/N] " a
  case "$a" in y|Y|yes|YES) ;; *) echo "Nothing changed."; exit 1 ;; esac
}
finish() {
  if [ "$reboot" = 1 ]; then
    if [ "$(systemctl --user --machine=halogen@.host is-active halogen-fetch.service 2>/dev/null)" = activating ]; then
      echo "Not rebooting: Halogen is downloading models (sudo halogenctl fetch-logs). Reboot when it is done."
      return 0
    fi
    echo "Rebooting now."; systemctl reboot
  else
    echo "It applies at the next reboot, which stops Halogen for a few minutes: sudo systemctl reboot"
  fi
}
# Exact digest, edition label and release of an image in the registry, as
# "<digest> <edition> <release>". skopeo prints a missing label as an empty string, so the edition
# is empty, and the line has two spaces there, on images from before the label. Uses bootc's
# registry login, if there is one (a private package).
remote() {
  local auth out; read -ra auth <<< "$(auth_args)"
  if ! out="$(skopeo inspect "${auth[@]}" --no-tags \
      --format "{{.Digest}} $edition_label {{index .Labels \"org.opencontainers.image.version\"}}" "docker://$1" 2>&1)"; then
    printf '%s\n' "$out" | tr -cd '[:print:]\n' | tail -n 3 >&2
    die "could not read $1 from the registry. Is there a release for it yet, and is the network up?"
  fi
  printf '%s' "$out" | tr -cd '[:print:]'
}
# Switch to another image, after showing from -> to and asking. With "pin", switch to its
# exact digest, so the machine stays on that build even if the tag is ever pushed again.
switch_to() {
  local what="$1" target="$2" pin="${3:-}" info digest from staged rest edition release want=npu
  info="$(remote "$target")"; digest="${info%% *}"; rest="${info#* }"
  edition="${rest%% *}"; release="${rest#* }"
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "the registry gave no usable digest for $target"
  # The tag names an edition; the image's label must agree, when it has one.
  # A digest names one exact build already chosen (upgrade's first signed switch): it keeps its edition.
  case "$target" in *@sha256:*) want="$edition" ;; *-no-npu) want=no-npu ;; esac
  case "$edition" in
    npu|no-npu) [ "$edition" = "$want" ] || die "$target is the $edition edition in the registry, not $want; nothing changed" ;;
  esac
  from="$(describe booted)"
  echo "Now:   $from"
  [ -z "$(field staged ref)" ] || echo "Staged for the next boot, and replaced by this: $(describe staged)"
  echo "After: $target ($release)"
  need_policy
  confirm "${question:-Switch to it?}"
  [ -z "$pin" ] || target="$(repo)@$digest"
  if ! bootc switch "$sig_flag" "$target"; then
    die "bootc did not switch; nothing changed. If it says the image was rejected, that image isn't signed with halOS's key: this machine takes only signed images, and releases before 0.19.1-alpha.3 aren't signed."
  fi
  load
  staged="$(describe staged || echo "$target ($release)")"
  if [ -n "$(field staged digest)" ] && [ "$(field staged digest)" != "$digest" ]; then
    echo "Note: the image changed in the registry just now; staged instead: $staged"
  fi
  # A tag pointed back at an older build (by someone with access to the registry but not the
  # key, or a mistake): say so before the reboot. rollback --to goes back on purpose.
  # Only for the same image name (the first signed upgrade): other channels and the other edition
  # are built at other times, so an older build there is normal.
  if [ "$what" = upgrade ] && [ -n "$(field staged timestamp)" ] && [[ "$(field staged timestamp)" < "$(field booted timestamp)" ]]; then
    echo "Warning: the staged image was built before the one running ($(field staged timestamp) vs $(field booted timestamp))."
    echo "Its channel may have moved back. Check with sudo halosctl version before rebooting; sudo bootc rollback undoes the staging."
    reboot=0
  fi
  record "$what" "$from" "$staged"
  finish
}

# Unlock over SSH (#13): /usr/libexec/halogen/ssh-unlock keeps the keys on the EFI partition.
unlock="${HALOS_SSH_UNLOCK:-/usr/libexec/halogen/ssh-unlock}"
encrypted() { lsblk -rno FSTYPE 2> /dev/null | grep -qx crypto_LUKS; }
# The keys named on the command line, checked.
keys_from_args() {
  local i out all=""
  for ((i = 0; i < ${#src[@]}; i += 2)); do
    if [ "${src[i]}" = key ]; then
      out="$(printf '%s\n' "${src[i+1]}" | "$unlock" check)" || die "--key: not a public key this can use"
    else out="$("$unlock" fetch "${src[i]}" "${src[i+1]}")" || exit 1; fi
    all+="$out"$'\n'
  done
  printf '%s' "$all"
}
# Asks where the keys are until some are found and taken, or the person skips. Keys in $picked.
pick_keys() {
  local c site user k
  picked=""
  while :; do
    echo "   Where are your SSH public keys? 1) GitHub  2) GitLab  3) Codeberg  4) paste one key  5) skip"
    read -rp "   Choose 1-5: " c || return 1
    case "$c" in 1) site=github ;; 2) site=gitlab ;; 3) site=codeberg ;; 4) site=key ;; 5) return 1 ;; *) continue ;; esac
    if [ "$site" = key ]; then
      read -rp "   Paste the public key (one line, such as ssh-ed25519 AAAA... you@computer): " k || return 1
      if ! picked="$(printf '%s\n' "$k" | "$unlock" check 2> /dev/null)"; then
        echo "   That isn't a public key this can use. Try again, or pick another option."; continue
      fi
    else
      read -rp "   User name on $site: " user || return 1
      picked="$("$unlock" fetch "$site" "$user")" || { echo "   Try another site or user name, or paste a key."; continue; }
    fi
    echo "   Keys found:"; "$unlock" describe <<< "$picked"
    ask "   Let these keys unlock the disk? [Y/n]" y && return 0
  done
}
# Saves the keys; fails (without stopping setup) when they can't be saved.
ssh_unlock_on() {
  printf '%s\n' "$1" | "$unlock" install || { echo "   Couldn't save the keys; nothing changed." >&2; return 1; }
  # The keys you just chose replace the record (install made a new host key if the old one had changed).
  HALOS_RECORD_REPLACE=1 "$unlock" record || echo "   Couldn't keep their fingerprints on the encrypted disk; sudo halosctl ssh-unlock record tries again." >&2
  record ssh-unlock off on
  "$unlock" status | sed 's/^/   /'
  ssh_unlock_howto
}
ssh_unlock_howto() {
  echo "   On the computer you unlock from, add the entry above to ~/.ssh/config and the known_hosts"
  echo "   line to ~/.ssh/known_hosts, once. The early-boot server has a host key of its own, and"
  echo "   this keeps it apart from the running system's. From the next boot, when the disk waits"
  echo "   for its passphrase (the TPM couldn't unlock it, or isn't used): ssh <name>-unlock, as"
  echo "   above, then type the passphrase. Wired network only, with DHCP."
}

# SSH logins with keys only (security audit, #94): a drop-in ahead of Fedora's own (sshd takes the
# first value it reads), checked with sshd -t before sshd reloads.
https="${HALOS_HTTPS_HELPER:-/usr/libexec/halogen/https}"
https_conf="${HALOS_HTTPS_ETC:-/etc/halos}/https.env"
scheme() { case "$("$https" mode 2> /dev/null)" in self-signed|custom|letsencrypt) echo https ;; *) echo http ;; esac; }
keys_only="${HALOS_SSHD_DROPIN:-/etc/ssh/sshd_config.d/20-halos-keys-only.conf}"
passwords_off() { [ -e "$keys_only" ]; }
# The admin running this has a key to log in with, so turning passwords off can't lock them out.
admin_has_key() {
  local home line key
  [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] || return 1
  home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
  [ -n "$home" ] || return 1
  # sshd ignores keys in a home or .ssh others can write to (StrictModes).
  local d; for d in "$home" "$home/.ssh"; do
    [ -d "$d" ] && [ ! -L "$d" ] || return 1
    case "$(stat -c %A "$d")" in ?????w????|????????w?) return 1 ;; esac
  done
  # Read as that user, never following anything as root; a key OpenSSH still accepts.
  while IFS= read -r line; do
    key="$(grep -oE '(ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp[0-9]+|sk-ecdsa-sha2-nistp256@openssh\.com|ssh-rsa) [A-Za-z0-9+/]+={0,3}' <<< "$line" | head -n 1)"
    [ -n "$key" ] && ssh-keygen -l -f /dev/stdin <<< "$key" > /dev/null 2>&1 && return 0
  done < <(runuser -u "$SUDO_USER" -- cat "$home/.ssh/authorized_keys" 2> /dev/null)
  return 1
}
set_passwords() { # on|off; fails (without stopping setup) when sshd won't take it
  if [ "$1" = off ]; then
    printf '%s\n' "# halOS: SSH logins with keys only; sudo halosctl ssh-passwords on allows passwords again." \
      "PasswordAuthentication no" "KbdInteractiveAuthentication no" > "$keys_only.new" && mv -f "$keys_only.new" "$keys_only" || return 1
    # The setting sshd will use: an earlier file could say yes, and the first value wins.
    if ! sshd -t > /dev/null 2>&1 || ! sshd -T 2> /dev/null | grep -qx 'passwordauthentication no'; then
      rm -f "$keys_only"; echo "sshd didn't take the change (another setting comes first?); nothing changed" >&2; return 1
    fi
  else rm -f "$keys_only"; fi
  systemctl try-reload-or-restart sshd.service || { echo "sshd couldn't reload; the change applies at its next start" >&2; return 1; }
}

cmd="${1:-version}"; [ $# = 0 ] || shift
case "$cmd" in history|setup|power|ssh-unlock|ssh-passwords|dashboard|https) ;; *) load ;; esac
args=(); src=()
while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y) yes=1 ;;
    --reboot) reboot=1 ;;
    --check) check=1 ;;
    --skip) skip=1 ;;
    # Where ssh-unlock on takes its keys: pairs of (site or "key", user or key text).
    --github|--gitlab|--codeberg|--key)
      [ $# -ge 2 ] || die "$1 needs a value"; src+=("${1#--}" "$2"); shift ;;
    --to) [ $# -ge 2 ] || die "--to needs a version, such as 0.19.0-alpha.1"; to="$2"; shift ;;
    --email) [ $# -ge 2 ] || die "--email needs an address"; email="$2"; shift ;;
    --staging) staging=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done

[ "${#src[@]}" = 0 ] || [ "$cmd" = ssh-unlock ] || die "--github, --gitlab, --codeberg and --key go with ssh-unlock on"
if [ -n "$email" ] || [ "$staging" = 1 ]; then
  if [ "$cmd" != https ] || [ "${args[0]:-}" != letsencrypt ]; then die "--email and --staging go with https letsencrypt"; fi
fi
case "$cmd" in switch|npu|power|ssh-unlock|ssh-passwords|dashboard|https) ;; *) [ "${#args[@]}" = 0 ] ;; esac || die "unexpected ${args[0]} (for an older release: halosctl rollback --to <version>)"

case "$cmd" in
  version)
    ch="$(channel)"
    echo "halOS ${HALOS_RELEASE:-$(field booted version)}, ${HALOGEN_VARIANT:-unknown} edition"
    if [ -n "$ch" ]; then echo "Channel:   $ch"
    else echo "Channel:   none, pinned to this release (follow one with: sudo halosctl switch beta)"; fi
    echo "Halogen:   ${HALOGEN_VERSION:-unknown} (${HALOGEN_IMAGE:-unknown})"
    echo "Image:     $(booted_ref)"
    echo "Digest:    $(field booted digest)"
    echo "Built:     $(field booted timestamp)"
    if queued; then echo "Next boot: $(describe rollback) (rollback queued)"
    else echo "Next boot: $(describe staged || echo "no change staged")"; fi
    echo "Rollback:  $(describe rollback || echo "none")"
    if verified; then echo "Signatures: checked on every update (halOS's key)"
    else echo "Signatures: not checked yet; sudo halosctl upgrade turns it on"; fi
    ;;
  upgrade)
    if ! verified; then
      # Once per machine: an upgrade with the signature check on is a switch to the same image name
      # with --enforce-container-sigpolicy. It fetches the newest image of that name, so it is also
      # the upgrade. An image pinned by digest stays the same build.
      ref="$(field "$(next_dep)" ref)"; name="${ref%@*}"; name="${name%:*}"
      echo "This machine doesn't check halOS's signature on its updates yet. This upgrade turns it on:"
      echo "from then on it takes only images signed with halOS's key."
      if [ "$check" = 1 ]; then echo "Check skipped; turn it on with: sudo halosctl upgrade"; exit 0; fi
      question="Download the newest image of this name and check its signature from now on?"
      switch_to upgrade "$(repo)${ref#"$name"}"
      exit 0
    fi
    need_policy
    [ -n "$(channel)" ] || echo "Note: this machine is pinned to one release, so an upgrade finds nothing newer. To follow new releases: sudo halosctl switch <channel>"
    if ! found="$(bootc upgrade --check 2>&1)"; then printf '%s\n' "$found" >&2; die "bootc could not check for updates"; fi
    printf '%s\n' "$found"
    # bootc says "No changes in: <image>" when nothing newer is in the registry than what this
    # machine already has, which includes an update staged earlier. Then there is nothing to
    # stage, so don't ask. Any other answer (an update, or wording we don't know) goes on.
    if grep -qi '^No changes in' <<< "$found"; then
      if [ -n "$(field staged digest)" ] && [ "$(field staged digest)" != "$(field booted digest)" ]; then
        echo "An update is already staged: $(describe staged). Reboot to use it: sudo systemctl reboot"
      else echo "Already up to date."; fi
      exit 0
    fi
    [ "$check" = 0 ] || exit 0
    from="$(describe booted)"; before="$(field staged digest)"
    echo "Now:   $from"
    confirm "Download and stage the newest release on this channel?"
    bootc upgrade
    load; after="$(field staged digest)"
    if [ -z "$after" ] || [ "$after" = "$before" ]; then echo "No new update was staged."; exit 0; fi
    record upgrade "$from" "$(describe staged)"
    # ISO times sort as text. An older build means the channel moved back; say so before a reboot.
    if [[ "$(field staged timestamp)" < "$(field booted timestamp)" ]]; then
      echo "Warning: the staged image was built before the one running ($(field staged timestamp) vs $(field booted timestamp))."
      echo "Its channel may have moved back. Check with sudo halosctl version before rebooting."
    fi
    finish
    ;;
  switch)
    [ "${#args[@]}" = 1 ] || die "which channel? alpha, beta, rc, release or edge"
    case "${args[0]}" in
      alpha|beta|rc|edge) ch="${args[0]}" ;;
      release|stable|latest) ch=stable ;;
      *) die "unknown channel ${args[0]}: use alpha, beta, rc, release or edge" ;;
    esac
    # Compared with what boots next: a staged switch to another channel can be undone this way.
    [ "$ch" != "$(channel "$(next_dep)")" ] || { echo "Already on $ch. For its newest release: sudo halosctl upgrade"; exit 0; }
    need_suffix
    switch_to switch "$(repo):$ch$sfx"
    ;;
  rollback)
    if [ -n "$to" ]; then
      [[ "$to" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]] || die "not a release: $to (such as 0.19.0-alpha.1)"
      echo "This pins the machine to $to; follow a channel again later with: sudo halosctl switch <channel>"
      need_suffix
      switch_to rollback "$(repo):$to$sfx" pin
      exit 0
    fi
    ! queued || die "a rollback is already queued. Reboot to apply it (sudo systemctl reboot), or undo it with: sudo bootc rollback"
    target="$(describe rollback)" || die "there is no previous image to go back to. Older releases: sudo halosctl history, then halosctl rollback --to <version>"
    from="$(describe booted)"
    echo "Now:   $from"
    echo "After: $target"
    staged="$(describe staged || true)"
    [ -z "$staged" ] || echo "This drops the update staged for the next boot: $staged"
    confirm "Go back to it?"
    bootc rollback
    record rollback "$from" "$target"
    finish
    ;;
  npu)
    [ "${#args[@]}" = 1 ] || die "npu on or npu off?"
    case "${args[0]}" in
      on) want=npu; new="" ;;
      off) want=no-npu; new="-no-npu" ;;
      *) die "npu on or npu off, not ${args[0]}" ;;
    esac
    ! queued || die "a rollback is queued for the next boot. Reboot first, then run this again."
    next="$(next_dep)"; need_suffix
    now="npu"; [ "$sfx" = "" ] || now="no-npu"
    [ "$want" != "$now" ] || { echo "Already the $want edition$([ "$next" = staged ] && echo " at the next boot")."; exit 0; }
    # Keep the channel, or the exact release the machine is pinned to.
    ch="$(channel "$next")"
    if [ -n "$ch" ]; then target="$(repo):$ch$new"; pin=""
    else
      tag="$(field "$next" ref)"; tag="${tag##*/}"
      # Pinned by digest: the release that boots next is its version label (a staged rollback --to
      # keeps its own release), not necessarily the one running.
      case "$tag" in *@*) tag="$(field "$next" version)" ;; *:*) tag="${tag##*:}"; tag="${tag%-no-npu}" ;; *) tag="" ;; esac
      [ -n "$tag" ] || tag="${HALOS_RELEASE:-}"
      [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]] \
        || die "this machine follows no channel and its release ($tag) has no tag for the other edition. Follow a channel first: sudo halosctl switch <channel>"
      target="$(repo):$tag$new"; pin=pin
      # A plain version tag (0.19.0) moves with stable releases and weekly rebuilds: keep following it.
      if [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then pin=""; fi
    fi
    if [ "$want" = no-npu ]; then
      echo "The no-NPU edition turns the IOMMU off: Halogen measured 13-16% faster prefill, and no"
      echo "NPU models run. The IOMMU stops plugged-in devices from reading memory. Without it, a device"
      echo "plugged into a USB4/Thunderbolt port or PCIe slot can read all of it, including the disk"
      echo "encryption key while the machine runs. Use it only where nobody untrusted can touch the machine."
      echo "Your NPU models and checkpoints stay in /srv/models, so npu on needs no new download."
      echo "HALOGEN_NPU_* settings in halogen.env are ignored on this edition."
    else
      if ! has_npu; then
        echo "Warning: this machine shows no AMD NPU, so the NPU edition's NPU models can't run here."
      fi
      echo "The NPU edition keeps the IOMMU on, which the NPU needs. Its first start downloads any"
      echo "NPU models not already in /srv/models/npu."
    fi
    switch_to "npu-${args[0]}" "$target" ${pin:+"$pin"}
    ;;
  power)
    acpi="${HALOGEN_SYS:-/sys}/firmware/acpi"; pp="${HALOS_PLATFORM_PROFILE:-/usr/libexec/halogen/platform-profile}"
    saved_file="${HALOS_PROFILE_FILE:-/etc/halos/platform-profile}"
    [ -e "$acpi/platform_profile" ] || die "this machine's firmware offers no power profile (no $acpi/platform_profile), so there is nothing to set"
    now="$(tr -cd 'a-z-' < "$acpi/platform_profile")"
    offers="$( { tr -cd 'a-z -' < "$acpi/platform_profile_choices"; } 2>/dev/null || true)"
    chosen=""; [ ! -r "$saved_file" ] || chosen="$(tr -cd 'a-z-' < "$saved_file")"
    if [ "${#args[@]}" = 0 ]; then
      echo "Power profile: $now"
      echo "Chosen:        ${chosen:-performance (the default)}"
      [ "$now" = "${chosen:-performance}" ] || echo "They differ: something changed it since boot. Set it again with: sudo halosctl power ${chosen:-performance}"
      echo "Offered:       $offers"
      echo "Change it with: sudo halosctl power low-power|balanced|performance (applies at once, no restart)"
      exit 0
    fi
    [ "${#args[@]}" = 1 ] || die "one profile: low-power, balanced or performance"
    if [ "$reboot$yes$check$skip" != 0000 ] || [ -n "$to" ]; then die "power applies at once and takes no options"; fi
    want="${args[0]}"
    case "$want" in low-power|balanced|performance) ;; *) die "unknown profile: use low-power, balanced or performance" ;; esac
    "$pp" check "$want" || die "this firmware does not offer $want (it offers: $offers); nothing changed"
    if [ "$want" = "$now" ] && [ "$want" = "${chosen:-performance}" ]; then echo "Already $want."; exit 0; fi
    mkdir -p "$(dirname "$saved_file")"
    printf '%s\n' "$want" > "$saved_file.new" && mv -f "$saved_file.new" "$saved_file"
    record power "$now" "$want"
    "$pp" apply || die "saved $want, but the firmware did not take it; it is tried again at the next boot"
    echo "Power profile: $want, now and at every boot. Halogen keeps running; no restart needed."
    [ "$want" = performance ] || echo "Halogen serves slower at $want than at performance (sudo halogenctl bench measures it)."
    ;;
  ssh-unlock)
    [ "${#args[@]}" -le 1 ] || die "ssh-unlock on, off, record, or nothing for its state"
    [ "${#src[@]}" = 0 ] || [ "${args[0]:-}" = on ] || die "--github, --gitlab, --codeberg and --key go with ssh-unlock on"
    case "${args[0]:-}" in
      ''|status) "$unlock" status ;;
      record)
        [ "$("$unlock" status --short)" != off ] || die "unlocking over SSH isn't set up"
        "$unlock" status | sed 's/^/   /'
        confirm "Keep these keys' and host key's fingerprints on the encrypted disk, to notice if they change?"
        "$unlock" record
        echo "Recorded. The selftest and sudo halosctl ssh-unlock now warn if they change." ;;
      on)
        encrypted || die "the disk isn't encrypted, so there is nothing to unlock"
        if [ "${#src[@]}" -gt 0 ]; then keys="$(keys_from_args)"
        else
          [ -t 0 ] || die "name the keys (--github <user>, --gitlab <user>, --codeberg <user>, --key '<public key>'), or run it in a terminal"
          pick_keys || { echo "Nothing changed."; exit 1; }
          keys="$picked"
        fi
        echo "These keys may unlock the disk over SSH, replacing any set before:"
        "$unlock" describe <<< "$keys"
        confirm "Turn on unlocking over SSH with them?"
        ssh_unlock_on "$keys" || exit 1
        ;;
      off)
        [ "$("$unlock" status --short)" != off ] || { echo "Unlocking over SSH is already off."; exit 0; }
        confirm "Turn off unlocking over SSH?"
        "$unlock" remove
        record ssh-unlock on off
        echo "Off: from the next boot, no SSH server runs before the disk is unlocked."
        ;;
      *) die "ssh-unlock on, off, record, or nothing for its state" ;;
    esac
    ;;
  ssh-passwords)
    [ "${#args[@]}" -le 1 ] || die "ssh-passwords on, off, or nothing for its state"
    case "${args[0]:-}" in
      '')
        if passwords_off; then echo "SSH logins: keys only. Passwords again: sudo halosctl ssh-passwords on"
        else echo "SSH logins: keys or passwords. Keys only: sudo halosctl ssh-passwords off"; fi ;;
      off)
        if passwords_off; then echo "Passwords are already off for SSH logins."; exit 0; fi
        admin_has_key || die "your account (${SUDO_USER:-root}) has no SSH key in ~/.ssh/authorized_keys, so turning passwords off could lock you out. Add your key first (ssh-copy-id from your computer)"
        echo "SSH logins will need a key; passwords keep working at the machine's own screen."
        confirm "Turn off passwords for SSH logins?"
        set_passwords off || exit 1
        record ssh-passwords on off
        echo "Done: SSH logins now need a key." ;;
      on)
        passwords_off || { echo "Passwords are already allowed for SSH logins."; exit 0; }
        confirm "Allow passwords for SSH logins again?"
        set_passwords on || exit 1
        record ssh-passwords off on
        echo "Done: SSH logins take passwords again." ;;
      *) die "ssh-passwords on, off, or nothing for its state" ;;
    esac
    ;;
  dashboard)
    [ "${#args[@]}" -le 1 ] || die "dashboard on, off, or nothing for its state"
    if [ "$reboot$yes$check$skip" != 0000 ] || [ -n "$to" ]; then die "dashboard takes no options"; fi
    unit=halos-dashboard.service
    dash_on() { [ "$(systemctl is-enabled "$unit" 2> /dev/null)" = enabled ]; }
    dash_url() { local ip; ip="$(hostname -I 2> /dev/null | awk '{print $1}')"; echo "$(scheme)://${ip:-<this machine>}:8732"; }
    case "${args[0]:-}" in
      '')
        if dash_on; then echo "Dashboard: on ($(systemctl is-active "$unit" 2> /dev/null)), at $(dash_url). Off: sudo halosctl dashboard off"
        else echo "Dashboard: off. On: sudo halosctl dashboard on"; fi ;;
      on)
        dash_on && [ "$(systemctl is-active "$unit" 2> /dev/null)" = active ] && { echo "The dashboard is already on, at $(dash_url)."; exit 0; }
        systemctl enable --now "$unit" || die "the dashboard didn't start: sudo journalctl -u $unit"
        record dashboard off on
        echo "Dashboard on: $(dash_url) (no login: anyone on your network can view it, nobody can change anything)." ;;
      off)
        dash_on || [ "$(systemctl is-active "$unit" 2> /dev/null)" = active ] || { echo "The dashboard is already off."; exit 0; }
        systemctl disable --now "$unit" || die "the dashboard didn't stop: sudo systemctl status $unit"
        record dashboard on off
        echo "Dashboard off: port 8732 now says so, and it stays off after reboots."
        echo "Its history stays in /var/lib/halos-dashboard for when it's on again." ;;
      *) die "dashboard on, off, or nothing for its state" ;;
    esac
    ;;
  https)
    if [ "$reboot$check$skip" != 000 ] || [ -n "$to" ]; then die "https takes --yes only"; fi
    unit=halos-proxy.service
    addr() { local ip; ip="$(hostname -I 2> /dev/null | awk '{print $1}')"; echo "${ip:-<this machine>}"; }
    fact() { sed -n "s/^$1 //p" <<< "$facts"; }
    show() {
      facts="$("$https" describe)"
      case "$(fact mode)" in
        invalid)
          echo "HTTPS: the setting in $https_conf isn't off, self-signed, custom or letsencrypt, so Caddy doesn't start."
          echo "Fix: sudo halosctl https off, or sudo halosctl https self-signed" ;;
        off)
          echo "HTTPS: off. Apps use http://$(addr):8731/v1, and the dashboard is http://$(addr):8732."
          echo "On: sudo halosctl https self-signed, or sudo halosctl https custom <certificate> <key>" ;;
        self-signed)
          echo "HTTPS: on, with halOS's own authority (self-signed). Apps use https://$(addr):8731/v1,"
          echo "and the dashboard is https://$(addr):8732."
          if [ "$(fact ca)" = none ]; then echo "  The authority isn't made yet: sudo systemctl status $unit"
          else
            echo "  Authority's fingerprint (SHA-256): $(fact ca)"
            echo "  Valid until $(fact ca_until). Apps and browsers must trust it once:"
            echo "  sudo halosctl https ca > halos-ca.crt, then add halos-ca.crt to the app or the system."
          fi
          echo "  Names and addresses covered: $(fact names)"
          echo "  Other names (they replace the earlier ones; alone it keeps them): sudo halosctl https self-signed <name>..."
          echo "  A new address of this machine is added within a minute, by restarting Caddy." ;;
        custom)
          echo "HTTPS: on, with your certificate for $(fact subject), valid until $(fact until)."
          case "$(fact expires)" in
            soon) echo "  It expires within 14 days: sudo halosctl https custom <new certificate> <key>" ;;
            ended) echo "  It has ended, so apps refuse it: sudo halosctl https custom <new certificate> <key>" ;;
          esac
          echo "  Apps use https://<the name on the certificate>:8731/v1." ;;
        letsencrypt)
          local first; first="$(fact public)"; first="${first%% *}"
          echo "HTTPS: on, with Let's Encrypt certificates for $(fact public) (DNS: $(fact provider))."
          if [ "$(fact staging)" = yes ]; then
            echo "  From Let's Encrypt's staging (test) service: apps don't trust these. For real ones, run the"
            echo "  same command again without --staging: sudo halosctl https letsencrypt $(fact provider) $(fact public)"
          fi
          if [ "$(fact until)" = none ]; then
            echo "  No certificate yet: Caddy is still getting it, or can't. sudo journalctl -u $unit"
          else
            echo "  Valid until $(fact until), from $(fact issuer). Caddy renews it by itself, well before the end."
            case "$(fact expires)" in
              soon) echo "  It ends within 10 days, so renewing is failing: sudo journalctl -u $unit" ;;
              ended) echo "  It has ended, so apps refuse it: sudo journalctl -u $unit" ;;
            esac
          fi
          echo "  Apps use https://$first:8731/v1, and the dashboard is https://$first:8732."
          echo "  This machine's own names and addresses keep halOS's authority (sudo halosctl https ca):"
          echo "  $(fact names)" ;;
      esac
    }
    # Up means Caddy answers on 8731 (any HTTP code: Halogen may be down), not only that it started:
    # systemd counts a start as done before Caddy has bound its ports.
    proxy_up() {
      local code="" s=http i
      case "$("$https" mode)" in self-signed|custom|letsencrypt) s=https ;; esac
      for i in $(seq 10); do
        if [ "$(systemctl is-active "$unit" 2> /dev/null)" = active ]; then
          code="$(curl -sS -k -m 3 -o /dev/null -w '%{http_code}' "$s://127.0.0.1:8731/health" 2> /dev/null || true)"
          [ -n "$code" ] && [ "$code" != 000 ] && return 0
        fi
        [ "$i" = 10 ] || sleep 1
      done
      return 1
    }
    # With Let's Encrypt, up also means each public name is served a certificate: Caddy gets them
    # after it starts, which takes from seconds to a few minutes (the TXT record must reach the
    # provider's name servers). Asked once a few seconds, never with curl's retries (a 503 answer
    # would make curl wait 30 s each time).
    acme_up() {
      local n code ok start=$SECONDS wait="${HALOS_ACME_WAIT:-300}" told=0 public
      [ "$("$https" mode)" = letsencrypt ] || return 0
      read -ra public <<< "$(sed -n 's/^HALOS_HTTPS_NAMES=//p' "$https_conf" | tail -n 1)"
      echo "Getting certificates from Let's Encrypt (usually under a minute, at most $((wait / 60)) minutes)..."
      while :; do
        ok=1
        for n in "${public[@]}"; do
          code="$(curl -sS -k -m 5 --resolve "$n:8731:127.0.0.1" -o /dev/null -w '%{http_code}' "https://$n:8731/health" 2> /dev/null || true)"
          if [ -z "$code" ] || [ "$code" = 000 ]; then ok=0; fi
        done
        [ "$ok" = 0 ] || return 0
        [ $((SECONDS - start)) -lt "$wait" ] || break
        if [ $((SECONDS - start)) -ge $((told + 30)) ]; then told=$((SECONDS - start)); echo "  still waiting ($told s)"; fi
        sleep 5
      done
      # What Caddy said, without anything but the error text (the providers' own credentials are
      # kept out of it).
      echo "No certificate after $wait s. Caddy's last errors:" >&2
      journalctl -u "$unit" --since "$since" --no-pager -o cat 2> /dev/null \
        | jq -Rr 'fromjson? | select(.level == "error") | .error // empty' 2> /dev/null \
        | tail -n 3 | tr -d '\000-\010\013-\037\177' | cut -c1-300 | sed 's/^/  /' >&2 || true
      return 1
    }
    # Switch, and go back to what was there (the mode, and the certificate or DNS credentials it
    # had) if Caddy doesn't come up with it, so the API never stays down.
    apply() {
      local saved="" certs=""
      [ -e "$https_conf" ] && saved="$(cat "$https_conf")"
      case "$1" in
        commit) shift; "$https" commit; certs=restore ;;
        dns-commit) shift; "$https" dns-commit; certs=dns-restore ;;
      esac
      # A refused setting puts back what commit replaced (it is checked earlier, but never trusted).
      if ! "$https" set "$@"; then
        [ -z "$certs" ] || "$https" "$certs"
        die "nothing changed"
      fi
      since="$(date '+%Y-%m-%d %H:%M:%S')"
      revert() {
        trap - INT TERM HUP
        if [ -n "$saved" ]; then printf '%s\n' "$saved" > "$https_conf"; else rm -f "$https_conf"; fi
        [ -z "$certs" ] || "$https" "$certs"
      }
      # Interrupted while waiting (Ctrl-C, a dropped SSH session): the previous setting comes back.
      trap 'revert; systemctl restart "$unit"; die "interrupted, so the previous setting is back"' INT TERM HUP
      if ! systemctl restart "$unit" || ! proxy_up || ! acme_up; then
        revert
        if systemctl restart "$unit" && proxy_up; then
          die "Caddy didn't come up with it, so the previous setting is back: sudo journalctl -u $unit"
        fi
        die "Caddy didn't come up with it, nor with the previous setting: sudo journalctl -u $unit, then sudo halosctl https off"
      fi
      trap - INT TERM HUP
    }
    case "${args[0]:-}" in
      '') show ;;
      ca) "$https" ca ;;
      forget-dns)
        dnsd="${HALOS_HTTPS_ETC:-/etc/halos}/https/dns"
        # The folder itself always exists (tmpfiles); saved means a provider or a kept older copy.
        if [ ! -e "$dnsd/provider" ] && [ ! -d "$dnsd/.prev" ]; then echo "No DNS credentials are saved."; exit 0; fi
        confirm "Delete the saved DNS provider credentials? (Revoke them at the provider too.) The front door restarts for a moment."
        "$https" dns-forget
        # Caddy got them as systemd credentials when it started, and keeps them until it stops.
        systemctl try-restart halos-proxy.service
        echo "Deleted." ;;
      off)
        [ "$("$https" mode)" != off ] || { echo "HTTPS is already off."; exit 0; }
        confirm "Go back to plain HTTP on 8731 and 8732? Apps set to https:// stop working until changed back."
        old="$("$https" mode)"; apply off
        record https "$old" off
        show ;;
      self-signed)
        old="$("$https" mode)"
        echo "Apps must then use https:// and trust halOS's authority once (sudo halosctl https ca prints it);"
        echo "plain http:// gets a redirect."
        confirm "Turn on HTTPS with halOS's own authority?"
        apply self-signed "${args[@]:1}"
        # Caddy makes its authority at its first HTTPS start.
        for _ in $(seq 20); do "$https" ca > /dev/null 2>&1 && break; sleep 0.5; done
        record https "$old" self-signed
        show ;;
      custom)
        [ "${#args[@]}" = 3 ] || die "https custom <certificate> <key> (PEM files; the key without a passphrase)"
        old="$("$https" mode)"
        # Checked from a staged copy; nothing in use changes until you say yes.
        "$https" stage "${args[1]}" "${args[2]}"
        staged="${HALOS_HTTPS_ETC:-/etc/halos}/https/.pending/cert.pem"
        echo "Certificate for $(openssl x509 -in "$staged" -noout -subject -nameopt RFC2253 2> /dev/null | cut -d= -f2-), valid until $(openssl x509 -in "$staged" -noout -enddate 2> /dev/null | cut -d= -f2)."
        if ! ( confirm "Turn on HTTPS with this certificate?" ); then "$https" discard; exit 1; fi
        apply commit custom
        record https "$old" custom
        show ;;
      letsencrypt)
        [ "${#args[@]}" -ge 3 ] || die "https letsencrypt <cloudflare|duckdns|porkbun|namecheap> <name>... [--email <address>] [--staging]"
        p="${args[1]}"
        case "$p" in
          cloudflare|duckdns) fields=(api_token) ;;
          porkbun) fields=(api_key api_secret_key) ;;
          namecheap) fields=(api_key user client_ip) ;;
          *) die "the DNS provider must be cloudflare, duckdns, porkbun or namecheap (how to make each one's key: INSTALL.md, HTTPS)" ;;
        esac
        old="$("$https" mode)"
        set_args=(letsencrypt "$p")
        [ -z "$email" ] || set_args+=(--email "$email")
        [ "$staging" = 0 ] || set_args+=(--staging)
        set_args+=("${args[@]:2}")
        # Names, email and provider checked before any secret is asked for.
        "$https" set --check "${set_args[@]}" || exit 1
        echo "Let's Encrypt certificates for ${args[*]:2}, through $p's API (DNS-01: no port is opened to the"
        echo "internet). Each name must be in a zone at $p, and point to this machine (a private address is"
        echo "fine). Certificates are public: the names appear in Certificate Transparency logs."
        [ "$staging" = 0 ] || echo "Staging: Let's Encrypt's test service, whose certificates apps don't trust."
        # The provider's credentials: asked for here (secrets not shown), or field=value lines on
        # stdin with --yes; never as arguments, which sudo's log and shell history would keep.
        dnsconf="${HALOS_HTTPS_ETC:-/etc/halos}/https/dns"
        saved_p="$(cat "$dnsconf/provider" 2> /dev/null || true)"
        "$https" dns-discard   # nothing half-staged from an earlier, interrupted run
        creds=""
        if [ -t 0 ]; then
          if [ "$saved_p" != "$p" ] || ! ask "Use the $p credentials saved before? [Y/n]" y; then
            for f in "${fields[@]}"; do
              case "$f" in
                user) read -rp "$p API user name: " v ;;
                client_ip) read -rp "This machine's public IPv4 address, as allowed in Namecheap's API settings: " v ;;
                *) read -rsp "$p $f (not shown): " v; echo ;;
              esac
              creds+="$f=$v"$'\n'
            done
          fi
        else
          creds="$(head -c 4096)"
          [ -n "$creds" ] || [ "$saved_p" = "$p" ] || die "no $p credentials: give them as field=value lines on stdin (${fields[*]})"
        fi
        if [ -n "$creds" ]; then printf '%s' "$creds" | "$https" dns-stage "$p"; fi
        unset creds v
        if ! ( confirm "Turn on HTTPS with Let's Encrypt?" ); then "$https" dns-discard; exit 1; fi
        if [ -d "$dnsconf/.pending" ]; then
          apply dns-commit "${set_args[@]}"
          # They work, so the replaced ones go (revoke those at the provider too).
          "$https" dns-forget-prev
        else apply "${set_args[@]}"; fi
        record https "$old" letsencrypt
        show ;;
      *) die "https self-signed, custom <certificate> <key>, letsencrypt <provider> <name>..., off, ca, forget-dns, or nothing for its state" ;;
    esac
    ;;
  history)
    if [ -s "$history" ]; then cat "$history"; else echo "No changes recorded yet. Changes made with halosctl are listed here."; fi
    ;;
  setup)
    # First-boot setup: how the disk unlocks, a Hugging Face token, settings. Each step can be
    # skipped, and it can run again at any time. On a new install the first download waits for
    # it (up to 30 minutes); finishing or --skip lets the download start.
    state="${HALOGEN_STATE_DIR:-/var/lib/halogen}"; configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
    as_halogen() { runuser -u halogen -- "$@"; }
    pending=0; ! as_halogen test -e "$state/setup-pending" || pending=1
    release_fetch() {
      [ "$pending" = 1 ] || return 0
      as_halogen rm -f "$state/setup-pending"
      echo "The first download (about 130 GB) starts now. The login screen shows its progress;"
      echo "follow the details with: sudo halogenctl fetch-logs"
    }
    if [ "$skip" = 1 ]; then
      release_fetch; [ "$pending" = 1 ] || echo "Setup isn't pending; nothing to skip."
      exit 0
    fi
    [ -t 0 ] || die "setup asks questions, so run it in a terminal (or: sudo halosctl setup --skip)"
    echo "halOS setup. Each step can be skipped; run sudo halosctl setup again any time."

    echo; echo "1. How the disk unlocks at boot"
    # The guided installer keeps the choice made there (#13); it sets the defaults below.
    chosen="$("$unlock" choice 2> /dev/null || true)"
    tpm_yn="[Y/n]"; tpm_default=y; ssh_yn="[Y/n]"; ssh_default=y
    case "$chosen" in ssh|none) tpm_yn="[y/N]"; tpm_default=n ;; esac
    case "$chosen" in tpm|none) ssh_yn="[y/N]"; ssh_default=n ;; esac
    crypt="$(lsblk -rno PATH,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')"
    [ -n "$crypt" ] || chosen=""
    case "$chosen" in
      both) echo "   At install you chose: the TPM, and SSH when it can't." ;;
      tpm) echo "   At install you chose: the TPM." ;;
      ssh) echo "   At install you chose: SSH, not the TPM." ;;
      none) echo "   At install you chose: the passphrase at the keyboard." ;;
    esac
    if [ -z "$crypt" ]; then echo "   The disk isn't encrypted, so there is nothing to unlock."
    elif [ ! -e "${HALOGEN_DEV:-/dev}/tpmrm0" ] && [ ! -e "${HALOGEN_DEV:-/dev}/tpm0" ]; then echo "   No TPM found: you type the passphrase at each boot."
    elif [ "$(cryptsetup luksDump "$(head -n 1 <<< "$crypt")" 2>/dev/null | grep -cE '^[[:space:]]*[0-9]+: systemd-tpm2')" -gt 0 ]; then
      echo "   It unlocks with the TPM already. After a BIOS or Secure Boot change: sudo halogen-enroll-tpm"
    elif echo "   With the TPM this machine unlocks its own disk: that protects a disk taken out of it, not" \
              "the machine taken whole (INSTALL.md, section 8)." && \
         ask "   Unlock with the TPM, so no passphrase is needed while Secure Boot and the BIOS stay the same? $tpm_yn" "$tpm_default"; then
      halogen-enroll-tpm || echo "   That didn't work; the passphrase still unlocks the disk. Try again later: sudo halogen-enroll-tpm"
    else echo "   Kept: you type the passphrase at each boot."; fi
    if [ -n "$crypt" ]; then
      echo "   Unlocking over SSH: when the TPM can't unlock the disk (after a BIOS update, say), or on a"
      echo "   machine without one, you type the passphrase from another computer instead of at a keyboard."
      if [ "$("$unlock" status --short 2> /dev/null || echo off)" != off ]; then
        # Set up by the installer: keep the fingerprints now, from the first boot.
        rc=0; "$unlock" verify 2> /dev/null || rc=$?
        if [ "$rc" = 2 ] && "$unlock" record 2> /dev/null; then
          echo "   Recorded their fingerprints on the encrypted disk, to notice if they change."
        elif [ "$rc" = 1 ]; then
          echo "   WARNING: they differ from the record on the encrypted disk; see sudo halosctl ssh-unlock"
        fi
        echo "   It's set up already (sudo halosctl ssh-unlock changes it):"
        "$unlock" status | sed 's/^/   /'
        ssh_unlock_howto
      elif ask "   Set up unlocking over SSH? $ssh_yn" "$ssh_default" && pick_keys; then
        ssh_unlock_on "$picked" || echo "   Try again later: sudo halosctl ssh-unlock on"
      else echo "   Skipped. Later: sudo halosctl ssh-unlock on"; fi
    fi

    if ! passwords_off && admin_has_key; then
      echo "   Your account logs in over SSH with a key. Passwords could be turned off for SSH logins, so"
      echo "   nobody can guess one (the machine's own screen still takes it)."
      if ask "   Allow only keys for SSH logins? [y/N]" n; then
        if set_passwords off; then record ssh-passwords on off; echo "   Done."; else echo "   Kept. Later: sudo halosctl ssh-passwords off"; fi
      else echo "   Kept. Later: sudo halosctl ssh-passwords off"; fi
    fi

    echo; echo "2. Hugging Face token (optional: higher download limits, and access to gated repositories)"
    echo "   It stays on this machine, in /srv/configs, and is never printed."
    if as_halogen test -s "$configs/hf-token"; then echo "   A token is saved. Change it with: sudo halogenctl hf-token"
    elif ask "   Add one now? Create it at huggingface.co/settings/tokens (read access is enough). [y/N]" n; then
      halogenctl hf-token > /dev/null || true
      if as_halogen test -s "$configs/hf-token"; then echo "   Saved."; fi
    else echo "   Skipped. Add one later with: sudo halogenctl hf-token"; fi

    echo; echo "3. Settings"
    echo "   Halogen's defaults suit most people. Every option, with what it does: sudo halogenctl options"
    if ask "   Open /srv/configs/halogen.env in an editor now? [y/N]" n; then
      # As sudoedit does: root edits a private copy, and the copy goes back as halogen. Nothing of
      # halogen's (its home, an editor startup file) runs on root's terminal, and root never
      # opens halogen's files itself.
      editor="$(command -v "${EDITOR:-nano}" || command -v vi || true)"
      [ -n "$editor" ] || die "no editor found; edit it with: sudo halogenctl options, then the file"
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      as_halogen cat "$configs/halogen.env" > "$tmp/halogen.env" || die "could not read $configs/halogen.env"
      cp "$tmp/halogen.env" "$tmp/before"
      if "$editor" "$tmp/halogen.env" && ! cmp -s "$tmp/before" "$tmp/halogen.env"; then
        # shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
        as_halogen sh -c 'umask 027; cat > "$1.new" && mv -f "$1.new" "$1"' sh "$configs/halogen.env" < "$tmp/halogen.env"
        echo "   Saved. What Halogen will get: sudo halogenctl config"
      else echo "   No change."; fi
      rm -rf "$tmp"; trap - EXIT
    else echo "   Kept the defaults."; fi

    echo
    if [ "$pending" = 1 ]; then release_fetch
    elif ask "Restart Halogen now, so the changes apply? It stops answering for a few minutes. [y/N]" n; then
      halogenctl restart && echo "Restarting. The login screen shows when it is ready."
    else echo "Apply changes later with: sudo halogenctl restart"; fi
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
