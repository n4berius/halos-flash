## halOS's audit rules (#107), loaded by augenrules at boot. Fedora's default rules file
## (audit.rules, "-a task,never") turns system-call auditing off for every process, and file
## watches with it, so the image removes it and these rules take its place.
## Read them back with: sudo ausearch -i -k <key>   (keys below), or sudo aureport --summary

## Start afresh; keep going past a rule that can't load (a missing path) instead of loading none.
-D
-i
## Room for bursts, and never stop the machine when the queue fills: only report it (-f 1).
-b 8192
--backlog_wait_time 60000
-f 1

## Halogen's own processes (everything its user manager starts as uid 970: the server, its
## containers, downloads, benchmarks) are left out of system-call auditing. They are the busy
## ones: this keeps the cost of auditing off the engine. It also means the watches below record
## root's and admins' changes (halogenctl run with sudo included), not what Halogen's own
## services write in /var/srv/configs. The selftest checks this rule is loaded (-i would hide it failing).
## auid=970: only Halogen's own login session (its user manager, started by PAM with login uid
## 970). Root acting as uid 970 from an admin's login or a system service stays audited, so
## taking on Halogen's uid (runuser, setpriv, sudo -u) is no way to hide a change from the watches
## below. What root asks Halogen's own manager to run is still left out; it has only halogen's rights.
-a task,never -F uid=970 -F auid=970

## halOS's settings and keys
-w /etc/halos -p wa -k halos-config
-w /var/srv/configs -p wa -k halogen-config
## Which images updates are taken from (signature policy and key)
-w /etc/containers/policy.json -p wa -k signature-policy
-w /etc/containers/registries.d -p wa -k signature-policy
-w /etc/pki/containers -p wa -k signature-policy
## How Halogen's container is started (the Quadlet and its drop-ins), and the rest of the
## container settings (registries, mirrors)
-w /etc/containers/systemd -p wa -k quadlet
-w /etc/containers -p wa -k containers
## The audit rules and settings themselves, and system services and timers
-w /etc/audit -p wa -k audit-config
-w /etc/systemd -p wa -k systemd-config
## Logins and admin rights
-w /etc/ssh -p wa -k sshd-config
-w /etc/pam.d -p wa -k pam
-w /etc/security -p wa -k pam
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers
-w /etc/passwd -p wa -k accounts
-w /etc/group -p wa -k accounts
-w /etc/shadow -p wa -k accounts
-w /etc/gshadow -p wa -k accounts
-w /etc/subuid -p wa -k accounts
-w /etc/subgid -p wa -k accounts
## Things that run code as root: a preloaded library, kernel modules, udev rules; and the
## firewall and kernel settings
-w /etc/ld.so.preload -p wa -k preload
-w /etc/modprobe.d -p wa -k modules
-w /etc/modules-load.d -p wa -k modules
-w /etc/udev/rules.d -p wa -k udev
-w /etc/firewalld -p wa -k firewall
-w /etc/sysctl.d -p wa -k sysctl
-w /etc/sysctl.conf -p wa -k sysctl
## Settings every login and program picks up: the environment, where libraries and names are
## looked up, and what is mounted at boot
-w /etc/environment -p wa -k environment
-w /etc/ld.so.conf -p wa -k preload
-w /etc/ld.so.conf.d -p wa -k preload
-w /etc/ld.so.cache -p wa -k preload
## nsswitch.conf and PAM's system-auth are links into authselect's folder on Fedora, and a watch
## on a link doesn't cover the file it points to.
-w /etc/nsswitch.conf -p wa -k accounts
-w /etc/authselect -p wa -k accounts
-w /etc/fstab -p wa -k mounts
## Who gets shut out after failed logins, and who never does
-w /etc/fail2ban -p wa -k fail2ban
-w /etc/crypttab -p wa -k luks-tpm
## Runs of modprobe, insmod and rmmod (all kmod) by any process, logged in or not. Loads the kernel
## starts itself, and those udev and systemd make through the library, run no program and aren't seen.
-a always,exit -F path=/usr/bin/kmod -F perm=x -k modules
## Disk encryption and the TPM, OS updates and halOS's own tools: each run by someone logged in
## (auid is the login the process came from; "unset" is the system's own services, such as the
## status timer that runs "halosctl version" every ten minutes, which would bury the rest).
-a always,exit -F path=/usr/bin/halogen-enroll-tpm -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/bin/systemd-cryptenroll -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/sbin/cryptsetup -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/bin/bootc -F perm=x -F auid!=unset -k os-update
-a always,exit -F path=/usr/bin/halosctl -F perm=x -F auid!=unset -k halosctl
-a always,exit -F path=/usr/bin/halogenctl -F perm=x -F auid!=unset -k halogenctl
## Logins, sudo and account changes need no rule: PAM and the tools report them themselves.

## Lock the rules until the next reboot: nobody, root included, can switch auditing off or change
## a rule on the running system (an attempt is refused and recorded). A rule change therefore
## needs a reboot, as an OS update does. augenrules keeps this line last.
-e 2
