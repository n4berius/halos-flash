## halOS's audit rules (#107), loaded by augenrules at boot. Fedora's default rules file
## (audit.rules, "-a task,never") turns system-call auditing off for every process, and file
## watches with it, so the image removes it and these rules take its place.
## Read them back with: sudo ausearch -i -k <key>   (keys below), or sudo aureport --summary

## Start afresh; keep going past a rule that can't load (a missing path) instead of loading none.
-D
-i
## Room for bursts, and never stop the machine when the queue fills: only report it (-f 1).
-b 8192
--backlog_wait_time 60000
-f 1

## Halogen's own processes (everything its user manager starts as uid 970: the server, its
## containers, downloads, benchmarks) are left out of system-call auditing. They are the busy
## ones: this keeps the cost of auditing off the engine. It also means the watches below record
## root's and admins' changes (halogenctl run with sudo included), not what Halogen's own
## services write in /var/srv/configs. The selftest checks this rule is loaded (-i would hide it failing).
-a task,never -F uid=970

## halOS's settings and keys
-w /etc/halos -p wa -k halos-config
-w /var/srv/configs -p wa -k halogen-config
## Which images updates are taken from (signature policy and key)
-w /etc/containers/policy.json -p wa -k signature-policy
-w /etc/containers/registries.d -p wa -k signature-policy
-w /etc/pki/containers -p wa -k signature-policy
## Logins and admin rights
-w /etc/ssh/sshd_config -p wa -k sshd-config
-w /etc/ssh/sshd_config.d -p wa -k sshd-config
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers
-w /etc/passwd -p wa -k accounts
-w /etc/group -p wa -k accounts
-w /etc/shadow -p wa -k accounts
## Disk encryption and the TPM, OS updates and halOS's own tools: each run by someone logged in
## (auid is the login the process came from; "unset" is the system's own services, such as the
## status timer that runs "halosctl version" every ten minutes, which would bury the rest).
-a always,exit -F path=/usr/bin/halogen-enroll-tpm -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/bin/systemd-cryptenroll -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/sbin/cryptsetup -F perm=x -F auid!=unset -k luks-tpm
-a always,exit -F path=/usr/bin/bootc -F perm=x -F auid!=unset -k os-update
-a always,exit -F path=/usr/bin/halosctl -F perm=x -F auid!=unset -k halosctl
-a always,exit -F path=/usr/bin/halogenctl -F perm=x -F auid!=unset -k halogenctl
## Logins, sudo and account changes need no rule: PAM and the tools report them themselves.
