# The search container's way out (halogenctl web-search): an ordinary network with DNS and a route
# to the internet and your LAN, for SearXNG's queries to search engines, or the relay's to your own
# SearXNG. Halogen is never on it. isolate=strict: no traffic between it and any other Podman network
# (isolate=true would cut only networks that also set it; Podman's default network, used by the
# download containers, doesn't). halogen-internal is internal, with no route in or out anyway.
[Network]
NetworkName=halos-search-out
Options=isolate=strict
