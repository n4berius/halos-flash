[Unit]
Description=Halogen Flash server
Requires=halogen-fetch.service
After=halogen-fetch.service
# An unclean GPU exit can need a reboot, so do not restart forever.
StartLimitIntervalSec=900
StartLimitBurst=3

[Container]
Image=@HALOGEN_IMAGE@
Pull=never
ContainerName=halogen
# On this machine only: halos-proxy.service (Caddy) answers the network on 8731, over HTTP or
# HTTPS, and passes requests on to here.
PublishPort=127.0.0.1:18731:8731
AddDevice=/dev/kfd
AddDevice=/dev/dri
Ulimit=memlock=-1:-1
PodmanArgs=--ipc=host --group-add=keep-groups
# No capabilities and no setuid gains inside the container (security audit R2). Halogen's
# entrypoint changes no owners or users, devices come through the halogen group, and memlock
# comes from the rlimit above, not CAP_IPC_LOCK. The fetch containers already run this image so.
DropCapability=all
NoNewPrivileges=true
# The image itself is read-only while it runs (security audit, owner agreed): Halogen's start writes
# only to /tmp and /var/tmp (its tuning-plan copy, NPU output, a prompt-cache snapshot of up to
# 26.6 GiB), and the GPU runtime may cache under /root. Those stay writable on disk as before
# (anonymous volumes, removed with the container), never in memory. podman's own read-only tmpfs is
# off: it mounts a tmpfs on /tmp and /var/tmp beside a volume there, and which one wins changes from
# start to start (code review, reproduced). So /run gets its tmpfs here, and the host's /dev/shm
# (--ipc=host) is bound again, since --read-only alone remounts it read-only.
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/run
Volume=/dev/shm:/dev/shm
Volume=/tmp
Volume=/var/tmp
Volume=/root
# Your approved settings, then the locked ones from the read-only OS.
EnvironmentFile=/run/user/970/halogen/effective.env
EnvironmentFile=/usr/share/halogen/locked.env
StopTimeout=60

# No download settings here: the server starts offline and read-only.
Volume=/srv/models:/models:ro
# The prompt cache on disk (Halogen's HALOGEN_CACHE_DIR): a conversation survives a restart of
# Halogen instead of being read again in full. The one writable folder under the models; prepare
# makes it at boot, and render-config sets HALOGEN_CACHE_DIR=/cache unless
# sudo halogenctl cache off (the mount stays; Halogen then isn't told about it).
Volume=/srv/models/.prompt-cache:/cache:noexec,nosuid,nodev
Volume=/srv/configs/api-key:/run/secrets/halogen-api-key:ro

[Service]
# A container left behind by a hard reboot is replaced at the next start, but podman's --replace
# keeps its anonymous volumes (up to 26.6 GiB in /var/tmp): remove it with them first.
ExecStartPre=-/usr/bin/podman rm -v -f -i halogen
ExecStartPre=/usr/libexec/halogen/render-config
ExecStartPre=/usr/libexec/halogen/preflight
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
