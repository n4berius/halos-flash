# Everything this image pins. Update here, then rebuild.
FEDORA_BOOTC_IMAGE=quay.io/fedora/fedora-bootc:45

# crun held at 1.30.1: 1.31 no longer creates a missing mount point under a read-only root, so
# Halogen's key at /run/secrets fails every start (crun#2480; fix proposed in podman#30265). To
# remove once Fedora ships a fixed podman or crun (the build log's "crun in Fedora's base today"
# line shows what it has): these two lines, the Containerfile step, the two --build-arg in
# scripts/build.sh and the three crun asserts in tests/static.sh; the selftest's container-start
# check stays, and must pass in the VM test without the hold.
# Fedora's signed copy (key f577861e); the build checks the sha256 and the signature.
CRUN_PIN_URL=https://kojipkgs.fedoraproject.org/packages/crun/1.30.1/1.fc45/data/signed/f577861e/x86_64/crun-1.30.1-1.fc45.x86_64.rpm
CRUN_PIN_SHA256=b4e8c87d553cac7727b27a2b9514019223c75df0edb075a48f4c17f25ec08842

# kernel-next: a test kernel for the images tagged kernel-next and kernel-next-no-npu, built
# from main beside edge (KERNEL_TRACK=next in scripts/build.sh). Every other image keeps Fedora
# 45's own kernel. Fedora 46's (Rawhide's) build of 7.4-rc2: the plain rc build, which Fedora
# makes without its debug options (the build checks), signed for Secure Boot with Fedora's key
# and its packages with Fedora 46's (the base image carries that key). The build checks each
# package's sha256 and signature. To move it: a new NVR, its signing key folder and the four
# sums (sha256sum of the files under KERNEL_NEXT_URL). Koji may stop serving a Rawhide rc build
# some weeks after the next one lands; the build then says to move the pin. To end it, once
# Fedora 45 ships 7.4: build.yml pushes edge's image under the kernel-next tags for a while (so
# machines on it move to edge at their next upgrade), and halosctl keeps the channel name; then
# these lines, the Containerfile step and the iso.yml entry go.
KERNEL_NEXT_NVR=7.4.0-0.rc2.19.fc46
KERNEL_NEXT_URL=https://kojipkgs.fedoraproject.org/packages/kernel/7.4.0/0.rc2.19.fc46/data/signed/91211fce/x86_64
KERNEL_NEXT_SHA256="kernel:7b4d624f00c81f40839847814d5fef456f5d351af3764781128613318c40a3b9 kernel-core:25385a287566f18ad494be73fb7f558972f2b7c037ee5cbf771cd6ead1c5af4c kernel-modules:8576ca9ed85a3eb99eacecb81ceebaa0bea0ec0f89f40d4ebbaf51ba6999241a kernel-modules-core:f82f11525f75db62097f4e3e03cf2ec994cfca071e810f516af104729d8ec36f"

HALOGEN_VERSION=0.20.6
# The OS image is published as ghcr.io/n4berius/halos-flash:<HALOGEN_VERSION>.
# Leave empty to have scripts/build.sh resolve the tag to a digest at build time.
# Either way, the image only ever runs the digest it was built with.
HALOGEN_DIGEST=sha256:f68892a56d8a1182645042574d702374bff402bb986ec4d49304cbe89483dbaf

# Commit of peonist-ai/halogen-flash-server that matches HALOGEN_VERSION.
HALOGEN_SOURCE_COMMIT=e4ef9b381dcdaa99cffb2ace709f8d3762dede97
HALOGEN_CLOCK_SHA256=0dbd47c15f1002e0a8997ec7070e96f3e009125068eab8eccbbd49424a594f5a
HALOGEN_LICENSE_SHA256=58f970ff94fb67d41146f1551a83fb208b5aee4d087224e2097b92850404f53b
HALOGEN_NOTICES_SHA256=c070f415203259e0caf2c9d52bf9af6dfb79a3854a42f0a37616419a4aa2b02c

HALOGEN_WEIGHTS_REPO=peonist-ai/halogen-qwen3.8-flash-next
# A commit of the weights repo, so every install downloads the same files. The image's verify
# mode checks the checkpoint either way. Change it only together with HALOGEN_VERSION, when
# Halogen's release notes say the Flash checkpoints changed or a release reads a new file from
# the repo (0.20.6: the draft head), then run scripts/weights-sums.sh.
HALOGEN_WEIGHTS_REVISION=bd9765dfc69d2ae86eea8f00a5bd93a405c2ad7a

# The ISO builder runs privileged and writes the installer, so it is pinned by digest and
# updated on purpose (osbuild's image-builder-cli; this digest built every ISO since 0.19.0).
IMAGE_BUILDER=ghcr.io/osbuild/image-builder-cli@sha256:5b31804eb2d9f2232ad797a94909c1c2c6ad8fd3a10d8d2232fcb82194b9f751
# bf16-to-hgn (github.com/Quat3rnion/bf16-to-hgn, MIT or Apache-2.0; native/ Apache-2.0): converts
# full-precision Qwen3.8 Flash Next safetensors to .hgn on the machine (halogenctl flash convert).
# Built from this exact commit into the OS image, CPU only.
BF16_TO_HGN_COMMIT=eaa15cb465410c95adf355f3208a34a95d6e81b9

# halogen-dashboard (github.com/Quat3rnion/halogen-dashboard, by Quaternion, MIT or Apache-2.0):
# a live web page of Halogen's load and health on port 8732 (halos-dashboard.service). Built from
# this exact commit into the OS image, web page included.
HALOGEN_DASHBOARD_COMMIT=7f52ec2f864d148c96a5f87a01ad55309e920b63
