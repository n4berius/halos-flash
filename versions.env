# Everything this image pins. Update here, then rebuild.
FEDORA_BOOTC_IMAGE=quay.io/fedora/fedora-bootc:45

HALOGEN_VERSION=0.20.4
# The OS image is published as ghcr.io/n4berius/halos-flash:<HALOGEN_VERSION>.
# Leave empty to have scripts/build.sh resolve the tag to a digest at build time.
# Either way, the image only ever runs the digest it was built with.
HALOGEN_DIGEST=sha256:70445bcf7acff8f1fe11396a97b866ed30dca31caf5fac62049127658080e07f

# Commit of peonist-ai/halogen-flash-server that matches HALOGEN_VERSION.
HALOGEN_SOURCE_COMMIT=de6e7f837b742cbad6e77e86e9e20232daae545f
HALOGEN_CLOCK_SHA256=0dbd47c15f1002e0a8997ec7070e96f3e009125068eab8eccbbd49424a594f5a
HALOGEN_LICENSE_SHA256=58f970ff94fb67d41146f1551a83fb208b5aee4d087224e2097b92850404f53b
HALOGEN_NOTICES_SHA256=6cbd17e0a3b9fad8d614bb6f23be9cb123888696069a15b98315537c002ead0c

HALOGEN_WEIGHTS_REPO=peonist-ai/halogen-qwen3.8-flash-next
# A commit of the weights repo, so every install downloads the same files. The image's verify
# mode checks the checkpoint either way. Change it only together with HALOGEN_VERSION, when
# Halogen's release notes say the Flash checkpoints changed.
HALOGEN_WEIGHTS_REVISION=8ef7ad828f7fa715cba0721a8ef9f9ab20d44e50

# The ISO builder runs privileged and writes the installer, so it is pinned by digest and
# updated on purpose (osbuild's image-builder-cli; this digest built every ISO since 0.19.0).
IMAGE_BUILDER=ghcr.io/osbuild/image-builder-cli@sha256:5b31804eb2d9f2232ad797a94909c1c2c6ad8fd3a10d8d2232fcb82194b9f751
# bf16-to-hgn (github.com/Quat3rnion/bf16-to-hgn, MIT or Apache-2.0; native/ Apache-2.0): converts
# full-precision Qwen3.8 Flash Next safetensors to .hgn on the machine (halogenctl flash convert).
# Built from this exact commit into the OS image, CPU only.
BF16_TO_HGN_COMMIT=eaa15cb465410c95adf355f3208a34a95d6e81b9

# halogen-dashboard (github.com/Quat3rnion/halogen-dashboard, by Quaternion, MIT or Apache-2.0):
# a live web page of Halogen's load and health on port 8732 (halos-dashboard.service). Built from
# this exact commit into the OS image, web page included.
HALOGEN_DASHBOARD_COMMIT=7f52ec2f864d148c96a5f87a01ad55309e920b63
