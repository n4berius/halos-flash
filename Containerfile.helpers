# The helper programs the OS image carries, built from source (#122): bf16-to-hgn, halogen-dashboard
# with halOS's dashboard-nodump library, Caddy, and tool-eval-bench's Python source. scripts/build-helpers.sh builds this file once
# and exports the last stage's tree; scripts/build.sh hands that tree to the Containerfile as the
# build context "helpers", so CI builds them once for its four image jobs instead of four times.
# FEDORA_BOOTC_IMAGE is the base by digest, the same one the OS image is then built on.
ARG FEDORA_BOOTC_IMAGE

# bf16-to-hgn, built from its pinned commit on the same base, so its C++ and OpenMP libraries are
# the ones the OS image has (libstdc++, libgomp). The compilers stay in this stage. /root links to
# /var/roothome, which the base image lacks, and cargo keeps its downloads in ~/.cargo.
# The compilers are installed before the commit is named, so a new pin reuses that layer (#122).
FROM ${FEDORA_BOOTC_IMAGE} AS bf16-to-hgn
RUN dnf -y --setopt=install_weak_deps=False install cargo rust gcc-c++ git-core
ARG BF16_TO_HGN_COMMIT
RUN set -eu; \
    git clone -q https://github.com/Quat3rnion/bf16-to-hgn /src; \
    cd /src; git checkout -q "$BF16_TO_HGN_COMMIT"; \
    [ "$(git rev-parse HEAD)" = "$BF16_TO_HGN_COMMIT" ]; \
    mkdir -p "$(realpath /root)"; \
    cargo build --release --locked; \
    ./target/release/bf16-to-hgn --version; \
    { echo "bf16-to-hgn stage:"; rpm -q cargo rust gcc-c++ | sed 's/^/  /'; } > /toolchain.txt

# halogen-dashboard (Quaternion's live page of Halogen's load), built from its pinned commit: the
# web page first (the binary embeds it), then the collector. Node and Rust stay in this stage.
# Packages' install scripts never run (--ignore-scripts): the page builds without them.
# Also gathers the licences of what the binary carries: the embedded web page's font (IBM Plex
# Sans, SIL OFL 1.1), uPlot, Svelte and the two small parts Svelte's runtime uses (clsx,
# esm-env), and the Rust crates it is built from.
FROM ${FEDORA_BOOTC_IMAGE} AS dashboard
RUN dnf -y --setopt=install_weak_deps=False install cargo rust gcc nodejs pnpm git-core jq
ARG HALOGEN_DASHBOARD_COMMIT
RUN set -eu; \
    git clone -q https://github.com/Quat3rnion/halogen-dashboard /src; \
    cd /src; git checkout -q "$HALOGEN_DASHBOARD_COMMIT"; \
    [ "$(git rev-parse HEAD)" = "$HALOGEN_DASHBOARD_COMMIT" ]; \
    mkdir -p "$(realpath /root)"; \
    (cd web && pnpm install --frozen-lockfile --ignore-scripts && pnpm build); \
    cargo build --release --locked --bin halogen-dashboard; \
    ./target/release/halogen-dashboard --version; \
    lic=/out/licenses; mkdir -p "$lic/web"; \
    cp LICENSE-MIT LICENSE-APACHE "$lic/"; \
    svelte_deps="$(realpath web/node_modules/svelte)/.."; \
    for p in @fontsource-variable/ibm-plex-sans uplot svelte clsx esm-env; do \
      d="web/node_modules/$p"; case "$p" in clsx|esm-env) d="$svelte_deps/$p" ;; esac; \
      f="$(find "$d/" -maxdepth 1 -iname 'licen[cs]e*' | head -n 1)"; \
      [ -n "$f" ] || { echo "no licence file for $p" >&2; exit 1; }; \
      cp "$f" "$lic/web/$(echo "$p" | tr / _ | tr -d @)-LICENSE"; \
    done; \
    { echo "Rust crates halogen-dashboard is built from (name, version, licence), from Cargo.lock at $HALOGEN_DASHBOARD_COMMIT."; \
      echo "Their licence texts are at https://crates.io/crates/<name>/<version>."; echo; \
      cargo metadata --format-version 1 --locked --filter-platform x86_64-unknown-linux-gnu \
        | jq -r '.packages[] | select(.name != "halogen-dashboard") | "\(.name) \(.version) \(.license // "see crates.io")"' | sort -u; \
    } > "$lic/crates.txt"; \
    grep -q '^axum ' "$lic/crates.txt" && grep -q '^rusqlite ' "$lic/crates.txt" \
      || { echo "the crate list is incomplete" >&2; exit 1; }
# halOS's own small library, preloaded into the dashboard so a crash can't put the API key in the
# journal (src/dashboard-nodump.c). Same base image, so the same glibc as the os stage.
COPY src/dashboard-nodump.c /halos-src/
RUN set -eu; \
    gcc -O2 -shared -fPIC -Wall -Wextra -Werror -o /out/dashboard-nodump.so /halos-src/dashboard-nodump.c; \
    [ -z "$(LD_PRELOAD=/out/dashboard-nodump.so /usr/bin/true 2>&1)" ]; \
    chmod 0755 /out; \
    setpriv --reuid=65534 --regid=65534 --clear-groups cat /proc/self/environ > /dev/null; \
    ! LD_PRELOAD=/out/dashboard-nodump.so setpriv --reuid=65534 --regid=65534 --clear-groups cat /proc/self/environ > /dev/null 2>&1; \
    { echo "dashboard stage:"; rpm -q cargo rust gcc nodejs pnpm | sed 's/^/  /'; } > /toolchain.txt

# Caddy, halOS's front door (halos-proxy.service): Halogen's API on 8731 and the dashboard on 8732,
# over HTTP or HTTPS. Built from src/caddy, whose go.mod and go.sum pin every module by version and
# hash, because Fedora's caddy package has no DNS providers for Let's Encrypt's DNS-01 challenge.
# DuckDNS and Namecheap go through halOS's own modules (src/caddy/dnsproviders), since their
# caddy-dns plugins carry no licence. Also gathers the licence files of every module linked in.
# Three layers, so a local rebuild after a change to halOS's own Go source reuses the first two
# (#122): Go itself, then the modules go.mod and go.sum name (downloaded and checked against
# go.sum), then the source, built with the network to Go's proxy turned off (GOPROXY=off), so it
# uses only the modules checked in the layer before. A change to go.mod or go.sum (Dependabot)
# downloads the modules again; a new base digest redoes all three. The last step keeps Go's compile
# cache in a podman cache mount (on the building machine only, never in the image or the tree), so a
# source-only rebuild compiles only what changed: about 5 s instead of 98 s, measured with Go 1.27's
# image standing in for the base. The tests are compiled (go test -c) and run directly, so they
# always run: plain go test reused a cached pass. Go trusts a cache entry by its key, so nothing
# built here runs as root while the cache is writable: the test binary and Caddy run as nobody, who
# can't write to the cache, so a branch built on the same machine can't plant an entry a later build
# of main reuses. CI starts each run on a fresh runner with no layers and no cache mount, so it
# gains nothing there, and no cache crosses runs.
FROM ${FEDORA_BOOTC_IMAGE} AS caddy
ENV GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0 GOSUMDB=sum.golang.org
RUN set -eu; \
    dnf -y --setopt=install_weak_deps=False install golang; \
    mkdir -p "$(realpath /root)"
COPY src/caddy/go.mod src/caddy/go.sum /src/caddy/
RUN set -eu; \
    cd /src/caddy; \
    GOPROXY=https://proxy.golang.org go mod download; \
    go mod verify
COPY src/caddy/ /src/caddy/
# caddy-dns/cloudflare prints a token it refuses (journal), so the https helper's dns_value_ok lets
# only the two shapes it accepts through. The build stops if the plugin's check ever changes.
RUN --mount=type=cache,id=halos-caddy-go-build,target=/go-build set -eu; \
    cd /src/caddy; \
    export GOPROXY=off GOCACHE=/go-build; \
    nobody() { setpriv --reuid=65534 --regid=65534 --clear-groups "$@"; }; \
    t="$(mktemp -d)"; \
    go test -c -o "$t/dnsproviders.test" ./dnsproviders/; \
    chmod 0755 "$t"; (cd dnsproviders && nobody "$t/dnsproviders.test"); \
    go build -trimpath -ldflags='-s -w' -o /out/caddy .; \
    nobody /out/caddy version; \
    nobody /out/caddy list-modules > "$t/modules"; \
    for p in cloudflare duckdns namecheap porkbun; do grep -qx "dns.providers.$p" "$t/modules"; done; \
    cf="$(go list -m -f '{{.Dir}}' github.com/caddy-dns/cloudflare)/cloudflare.go"; \
    if ! grep -qF 'regexp.MustCompile(`^[A-Za-z0-9_-]{35,50}$`)' "$cf" \
      || ! grep -qF 'regexp.MustCompile(`^cf(ut|at)_[A-Za-z0-9_-]{32,256}$`)' "$cf" \
      || [ "$(grep -c 'regexp.MustCompile' "$cf")" != 2 ]; then echo "caddy-dns/cloudflare's token check changed: update dns_value_ok in files/usr/libexec/halogen/https" >&2; exit 1; fi; \
    lic=/out/licenses; mkdir -p "$lic/modules"; \
    { echo "Go modules linked into halOS's Caddy (path, version), from src/caddy/go.sum."; \
      echo "Each module's licence file, where it has one, is under modules/<path>/."; echo; } > "$lic/modules.txt"; \
    go list -deps -f '{{with .Module}}{{if .Version}}{{.Path}} {{.Version}} {{.Dir}}{{end}}{{end}}' . | sort -u \
      | while read -r m v d; do \
          echo "$m $v" >> "$lic/modules.txt"; \
          f="$(find "$d" -maxdepth 1 -type f \( -iname 'licen[cs]e*' -o -iname 'copying*' -o -iname 'notice*' \) | sort)"; \
          if [ -n "$f" ]; then mkdir -p "$lic/modules/$m"; echo "$f" | while read -r g; do cp "$g" "$lic/modules/$m/"; done; fi; \
        done; \
    echo "go $(go env GOVERSION) (the standard library): go-LICENSE" >> "$lic/modules.txt"; \
    goli="$(go env GOROOT)/LICENSE"; [ -r "$goli" ] || goli=/usr/share/licenses/golang/LICENSE; \
    cp "$goli" "$lic/go-LICENSE"; \
    for m in github.com/caddyserver/caddy/v2 github.com/caddy-dns/cloudflare github.com/caddy-dns/porkbun \
      github.com/libdns/duckdns github.com/libdns/namecheap; do \
      ls "$lic/modules/$m/"* > /dev/null || { echo "no licence file for $m" >&2; exit 1; }; \
    done; \
    { echo "caddy stage:"; rpm -q golang | sed 's/^/  /'; echo "  $(go env GOVERSION)"; } > /toolchain.txt

# tool-eval-bench (SeraphimSerapis, MIT): the tool-calling benchmark behind `halogenctl bench tools`.
# Pure Python, so nothing is compiled: this stage only takes the package from its pinned release
# commit, without its optional web page (it needs Starlette, which the image lacks), and records the
# version that setuptools-scm would have written. The OS image installs its four libraries from
# Fedora (httpx, PyYAML, rich, python-dotenv).
FROM ${FEDORA_BOOTC_IMAGE} AS tool-eval-bench
RUN dnf -y --setopt=install_weak_deps=False install git-core
ARG TOOL_EVAL_BENCH_COMMIT
ARG TOOL_EVAL_BENCH_VERSION
RUN set -eu; \
    git clone -q https://github.com/SeraphimSerapis/tool-eval-bench /src; \
    cd /src; git checkout -q "$TOOL_EVAL_BENCH_COMMIT"; \
    [ "$(git rev-parse HEAD)" = "$TOOL_EVAL_BENCH_COMMIT" ]; \
    grep -qx 'license = "MIT"' pyproject.toml; \
    mkdir -p /out/licenses; \
    cp -r src/tool_eval_bench /out/tool_eval_bench; \
    rm -rf /out/tool_eval_bench/web; \
    find /out -name __pycache__ -prune -exec rm -rf {} +; \
    printf 'version = "%s"\n__version__ = version\n' "$TOOL_EVAL_BENCH_VERSION" > /out/tool_eval_bench/_version.py; \
    cp LICENSE /out/licenses/LICENSE; \
    { echo "tool-eval-bench stage (Python source, nothing compiled):"; rpm -q git-core | sed 's/^/  /'; } > /toolchain.txt

# What the OS image copies (Containerfile, COPY --from=helpers), one folder per program.
FROM scratch AS helpers
COPY --from=bf16-to-hgn /src/target/release/bf16-to-hgn /bf16-to-hgn/bf16-to-hgn
COPY --from=bf16-to-hgn /src/LICENSE-MIT /src/LICENSE-APACHE /bf16-to-hgn/licenses/
COPY --from=bf16-to-hgn /src/native/LICENSE /bf16-to-hgn/licenses/native/LICENSE
COPY --from=bf16-to-hgn /src/native/NOTICE /bf16-to-hgn/licenses/native/NOTICE
COPY --from=dashboard /src/target/release/halogen-dashboard /dashboard/halogen-dashboard
COPY --from=dashboard /out/licenses/ /dashboard/licenses/
COPY --from=dashboard /out/dashboard-nodump.so /dashboard/dashboard-nodump.so
COPY --from=caddy /out/caddy /caddy/caddy
COPY --from=caddy /out/licenses/ /caddy/licenses/
COPY --from=tool-eval-bench /out/tool_eval_bench/ /tool-eval-bench/tool_eval_bench/
COPY --from=tool-eval-bench /out/licenses/ /tool-eval-bench/licenses/
# The compilers each stage used, for the build record (scripts/build-info.sh, #121).
COPY --from=bf16-to-hgn /toolchain.txt /bf16-to-hgn/toolchain.txt
COPY --from=dashboard /toolchain.txt /dashboard/toolchain.txt
COPY --from=caddy /toolchain.txt /caddy/toolchain.txt
COPY --from=tool-eval-bench /toolchain.txt /tool-eval-bench/toolchain.txt
